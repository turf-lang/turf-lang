// Test: Issue #173 - TurfWarning
// Verifies that a shadowing warning does NOT halt compilation.
// The program must still produce output.
// Expected: warning emitted, binary runs, prints "30"

import io;

fn main(): int {
    mutable x: int = 10;
    if (x > 5) {
        mutable x: int = 20;
        if (x > 10) {
            mutable x: int = 30;
            io.printline(x);
        }
    }
    return 0;
}
