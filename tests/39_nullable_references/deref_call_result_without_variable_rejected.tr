// A call's `&?T` result read directly: unchecked before, like
// fail_deref_field_chain_without_variable.tr.
struct Node { val: int, next: &?Node }

fn find(): &?Node {
    return null;
}

@test(compile_error, E081, "I cannot access the field `val` of this `&?Node`, which might be `null`")
fn rejects_deref_call_result_without_variable(): void {
    find().val;
}
