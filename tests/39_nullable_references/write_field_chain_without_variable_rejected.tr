// The write form of fail_deref_field_chain_without_variable.tr.
struct Node { val: int, next: &?Node }

@test(compile_error, E081, "I cannot access the field `val` of `p.next`, which might be `null` here.")
fn rejects_write_field_chain_without_variable(): void {
    mut p: &Node = heap(Node::default());
    p.next.val = 3;
}
