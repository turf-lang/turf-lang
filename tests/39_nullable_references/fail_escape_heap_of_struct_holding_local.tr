// EXPECT-DIAG: E086
// EXPECT-DIAG: can't be boxed with heap() inside a struct or array value
// heap(m) copies `m` onto the GC heap, `m.next` included: the boxed node
// outlives this frame but points into it.
struct N { val: int, next: &?N }

fn make(): &N {
    mut n: N = N::default();
    n.val = 42;
    mut m: N = N::default();
    m.next = &n;
    return heap(m);
}

fn main(): int {
    mut p: &N = make();
    return p.val;
}
