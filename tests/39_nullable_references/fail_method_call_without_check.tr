// EXPECT-DIAG: E081
// EXPECT-DIAG: 'q' might be 'null' here, but you're calling its 'bump' method
// A method call reads its receiver as `self`, so on a `&?T` it needs the same
// null check a field read does. Only `q.field` was checked: this compiled and
// faulted at address 0x0. Found by turf-fuzz probing.
struct Node { val: int, next: &?Node }

fn Node.bump(k: int): void {
    self.val = self.val + k;
}

fn main(): int {
    mut q: &?Node = null;
    q.bump(1);
    return 0;
}
