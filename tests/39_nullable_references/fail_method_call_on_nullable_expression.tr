// EXPECT-DIAG: E081
// EXPECT-DIAG: I cannot call the method `bump` of `p.next`, which might be `null` here.
// A method call whose receiver is a `&?T` field nothing checked.
struct Node { val: int, next: &?Node }

fn Node.bump(k: int): void {
    self.val = self.val + k;
}

fn main(): int {
    mut p: &Node = heap(Node::default());
    p.next.bump(1);
    return 0;
}
