import io;

fn main(): int {
    mut x: int = 2;
    mut result: int = 0;

    // Multi-value stacked matches — all share one body
    compare x {
        matches 1:
        matches 2:
        matches 3:
            result = 100;
        done

        otherwise:
            result = 999;
    }
    assert(result == 100, "stacked matches: x=2 should hit shared body");

    mut y: int = 5;
    mut result2: int = 0;
    compare y {
        matches 1:
        matches 2:
        matches 3:
            result2 = 100;
        done
        otherwise:
            result2 = 200;
    }
    assert(result2 == 200, "stacked matches: x=5 should hit otherwise");

    return 0;
}
