// RUNTIME_ABORT_EXPECTED
// Companion to 14_fail_not_final_statement.tr: when the fail() branch IS
// actually taken, it must still compile cleanly (see that test's doc
// comment for the full crash history) AND actually abort at runtime --
// the dead-block-repositioning fix must not accidentally make fail()
// stop calling abort(), or let execution fall through into the
// "unreachable" code that follows it in source.

import io;

fn checkPositive(x: int): int {
    if (x < 0) {
        fail("checkPositive: x must not be negative");
        io::printline("must never print: fail() should have aborted first");
    }
    return x * 2;
}

fn main(): int {
    mut result: int = checkPositive(-5);
    io::printline("must never print: checkPositive should have aborted");
    return 0;
}
