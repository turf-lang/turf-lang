// Test: Iterate via Direction::VALUES and Direction::NAMES
enum Direction { North, East, South, West }

fn main(): int {
    immut count: int = Direction::COUNT;
    assert(count == 4, "COUNT == 4");

    immut vals: Direction* = Direction::VALUES;
    immut names: string* = Direction::NAMES;

    mut i: int = 0;
    while i < count {
        immut d: Direction = vals[i];
        immut n: string = names[i];

        assert((d to int) == i, "VALUES element matches ordinal");
        assert((d to string) == n, "NAMES element matches to_string cast");
        
        // Also verify string matches
        if i == 0 { assert(n == "North", "index 0 is North"); }
        if i == 1 { assert(n == "East", "index 1 is East"); }
        if i == 2 { assert(n == "South", "index 2 is South"); }
        if i == 3 { assert(n == "West", "index 3 is West"); }

        i = i + 1;
    }
    return 0;
}
