// F-11e: tests moved from fail_*.tr files, one function each; each `@test` names the
// error its body must be rejected with.

import io::[*];
import test;

// Regression test (was DISCOVERED_ISSUES.md #8): a typo'd bare language
// intrinsic (assert, fail, typeof — callable without a module qualifier)
// must get a real "did you mean" suggestion, not a bare "Unknown function"
// with zero candidates.
//
// The original gap was that intrinsics don't exist as SymbolTable entries
// (they're recognized via LookupBuiltin(), not registered as callable
// symbols), so the typo corrector's SymbolTable-only candidate search never
// saw them. Re-verified fixed: misspelling 'assert' as 'asert' now gets a
// direct 'test::assert(...)' suggestion.

@test(compile_error, E041, "I cannot find a function named `asert`.")
fn rejects_bare_intrinsic_typo(): void {
    asert(1 == 1);
}

// Regression test: a local variable that is not callable but shares a name with
// an imported function used to be silently ignored at the call site, so
// `printline("Hi")` compiled and called io::printline. The local is what the
// name means in that scope; calling it is an error.

@test(compile_error, E135, "I cannot call `printline`, which is a variable of type `int` and not a function")
fn rejects_call_shadowed_by_local_variable(): void {
    mut printline: int = 0;

    printline("Hi" + (printline to string));

}

@test(compile_error, E040, "")
fn rejects_undeclared_var_pin(): void {
    if (1 > 0) {
        mut counter: int = 0;
        test::assert(counter == 0, "");
    }

    // ... padding so declaration is out of +/-5 window ...
    // This tests the SLM context window logic when analyzing the error.
    mut padding1: int = 0;
    mut padding2: int = 0;
    mut padding3: int = 0;
    mut padding4: int = 0;
    mut padding5: int = 0;
    mut padding6: int = 0;

    // counter is out of scope here
    test::assert(counter == 0, "should fail: undeclared var");

}
