fn main(): int {
    mut x: int = 1;
    assert(x == 1, "x scope");

    if (x > 0) {
        mut y: int = 2;
        assert(x == 1, "outer x accessible in inner");
        assert(y == 2, "y scope");

        if (y > 0) {
            mut z: int = 3;
            assert(x == 1, "outermost x accessible");
            assert(y == 2, "outer y accessible");
            assert(z == 3, "z scope");
        } else {
            assert(false, "Unreachable");
        }
        assert(y == 2, "y still accessible after inner block");
    } else {
        assert(false, "Unreachable");
    }

    assert(x == 1, "x still accessible at end");

    return 0;
}
