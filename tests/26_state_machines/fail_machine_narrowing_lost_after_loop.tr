// RUNTIME_ABORT_EXPECTED
// EXPECT-RUNTIME: C::transition(Connecting) -- no such transition from the current state
// After a loop the state in a narrowed arm is no longer known, so the
// transition is checked when it runs instead of being trusted.
machine C {
    Idle -> Connecting,
    Connecting -> Connected
}

fn advance(p: &C): void {
    p.transition(C::Connecting);
}

fn main(): int {
    mut x: C = C::Idle;
    compare x {
        matches C::Idle:
        for i in 0..3 {
            x.transition(C::Connecting);
        }
        done
        otherwise:
        return 1;
    }
    return 0;
}
