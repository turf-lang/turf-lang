// RUNTIME_ABORT_EXPECTED
// OPT-002 must never elide a check that ISN'T provably safe. `bigVal()`'s
// return is a FuncCallExprAST -- markElidableChecks()'s evalConstExpr() has
// no case for it at all (it only folds literals, plain-variable reads, and
// +/-/* over already-known operands, per its own doc comment,
// ValueRange.cpp), so `a` is correctly never treated as a known constant,
// and `a + 1` must still trap at runtime exactly like it did before this
// group existed.
fn bigVal(): int {
    return 9223372036854775807;
}

fn main(): int {
    mut a: int = bigVal();
    a = a + 1;
    return 0;
}
