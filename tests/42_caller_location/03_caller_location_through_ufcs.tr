// A `@caller_location` function called in method form (UFCS) gets its hidden
// argument too. `s.substring(1, 3)` asserted in codegen (the UFCS branch of
// MethodCallExprAST::codegen() never appended it) while
// `strings::substring(s, 1, 3)` was fine; found writing REL-005's benchmarks.
// A user function behaves the same way, and records the calling line.

import test;
import strings;

@caller_location
fn where(s: string, n: int): string {
    return caller_location;
}

fn main(): int {
    immut s: string = "abcdef";
    test::assert(s.substring(1, 3) == "bc", "substring in method form");
    test::assert(s.substring(1, 3) == strings::substring(s, 1, 3), "both forms agree");
    for i in 0..2 {
        test::assert(s.substring(i, i + 1).length() == 1, "inside a loop");
    }
    immut at: string = s.where(1);
    test::assert(at.ends_with(":22"), "a user function names the calling line");
    return 0;
}
