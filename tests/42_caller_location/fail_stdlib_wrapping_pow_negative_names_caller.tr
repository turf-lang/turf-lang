// NM-3: a negative exponent has no integer result, so wrapping_pow panics.
// RUNTIME_ABORT_EXPECTED
// EXPECT-RUNTIME: fail_stdlib_wrapping_pow_negative_names_caller.tr:7: math::wrapping_pow: negative exponent

fn main(): int {
    mut e: int = -1;
    immut p: int = math::wrapping_pow(2, e);
    return p;
}
