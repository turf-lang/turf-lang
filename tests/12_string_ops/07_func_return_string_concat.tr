// Test: Concatenating return values from multiple functions returning strings
import io;

import test;
fn get_greeting(): string {
    return "Hello";
}

fn get_separator(): string {
    return ", ";
}

fn get_name(num: int): string {
    if num == 1 {
        return "Alice";
    }
    return "Bob";
}

fn get_exclamation(): string {
    return "!";
}

fn main(): int {
    // Concatenate return values from 4 different functions
    mut msg1: string = get_greeting() + get_separator() + get_name(1) + get_exclamation();
    test::assert(msg1 == "Hello, Alice!", "msg1 concatenation failed");

    mut msg2: string = get_greeting() + get_separator() + get_name(2) + get_exclamation();
    test::assert(msg2 == "Hello, Bob!", "msg2 concatenation failed");

    // Also test function return + literal + variable
    mut prefix: string = "[LOG] ";
    mut full_log: string = prefix + get_name(1) + " connected.";
    test::assert(full_log == "[LOG] Alice connected.", "full_log concatenation failed");

    io::printline("07_func_return_string_concat passed!");
    return 0;
}
