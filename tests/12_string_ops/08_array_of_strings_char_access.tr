// Test: Function returning array of strings and checking character indices of elements
import io;

fn get_words(): string[4] {
    mut arr: string[4] = ["apple", "banana", "cherry", "date"];
    return arr;
}

fn main(): int {
    mut words: string[4] = get_words();

    // Check string equality on array elements
    assert(words[0] == "apple", "words[0] should be apple");
    assert(words[2] == "cherry", "words[2] should be cherry");
    assert(words[3] == "date", "words[3] should be date");

    // Check character access on returned array elements (words[i][j])
    mut c0_0: int = words[0][0]; // 'a' in "apple" -> 97
    mut c1_1: int = words[1][1]; // 'a' in "banana" -> 97
    mut c2_0: int = words[2][0]; // 'c' in "cherry" -> 99
    mut c3_3: int = words[3][3]; // 'e' in "date" -> 101

    assert(c0_0 == 97, "words[0][0] should be 97 ('a')");
    assert(c1_1 == 97, "words[1][1] should be 97 ('a')");
    assert(c2_0 == 99, "words[2][0] should be 99 ('c')");
    assert(c3_3 == 101, "words[3][3] should be 101 ('e')");

    // Also check direct inline indexing on function call return
    assert(get_words()[2][0] == 99, "get_words()[2][0] should be 99 ('c')");

    io::printline("08_array_of_strings_char_access passed!");
    return 0;
}
