// F-11e: tests moved from fail_*.tr files, one function each; each `@test` names the
// error its body must be rejected with.

import mem;

// The `@ownership` annotations on externs declared inside a function body
// reach the alias analysis exactly as file-scope ones do.

@test(compile_error, E017, "I found a second free of `p`")
fn rejects_annotated_local_extern_double_free(): void {
    @ownership(acquires)
    extern fn malloc(size: int): int*;

    @ownership(releases: p)
    extern fn free(p: int*): void;

    unsafe {
        mut p: int* = malloc(sizeof(int) * 4);
        free(p);
        free(p);
    }
}

// `p.free()` is `mem::free(p)` through UFCS, so the alias analysis reads the
// callee's `@ownership(releases: p)` the same way, with the receiver as the
// first argument. Before, a method-call form was never looked at.

@test(compile_error, E017, "I found a second free of `p`.")
fn rejects_ufcs_release_double_free(): void {
    unsafe {
        mut p: void* = mem::alloc(16);
        p.free();
        p.free();
    }
}
