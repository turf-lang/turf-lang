// EXPECT-NO-DIAG: Expected a word or a string
// A keyword is a word in an annotation's arguments, so `error: x` parses (an
// annotation such as `@diagnostics(error: ...)` needs that) and reaches the
// pass that owns the name, which says what is wrong. It used to be a syntax
// error at the parser.

@ownership(error: x)
extern fn malloc(size: int): int*;

fn main(): int {
    return 0;
}
