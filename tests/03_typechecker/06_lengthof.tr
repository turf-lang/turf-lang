import io;

import test;
fn main(): int {
    // Basic string literal
    mut a: int = lengthof("hello");
    test::assert(a == 5, "");

    // Empty string must return 0
    mut b: int = lengthof("");
    test::assert(b == 0, "");

    // Three-character string
    mut c: int = lengthof("abc");
    test::assert(c == 3, "");

    // Stored in a variable first
    mut s: string = "Turf";
    mut d: int = lengthof(s);
    test::assert(d == 4, "");

    // Used directly in an expression
    mut e: int = lengthof("hi") + lengthof("!");
    test::assert(e == 3, "");

    // Longer string
    mut f: int = lengthof("Hello, World!");
    test::assert(f == 13, "");
    
    return 0;
}
