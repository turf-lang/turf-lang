import io;

fn main(): int {
    // 1. !true compiles to false
    assert(!true == false, "!true should be false");

    // 2. !false compiles to true
    assert(!false == true, "!false should be true");

    // 3. if !flag { ... } parses and compiles correctly
    mutable flag: bool = false;
    mutable ran: bool = false;
    if !flag {
        ran = true;
    }
    assert(ran == true, "if !flag block should execute");

    // 4. !!x (double negation) parses as !(!x) and compiles correctly
    mutable x: bool = true;
    assert(!!x == true, "!!true should be true");
    mutable y: bool = false;
    assert(!!y == false, "!!false should be false");

    // 5. != as a binary operator is unaffected
    mutable a: int = 10;
    mutable b: int = 20;
    assert(a != b, "!= should work normally");

    return 0;
}
