import io;

struct Point {
    x: int,
    y: int,
    name: string,
    z: double
}

fn main(): int {
    // 1. Local primitive variables must be explicitly assigned before use.
    //    Declare then assign — this is valid.
    mut x: int;
    x = 42;
    assert(x == 42, "assign after empty declaration");

    // 2. Struct variables declared without "= value" are default-initialized.
    mut p: Point;
    assert(p.x == 0, "struct field default init x");
    assert(p.y == 0, "struct field default init y");
    assert(p.name == "", "struct field default init name");
    assert(p.z == 0.0, "struct field default init z");

    // 3. Struct literal with partial fields — missing fields are default-initialized.
    mut p2: Point = Point{x: 5};
    assert(p2.x == 5, "explicit field init");
    assert(p2.y == 0, "missing field y default init");
    assert(p2.name == "", "missing field name default init");
    assert(p2.z == 0.0, "missing field z default init");

    return 0;
}
