import io;

struct Point {
    x: int,
    y: int,
    name: string,
    z: double
}

fn main(): int {
    mut a: int = 0;
    mut b: double = 0.0;
    mut c: bool = false;
    mut d: string = "";

    assert(a == 0, "");
    assert(b == 0.0, ""); 
    assert(c == false, "");
    assert(d == "", "");

    mut p: Point = Point { x: 0, y: 0, name: "", z: 0.0 };

    assert(p.x == 0, "");
    assert(p.y == 0, "");
    assert(p.name == "", "");
    assert(p.z == 0.0, "");

    return 0;
}
