import io;

struct Point {
    x: int,
    y: int,
    name: string,
    z: double
}

fn main(): int {
    mut a: int;
    mut b: double;
    mut c: bool;
    mut d: string;
    mut ptr_val: int*;

    assert(a == 0, "int default init");
    assert(b == 0.0, "double default init"); 
    assert(c == false, "bool default init");
    assert(d == "", "string default init");
    assert(ptr_val == null, "pointer default init");

    mut p: Point;

    assert(p.x == 0, "struct field default init x");
    assert(p.y == 0, "struct field default init y");
    assert(p.name == "", "struct field default init name");
    assert(p.z == 0.0, "struct field default init z");

    return 0;
}
