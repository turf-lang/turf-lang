import io;

fn main(): int {
    io.printline("T 1");
    assert(typeof(10) == "int", "");

    io.printline("T 2");
    assert(typeof("hello") == "string", "");

    io.printline("T 3");
    assert(typeof(3.14) == "double", "");

    io.printline("T 4");
    assert(typeof(true) == "bool", "");

    io.printline("T 5");
    assert(typeof([1, 2]) == "int[2]", "");
    io.printline("Done");
    return 0;
}
