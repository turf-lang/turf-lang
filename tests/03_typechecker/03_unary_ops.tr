import io;

import test;
fn main(): int {
    mut a: int = -5;
    mut b: int = -a;
    mut c: double = -3.14;
    mut d: double = -c;

    test::assert(a == -5, "");
    test::assert(b == 5, "");
    test::assert(c < -3.13 && c > -3.15, "");
    test::assert(d > 3.13 && d < 3.15, "");

    return 0;
}
