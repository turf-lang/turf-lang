// tests/08_e2e_stress/06_gc_bounded_allocation.tr
// MEM-002's own completion criterion (docs/planning/ARCHITECTURE_OVERHAUL.md
// §8): "The stress test's RSS is bounded ... the observable proof that
// leaks are gone." This file is the allocation workload;
// scripts/gc_rss_smoke.sh is what actually measures peak RSS around it (an
// ordinary `test_runner.sh` run only checks this compiles and exits 0 --
// see that script for the real assertion).
//
// Each build_list() call allocates its own List<int>, grows it to 1000
// elements (~8KB backing buffer at its final capacity), and returns only
// its LENGTH -- the List<int> value itself, and everything it points at,
// is unreachable the instant the function returns. Run 5000 times, total
// GC-heap allocation REQUESTS sum to roughly 5000 * 16KB =~ 80MB (the
// doubling-growth series 8,16,32,...,1024 elements * 8 bytes, summed, per
// call) -- if nothing collected, peak RSS would approach that figure. If
// the collector works, peak RSS stays close to a small, constant number of
// lists' worth, independent of how many iterations run.

import list::List;
import test;

fn build_list(n: int): int {
    mut l: List<int> = List::default();
    mut i: int = 0;
    while i < n {
        l.push(i);
        i = i + 1;
    }
    return l.length();
}

fn main(): int {
    mut total: int = 0;
    mut iter: int = 0;
    while iter < 5000 {
        total = total + build_list(1000);
        iter = iter + 1;
    }
    test::assert(total == 5000 * 1000, "bounded-allocation stress: total count correct");
    return 0;
}
