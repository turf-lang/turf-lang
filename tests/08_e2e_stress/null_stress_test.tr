import test;

struct Data {
    id: int,
    name: string
}

fn Data.new(id: int, name: string): void {
    self.id = id;
    self.name = name;
}

struct Node {
    val: int,
    data: Data*,
    left: Node*,
    right: Node*
}

fn Node.new(val: int, data: Data*, left: Node*, right: Node*): void {
    self.val = val;
    self.data = data;
    self.left = left;
    self.right = right;
}

fn createNode(val: int, data: Data*, left: Node*, right: Node*): Node {
    return Node::new(val, data, left, right);
}

fn findVal(node: Node*, target: int): bool {
    if node == null {
        return false;
    }
    if node.val == target {
        return true;
    }
    mut found_left: bool = findVal(node.left, target);
    if found_left {
        return true;
    }
    return findVal(node.right, target);
}

fn main(): int {
    mut d1: Data = Data::new(1, "Data 1");
    mut d2: Data = Data::new(2, "Data 2");

    // Initialize root, left, right nodes with valid pointers and null pointers
    mut l_node: Node = createNode(5, &d1, null, null);
    mut r_node: Node = createNode(15, &d2, null, null);
    mut root: Node = createNode(10, null, &l_node, &r_node);

    // Verify properties
    test::assert(root.data == null, "root data should be null");
    test::assert(root.left != null, "root left should not be null");
    test::assert(root.right != null, "root right should not be null");

    // Traverse and find values using the recursive function which checks against null
    mut found_10: bool = findVal(&root, 10);
    mut found_5: bool = findVal(&root, 5);
    mut found_15: bool = findVal(&root, 15);
    mut found_100: bool = findVal(&root, 100);

    test::assert(found_10 == true, "should find 10");
    test::assert(found_5 == true, "should find 5");
    test::assert(found_15 == true, "should find 15");
    test::assert(found_100 == false, "should not find 100");

    // Re-assign pointers to null and check behavior
    mut p_node: Node* = &root;
    p_node = null;
    test::assert(p_node == null, "p_node should be successfully assigned to null");

    // Chain pointers in multiple levels
    mut current: Node* = &root;
    mut count: int = 0;
    while current != null {
        count = count + 1;
        if count == 1 {
            current = current.left;
        } else {
            current = null;
        }
    }
    test::assert(count == 2, "should iterate twice");

    return 0;
}
