fn ackermann(m: int, n: int): int {
    if m == 0 {
        return n + 1;
    }
    if m > 0 {
        if n == 0 {
            return ackermann(m - 1, 1);
        }
    }
    return ackermann(m - 1, ackermann(m, n - 1));
}

fn main(): int {
    mut result: int = ackermann(3, 4);
    assert(result == 125, "");

    return 0;
}
