// EXPECT-DIAG: E041
// EXPECT-DIAG: Unknown function 'undeclared_elsewhere'
// TDP-2-006: a compile_error test takes the errors inside it only; the same
// mistake anywhere else in the file is the program's.
@test(compile_error, E041, "Unknown function")
fn a(): void {
    undeclared();
}

fn main(): int {
    undeclared_elsewhere();
    return 0;
}
