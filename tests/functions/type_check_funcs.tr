// Implicit Widening doesn't work, passing integer in toDouble() function where it expects a double produces a weird error
// > ./turf tests/functions/type_check_funcs.tr
// [AliasAnalysis] running on function: add
// [AliasAnalysis] running on function: toDouble
// [AliasAnalysis] running on function: greet
// [Main] GlobalCFGs size before CallGraph: 3
// [CallGraph] Functions: 0
// ── error at line 15, col 11
// 
//   Oops! You can't use a void value here!
//   You're trying to store the result of a void function in 'result'.
//   Hint: A void function doesn't produce a value. You can call it as a statement, but not use its result in an expression or assignment.

fn int add(int a, int b) {
    return a + b
}

fn double toDouble(double x) {
    return x
}

fn void greet() {
    io.printline("hello")
}

fn int main() {
    // Passing int where double expected (implicit widening)
    double result = toDouble(42)
    io.printline(result)

    // Returning int from int function - should work
    int sum = add(3, 7)
    io.printline(sum)

    // Passing double where int expected (implicit narrowing)
    int narrow = add(3, 2)
    io.printline(narrow)

    // Calling void function as a statement - should work
    greet()

    // Using bool-to-int implicit conversion - should work
    int boolResult = add(1, true)
    io.printline(boolResult)

    return 0
}
