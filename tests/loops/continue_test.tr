fn int main() {
    int i = 0
    int sum = 0

    while i < 10 {
        i = i + 1
        if i % 2 == 0 {
            continue
        } else {}
        sum = sum + i
    }
    io.printline(sum) 

    int for_sum = 0
    for j in 1..10 step j += 1 {
        if j % 2 == 0 {
            continue
        } else {}
        for_sum = for_sum + j
    }
    io.printline(for_sum)

    return 0
}
