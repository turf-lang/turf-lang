// A generic type named only by a function signature: no local, field or
// call anywhere else instantiates `Box<int>`, `Box<Box<bool>>` or
// `List<int>`. The parameter slot is that struct, so its layout is still
// needed. Nothing recorded the instantiation, and the compile died with
// "monomorphized struct instantiation 'Box_gen1_int' was never given a real
// layout". Found by turf-fuzz (a helper taking a `List<int>` that no local
// instantiates); visitFuncDef() now records the signature's generic types.
import list::List;

struct Box<T> {
    v: T
}

fn unused_box(b: Box<int>): int {
    return 7;
}

fn unused_nested(b: Box<Box<bool>>): int {
    return 8;
}

fn unused_list(l: List<int>, n: int): int {
    return n;
}

fn main(): int {
    return 0;
}
