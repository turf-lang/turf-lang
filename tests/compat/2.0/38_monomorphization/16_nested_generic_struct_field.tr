// Regression test: D2's nested case (docs/development/changes/TYPE-002.md,
// S15) -- `struct Holder { items: List<List<Big>> }` must record BOTH the
// outer List<List<Big>> instantiation AND the inner List<Big> one, not just
// the outer. recordGenericFieldInstantiations() (TypeCheckerDecl.cpp)
// recurses into a GenericType's own type arguments specifically to cover
// this shape.
import list::List;
import test;

struct Big { a: int, b: int, c: int }
struct Holder { items: List<List<Big> >, n: int }

fn main(): int {
    // Holder = { items: List<List<Big>> (8 bytes: the header handle, LEC-009), n: int (8 bytes) } = 16
    test::assert(sizeof(Holder) == 16, "nested List<List<Big>> field must get a real layout too");

    // Each level's header (ListHeader<List<Big>>, ListHeader<Big>) needs a
    // real layout of its own once a value is built.
    mut h: Holder = Holder::default();
    mut inner: List<Big> = List::default();
    inner.push(Big::default());
    h.items.push(inner);
    test::assert(h.items[0].length() == 1, "both header levels work");
    return 0;
}
