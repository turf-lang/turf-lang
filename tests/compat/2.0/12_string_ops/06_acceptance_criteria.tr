// Test: Acceptance criteria for Issue #183
// "Hello, " + "world" compiles and produces "Hello, world" at runtime.
// name == "world" compiles and evaluates correctly.
// "hello"[1] produces 101 ('e' in ASCII).
import io;

import test;
fn main(): int {
    // AC1: Concatenation
    mut ac1: string = "Hello, " + "world";
    test::assert(ac1 == "Hello, world", "AC1 failed: concatenation");

    // AC2: Equality
    mut name: string = "world";
    test::assert(name == "world", "AC2 failed: equality");

    // AC3: Character access -- FDN-004/D17: "hello"[1] is now `char`, not
    // `int` (widened here for the comparison).
    mut char_e: char = "hello"[1];
    test::assert((char_e to int) == 101, "AC3 failed: character access");

    io::printline("All Issue #183 acceptance criteria passed!");
    return 0;
}
