// EXPECT-DIAG: E029
// EXPECT-DIAG: 'p' is a variable, not a type or module
// Regression test: same ScopeOperatorOnInstanceError, but the method being
// reached for is a TRUE static method (fn StructName.method(...) static:
// RetType, no self) rather than an instance method -- confirms the "you
// meant '.'" diagnosis fires purely based on whether the LEFT-hand name is
// a real variable, independent of what kind of method the RIGHT-hand name
// would have resolved to.

struct P {}

fn P.square(x: int) static: int {
    return x * x;
}

fn main(): int {
    mut p: P = P::default();
    immut y: int = p::square(5);
    return 0;
}
