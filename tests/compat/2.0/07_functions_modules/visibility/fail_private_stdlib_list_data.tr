// EXPECT-DIAG: E088
// EXPECT-DIAG: Field 'List.h' is private to module 'list'
// LEC-002 E088: the flagship case. A List's storage used to be reachable from
// any module only because nothing could be private (STD-003 item 5); it is now
// private to list.tr, and the hint points at the public methods (`get`, `set`,
// `length`, ...) instead. Since LEC-009 the storage sits behind `h`, the handle
// to the list's one shared header.
import list::List;

fn main(): int {
    mut l: List<int> = List::default();
    l.push(1);
    return l.h.len;
}
