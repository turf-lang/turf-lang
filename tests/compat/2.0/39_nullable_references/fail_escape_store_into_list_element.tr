// EXPECT-DIAG: E086
// EXPECT-DIAG: can't be stored into a field that outlives this function
// A collection's element lives in its heap buffer (and was checked when it
// went in), so `l[0].next = &n` hands the caller's node a reference into
// this frame (owner decision 2026-10-12, found by turf-fuzz).
import list::List;

struct N { val: int, next: &?N }

fn f(l: List<&N>): void {
    mut n: N = N::default();
    n.val = 42;
    l[0].next = &n;
}

fn main(): int {
    mut l: List<&N> = List::default();
    l.push(heap(N::default()));
    f(l);
    return 0;
}
