// Narrowing reaches into a `recover run { }` block: a guard inside the block
// narrows within it, and a check before the statement holds inside it. The
// block gets its own CFG for this; without one, checking the block at all
// (fail_deref_inside_recover_block.tr) would reject the guarded form.
import test;

struct Node { val: int }

error Fail { Always }

fn bad(): !int {
    return Fail::Always;
}

fn guarded(p: &?Node): int {
    mut v: int = bad() recover run {
        if (p != null) {
            return p.val;
        }
        return -1;
    };
    return v;
}

fn checked_before(p: &?Node): int {
    if (p == null) {
        return -2;
    }
    mut v: int = bad() recover run { return p.val; };
    return v;
}

fn nested(p: &?Node): int {
    mut v: int = bad() recover run {
        if (p == null) {
            return -3;
        }
        mut w: int = bad() recover run { return p.val; };
        return w;
    };
    return v;
}

// A `continue`/`break` inside the block belongs to a loop outside it. The
// block's own CFG treats it as leaving the block; this used to be E007
// "'continue' used outside of a loop" (turf-fuzz differential seed 424234).
fn in_loop(p: &?Node): int {
    mut t: int = 0;
    for i in 0..3 {
        mut v: int = bad() recover run {
            if (p == null) {
                continue;
            }
            if (i == 2) {
                break;
            }
            t = t + p.val;
            continue;
        };
        t = t + v;
    }
    return t;
}

fn main(): int {
    mut n: Node = Node::default();
    n.val = 7;
    mut none: &?Node = null;
    test::assert_eq(guarded(&n), 7, "guard inside the block");
    test::assert_eq(guarded(none), -1, "guard inside the block, null");
    test::assert_eq(checked_before(&n), 7, "check before the statement");
    test::assert_eq(checked_before(none), -2, "check before the statement, null");
    test::assert_eq(nested(&n), 7, "nested recover");
    test::assert_eq(nested(none), -3, "nested recover, null");
    test::assert_eq(in_loop(&n), 14, "continue and break inside the block");
    test::assert_eq(in_loop(none), 0, "continue inside the block, null");
    return 0;
}
