// Test: Loop over all variants via int cast, verify to string matches expected
import test;

enum Direction { North, East, South, West }

fn main(): int {
    immut expected: string[4] = ["North", "East", "South", "West"];
    immut count: int = Direction::COUNT;
    test::assert(count == 4, "COUNT == 4");

    mut i: int = 0;
    while i < count {
        immut d: Direction = i to Direction;
        test::assert((d to string) == expected[i], "variant string matches");
        test::assert((d to int) == i, "variant int matches");
        i = i + 1;
    }
    return 0;
}
