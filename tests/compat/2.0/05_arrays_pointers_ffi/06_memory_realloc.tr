import io;

import test;
extern fn malloc(size: int): int*;
extern fn realloc(p: int*, size: int): int*;
extern fn free(p: int*): void;

// (issue #238) Every raw `int*` local below needs `unsafe { }` around its
// declaration (FINAL_SPRINT.md's Track A "Caller-side locals" rule).
fn main(): int {
    unsafe {
        mut p: int* = malloc(sizeof(int) * 5);
        p[0] = 10;
        p[1] = 20;
        p[2] = 30;

        test::assert(p[0] == 10, "");
        test::assert(p[1] == 20, "");
        test::assert(p[2] == 30, "");

        p = realloc(p, sizeof(int) * 10);
        p[5] = 50;

        test::assert(p[5] == 50, "");
        free(p);
    }

    return 0;
}
