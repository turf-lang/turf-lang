// Regression test (Issue #185, CFG Phase 1): a simple function with a small
// number of branches must NOT trigger a CyclomaticComplexityWarning.
// 4 if-branches produces M well below 15 — compiles and runs cleanly.

import test;

fn simple(x: int): int {
    mut result: int = 0;
    if x > 1 { result = result + 1; }
    if x > 2 { result = result + 1; }
    if x > 3 { result = result + 1; }
    if x > 4 { result = result + 1; }
    return result;
}

fn main(): int {
    test::assert(simple(5) == 4, "All 4 branches taken for x=5");
    test::assert(simple(1) == 0, "No branches taken for x=1");
    return 0;
}
