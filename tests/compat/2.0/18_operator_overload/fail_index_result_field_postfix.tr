import list::List;

struct Big {
    a: int
}

fn Big.new(a: int): void {
    self.a = a;
}

fn main(): int {
    mut bs: List<Big> = List::default();
    bs.push(Big::new(1));
    bs[0].a++;
    return 0;
}
