// EXPECT-DIAG: E126
// EXPECT-DIAG: Cannot index a value of type 'IntBox'
// `box[0] += 1` is a read AND a write. With only the setter declared there is
// no read to perform; the read half is reported, as for a plain `box[0]`. It
// must be a diagnostic whichever half is missing, never Codegen's "Base is not
// an array or pointer" (found by turf-fuzz). The getter-only twin is
// fail_index_compound_assign_getter_only.tr.
struct IntBox {
    a: int
}

operator []=(box: &IntBox, index: int, value: int): void {
    box.a = value;
}

fn main(): int {
    mut box: IntBox = IntBox::default();
    box[0] += 1;
    return 0;
}
