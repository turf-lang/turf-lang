// EXPECT-DIAG: E066
// EXPECT-DIAG: 'recover produce int' doesn't match this call's success type 'double' exactly
// The fallback of `recover produce` has the call's success type exactly: an
// `int` variable for a `!double` call was silently widened.

error E {
    Bad
}

fn half(x: double): !double {
    if x < 0.0 {
        return E::Bad;
    }
    return x / 2.0;
}

fn main(): int {
    mut n: int = 3;
    immut r: double = half(-1.0) recover produce n;
    return 0;
}
