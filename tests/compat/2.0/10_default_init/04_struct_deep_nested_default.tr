// Test: 3-level deep struct nesting — all fields zero-initialized
// recursively via explicit Outer::default() (SEM-004: no more eager
// zero-init on a bare declaration).
import io;

import test;
struct Inner {
    val: int,
    flag: bool
}

struct Middle {
    score: double,
    inner: Inner
}

struct Outer {
    label: string,
    mid: Middle
}

fn main(): int {
    mut o: Outer = Outer::default();
    test::assert(o.label == "", "Outer.label default empty string");
    test::assert(o.mid.score == 0.0, "Outer.mid.score default 0.0");
    test::assert(o.mid.inner.val == 0, "Outer.mid.inner.val default 0");
    test::assert(o.mid.inner.flag == false, "Outer.mid.inner.flag default false");
    return 0;
}
