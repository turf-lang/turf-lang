// LEC-007: a stdlib precondition panic names the CALLER's line, not a line in queue.tr.
// RUNTIME_ABORT_EXPECTED
// EXPECT-RUNTIME: fail_stdlib_queue_dequeue_names_caller.tr:8: Queue.dequeue: dequeue on empty queue
import queue::Queue;

fn main(): int {
    mut q: Queue<int> = Queue::default();
    q.dequeue();
    return 0;
}
