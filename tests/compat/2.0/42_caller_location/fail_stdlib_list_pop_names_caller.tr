// LEC-007: a stdlib precondition panic names the CALLER's line, not a line in list.tr.
// RUNTIME_ABORT_EXPECTED
// EXPECT-RUNTIME: fail_stdlib_list_pop_names_caller.tr:8: List.pop: pop on empty list
import list::List;

fn main(): int {
    mut l: List<int> = List::default();
    l.pop();
    return 0;
}
