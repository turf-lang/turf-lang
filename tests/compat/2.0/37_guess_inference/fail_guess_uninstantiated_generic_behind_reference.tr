// only, missed this one, and the program reached Codegen with an open `T`
// (an LLVM-verifier internal error). See fail_guess_uninstantiated_generic.tr
// for the same mistake with `List`.
struct Inner<T> {
    v: T
}

struct Wrap<T> {
    h: &Inner<T>
}

fn main(): int {
    mut w = Wrap::default();
    return 0;
}
