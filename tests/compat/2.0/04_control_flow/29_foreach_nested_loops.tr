import test;

fn main(): int {
    immut numbers: int[3] = [10, 20, 30];
    mut total: int = 0;

    for i in 0..3 step i += 1 {
        for value in numbers {
            total = total + value;
        }
    }
    test::assert(total == 180, ""); // (10+20+30) * 3

    immut outer: int[2] = [1, 2];
    immut inner: int[3] = [10, 20, 30];

    mut nested: int = 0;
    for a in outer {
        for (j, b) in inner {
            nested = nested + a * b + j;
        }
    }
    // a=1: (1*10+0)+(1*20+1)+(1*30+2) = 10+21+32 = 63
    // a=2: (2*10+0)+(2*20+1)+(2*30+2) = 20+41+62 = 123
    test::assert(nested == 186, "");

    return 0;
}
