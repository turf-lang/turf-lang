// RUNTIME_ABORT_EXPECTED
// EXPECT-RUNTIME: runtime check: Negative exponent in integer '**'
// `int ** int` is an int, which cannot hold 2 ** -1; a negative exponent
// panics. A double on either side (`2 ** -1.0`) is the way to get 0.5.
fn id(x: int): int {
    return x;
}

fn main(): int {
    io::printline(id(2) ** id(-1));
    return 0;
}
