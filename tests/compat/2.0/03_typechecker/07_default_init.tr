import io;

import test;
struct Point {
    x: int,
    y: int,
    name: string,
    z: double
}

fn main(): int {
    // 1. Local primitive variables must be explicitly assigned before use.
    //    Declare then assign — this is valid.
    mut x: int;
    x = 42;
    test::assert(x == 42, "assign after empty declaration");

    // 2. SEM-004 (F-INIT-1, FREEZE.md §6.4): a struct declared without
    //    "= value" is NOT default-initialized anymore -- that was Mechanism
    //    B, now removed. `Point::default()` is the explicit opt-in, and it
    //    zero-inits every field; fields set afterward override just that
    //    field, leaving the rest at their defaults -- the replacement for
    //    the old brace-literal's "missing fields default-initialize"
    //    behavior (partial-field brace-literal construction no longer
    //    exists at all). See fail_struct_use_before_init.tr for what
    //    reading a field with no "::default()"/explicit initializer does
    //    now.
    mut p: Point = Point::default();
    test::assert(p.x == 0, "struct field default init x");
    test::assert(p.y == 0, "struct field default init y");
    test::assert(p.name == "", "struct field default init name");
    test::assert(p.z == 0.0, "struct field default init z");

    mut p2: Point = Point::default();
    p2.x = 5;
    test::assert(p2.x == 5, "explicit field init");
    test::assert(p2.y == 0, "missing field y default init");
    test::assert(p2.name == "", "missing field name default init");
    test::assert(p2.z == 0.0, "missing field z default init");

    return 0;
}
