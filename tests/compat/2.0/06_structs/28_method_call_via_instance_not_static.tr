// Companion to fail_static_method_call.tr: confirms the SAME method
// (declared with no explicit self-opt-out, since none exists) works fine
// when called through a real instance instead of the bare struct type
// name -- the crash fix and the "no true static methods" finding are
// specific to the static-call form, not method calls in general.

import test;

struct MathUtil {}

fn MathUtil.square(x: int): int {
    return x * x;
}

fn main(): int {
    mut mu: MathUtil = MathUtil::default();
    test::assert(mu.square(5) == 25, "instance method call should work");
    return 0;
}
