// EXPECT-DIAG: E141
// EXPECT-DIAG: 'a' is immutable, but 'outer' writes to the array it is given as 'arr'.
// Issue #260: the write is two calls down -- `outer` only hands its slice to
// `inner`, which writes it. The check follows the slice through the call.
fn inner(x: int[]): void {
    x[0]++;
}

fn outer(arr: int[]): void {
    inner(arr);
}

fn main(): int {
    immut a: int[2] = [1, 2];
    outer(a);
    return 0;
}
