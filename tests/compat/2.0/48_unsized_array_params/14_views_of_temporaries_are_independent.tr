// Range slicing: a view variable made from a TEMPORARY array (a call's
// result, `mk(i)` or `mk(i)[..]`) must own that temporary's storage. The
// first version spilled every temporary into one stack slot per source
// location, so in a loop doing `w = v; v = mk(i);` both views pointed at the
// same slot and `w` silently changed when `v` was refilled (it read 2 where
// it should read 1). A stored view of a temporary now gets a GC block of its
// own; a temporary passed straight to a `T[]` parameter still uses the
// stack, since it is only read during that call.
import test;

fn mk(i: int): int[2] {
    return [i, i * 10];
}

fn first(arr: int[]): int {
    return arr[0];
}

fn main(): int {
    mut a: int[2] = [0, 0];

    mut w: int[] = a;
    mut v: int[] = a;
    mut i: int = 1;
    while i <= 3 {
        w = v;
        v = mk(i);
        i++;
    }
    test::assert(w[0] == 2 && v[0] == 3, "two views of one call site stay apart");

    mut p: int[] = a;
    mut q: int[] = a;
    i = 1;
    while i <= 2 {
        p = q;
        q = mk(i)[..];
        i++;
    }
    test::assert(p[0] == 1 && q[0] == 2, "...also through a slice of a temporary");

    // An inferred view of a temporary, kept across a collection.
    immut kept = mk(7)[1..];
    gc_collect();
    test::assert(kept[0] == 70, "a stored view of a temporary survives collection");

    // Passed straight to a parameter: no view outlives the call.
    test::assert(first(mk(5)) == 5 && first(mk(6)) == 6, "temporaries as arguments");
    return 0;
}
