// DSA Problem 5: Longest Increasing Subsequence (LIS) - O(n^2) DP
// Given a sequence, find the length of the longest strictly increasing subsequence
// Uses list<int> for the DP table

fn int lis(list<int> arr) {
    int n = arr.length
    if n == 0 {
        return 0
    }

    // dp[i] = length of LIS ending at index i
    list<int> dp

    int i = 0
    while i < n {
        dp.push(1)
        i++
    }

    int j = 1
    while j < n {
        int k = 0
        while k < j {
            if arr[k] < arr[j] {
                if dp[k] + 1 > dp[j] {
                    dp[j] = dp[k] + 1
                }
            }
            k++
        }
        j++
    }

    // Find the maximum in dp
    int best = 0
    int m = 0
    while m < n {
        if dp[m] > best {
            best = dp[m]
        }
        m++
    }
    return best
}

// --- Main ---
list<int> seq1
seq1.push(10)
seq1.push(9)
seq1.push(2)
seq1.push(5)
seq1.push(3)
seq1.push(7)
seq1.push(101)
seq1.push(18)

// LIS of [10,9,2,5,3,7,101,18] = 4  (e.g., [2,3,7,101])
int r1 = lis(seq1)
printline("LIS of [10,9,2,5,3,7,101,18]:")
printline(r1)

list<int> seq2
seq2.push(0)
seq2.push(1)
seq2.push(0)
seq2.push(3)
seq2.push(2)
seq2.push(3)

// LIS of [0,1,0,3,2,3] = 4  (e.g., [0,1,2,3])
int r2 = lis(seq2)
printline("LIS of [0,1,0,3,2,3]:")
printline(r2)

list<int> seq3
seq3.push(7)
seq3.push(7)
seq3.push(7)
seq3.push(7)

// LIS of [7,7,7,7] = 1 (all equal, strictly increasing)
int r3 = lis(seq3)
printline("LIS of [7,7,7,7]:")
printline(r3)

list<int> seq4
seq4.push(1)
seq4.push(3)
seq4.push(6)
seq4.push(7)
seq4.push(9)
seq4.push(4)
seq4.push(10)
seq4.push(5)
seq4.push(6)

// LIS of [1,3,6,7,9,4,10,5,6] = 6  (e.g., [1,3,6,7,9,10])
int r4 = lis(seq4)
printline("LIS of [1,3,6,7,9,4,10,5,6]:")
printline(r4)
