// DSA Problem 4: Sieve of Eratosthenes
// Finds all prime numbers up to N using a boolean sieve
// Uses list<bool> for the sieve table

fn void sieve(int limit) {
    list<bool> is_prime

    int i = 0
    while i <= limit {
        is_prime.push(true)
        i++
    }

    // 0 and 1 are not prime
    is_prime[0] = false
    is_prime[1] = false

    int p = 2
    while p * p <= limit {
        if is_prime[p] {
            int multiple = p * p
            while multiple <= limit {
                is_prime[multiple] = false
                multiple = multiple + p
            }
        }
        p++
    }

    printline("Primes up to limit:")
    int j = 0
    while j <= limit {
        if is_prime[j] {
            print(j)
            print(" ")
        }
        j++
    }
    printline("")
}

fn int countPrimes(int limit) {
    list<bool> is_prime

    int i = 0
    while i <= limit {
        is_prime.push(true)
        i++
    }

    is_prime[0] = false
    is_prime[1] = false

    int p = 2
    while p * p <= limit {
        if is_prime[p] {
            int multiple = p * p
            while multiple <= limit {
                is_prime[multiple] = false
                multiple = multiple + p
            }
        }
        p++
    }

    int count = 0
    int j = 0
    while j <= limit {
        if is_prime[j] {
            count++
        }
        j++
    }
    return count
}

// --- Main ---
sieve(50)

int total = countPrimes(100)
printline("Number of primes up to 100:")
printline(total)
