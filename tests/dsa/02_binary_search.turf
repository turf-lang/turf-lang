// DSA Problem 2: Binary Search
// Searches for a target in a sorted array (O(log n))
// Returns the index or -1 if not found

fn int binarySearch(list<int> arr, int target) {
    int low = 0
    int high = arr.length - 1

    while low <= high {
        int mid = (low + high) / 2
        if arr[mid] == target {
            return mid
        } elseif arr[mid] < target {
            low = mid + 1
        } else {
            high = mid - 1
        }
    }
    return -1
}

// --- Main ---
list<int> sorted
sorted.push(2)
sorted.push(5)
sorted.push(8)
sorted.push(13)
sorted.push(21)
sorted.push(34)
sorted.push(55)
sorted.push(89)

int idx1 = binarySearch(sorted, 21)
printline("Search for 21:")
printline(idx1)

int idx2 = binarySearch(sorted, 1)
printline("Search for 1 (not in list):")
printline(idx2)

int idx3 = binarySearch(sorted, 89)
printline("Search for 89 (last element):")
printline(idx3)

int idx4 = binarySearch(sorted, 2)
printline("Search for 2 (first element):")
printline(idx4)
