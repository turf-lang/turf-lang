// Minimal reproducer for Bug 2:
// Does a top-level declaration after a function that has a return in a
// conditional base-case get falsely flagged as unreachable?

fn int identity(int n) {
    if n == 0 {
        return 0
    }
    return n
}

// This top-level declaration should NOT be unreachable
int result = identity(5)
printline(result)
