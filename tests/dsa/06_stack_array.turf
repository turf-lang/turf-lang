// Stack Implementation using a fixed-size int array (no list type)
//
// NOTE ON TURFLANG LIMITATIONS:
//   - Functions cannot access top-level variables (no global variable scope)
//   - Arrays cannot be passed by reference (only by value, which is a copy)
//   - Therefore, a stack using helper functions (push/pop/peek) is not possible
//     with arrays, because the mutated copy would be discarded.
//
// SOLUTION: The stack is implemented fully inline using:
//   - int[100] stack_data  -> backing storage (fixed capacity of 100)
//   - int stack_top        -> index of the top element (-1 = empty)
// All push/pop/peek operations are written directly at the call site.
// This is perfectly valid; it's the standard embedded-systems style stack.

int[100] stack_data
int stack_top = -1

// ========== Demo 1: Basic push / pop / peek ==========
printline("=== Stack Demo: Push / Pop / Peek ===")

// PUSH 10
stack_top++
stack_data[stack_top] = 10

// PUSH 20
stack_top++
stack_data[stack_top] = 20

// PUSH 30
stack_top++
stack_data[stack_top] = 30

// PUSH 40
stack_top++
stack_data[stack_top] = 40

// PUSH 50
stack_top++
stack_data[stack_top] = 50

printline("Stack size after 5 pushes (expect 5):")
printline(stack_top + 1)

printline("Peek top (expect 50):")
printline(stack_data[stack_top])

// POP
int popped1 = stack_data[stack_top]
stack_top--
printline("Popped (expect 50):")
printline(popped1)

// POP
int popped2 = stack_data[stack_top]
stack_top--
printline("Popped (expect 40):")
printline(popped2)

// POP
int popped3 = stack_data[stack_top]
stack_top--
printline("Popped (expect 30):")
printline(popped3)

printline("Stack size after 3 pops (expect 2):")
printline(stack_top + 1)

printline("Peek top after pops (expect 20):")
printline(stack_data[stack_top])

// Pop remaining
int popped4 = stack_data[stack_top]
stack_top--
int popped5 = stack_data[stack_top]
stack_top--

printline("Stack empty? (expect true):")
bool is_empty = stack_top < 0
printline(is_empty)

// ========== Demo 2: Overflow guard ==========
printline("")
printline("=== Overflow / Underflow Guard ===")

// Attempt to pop from empty stack (underflow check)
if stack_top < 0 {
    printline("Cannot pop: stack is empty (underflow prevented)")
} else {
    int bad_pop = stack_data[stack_top]
    stack_top--
}

// Fill stack to capacity (100 elements)
int fill_i = 0
while fill_i < 100 {
    stack_top++
    stack_data[stack_top] = fill_i * fill_i
    fill_i++
}

printline("Stack size after filling to capacity (expect 100):")
printline(stack_top + 1)

// Attempt to push beyond capacity (overflow check)
if stack_top >= 99 {
    printline("Cannot push: stack is full (overflow prevented)")
} else {
    stack_top++
    stack_data[stack_top] = 9999
}

// ========== Demo 3: Using the stack as a reversal tool ==========
// Push values 1..8, then pop them to get reverse order
printline("")
printline("=== Reversing a sequence using the Stack ===")

// Reset stack
stack_top = -1

int[8] sequence = [3, 1, 4, 1, 5, 9, 2, 6]

printline("Original sequence:")
int si = 0
while si < 8 {
    print(sequence[si])
    print(" ")
    si++
}
printline("")

// Push all onto stack
int pi = 0
while pi < 8 {
    stack_top++
    stack_data[stack_top] = sequence[pi]
    pi++
}

// Pop all back (gives reversed order)
printline("Reversed sequence (via stack):")
while stack_top >= 0 {
    print(stack_data[stack_top])
    print(" ")
    stack_top--
}
printline("")

// ========== Demo 4: Bracket balancing (inline stack) ==========
// Encode '(' as 1, ')' as -1
// Sequence: ( ( ) ( ) ) -> balanced
printline("")
printline("=== Bracket Balancing via Inline Stack ===")

int[6] brackets = [1, 1, -1, 1, -1, -1]
int b_top = -1
int[6] b_stack
bool balanced = true

int bi = 0
while bi < 6 {
    if brackets[bi] == 1 {
        b_top++
        b_stack[b_top] = 1
    } else {
        if b_top < 0 {
            balanced = false
        } else {
            b_top--
        }
    }
    bi++
}

if b_top != -1 {
    balanced = false
}

printline("(()()) is balanced? (expect true):")
printline(balanced)

// Sequence: ( ) ) ( -> not balanced
int[4] brackets2 = [1, -1, -1, 1]
int b2_top = -1
int[4] b_stack2
bool balanced2 = true

int bj = 0
while bj < 4 {
    if brackets2[bj] == 1 {
        b2_top++
        b_stack2[b2_top] = 1
    } else {
        if b2_top < 0 {
            balanced2 = false
        } else {
            b2_top--
        }
    }
    bj++
}

if b2_top != -1 {
    balanced2 = false
}

printline("())( is balanced? (expect false):")
printline(balanced2)
