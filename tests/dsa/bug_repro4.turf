// Exact minimal reproduction of the original stack file cascade:
// fn that references UNKNOWN top-level vars -> error inside fn body
// -> subsequent top-level declarations get "unreachable" error

fn void push(int val) {
    if stack_top >= 99 {       // 'stack_top' unknown here -> error
        return
    }
    stack_top++
    stack_data[stack_top] = val
}

// These should compile fine but get caught in the error cascade
int[100] stack_data
int stack_top = -1
printline(stack_top)
