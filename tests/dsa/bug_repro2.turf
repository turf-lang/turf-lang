// Reproducer: function that references a top-level variable (declared before it)
// but the function is ALSO called before the variable is visible in the function scope.

int[100] data
int top = -1

fn void push(int val) {
    // This fails: 'top' and 'data' are top-level vars, not accessible inside fn
    if top >= 99 {
        printline("overflow")
        return
    }
    top++
    data[top] = val
}

int x = 42
printline(x)
