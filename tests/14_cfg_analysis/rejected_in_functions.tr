// F-11e: tests moved from fail_*.tr files, one function each; each `@test` names the
// error its body must be rejected with.

import io;

// Regression test (Issue #180 follow-up): DefiniteAssignmentPass must reach
// a do-while's condition. CFGBuilder::visitDoWhile() adds the condition
// expression to `dowhile.cond`'s own statement list (see CFG.cpp), so a read
// of a variable that isn't assigned on every path reaching that block must
// still be flagged -- exactly like it already is for a plain `while`
// condition. `y` is only assigned inside a conditionally-taken branch of the
// loop body, so on the very first pass through `dowhile.cond` (i starts at
// 0, so `i > 100` never took the true branch) `y` is not definitely
// assigned yet.
@test(compile_error, E008, "I cannot use `y` (type `int`) before it has a value")
fn rejects_35_do_while_cond_uses_maybe_unassigned(): void {
    mut y: int;
    mut i: int = 0;
    do {
        if i > 100 {
            y = 5;
        }
        i = i + 1;
    } while y > 0;
}

// Issue #263: a declaration after `return` used to be reported under a
// separate, never-visible code (E013). It is the same mistake as any other
// statement after a terminator, so it must be E012.
@test(compile_error, E012, "")
fn rejects_41_declaration_after_return_is_e012(): void {
    return;
    mut x: int = 5;
}

// A `recover run { }` block runs before the statement holding it completes,
// so it sees only what was assigned before that statement.

error Bad {
    Oops,
}

fn g(): !int {
    return Bad::Oops;
}

@test(compile_error, E008, "I cannot use `x` (type `int`) before it has a value")
fn rejects_52_recover_block_reads_unassigned(): void {
    mut x: int;
    x = (g() recover run {
            io::printline(x);
            return;
        });
    x;
}
