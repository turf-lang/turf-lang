// Regression test (#186 acceptance criteria):
// AC1: mutable x: int = 5; mutable y: int = x + 1; return y;
//      → no warning (x is read, y is read).
// AC2: mutable x: int = 5; return 0;
//      → UnusedVariableWarning for x (declared but never used).
// AC3: mutable x: int = 5; x = 10; return x;
//      → DeadStoreWarning for the first assignment (x = 5 is overwritten).
//
// AC1 is verified at runtime (function executes correctly).
// AC2 and AC3 each trigger non-fatal warnings; compilation continues.

fn ac1(a: int): int {
    mutable x: int = 5;
    mutable y: int = x + 1;
    return y;
}

// ac2 and ac3 are defined below — they trigger warnings but still compile.
fn ac2(): int {
    mutable x: int = 5;
    return 0;
}

fn ac3(): int {
    mutable x: int = 5;
    x = 10;
    return x;
}

fn main(): int {
    mutable r: int = ac1(0);
    assert(r == 6, "AC1: y = x + 1 = 6");
    mutable r2: int = ac2();
    assert(r2 == 0, "AC2: returns 0 despite unused x");
    mutable r3: int = ac3();
    assert(r3 == 10, "AC3: returns 10 despite dead store on x=5");
    return 0;
}
