// EXPECT-NO-DIAG: dead store
// EXPECT-NO-DIAG: is never read
// EXPECT-NO-DIAG: never used
// Writing one element keeps the others, so it does not end the life of the
// value stored before it: neither `x[0] = 1` nor `y`'s initializer is dead.

import test;

fn main(): int {
    mut x: int[3];
    x[0] = 1;
    x[1] = 2;
    test::assert(x[0] == 1 && x[1] == 2 && x[2] == 0, "both writes are read");

    mut y: int[3] = [4, 5, 6];
    y[2] = 9;
    test::assert(y[0] == 4 && y[2] == 9, "the initializer is read");

    mut grid: int[2][2] = [[1, 2], [3, 4]];
    mut i: int = 0;
    while i < 2 {
        grid[i][i] = 0;
        i = i + 1;
    }
    test::assert(grid[0][1] == 2 && grid[1][1] == 0, "a loop writing elements");
    return 0;
}
