// Acceptance criteria test (Issue #185, CFG Phase 1).
// Tests all required acceptance criteria from the issue:
//
// AC1: while(true) { x = x + 1; } → InfiniteLoopWarning at compile time,
//      but compilation succeeds (TurfWarning is non-interrupting).
//      Implemented via an_infinite_body() below — compiled but never called,
//      so the test suite does not hang.
//
// AC2: while(true) { if (x > 10) { break; } } → NO warning (break present).
//      Verified by the loop actually running and break working at runtime.
//
// AC3: for loop with break → NO warning, break exits correctly at runtime.
//
// AC4: Both analyses use TurfWarning — compilation always succeeds.
//
// AC5: The program runs to completion (all TurfWarning emissions are
//      non-interrupting, compilation is never aborted by a warning).

// AC1: This function has a while(true) loop with no exit — triggers
// InfiniteLoopWarning at compile time. It is intentionally never called
// from main() so the process does not actually loop forever.
fn an_infinite_body(): int {
    mut x: int = 0;
    while true {
        x = x + 1;
    }
    return 0;
}

fn main(): int {
    // AC2: while(true) with break — must compile without InfiniteLoopWarning
    // and must exit correctly at runtime.
    mut x: int = 0;
    while true {
        x = x + 1;
        if x > 10 {
            break;
        }
    }
    assert(x == 11, "AC2: while(true) with break exited at x==11");

    // AC3: for loop with break — must compile without warning and exit
    // at the correct iteration.
    mut found: int = -1;
    for i in 0..50 step i += 1 {
        if i == 5 {
            found = i;
            break;
        }
    }
    assert(found == 5, "AC3: for loop break at i==5");

    // AC4/AC5: reaching here proves all compilations succeeded and no
    // TurfWarning interrupted compilation.
    assert(true, "AC4/AC5: program reached completion");

    return 0;
}
