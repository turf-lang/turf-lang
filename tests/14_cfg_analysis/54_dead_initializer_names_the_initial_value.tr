// EXPECT-DIAG: The initial value of 'x' is never read
// EXPECT-NO-DIAG: is assigned but the value is never read
// EXPECT-NO-DIAG: never used
// `x` is read, but every path assigns it again first: the warning is about
// the initial value, not the variable.

import io;

fn main(): int {
    mut x: int = 0;
    mut i: int = 0;
    while i < 3 {
        x = i * 2;
        io::printline(x);
        i = i + 1;
    }
    return 0;
}
