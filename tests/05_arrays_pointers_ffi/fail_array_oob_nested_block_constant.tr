// Companion to fail_array_oob_via_constant_propagation.tr: same constant-
// propagation bounds bug, but with the offending variable declared inside a
// NESTED block rather than at the function's top level -- the shape that
// originally motivated the "scope already unwound" hypothesis (see
// src/ValueRange.cpp's ValueRangePass::runOnCFG() doc comment for the full
// root-cause writeup, which turned out to apply to top-level locals too).

fn main(): int {
    mut arr: int[3] = [10, 20, 30];
    if true {
        mut i: int = 5;
        io.printline(arr[i]);
    }
    return 0;
}
