// Regression test (was DISCOVERED_ISSUES.md #15 and #23):
//   #15 — SymbolTable::canAssign checked `From->getName() == "void*"` when
//        allowing an untyped FFI pointer to coerce into a typed pointer
//        (e.g. int*), but the untyped pointer type is actually named "ptr",
//        not "void*" -- so `mut p: int* = malloc(8);` was rejected outright
//        (required declaring `extern fn malloc(...): int*;` as a workaround
//        to bypass the broken check).
//   #23 — explicit `ptr to StructName` casts were rejected
//        ("Cannot explicitly cast 'ptr' to 'Node'"), which blocked dynamic
//        allocation of structs / building heap-based recursive structures.
// Both re-verified fixed.

extern fn malloc(size: int): ptr;
extern fn free(p: ptr): void;

struct Node {
    val: int
}

fn main(): int {
    // #15: untyped `ptr` from malloc coerces directly into a typed pointer.
    mut ip: int* = malloc(8);
    assert(ip != null, "");

    // #23: explicit ptr -> struct-pointer cast, for heap-allocated structs.
    mut raw: ptr = malloc(8);
    mut h: Node* = raw to Node*;
    h.val = 77;
    assert(h.val == 77, "");

    free(raw);
    free(ip);
    return 0;
}
