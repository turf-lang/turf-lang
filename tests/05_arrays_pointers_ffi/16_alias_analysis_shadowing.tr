// Regression guard for AliasAnalysisPass's identity-vs-name tracking fix
// (see src/AliasAnalysis.cpp's doc comment): freeing a variable that merely
// SHARES A NAME with an already-freed variable in an outer scope -- but is
// actually a distinct, never-allocated shadowing declaration -- must NOT be
// flagged as a double free. Before the fix, name-based (rather than
// resolved-identity-based) tracking left a stale freed-allocation entry
// under "p" that the inner shadowing `mut p: int* = null;` never cleared
// (its initializer is neither a malloc()/realloc() call nor a plain
// variable alias, so neither tracked branch ran), so the inner free(p) was
// misread as re-freeing the outer allocation.

import io;

extern fn malloc(size: int): int*;
extern fn free(p: int*): void;

// (issue #238) Every raw `int*` local below needs `unsafe { }` around its
// declaration (FINAL_SPRINT.md's Track A "Caller-side locals" rule).
fn main(): int {
    unsafe {
        mut p: int* = malloc(sizeof(int) * 4);
        free(p);

        if true {
            mut p: int* = null;
            free(p);
            io::printline("freed the shadowed (null) p, not the outer one");
        }
    }

    return 0;
}
