// EXPECT-NO-DIAG: E008
// A fixed-size array declared without an initializer is assigned from its
// declaration: its storage is zero-filled, and every element nothing wrote
// reads as the zero value of its type, whether or not anything was written.

import test;

struct Point {
    x: int,
    y: int
}

struct P {
    id: int
}

fn main(): int {
    // Filled in a loop, then read.
    mut squares: int[10];
    for i in 0..10 {
        squares[i] = i * i;
    }
    test::assert(squares[3] == 9 && squares[9] == 81, "filled in a loop");

    // Filled in a `while` that might not run.
    mut evens: int[4];
    mut k: int = 0;
    while k < 4 {
        evens[k] = k * 2;
        k = k + 1;
    }
    test::assert(evens[3] == 6, "filled in a while loop");

    // Read with no write at all.
    mut none: int[5];
    test::assert(none[0] == 0 && none[4] == 0, "an int array reads zero");
    mut flags: bool[2];
    test::assert(!flags[1], "a bool array reads false");
    mut ds: double[2];
    test::assert(ds[0] == 0.0, "a double array reads 0.0");
    mut names: string[2];
    test::assert(names[1] == "", "a string array reads empty strings");

    // One write leaves the rest zero.
    mut one: int[5];
    one[0] = 1;
    test::assert(one[0] == 1 && one[3] == 0, "unwritten elements read zero");

    // Structs and nested arrays.
    mut pts: Point[3];
    test::assert(pts[0].x == 0 && pts[2].y == 0, "struct elements read zero");
    mut ps: P[2];
    ps[0].id = ps[1].id + 5;
    test::assert(ps[0].id == 5, "a write reading another element");
    mut g: int[2][3];
    test::assert(g[1][2] == 0, "a 2-D array reads zero");
    return 0;
}
