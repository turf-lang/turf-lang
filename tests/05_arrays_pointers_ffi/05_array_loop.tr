fn main(): int {
    mut squares: int[5] = [0, 0, 0, 0, 0];

    for i in 0..5 step i += 1 {
        squares[i] = i * i;
    }

    assert(squares[0] == 0, "");
    assert(squares[1] == 1, "");
    assert(squares[2] == 4, "");
    assert(squares[3] == 9, "");
    assert(squares[4] == 16, "");

    return 0;
}
