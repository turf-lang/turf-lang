import test;

fn main(): int {
    mut numbers: int[5] = [0, 0, 0, 0, 0];
    numbers[0] = 10;
    numbers[1] = 20;
    numbers[2] = 30;
    numbers[3] = 40;
    numbers[4] = 50;

    test::assert(numbers[0] == 10, "");
    test::assert(numbers[1] == 20, "");
    test::assert(numbers[2] == 30, "");
    test::assert(numbers[3] == 40, "");
    test::assert(numbers[4] == 50, "");

    mut zeros: int[3] = [0, 0, 0];
    test::assert(zeros[0] == 0, "");
    test::assert(zeros[1] == 0, "");
    test::assert(zeros[2] == 0, "");

    mut arr: int[2] = [1, 2];
    test::assert(arr[0] == 1, "");
    test::assert(arr[1] == 2, "");

    return 0;
}
