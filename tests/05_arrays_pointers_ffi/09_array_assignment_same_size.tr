// Regression test: whole-array assignment between two variables of the SAME
// declared size must still work correctly after Types.cpp's typesCompatible()
// was made array-size-aware (see fail_array_size_mismatch.tr for the bug
// this guards against regressing).

fn main(): int {
    mut a: int[5] = [1, 2, 3, 4, 5];
    mut b: int[5] = [10, 20, 30, 40, 50];

    a = b;

    assert(a[0] == 10, "");
    assert(a[1] == 20, "");
    assert(a[2] == 30, "");
    assert(a[3] == 40, "");
    assert(a[4] == 50, "");

    return 0;
}
