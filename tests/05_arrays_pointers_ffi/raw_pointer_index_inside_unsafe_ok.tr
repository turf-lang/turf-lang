// Regression test (OVH-003, docs/planning/OVERHAUL_REMAINING_WORK.md): the
// passing counterpart to fail_raw_pointer_index_outside_unsafe.tr -- the
// identical `someList.data[i]` write compiles when lexically inside
// `unsafe { }` (this test) or in a module that declares the raw-pointer
// capability (`unsafe module;` -- the shape `lib/std/collections/list.tr`
// itself uses for its own internal `self.data[i]`; not repeated here
// since `tests/` is "under the install root" from the compiler's own
// point of view -- docs/development/changes/LANG-002.md's *Known
// pitfalls* -- so a second file exercising that path would be redundant
// with list.tr's own already-passing suite).

import list::List;

fn main(): int {
    mut l: List<int> = List::default();
    l.push(1);
    l.push(2);
    mut result: int = 0;
    unsafe {
        l.data[0] = 42;
        result = l.data[0];
    }
    return result - 42;
}
