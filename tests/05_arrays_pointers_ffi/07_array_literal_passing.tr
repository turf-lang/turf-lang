struct Point {
    x: int,
    y: int
}

fn sum_array(arr: int[4]): int {
    return arr[0] + arr[1] + arr[2] + arr[3];
}

fn get_points(): Point[2] {
    return [Point { x: 10, y: 20 }, Point { x: 30, y: 40 }];
}

fn main(): int {
    // 1. Array literal passed directly as function argument
    assert(sum_array([1, 2, 3, 4]) == 10, "Array literal passing failed");
    
    // 2. Reassignment with an array literal
    mut arr: int[4] = [0, 0, 0, 0];
    arr = [5, 6, 7, 8];
    assert(sum_array(arr) == 26, "Array literal assignment failed");
    
    // 3. Array of structs using literals
    mut points: Point[2] = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }];
    assert(points[0].x == 1, "Struct array 0.x failed");
    assert(points[1].y == 4, "Struct array 1.y failed");
    
    // 4. Return array of structs and inline indexing
    assert(get_points()[1].x == 30, "R-value array of structs inline indexing failed");
    
    return 0;
}
