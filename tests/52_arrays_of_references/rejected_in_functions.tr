// F-11e: tests moved from fail_*.tr files, one function each; each `@test` names the
// error its body must be rejected with.

// An array of non-null references has no valid zero value: the storage is
// zero-filled, so an element nothing wrote would be a null `&N` (owner,
// 2026-10-12). `(&?N)[2]` would be fine: its elements start null.
struct N { val: int }

@test(compile_error, E128, "The array `a`, a `(&N)[2]`, needs an initial value: it would start zero-filled, and a reference cannot be null.")
fn rejects_array_of_references_without_initializer(): void {
    mut a: (&N)[2];
}

// An element that carries a `&U` has no valid zero value either: `a[1].own`
// was a null `&U` (owner decision 2026-10-12, found by turf-fuzz). Same rule
// as `(&N)[2]` (fail_array_of_references_without_initializer.tr); an `&?U`
// field would be fine.
struct U { v: int }

struct H {
    own: &U,
    k: int
}

@test(compile_error, E128, "The array `a`, a `H[2]`, needs an initial value: it would start zero-filled, and `H.own` is a reference that cannot be null.")
fn rejects_array_of_structs_holding_reference_without_initializer(): void {
    mut a: H[2];
}
