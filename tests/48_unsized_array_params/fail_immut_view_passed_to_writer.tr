// EXPECT-DIAG: E141
// EXPECT-DIAG: `v` is immutable, and `fill` writes to the array it takes as `arr`. As an `int[]` parameter, it shares the caller's array, so the change would land in `v`.
// An `immut` view handed to a function that writes through its `T[]`.
fn fill(arr: int[], x: int): void {
    for (i, _y) in arr {
        arr[i] = x;
    }
}

fn main(): int {
    mut a: int[3] = [1, 2, 3];
    immut v = a[..];
    fill(v, 0);
    return 0;
}
