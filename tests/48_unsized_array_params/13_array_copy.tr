// `arr.copy()` returns a NEW, independent `T[]` whose storage is a fresh heap
// block, for any array or slice (a `T[N]`, a `T[]` parameter, a range slice,
// a 2D array). It is not a view, so editing the copy never changes the
// original, and an `immut` source is fine (no E144 on `mut c = a.copy();`,
// no E141 when passing the copy to a function that writes). Range slicing,
// issue #260.
import test;

struct Counter {
    n: int
}

fn Counter.new(): void {
    self.n = 0;
}

fn Counter.bump(): void {
    self.n += 1;
}

fn zero(arr: int[]): void {
    for (i, _x) in arr {
        arr[i] = 0;
    }
}

// Copies its parameter and edits the copy: the caller's array is untouched,
// so it may be called with an immut array.
fn doubledFirst(arr: int[]): int {
    mut c = arr.copy();
    c[0] = c[0] * 2;
    return c[0];
}

fn total(arr: int[]): int {
    mut t: int = 0;
    for v in arr {
        t += v;
    }
    return t;
}

fn main(): int {
    mut a: int[4] = [1, 2, 3, 4];

    mut whole = a.copy();
    whole[0] = 99;
    test::assert(a[0] == 1 && whole[0] == 99, "a whole-array copy is independent");
    test::assert(typeof(whole) == "int[]" && whole.length() == 4, "the copy is an int[]");

    mut part = a[1..3].copy();
    part[0] = 50;
    test::assert(a[1] == 2 && part.length() == 2 && part[1] == 3, "a slice copy is independent");

    // Runtime bounds.
    mut lo: int = 1;
    mut hi: int = 4;
    mut rt = a[lo..hi].copy();
    rt[2] = 7;
    test::assert(rt.length() == 3 && a[3] == 4, "a copy with runtime bounds");

    // Original edits do not reach the copy either.
    a[2] = 30;
    test::assert(whole[2] == 3, "editing the original leaves the copy alone");

    // 2D: editing the copy's row leaves the original's.
    mut grid: int[2][2] = [[1, 2], [3, 4]];
    mut gc = grid.copy();
    gc[0][0] = 100;
    test::assert(grid[0][0] == 1 && gc[0][0] == 100 && gc[1][1] == 4, "a 2D copy is deep");

    // Struct elements: a mutating method on the copy's element.
    mut cs: Counter[2] = [Counter::new(), Counter::new()];
    mut cc = cs.copy();
    cc[0].bump();
    test::assert(cs[0].n == 0 && cc[0].n == 1, "struct elements are copied");

    // An immut source can be copied into an editable array.
    immut fixed: int[3] = [5, 6, 7];
    mut edit = fixed.copy();
    edit[0] = 0;
    test::assert(fixed[0] == 5 && edit[0] == 0, "immut array copied into a mut one");
    zero(fixed.copy());
    test::assert(fixed[1] == 6, "an immut array's copy may be passed to a writer");
    test::assert(doubledFirst(fixed) == 10 && fixed[0] == 5, "a callee copying its parameter");

    // Empty copy.
    mut i: int = 2;
    test::assert(a[i..i].copy().length() == 0, "an empty slice copies to an empty array");

    // Chaining and using the result.
    mut twice = a.copy().copy();
    twice[0] = -1;
    test::assert(a[0] == 1 && twice.length() == 4, "chained copies");
    test::assert(a.copy()[1..].length() == 3, "a copy can be sliced");
    test::assert(total(a.copy()) == 1 + 2 + 30 + 4, "a copy passed to an int[] parameter");

    mut seen: int = 0;
    for v in a.copy() {
        seen += v;
    }
    test::assert(seen == 37, "for-each over a copy");

    // A fresh copy each iteration, independent of the others.
    mut copies: int = 0;
    for k in 0..3 {
        mut c = a.copy();
        c[0] = k + 10;
        test::assert(a[0] == 1 && c[0] == k + 10, "each iteration's copy is independent");
        copies += 1;
    }
    test::assert(copies == 3, "loop ran");

    // A copy of a `T[]` view, edited, does not reach what the view looks at.
    mut base: int[3] = [1, 2, 3];
    mut view: int[] = base;
    mut vc = view.copy();
    vc[0] = 8;
    test::assert(base[0] == 1, "a copy of a view is not a view");
    return 0;
}
