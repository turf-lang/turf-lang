// EXPECT-DIAG: E066
// EXPECT-DIAG: I cannot assign an `int[2]` to `a`, which is an `int[3]`.
// EXPECT-DIAG: I cannot assign an `int[2]` to `a`, which is an `int[3]`.
// The literal gave 'a' the size 3 (it is exactly int[3]), so a literal of
// another length can't be assigned to it later.
fn main(): int {
    mut a: int[] = [1, 2, 3];
    a = [1, 2];
    return a[0];
}
