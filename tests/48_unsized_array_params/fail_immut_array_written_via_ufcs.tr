// EXPECT-DIAG: E141
// EXPECT-DIAG: `a` is immutable, and `zero` writes to the array it takes as `arr`. As an `int[]` parameter, it shares the caller's array, so the change would land in `a`.
// Issue #260: the same rule for a UFCS receiver (`a.zero()` is `zero(a)`).
fn zero(arr: int[]): void {
    arr[0] = 0;
}

fn main(): int {
    immut a: int[2] = [1, 2];
    a.zero();
    return 0;
}
