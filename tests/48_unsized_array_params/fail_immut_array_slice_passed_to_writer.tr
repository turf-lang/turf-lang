// EXPECT-DIAG: E141
// EXPECT-DIAG: `a` is immutable, and `fill` writes to the array it takes as `arr`. As an `int[]` parameter, it shares the caller's array, so the change would land in `a`.
// A slice expression of an immutable array is rooted at that array.
fn fill(arr: int[], x: int): void {
    for (i, _y) in arr {
        arr[i] = x;
    }
}

fn main(): int {
    immut a: int[3] = [1, 2, 3];
    fill(a[1..], 0);
    return 0;
}
