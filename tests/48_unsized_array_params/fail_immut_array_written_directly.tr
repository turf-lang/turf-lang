// EXPECT-DIAG: E141
// EXPECT-DIAG: `a` is immutable, and `fill` writes to the array it takes as `arr`. As an `int[]` parameter, it shares the caller's array, so the change would land in `a`.
// Issue #260: a `T[]` parameter shares the caller's array, so this call would
// change `a` even though it is `immut`. It used to compile and run, and `a`
// came back changed.
fn fill(arr: int[], v: int): void {
    for (i, _x) in arr {
        arr[i] = v;
    }
}

fn main(): int {
    immut a: int[3] = [1, 2, 3];
    fill(a, 0);
    return a[0];
}
