// EXPECT-DIAG: E141
// EXPECT-DIAG: `h` is immutable, and `clear` writes to the array it takes as `arr`. As an `int[]` parameter, it shares the caller's array, so the change would land in `h`.
// Issue #260: an array FIELD of an immutable struct is just as immutable.
struct Holder {
    data: int[2]
}

fn Holder.new(): void {
    self.data = [1, 2];
}

fn clear(arr: int[]): void {
    arr[0] = 0;
}

fn main(): int {
    immut h: Holder = Holder::new();
    clear(h.data);
    return 0;
}
