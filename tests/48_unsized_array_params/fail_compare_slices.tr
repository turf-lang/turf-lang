// EXPECT-DIAG: E124
// EXPECT-DIAG: Cannot compare arrays with '!='.
// The same for slices, which used to compare their { pointer, length } pairs
// the same broken way. "Equal" could mean same elements or same storage, so
// it has to be written out.
fn main(): int {
    mut a: int[3] = [1, 2, 3];
    immut v = a[..];
    if v != a[1..] {
        return 1;
    }
    return 0;
}
