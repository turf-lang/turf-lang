// Deliberately broken companion module for fail_import_syntax_error.tr --
// `ptr` is this language's own reserved type keyword, so using it as a
// parameter name is a genuine syntax error. Named `..._module.tr` so
// scripts/test_runner.sh's `grep -v "_module.tr"` skips it as a standalone
// test entry point; it only exists to be imported.
extern fn broken(ptr: void*): void;
