// Regression test: `Module::StructName::new(...)` / `Module::StructName::
// default()` -- module-qualified construction. The parser already handles
// this generically (a second consecutive '::' reinterprets the leading name
// as ModuleQualifier, the same mechanism `Module::StructName::method(...)`
// static calls already use -- see modules_and_scope_resolution.md 2.3/2.8.1)
// so this is a Resolver/Codegen-level regression test, not a parser one:
// confirms validateModuleQualifier() is actually invoked for `new`/`default`
// the same way it is for a qualified type annotation or a static method
// call, and that the shorter bare form works too once the type is
// bare-visible (via the on-demand `Shape`/`ShapeUtil` imports below).

import io;
import construction_shape_module::[Shape, ShapeUtil];

fn main(): int {
    // Fully module-qualified.
    mut s1: construction_shape_module::Shape =
        construction_shape_module::Shape::new(3, "triangle");
    assert(s1.sides == 3, "qualified new() sets sides");

    mut s2: construction_shape_module::Shape =
        construction_shape_module::Shape::default();
    assert(s2.sides == 0, "qualified default() zero-inits");

    // Bare form, now that Shape/ShapeUtil are on-demand imported above.
    mut s3: Shape = Shape::new(4, "square");
    assert(s3.sides == 4, "bare new() after on-demand import");

    assert(ShapeUtil::describe(3) == "triangle", "static method, '.' decl + 'static' keyword, cross-module");
    assert(construction_shape_module::ShapeUtil::describe(5) == "polygon", "qualified static method call still works");

    io::printline("module-qualified construction works");
    return 0;
}
