fn add(a: int, b: int): int {
    return a + b;
}

fn toDouble(x: double): double {
    return x;
}

fn greet(): void {
}

fn main(): int {
    // Passing int where double expected (implicit widening)
    mut result: double = toDouble(42);
    assert(result == 42.0, "");

    // Returning int from int function - should work
    mut sum: int = add(3, 7);
    assert(sum == 10, "");

    // Passing double where int expected (implicit narrowing)
    mut narrow: int = add(3, 2.5);
    assert(narrow == 5, "");

    // Calling void function as a statement - should work
    greet();

    // Using bool-to-int implicit conversion - should work
    mut boolResult: int = add(1, true);
    assert(boolResult == 2, "");

    return 0;
}
