// Companion for the import_scope_* tests (LEC-008): imports
// import_scope_inner_module itself, so it may spell it, and hands values of the
// inner module's type to callers that never imported the inner module.
import import_scope_inner_module;

pub fn outer_value(): int {
    return import_scope_inner_module::inner_value() + 1;
}

pub fn outer_make(v: int): import_scope_inner_module::InnerBox {
    return import_scope_inner_module::make_inner(v);
}
