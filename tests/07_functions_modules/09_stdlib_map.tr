// Regression test: lib/std/map.tr (Map<K, V>), imported and exercised
// end-to-end -- put/get/contains/remove/length, key overwrite, growth past
// the initial capacity, and a non-string (int->double) instantiation.

import map::Map;
import io;

fn main(): int {
    mut m: Map<string, int>;
    m.put("a", 1);
    m.put("b", 2);
    m.put("c", 3);
    assert(m.length() == 3, "");
    assert(m.get("a") == 1, "");
    assert(m.get("b") == 2, "");
    assert(m.get("c") == 3, "");
    assert(m.contains("a") == true, "");
    assert(m.contains("z") == false, "");

    // Overwriting an existing key must not grow the map.
    m.put("a", 100);
    assert(m.length() == 3, "");
    assert(m.get("a") == 100, "");

    m.remove("b");
    assert(m.length() == 2, "");
    assert(m.contains("b") == false, "");

    // Force growth past the initial capacity (8) -- a separate int-keyed
    // map, since `m` above is string-keyed.
    mut ints: Map<int, int>;
    mut i: int = 0;
    while i < 20 {
        ints.put(i, i * 2);
        i = i + 1;
    }
    assert(ints.length() == 20, "");
    assert(ints.get(19) == 38, "");

    // int -> double instantiation, exercising the double-erasure argument-
    // passing path (see 10_generic_double_erasure.tr for the dedicated,
    // narrower regression covering the exact bug this once crashed on).
    mut prices: Map<int, double>;
    prices.put(1, 1.5);
    prices.put(2, 2.75);
    assert(prices.get(1) == 1.5, "");
    assert(prices.get(2) == 2.75, "");

    io::printline("map ok");
    return 0;
}
