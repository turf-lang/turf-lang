// Companion module (no main()) for scope_construction_via_module_import.tr --
// declares a struct with a constructor and an empty struct with a static
// method, both using the '.'-declaration syntax (static or not).

pub struct Shape {
    sides: int,
    label: string
}

pub fn Shape.new(sides: int, name: string): void {
    self.sides = sides;
    self.label = name;
}

pub struct ShapeUtil {}

pub fn ShapeUtil.describe(sides: int) static: string {
    if (sides == 3) {
        return "triangle";
    }
    return "polygon";
}
