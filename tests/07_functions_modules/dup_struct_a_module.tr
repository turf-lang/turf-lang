// Companion module for same_struct_name_across_modules.tr -- declares a
// struct named 'Point', as does dup_struct_b_module.tr (with a different
// shape). Importing both used to be a cross-module DuplicateTypeNameError;
// since FDN-003 they are two distinct types, dup_struct_a_module::Point and
// dup_struct_b_module::Point. Named `..._module.tr` so
// scripts/test_runner.sh's `grep -v "_module.tr"` skips it as a standalone
// test entry point; it only exists to be imported.
pub struct Point {
    pub x: int
}

pub fn makeA(): Point {
    return Point::default();
}
