// Regression test: `Module::EnumName::Variant` where Module and EnumName
// are both correct but Variant doesn't actually exist on that enum must
// still be rejected with the ordinary "no variant" diagnostic -- proves
// the 3-part chain reaches the SAME variant-existence check the 2-part
// bare form (EnumName::Variant) already had, not a separate, less-checked
// path.

import functionless_module_enum_module;

fn main(): int {
    immut s: functionless_module_enum_module::Shade =
        functionless_module_enum_module::Shade::NoSuchVariant;
    return 0;
}
