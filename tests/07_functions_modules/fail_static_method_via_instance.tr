// Regression test: a TRUE static method (declared with the `::` form, no
// `self` parameter at all) can't be called through an instance with '.' --
// arity naturally mismatches (the implicit self the '.' call form always
// passes has no matching declared parameter to receive it).

struct MathUtil {
    dummy: int
}

fn MathUtil::square(x: int): int {
    return x * x;
}

fn main(): int {
    mut mu: MathUtil = MathUtil { dummy: 0 };
    immut y: int = mu.square(5);
    return 0;
}
