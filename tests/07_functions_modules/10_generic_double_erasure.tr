// Regression test: passing a `double` value into a generic (type-erasure)
// method/init parameter used to crash the compiler with an illegal
// "bitcast double to ptr" -- MethodCallExprAST::codegen()'s argument-casting
// loop (and the matching struct-init-call loop) had a case for erasing
// int/bool arguments into an opaque `ptr`-typed generic slot, and for
// UN-erasing a double back out, but was missing the forward "erase a
// double argument INTO ptr" case entirely, falling through to an
// unconditional (and for double<->ptr, illegal) CreateBitCast(). Confirmed
// via both List<double>.push(1.5) and Map<K,V>.put(key, <double>).

import list::List;
import map::Map;
import io;

fn main(): int {
    mut l: List<double>;
    l.push(1.5);
    l.push(2.5);
    assert(l.pop() == 2.5, "");
    assert(l.pop() == 1.5, "");

    mut m: Map<int, double>;
    m.put(1, 3.25);
    m.put(2, 4.75);
    assert(m.get(1) == 3.25, "");
    assert(m.get(2) == 4.75, "");

    io::printline("generic double erasure ok");
    return 0;
}
