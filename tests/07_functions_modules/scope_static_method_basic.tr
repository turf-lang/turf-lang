// Regression test: `fn StructName.method(...) static: RetType` declares a
// TRUE static method -- no implicit `self` parameter -- callable only as
// `StructName::method(args)`, never through an instance. The exact same
// struct can also declare ordinary instance methods (`.` form, no
// `static`) alongside it; the two forms don't interfere with each other.
//
// MathUtil is a genuinely EMPTY struct (`struct MathUtil {}`) -- a static
// method has no use for instance state at all, so there's no reason a
// "namespace"-style struct that exists only to hold static methods should
// need a meaningless placeholder field just to satisfy the parser. Empty
// structs are fully supported (see tests/06_structs/29_empty_struct.tr);
// this was in fact the direct motivation for confirming that.

import io;

struct MathUtil {}

fn MathUtil.square(x: int) static: int {
    return x * x;
}

fn MathUtil.describe(): string {
    // A legitimate instance method on an empty struct: self is still a
    // real pointer, it just never needs to read a field through it.
    return "a MathUtil instance";
}

fn main(): int {
    assert(MathUtil::square(5) == 25, "static method call works");
    assert(MathUtil::square(0) == 0, "static method call works for zero");

    mut mu: MathUtil = MathUtil::default();
    io::printline(mu.describe());

    io::printline("static + instance methods coexist on one (empty) struct");
    return 0;
}
