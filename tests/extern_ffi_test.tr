// Test extern fn FFI (Issue #175)
extern fn strlen(s: string): int;
extern fn puts(s: string): int;
extern fn malloc(size: int): ptr;
extern fn free(p: ptr): void;

fn main(): int {
    mutable len: int = strlen("hello");
    io.printline(len);
    mutable unused: int = puts("extern fn works!");
    return 0;
}
