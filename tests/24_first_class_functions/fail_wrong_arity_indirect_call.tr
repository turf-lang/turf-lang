// EXPECT-DIAG: E044
// EXPECT-DIAG: 'f' expects 1 argument, got 2
// Calling a function-typed parameter with the wrong number of arguments must
// be caught by the TypeChecker's indirect-call arity check, same as an
// ordinary direct call would be.
fn apply(f: fn(int): int, x: int): int {
    return f(x, x);
}

fn double_it(n: int): int { return n * 2; }

fn main(): int {
    return apply(double_it, 5);
}
