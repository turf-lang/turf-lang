unsafe module;

// A lambda's value is one C function pointer (FREEZE F-FN-3), so it can be
// qsort's comparator, from a variable or written where it is passed.

import test;

extern fn qsort(base: ptr, n: int, size: int, cmp: fn(ptr, ptr): int32): void;

fn main(): int {
    mut v: int[5] = [5, 2, 9, 1, 3];
    immut ascending = fn(a: ptr, b: ptr): int32 {
        mut x: int = (a to int*)[0];
        mut y: int = (b to int*)[0];
        if x < y { return -1 to int32; }
        if x > y { return 1 to int32; }
        return 0 to int32;
    };
    qsort(&v[0] to ptr, 5, 8, ascending);
    test::assert(v[0] == 1 && v[2] == 3 && v[4] == 9, "sorted by a lambda in a variable");
    qsort(&v[0] to ptr, 5, 8, fn(a: ptr, b: ptr): int32 { return ((b to int*)[0] - (a to int*)[0]) to int32; });
    test::assert(v[0] == 9 && v[4] == 1, "sorted by a lambda written in the call");
    return 0;
}
