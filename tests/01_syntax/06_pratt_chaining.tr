import test;

struct Builder {
    val: int
}

// Mutates self and returns self by reference -- see
// tests/06_structs/23_self_pointer_chaining.tr for why this (rather than a
// by-value `Builder` return) is the idiomatic way to support chaining, and
// for why the return type is `&Builder` (issue #238: a plain function may
// never return a raw ptr/T* type, even inside `unsafe { }` -- it used to
// be `Builder*` here too) with an explicit `unsafe { self to &Builder }`
// to satisfy it (self's own synthesized type is still a raw pointer,
// unchanged by this issue, but always non-null by construction).
//
// This method was MISSING entirely until this fix: the original test called
// `b.push(1).push(2)` against a `Builder` struct that declared zero methods.
// Before TypeChecker::visitMethodCall() gained a real "does this method
// exist on this struct" check (see StructMethodNotFoundError in Errors.h),
// an unresolved struct-method call was silently permissive all the way
// through Codegen -- both calls just vanished from the compiled program
// with no error, so this test "passed" without the Pratt parser's chaining
// behavior ever actually being exercised semantically (only parsed, never
// resolved or executed). Now that the compiler correctly rejects a call to
// a genuinely nonexistent method, the test needs a REAL method to chain
// against for its own claimed purpose to mean anything.
fn Builder.push(x: int): &Builder {
    self.val = self.val + x;
    unsafe {
        return self to &Builder;
    }
}

fn main(): int {
    mut b: Builder = Builder::default();

    // Test Pratt Parser's ability to chain method calls
    b.push(1).push(2);
    test::assert(b.val == 3, "chained push(1).push(2) should leave val == 3");

    return 0;
}
