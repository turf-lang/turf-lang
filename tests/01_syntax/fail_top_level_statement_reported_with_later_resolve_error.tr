// EXPECT-DIAG: E103
// EXPECT-DIAG: E040
// A statement at the top level is a syntax error even when the file also
// has a name the resolver cannot find. The pre-pass skips the stray line,
// and its resolver failure must not end the compile before the main pass
// reports it (issue #321).
immut K: int = 3;

fn main(): int {
    io::printline(K);
    return 0;
}
