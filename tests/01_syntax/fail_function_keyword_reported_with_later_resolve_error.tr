// `function` is not a keyword (yet: TDP-2-023). The line that uses it is a
// syntax error, reported beside the later "unknown function" error rather
// than hidden by it (issue #321).
function add(a: int, b: int): int { return a + b; }

fn main(): int {
    io::printline(add(1, 2));
    return 0;
}
