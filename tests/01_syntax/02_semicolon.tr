import test;

fn main(): int {
    mut a: int = 10;
    mut b: int = 20;
    mut max_val: int = 0;

    if (a > b) {
        max_val = a;
    } else {
        max_val = b;
    }

    test::assert(max_val == 20, "max_val should be 20, ensuring if-else parses without trailing semicolons");

    mut i: int = 0;
    while i < 5 {
        i = i + 1;
    }

    test::assert(i == 5, "while loop should run 5 times and not require a semicolon after the block");

    return 0;
}
