// EXPECT-DIAG: E102
// EXPECT-FIX: insert ';' after 'io::printline("hello")'
// The classic forgotten ';' at the end of a line. The parser only notices at the
// NEXT statement, but the ';' belongs right after the call before it, so
// that is where the Fix: inserts it (the fix-it carries its own line). The
// trailing comment must stay after the ';', not swallow it.
import io;

fn main(): int {
    mut count: int = 3; // a counter
    io::printline("hello") // no semicolon here
    io::printline("world");
    return 0;
}
