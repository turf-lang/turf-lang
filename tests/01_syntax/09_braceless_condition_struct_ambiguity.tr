// Regression test (was DISCOVERED_ISSUES.md #1): Turflang allows braceless
// block conditions (`if a > b {`), but if the condition expression ends
// with a bare identifier immediately followed by `{`, the parser's
// struct-init lookahead (`Identifier '{' field: expr ... '}'`) used to
// greedily match that `{` as the start of a struct literal instead of the
// block body -- e.g. `if x {` would try to parse `x { ... }` as a struct
// initializer for a (nonexistent) struct named `x`.
//
// The fix at the time (NoStructInitGuard / g_AllowStructInit) disabled
// struct-init lookahead while parsing if/while/for/compare conditions. That
// entire mechanism (guard included) is gone now, for a stronger reason than
// "the guard works": the struct-construction overhaul removed brace-literal
// construction (`Identifier '{' ... '}'`) from the grammar ENTIRELY (see
// `StructName::new(...)`/`StructName::default()` instead) -- so `if x {`
// can no longer be ambiguous with a struct literal at all, since no
// identifier immediately followed by '{' is ever a struct literal anymore,
// condition or not. Kept as a regression test for the braceless-condition
// PARSING itself (still a real, independent feature -- if/while/for
// without parentheses around the condition), now with the historical
// ambiguity as context for why these specific shapes were chosen.

import test;

struct Point { x: int }

fn Point.new(x: int): void {
    self.x = x;
}

fn main(): int {
    mut b: int = 5;
    mut count: int = 0;

    // if-condition ending in a bare identifier comparison, no parens
    if b > 3 {
        count = count + 1;
    }
    test::assert(count == 1, "");

    // while-condition ending in a bare identifier, no parens
    mut n: int = 3;
    while n > 0 {
        n = n - 1;
        count = count + 1;
    }
    test::assert(count == 4, "");

    // for-loop step clause ending in a bare identifier, no parens
    mut step_amt: int = 1;
    mut total: int = 0;
    for i in 1..3 step i += step_amt {
        total = total + i;
    }
    test::assert(total == 3, "");

    // A genuine struct construction must still work in a normal expression
    // position (not a condition).
    mut p: Point = Point::new(9);
    test::assert(p.x == 9, "");

    return 0;
}
