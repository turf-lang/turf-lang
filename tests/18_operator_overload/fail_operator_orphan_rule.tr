// EXPECT-DIAG: E080
// EXPECT-DIAG: 'operator +' does not own any of its operand types
// Negative test: LANG-001's orphan rule (§13.4) -- a module (here, the main
// file, which owns neither type) may not declare an operator between two
// struct types it doesn't own. Without this rule, operator meaning would
// depend on import order: whichever third module happens to get imported
// (or not) would silently change what 'a + b' means for A/B.
import orphan_a_module::A;
import orphan_b_module::B;

operator +(a: A, b: B): A {
    return a;
}

fn main(): int {
    return 0;
}
