// Negative test (LEC-006, E098): the same lost write as a mutating method, in
// the form people actually write. `outer[0]` is a COPY of the inner List's
// header; `push` bumps `len` in that copy, so `outer[0].length()` stays 0.
// (`outer[0][0] = v` is different and works -- it writes through the shared
// buffer; see 22_index_result_writes_that_land.tr.)
// Expected: E098, "Cannot call 'push' on the value an 'operator[]' read returned".
import list::List;

fn main(): int {
    mut outer: List<List<int>> = List::default();
    mut inner: List<int> = List::default();
    outer.push(inner);
    outer[0].push(5);
    return 0;
}
