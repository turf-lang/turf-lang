// Negative test: bitwise operators are not in the overloadable whitelist
// (+ - * / == != < > <= >= only) -- 'operator &' must be rejected at parse
// time with a clear diagnostic, not silently misparsed.
struct Vec2 {
    x: int,
    y: int
}

operator &(a: Vec2, b: Vec2): Vec2 {
    return a;
}

fn main(): int {
    return 0;
}
