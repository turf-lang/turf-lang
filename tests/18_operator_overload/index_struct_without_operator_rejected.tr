// REL-004 (fuzzer): a struct that declares no `operator []` was indexed anyway;
// the access had no type and Codegen stopped with "Base is not an array or
// pointer". Found as a one-token mutation of
// 10_operator_index_get_set.tr (the declaration was deleted).
struct IntBox {
    a: int,
}

@test(compile_error, E126, "I cannot index an `IntBox`.")
fn rejects_index_struct_without_operator(): void {
    mut box: IntBox = IntBox::default();
    box[0];
}
