// Negative test: LANG-001 scope boundary -- compound assignment THROUGH
// operator[] (`box[i] += 1`) is deliberately not supported (it would need a
// read-modify-write through both operator[] AND operator[]= together, a
// separate feature from plain index read/write; see
// docs/development/changes/LANG-001.md's Known pitfalls). Must be a clean
// diagnostic, not Codegen's "Internal error: Base is not an array or
// pointer" ICE.
struct IntBox {
    a: int
}

operator [](box: IntBox, index: int): int {
    return box.a;
}

operator []=(box: &IntBox, index: int, value: int): void {
    box.a = value;
}

fn main(): int {
    mut box: IntBox = IntBox::default();
    box.a = 1;
    box[0] += 1;
    return 0;
}
