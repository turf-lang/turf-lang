// Assignment is value-first everywhere: `x[i] = e` evaluates `e` before `i`,
// whether `x` is an array or a type with its own `operator []=` (a List, or a
// user struct). Before, an array evaluated `e` first but `l[i] = e` was the
// call `[]=(l, i, e)` and evaluated `i` first (found by turf-fuzz; owner
// decision 2026-10-11). A method call's arguments come before its receiver.

import test;
import list::List;

struct Box { v: int }

operator []=(b: &Box, i: int, value: int): void {
    b.v = i * 100 + value;
}

struct S { v: int }

fn S.add(k: int): void {
    self.v += k;
}

fn note(log: &List<int>, x: int): int {
    log.push(x);
    return x;
}

fn main(): int {
    mut log: List<int> = List::default();

    mut a: int[2] = [0, 0];
    a[note(&log, 1)] = note(&log, 2);

    mut l: List<int> = List::default();
    l.push(0);
    l.push(0);
    l[note(&log, 1)] = note(&log, 3);

    mut b: Box = Box::default();
    b[note(&log, 4)] = note(&log, 5);

    mut ss: S[2] = [S::default(), S::default()];
    ss[note(&log, 1)].add(note(&log, 6));

    test::assert(log.length() == 8, "every operand evaluated once");
    test::assert(log[0] == 2 && log[1] == 1, "array: value, then index");
    test::assert(log[2] == 3 && log[3] == 1, "List operator []=: value, then index");
    test::assert(log[4] == 5 && log[5] == 4, "user operator []=: value, then index");
    test::assert(log[6] == 6 && log[7] == 1, "method call: argument, then receiver");
    test::assert(a[1] == 2 && l[1] == 3 && b.v == 405 && ss[1].v == 6, "and the writes land");
    return 0;
}
