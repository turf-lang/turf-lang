// Negative test (LEC-006, E098): the compound-assignment form of
// fail_index_result_field_assign.tr -- `bs[0].a += 1` updates the copy.
// Expected: E098, "Cannot update part of the value an 'operator[]' read returned".
import list::List;

struct Big {
    a: int
}

fn Big.new(a: int): void {
    self.a = a;
}

fn main(): int {
    mut bs: List<Big> = List::default();
    bs.push(Big::new(1));
    bs[0].a += 1;
    return 0;
}
