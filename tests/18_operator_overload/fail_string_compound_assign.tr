// Negative test: `s += t` on strings is now a clean compile-time type
// error, not the silent invalid-LLVM-IR bug it was before this pass
// (CompoundAssignmentExprAST::codegen() used to emit a raw add on i8*,
// untested and unreachable via any passing test). This is a deliberate,
// accepted improvement -- extending operator resolution to
// CompoundAssignmentExprAST is tracked as a separate follow-up, not done
// in this pass.
import strings;

fn main(): int {
    mut s: string = "hello";
    s += " world";
    return 0;
}
