// F-11e: tests moved from fail_*.tr files, one function each; each `@test` names the
// error its body must be rejected with.

import list::List;

// The type has an `operator []`, but it takes an `int` index and the read
// passes a string. Operator overloads match exactly (F-OP-1). This used to be
// accepted with no type and then died in Codegen ("Base is not an array or
// pointer"); the write twin has always said "No 'operator[]=' overload
// matches".
struct IntBox {
    a: int
}

operator [](box: IntBox, index: int): int {
    return box.a;
}

@test(compile_error, E056, "No `operator[]` matches `IntBox[string]`.")
fn rejects_index_read_wrong_index_type(): void {
    mut box: IntBox = IntBox::default();
    box["zero"];
}

// Negative test (LEC-006 follow-up, E098): E098 used to rely on a method's own
// body assigning to self. `bs[0].outer()` assigns nothing itself -- it calls
// `self.wrapper()`, which calls `self.bump()`, which does the assignment -- so
// it compiled and silently lost the write on the copy bs[0] returned. The
// mutates-self check now follows those calls.
// Expected: E098, "Cannot call 'outer' on the value an 'operator[]' read returned".

struct Big {
    a: int
}

fn Big.new(a: int): void {
    self.a = a;
}

fn Big.bump(): void {
    self.a = self.a + 1;
}

fn Big.wrapper(): void {
    self.bump();
}

fn Big.outer(): void {
    self.wrapper();
}

@test(compile_error, E098, "I cannot call `outer` on what an `operator[]` read returned: it changes its receiver, and the receiver is a copy, so the change would be lost.")
fn rejects_index_result_transitive_mutating_method(): void {
    mut bs: List<Big> = List::default();
    bs.push(Big::new(1));
    bs[0].outer();
}
