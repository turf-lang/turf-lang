// F-11e: tests moved from fail_*.tr files, one function each; each `@test` names the
// error its body must be rejected with.

// LEC-004: a variant pattern only covers its variant when every field pattern
// matches anything. `Denied(_, 0)` matches only mode 0, so `Denied` is still
// uncovered without `otherwise` (E093).
error IOError {
    Denied(path: string, mode: int)
}

@test(compile_error, E093, "This `compare` on `IOError` does not cover every case, and it has no `otherwise`.")
fn rejects_error_compare_refutable_payload_does_not_cover(): void {
    mut e: IOError = IOError::Denied("x", 1);
    compare e {
        matches IOError::Denied(_, 0):
        return;
        done
    }
}

// STD-002: exactly ONE argument is the only legal call arity on an error
// variant -- two arguments stays rejected the same "not a function" way
// zero arguments already does (fail_error_variant_not_callable.tr), not
// silently accepted or arity-mismatched against some imagined overload.
error MathError {
    DivisionByZero,
}

@test(compile_error, E135, "I cannot call `MathError::DivisionByZero`, which is an error variant and not a function")
fn rejects_error_variant_construct_too_many_args(): void {
    mut e: MathError = MathError::DivisionByZero("a", "b");
}
