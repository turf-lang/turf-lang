// LEC-004: `try` inside a generic function. The operand's success type is the
// type parameter, substituted per instantiation; the error passes through.
import io;
import test;

error GenError {
    Refused(code: int)
}

fn<T> offer(x: T, refuse: bool): !T {
    if refuse { return GenError::Refused(42); }
    return x;
}

fn<T> relay(x: T, refuse: bool): !T {
    immut v: T = try offer(x, refuse);
    return v;
}

fn codeOf(refuse: bool): int {
    immut _s: string = relay("text", refuse) recover as err run {
        compare err {
            matches GenError::Refused(code):
            return code;
            done
            otherwise:
            return 0 - 1;
        }
    };
    return 0;
}

fn main(): int {
    immut a: int = relay(5, false) recover produce -1;
    immut b: string = relay("ok", false) recover produce "bad";
    immut c: double = relay(2.5, false) recover produce 0.0;
    test::assert(a == 5, "int instantiation");
    test::assert(b == "ok", "string instantiation");
    test::assert(c == 2.5, "double instantiation");
    test::assert(codeOf(true) == 42, "the payload survives a generic relay");
    test::assert(codeOf(false) == 0, "success");
    io::printline("25/27 PASS");
    return 0;
}
