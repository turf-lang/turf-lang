// Test (fail): a 'recover run { ... }' block that doesn't 'produce' a value
// must diverge (end in 'return') on every path -- otherwise there's nothing
// for the recovered expression to evaluate to.
error MathError {
    DivisionByZero,
}

fn divide(a: int, b: int): !int {
    if (b == 0) {
        return MathError::DivisionByZero;
    }
    return a / b;
}

@test(compile_error, E132, "A path through `recover run` ends without a `return`, and the block gives the call nothing to stand for.")
fn rejects_recover_run_non_diverging(): void {
    mut x: int = divide(10, 2) recover run {
        mut y: int = 5;
    };
}
