// EXPECT-DIAG: E092
// EXPECT-DIAG: 'p' is bound twice in the same pattern
// LEC-004: one name can't bind two fields of one pattern (E092), the same rule
// a struct pattern has.
error IOError {
    Denied(path: string, other: string)
}

fn open(p: string): !int {
    return IOError::Denied(p, p);
}

fn code(): int {
    immut v: int = open("x") recover as err run {
        compare err {
            matches IOError::Denied(p, p):
            return 1;
            done
            otherwise:
            return 2;
        }
    };
    return v;
}

fn main(): int {
    return 0;
}
