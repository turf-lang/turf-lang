// LEC-004: a variant pattern only covers its variant when every field pattern
// matches anything. `Denied(_, 0)` matches only mode 0, so `Denied` is still
// uncovered without `otherwise` (E093).
error IOError {
    Denied(path: string, mode: int)
}

fn main(): int {
    mut e: IOError = IOError::Denied("x", 1);
    compare e {
        matches IOError::Denied(_, 0):
            return 1;
        done
    }
    return 0;
}
