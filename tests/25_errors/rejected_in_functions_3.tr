// F-11e: tests moved from fail_*.tr files, one function each; each `@test` names the
// error its body must be rejected with.

// LEC-004: an error-variant pattern matches an error value. Matched against an
// int it can never succeed, which is E092 rather than a silent never-taken arm.
error IOError {
    NotFound(path: string)
}

@test(compile_error, E092, "This is an error-variant pattern, and what it matches is an `int`, not an error.")
fn rejects_error_pattern_on_non_error_subject(): void {
    mut n: int = 3;
    compare n {
        matches IOError::NotFound(path):
        return;
        done
        otherwise:
        return;
    }
}

// STD-002: `ErrorType::Variant(messageExpr)` requires messageExpr to be a
// 'string' -- a non-string argument is a type mismatch, not silently
// coerced.
error MathError {
    DivisionByZero,
}

@test(compile_error, E096, "The last argument of `MathError::DivisionByZero(...)` is its message, a `string`, and I found an `int`.")
fn rejects_error_variant_construct_wrong_message_type(): void {
    mut e: MathError = MathError::DivisionByZero(42);
}
