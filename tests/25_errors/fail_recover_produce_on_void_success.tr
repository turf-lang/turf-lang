// Test (fail): Errors.md's own explicit example -- 'recover produce value'
// is invalid when the call's success type is 'void' (there's no value to
// produce a mismatched replacement for).
error IOError {
    FileNotFound(path: string),
}

fn writeFile(path: string): !void {
    return IOError::FileNotFound(path);
}

fn main(): int {
    writeFile("a.txt") recover produce 42;
    return 0;
}
