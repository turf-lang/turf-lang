// Tests passing arrays by reference and mutating them inside a function.
// (Phase 3 functionality)

fn void double_elements(int[5] arr) {
    for i in 0..5 step i++ {
        arr[i] = arr[i] * 2
    }
}

fn int get_sum(int[5] arr) {
    int sum = 0
    for i in 0..5 step i++ {
        sum = sum + arr[i]
    }
    return sum
}

int[5] numbers = [1, 2, 3, 4, 5]

print(numbers[4])      // Expected: 5

// Mutate the array inside a function (pass-by-reference)
double_elements(numbers)

print(numbers[4])      // Expected: 10
print(get_sum(numbers)) // Expected: 30 (2 + 4 + 6 + 8 + 10)
