fn int ackermann(int m, int n) {
    if (m == 0) {
        return n + 1
    }
    if (m > 0) {
        if (n == 0) {
            return ackermann(m - 1, 1)
        }
    }
    return ackermann(m - 1, ackermann(m, n - 1))
}

fn int main() {
    // ackermann(3, 4) is 125, it tests recursion heavily
    io.printline(ackermann(3, 4))

    return 0
}
