struct User {
    int age,
    string name
}

fn int main() {
    User[5] users

    users[0] = User(25, "Alice")
    users[1] = User(30, "Bob")
    users[2] = User(35, "Charlie")

    io.printline(users[0].name)
    io.printline(users[0].age)
    io.printline(users[1].name)
    io.printline(users[1].age)

    return 0
}
