// Comprehensive ptr verification — Phase A+B final check
// Tests every meaningful pointer scenario before Phase C.

extern fn malloc(size: int): ptr;
extern fn free(p: ptr): void;
extern fn memset(p: ptr, c: int, n: int): ptr;
extern fn memcpy(dst: ptr, src: ptr, n: int): ptr;
extern fn strlen(s: string): int;
extern fn puts(s: string): int;

// --- Test: ptr as a Turflang function PARAMETER ---
fn zero_buffer(buf: ptr, size: int): void {
    memset(buf, 0, size);
}

// --- Test: ptr as a Turflang function RETURN TYPE ---
fn make_buffer(size: int): ptr {
    mutable p: ptr = malloc(size);
    memset(p, 0, size);
    return p;
}

// --- Test: ptr passed from one turf fn to another turf fn ---
fn release(p: ptr): void {
    free(p);
}

fn main(): int {
    // 1. Basic alloc/free
    mutable a: ptr = malloc(64);
    free(a);
    io.printline(1);   // checkpoint 1

    // 2. ptr returned from a Turflang function
    mutable b: ptr = make_buffer(32);
    release(b);
    io.printline(2);   // checkpoint 2

    // 3. Turflang fn that takes ptr parameter
    mutable c: ptr = malloc(16);
    zero_buffer(c, 16);
    free(c);
    io.printline(3);   // checkpoint 3

    // 4. Multiple independent ptr variables
    mutable d: ptr = malloc(8);
    mutable e: ptr = malloc(8);
    mutable f: ptr = memset(d, 1, 8);
    mutable g: ptr = memcpy(e, d, 8);
    free(d);
    free(e);
    io.printline(4);   // checkpoint 4

    // 5. null assigned to ptr
    mutable h: ptr = null;
    io.printline(5);   // checkpoint 5

    // 6. ptr from one extern as arg to another (chain)
    mutable src: ptr = malloc(64);
    mutable dst: ptr = malloc(64);
    memset(src, 7, 64);
    memcpy(dst, src, 64);
    free(src);
    free(dst);
    io.printline(6);   // checkpoint 6

    // 7. string-to-ptr implicit (extern fn accepting string works as ptr)
    mutable len: int = strlen("verify");
    io.printline(len); // expect: 6

    return 0;
}
