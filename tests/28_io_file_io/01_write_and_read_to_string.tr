// Regression coverage for the new buffered-file-I/O primitives added to
// lib/std/io/io.tr: io::write_string / io::read_to_string round-trip.
import io;
import strings;
import test;

// remove(2): POSIX unlink, bound locally (like several other tests bind
// their own one-off externs) just so this test can clean up its own temp
// file afterward instead of leaving it behind in the repo.
extern fn remove(path: string): int;

fn main(): int {
    immut path: string = "01_write_and_read_to_string.tmp";

    // write_string is `!void` (LEC-007; it returned bool): the recover block
    // runs only on failure, so reaching the next line is the success check.
    io::write_string(path, "hello from turf\nsecond line\n") recover run {
        test::fail("write_string should report success on a writable path");
    };

    immut content: string = io::read_to_string(path) recover run {
        test::fail("read_to_string should succeed right after write_string wrote the file");
        return 1;
    };
    test::assert(content == "hello from turf\nsecond line\n", "read_to_string should return exactly what was written");

    remove(path);

    io::printline("01 PASS: io::write_string / io::read_to_string round-trip");
    return 0;
}
