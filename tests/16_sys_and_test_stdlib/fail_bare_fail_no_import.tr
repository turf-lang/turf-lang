// Regression test: `fail` is no longer a compiler builtin -- it's an
// ordinary Turf function in lib/std/test.tr. A bare, unqualified `fail(...)`
// call with NO `import test;` must be rejected as an ordinary
// unknown-function error, exactly like calling any other unimported
// stdlib function bare would be.
fn main(): int {
    fail("this should never even compile");
    return 0;
}
