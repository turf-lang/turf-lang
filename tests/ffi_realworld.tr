// =============================================================================
// Turflang FFI Real-World Showcase
// Tests file I/O, math, time, strings, env, and process spawning.
// Compile: ./build/turf tests/ffi_realworld.tr -o ffi_realworld
// Run:     ./ffi_realworld
// (libm is auto-linked via 'extern from "m" fn' annotations)
// =============================================================================

// ── All extern fn declarations at top level ───────────────────────────────────

// I/O
extern fn printf(fmt: string, ...): int;
extern fn puts(s: string): int;
extern fn fopen(path: string, mode: string): ptr;
extern fn fclose(handle: ptr): int;
extern fn fwrite(buf: string, size: int, count: int, handle: ptr): int;
extern fn fread(buf: ptr, size: int, count: int, handle: ptr): int;
extern fn fseek(handle: ptr, offset: int, whence: int): int;
extern fn ftell(handle: ptr): int;

// Memory
extern fn malloc(size: int): ptr;
extern fn free(p: ptr): void;
extern fn memset(p: ptr, c: int, n: int): ptr;
extern fn memcpy(dst: ptr, src: ptr, n: int): ptr;

// Strings
extern fn strlen(s: string): int;
extern fn getenv(name: string): ptr;

// Math  (auto-linked — no --link flag needed)
extern from "m" fn sqrt(x: double): double;
extern from "m" fn pow(base: double, exp: double): double;
extern from "m" fn sin(x: double): double;
extern from "m" fn cos(x: double): double;
extern from "m" fn log(x: double): double;
extern from "m" fn floor(x: double): double;

// Time
extern fn time(t: ptr): int;
extern fn clock(): int;

// Process
extern fn system(cmd: string): int;

// Sockets (fd part only — struct binding needs Phase 4 unsafe{})
extern fn socket(domain: int, stype: int, proto: int): int;
extern fn close(sockfd: int): int;

// =============================================================================
// Helper
// =============================================================================
fn section(name: string): void {
    printf("\n=== %s ===\n", name);
}

// =============================================================================
// 1. File I/O
// =============================================================================
fn test_file_io(): void {
    section("File I/O");

    // write
    mutable whandle: ptr = fopen("/tmp/turf_test.txt", "w");
    mutable msg: string  = "Hello from Turflang FFI!\nLine two.\n";
    fwrite(msg, 1, strlen(msg), whandle);
    fclose(whandle);
    printf("Written /tmp/turf_test.txt\n");

    // read back
    mutable rhandle: ptr = fopen("/tmp/turf_test.txt", "r");
    mutable rbuf: ptr    = malloc(256);
    memset(rbuf, 0, 256);
    mutable nbytes: int  = fread(rbuf, 1, 255, rhandle);
    fclose(rhandle);
    printf("Read %d bytes:\n%s", nbytes, rbuf);
    free(rbuf);

    // seek / tell
    mutable shandle: ptr  = fopen("/tmp/turf_test.txt", "r");
    fseek(shandle, 0, 2);                // SEEK_END = 2
    mutable filesize: int = ftell(shandle);
    fclose(shandle);
    printf("File size: %d bytes\n", filesize);
}

// =============================================================================
// 2. Math library
// =============================================================================
fn test_math(): void {
    section("Math (libm via extern from)");

    printf("sqrt(2)       = %g\n", sqrt(2.0));
    printf("pow(2, 10)    = %g\n", pow(2.0, 10.0));
    printf("sin(pi/2)     = %g\n", sin(1.5707963));
    printf("cos(0)        = %g\n", cos(0.0));
    printf("log(e)        = %g\n", log(2.718281828));
    printf("floor(3.99)   = %g\n", floor(3.99));
}

// =============================================================================
// 3. Time
// =============================================================================
fn test_time(): void {
    section("Time");

    mutable timebuf: ptr = malloc(8);
    mutable epoch: int    = time(timebuf);
    free(timebuf);
    mutable clk0: int  = clock();
    mutable clk1: int  = clock();
    printf("Unix epoch    = %d\n", epoch);
    printf("clock() delta = %d ticks\n", clk1 - clk0);
}

// =============================================================================
// 4. Environment variables
// =============================================================================
fn test_env(): void {
    section("Environment");

    mutable homedir: ptr = getenv("HOME");
    printf("HOME  = %s\n", homedir);

    mutable loginshell: ptr = getenv("SHELL");
    printf("SHELL = %s\n", loginshell);

    mutable username: ptr = getenv("USER");
    printf("USER  = %s\n", username);
}

// =============================================================================
// 5. String and memory utilities
// =============================================================================
fn test_strings(): void {
    section("Strings + Memory");

    mutable greeting: string = "turflang is not a C wrapper";
    printf("string           = \"%s\"\n", greeting);
    printf("strlen           = %d\n", strlen(greeting));

    // malloc + memset + memcpy roundtrip
    mutable srcbuf: ptr = malloc(32);
    mutable dstbuf: ptr = malloc(32);
    memset(srcbuf, 88, 10);         // fill with 'X' (ASCII 88)
    memcpy(dstbuf, srcbuf, 10);
    printf("memcpy 10 x 'X'  = %.*s\n", 10, dstbuf);
    free(srcbuf);
    free(dstbuf);
}

// =============================================================================
// 6. Process spawning
// =============================================================================
fn test_process(): void {
    section("Process Spawning");

    system("echo 'system() called from Turflang FFI!'");
    printf("Kernel: ");
    system("uname -r");
    printf("Uptime: ");
    system("uptime -p 2>/dev/null || uptime");
}

// =============================================================================
// 7. Variadic printf — all format specifiers
// =============================================================================
fn test_printf_formats(): void {
    section("Variadic printf (all specifiers)");

    printf("%%s  string  : %s\n",    "hello");
    printf("%%d  int     : %d\n",    42);
    printf("%%g  double  : %g\n",    3.14159);
    printf("%%e  sci     : %e\n",    12345.6789);
    printf("%%x  hex     : %x\n",    255);
    printf("%%05d padded : %05d\n",  7);
    printf("%%.3f fixed  : %.3f\n",  2.718281828);
    printf("multiple    : %s is %d years old\n", "turf", 1);
}

// =============================================================================
// 8. Socket FD — what works today, what Phase 4 enables
// =============================================================================
fn test_socket(): void {
    section("Socket FD (creation + close)");

    // AF_INET=2, SOCK_STREAM=1, proto=0
    mutable sockval: int = socket(2, 1, 0);

    if sockval < 0 {
        printf("socket() failed — returned %d\n", sockval);
    } else {
        printf("socket() opened  fd=%d  (success)\n", sockval);
        printf("(bind/listen need Phase 4 unsafe{} for sockaddr_in)\n");

        // ===================================================================
        // Phase 4 web server — what the full picture looks like:
        //
        //   extern fn bind(fd: int, addr: ptr, len: int): int;
        //   extern fn listen(fd: int, backlog: int): int;
        //   extern fn accept(fd: int, addr: ptr, alen: ptr): int;
        //   extern fn send(fd: int, buf: ptr, len: int, flags: int): int;
        //   extern fn recv(fd: int, buf: ptr, len: int, flags: int): int;
        //   extern fn htons(port: int): int;
        //
        //   fn run_server(port: int): void {
        //       mutable sfd: int = socket(2, 1, 0);
        //       unsafe {
        //           mutable addr: ptr = malloc(16);
        //           memset(addr, 0, 16);
        //           // Write sockaddr_in layout into the raw ptr:
        //           //   bytes [0..1]  = AF_INET (2) as little-endian i16
        //           //   bytes [2..3]  = htons(port) as i16
        //           //   bytes [4..7]  = INADDR_ANY (0) as i32
        //           bind(sfd, addr, 16);
        //           free(addr);
        //       }
        //       listen(sfd, 10);
        //       // ... accept loop, send "HTTP/1.1 200 OK\r\n\r\nHello!" ...
        //   }
        // ===================================================================

        close(sockval);
        printf("socket fd=%d closed\n", sockval);
    }
}

// =============================================================================
// main
// =============================================================================
fn main(): int {
    puts("Turflang FFI — Real-World Showcase");
    puts("=====================================");

    test_file_io();
    test_math();
    test_time();
    test_env();
    test_strings();
    test_process();
    test_printf_formats();
    test_socket();

    puts("\nAll sections complete.");
    return 0;
}
