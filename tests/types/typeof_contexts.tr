// Test typeof() in various contexts

fn int main() {
  // Test 1: typeof() inside loops
  io.printline("=== typeof() in loop context ===")
  for i in 1..4 step i += 1 {
    io.print("typeof(i): ")
    io.printline(typeof(i))
  }

  // Test 2: typeof() with loop expressions
  int sum = 0
  for j in 1..6 step j += 1 {
    sum = sum + j
  }
  io.print("typeof(sum after loop): ")
  io.printline(typeof(sum))

  // Test 3: typeof() with while loop variable
  int counter = 0
  while counter < 3 {
    io.print("typeof(counter): ")
    io.printline(typeof(counter))
    counter = counter + 1
  }

  // Test 4: typeof() with complex assignment chains
  int x = 10
  int y = x + 20
  int z = y * 2
  io.print("typeof(z from chain): ")
  io.printline(typeof(z))

  // Test 5: typeof() in conditional branches
  io.printline("")
  io.printline("=== typeof() in conditionals ===")
  int check = 5
  if check > 0 {
    io.print("Branch typeof(check): ")
    io.printline(typeof(check))
  }

  return 0
}
