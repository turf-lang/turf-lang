import math

fn int main() {
    int a = math.abs(5)
    io.printline(a)

    int b = math.abs(-10)
    io.printline(b)

    double c = math.abs(-3.2)
    io.printline(c)

    int d = math.abs(0)
    io.printline(d)

    double e = math.abs(3.14)
    io.printline(e)

    int f = math.abs(1 + 2 * 3)
    io.printline(f)

    int g = math.abs(-100) + math.abs(-50)
    io.printline(g)

    double h = math.abs(-2.5) + math.abs(-1.5)
    io.printline(h)

    int i = math.abs(math.power(-3, 2))
    io.printline(i)

    return 0
}
