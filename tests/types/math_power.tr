import math

fn int main() {
    int a = math.power(2, 3)
    io.printline(a)

    int b = math.power(5, 0)
    io.printline(b)

    int c = math.power(3, 1)
    io.printline(c)

    double d = math.power(2, 3.0)
    io.printline(d)

    double e = math.power(2.0, 3)
    io.printline(e)

    double f = math.power(2.0, 3.0)
    io.printline(f)

    int g = math.power(10, 2)
    io.printline(g)

    double h = math.power(3, 2.0)
    io.printline(h)

    int i = math.power(-2, 3)
    io.printline(i)

    int j = math.power(-2, 4)
    io.printline(j)

    return 0
}
