fn int main() {
    string a = "Hello"
    io.printline(a)

    string b = "World"
    io.printline(b)

    string c = "Line1\nLine2"
    io.print(c)

    string d = "Tab\there"
    io.printline(d)

    string e = "Quote: \"hello\""
    io.printline(e)

    string f = "Backslash: \\"
    io.printline(f)

    string g = ""
    io.printline(g)

    return 0
}
