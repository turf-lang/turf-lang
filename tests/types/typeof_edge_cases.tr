// Edge case tests for typeof()

fn int main() {
    // Test 1: typeof() with cast expressions
    io.printline("=== Cast Expression Tests ===")
    io.print("typeof(int(3.14)): ")
    io.printline(typeof(int(3.14)))

    io.print("typeof(double(42)): ")
    io.printline(typeof(double(42)))

    io.print("typeof(string(123)): ")
    io.printline(typeof(string(123)))

    io.print("typeof(int(\"456\")): ")
    io.printline(typeof(int("456")))

    // Test 2: typeof() with conditional expressions
    io.printline("")
    io.printline("=== Conditional Expression Tests ===")
    int x = 5
    io.print("typeof(if x > 3 { 10 } else { 20 }): ")
    io.printline(typeof(if x > 3 { 10 } else { 20 }))

    io.print("typeof(if true { 1.5 } else { 2.5 }): ")
    io.printline(typeof(if true { 1.5 } else { 2.5 }))

    io.print("typeof(if false { true } else { false }): ")
    io.printline(typeof(if false { true } else { false }))

    // Test 3: typeof() with complex nested expressions
    io.printline("")
    io.printline("=== Complex Nested Expressions ===")
    int a = 10
    int b = 20
    double c = 3.5

    io.print("typeof((a + b) * 2): ")
    io.printline(typeof((a + b) * 2))

    io.print("typeof((a + c) * 2.0): ")
    io.printline(typeof((a + c) * 2.0))

    io.print("typeof(a > b && b > 5): ")
    io.printline(typeof(a > b && b > 5))

    // Test 4: typeof() with string concatenation (if supported)
    io.printline("")
    io.printline("=== String Operations ===")
    string msg = "Hello"
    io.print("typeof(lengthof(msg) + 5): ")
    io.printline(typeof(lengthof(msg) + 5))

    // Test 5: typeof() on the result of typeof()
    io.printline("")
    io.printline("=== Recursive typeof() ===")
    io.print("typeof(typeof(typeof(42))): ")
    io.printline(typeof(typeof(typeof(42))))

    return 0
}
