// Test typeof() with user-defined functions

fn int add(int a, int b) {
  return a + b
}

fn double multiply(double x, double y) {
  return x * y
}

fn bool isPositive(int n) {
  return n > 0
}

fn string greet() {
  return "Hello"
}

fn int main() {
  // Test typeof() on function call results
  io.printline("=== Function Return Type Tests ===")

  io.print("typeof(add(5, 3)): ")
  io.printline(typeof(add(5, 3)))

  io.print("typeof(multiply(2.5, 3.0)): ")
  io.printline(typeof(multiply(2.5, 3.0)))

  io.print("typeof(isPositive(10)): ")
  io.printline(typeof(isPositive(10)))

  io.print("typeof(greet()): ")
  io.printline(typeof(greet()))

  // Test typeof() with function call in expression
  io.print("typeof(add(1, 2) + 10): ")
  io.printline(typeof(add(1, 2) + 10))

  io.print("typeof(multiply(2.0, 3.0) * 1.5): ")
  io.printline(typeof(multiply(2.0, 3.0) * 1.5))

  return 0
}
