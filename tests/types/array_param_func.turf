// array_param_func.turf
// Verifies that array types are first-class in ParseType(), allowing them
// to appear in function signatures (the original hardcoding bug).

// There is a major issue here
// In both the function calls, get_first itself is called.
// > ./turf tests/types/array_param_func.turf
// [AliasAnalysis] running on function: sum_array
// [AliasAnalysis] running on function: get_first
// [AliasAnalysis] running on function: main
// [Main] GlobalCFGs size before CallGraph: 3
// [CallGraph] Functions: 1
// [CallGraph] main -> get_first, sum_array
// Compiled to program.o
// Successfully compiled to program

// > ./program
// Function get_first called
// 10
// Function get_first called
// 99

fn int sum_array(int[5] data) {
    int total = 0
    io.printline("Function sum_array called")
    for i in 0..5 step i++ {
        io.printline(total)
        total = total + data[i]
    }
    return total
}

fn int get_first(int[10] arr) {
    io.printline("Function get_first called")
    return arr[0]
}

fn int main() {
    int[5] nums = [10, 20, 30, 40, 50]
    int result = sum_array(nums)
    io.printline(result)       // Expected: 150

    int[10] big = [99, 1, 2, 3, 4, 5, 6, 7, 8, 9]
    int first = get_first(big)
    io.printline(first)        // Expected: 99

    return 0
}
