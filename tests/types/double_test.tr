fn int main() {
    double a = 3.14
    io.printline(a)

    double b = 2.718
    io.printline(b)

    double c = a + b
    io.printline(c)

    double d = 10.0 - 4.5
    io.printline(d)

    double e = 3.0 * 2.5
    io.printline(e)

    double f = 10.0 / 3.0
    io.printline(f)

    double g = -1.5
    io.printline(g)

    double h = 0.0
    io.printline(h)

    return 0
}
