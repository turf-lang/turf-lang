fn int main() {
    int a = 10
    int b = 20
    int c = a + b
    io.printline(c)

    int d = 100 - 30
    io.printline(d)

    int e = 7 * 8
    io.printline(e)

    int f = 100 / 4
    io.printline(f)

    int g = 17 % 5
    io.printline(g)

    int h = -42
    io.printline(h)

    int i = 0
    io.printline(i)

    int j = 1000000
    io.printline(j)

    return 0
}
