// More complex typeof() expression tests

fn int main() {
    // Int expressions
    int a = 5
    int b = 10
    io.print(typeof(a + b))
    io.printline(" - addition")

    io.print(typeof(a * b))
    io.printline(" - multiplication")

    io.print(typeof(a - b))
    io.printline(" - subtraction")

    // Double expressions
    double x = 2.5
    double y = 3.5
    io.print(typeof(x + y))
    io.printline(" - double addition")

    io.print(typeof(x / y))
    io.printline(" - double division")

    // Mixed type expressions (should promote to double)
    io.print(typeof(a + x))
    io.printline(" - int + double")

    io.print(typeof(5 + 2.5))
    io.printline(" - literal int + double")

    // Boolean expressions
    io.print(typeof(a > b))
    io.printline(" - comparison")

    io.print(typeof(a == b))
    io.printline(" - equality")

    io.print(typeof(true && false))
    io.printline(" - logical AND")

    io.print(typeof(true || false))
    io.printline(" - logical OR")

    // Nested typeof (typeof returns string)
    io.print(typeof(typeof(42)))
    io.printline(" - typeof of typeof")

    return 0
}
