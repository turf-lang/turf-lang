// Practical demo of typeof() usage

fn int main() {
    // Example 1: Dynamic type inspection for debugging
    io.printline("=== Type Inspection Demo ===")
    int x = 42
    double pi = 3.14159
    bool flag = true
    string name = "Turf"

    io.print("x is of type: ")
    io.printline(typeof(x))

    io.print("pi is of type: ")
    io.printline(typeof(pi))

    io.print("flag is of type: ")
    io.printline(typeof(flag))

    io.print("name is of type: ")
    io.printline(typeof(name))

    // Example 2: Understanding expression type promotion
    io.printline("")
    io.printline("=== Type Promotion Demo ===")

    int a = 5
    double b = 2.5

    io.print("a + b has type: ")
    io.printline(typeof(a + b))

    io.print("This shows that int + double promotes to: ")
    io.printline(typeof(10 + 3.5))

    // Example 3: Verifying comparison results
    io.printline("")
    io.printline("=== Comparison Result Types ===")

    io.print("Type of (5 > 3): ")
    io.printline(typeof(5 > 3))

    io.print("Type of (a == 10): ")
    io.printline(typeof(a == 10))

    io.print("Type of (true && false): ")
    io.printline(typeof(true && false))

    // Example 4: Checking builtin function return types
    io.printline("")
    io.printline("=== Builtin Function Return Types ===")

    string msg = "Hello, World!"
    io.print("lengthof(msg) returns: ")
    io.printline(typeof(lengthof(msg)))

    io.print("typeof(msg) returns: ")
    io.printline(typeof(typeof(msg)))

    return 0
}
