fn int main() {
    int[7] data
    io.printline(data.length)

    int[3] small = [10, 20, 30]
    io.printline(small.length)

    int[4] nums = [100, 200, 300, 400]
    for i in 0..nums.length step i += 1 {
        io.printline(nums[i])
    }

    io.printline(nums[small.length]) // Pratt Parsing Example

    return 0
}
