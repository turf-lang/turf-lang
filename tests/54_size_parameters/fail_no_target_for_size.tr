// EXPECT-DIAG: E129
// EXPECT-DIAG: I cannot tell the size `N` of the array `fill` returns: no argument has it, and nothing says what type the result is.
// A call whose result goes nowhere has no type to take N from.

fn<T, N: size> fill(value: T): T[N] {
    mut r: T[N];
    for i in 0..N {
        r[i] = value;
    }
    return r;
}

fn main(): int {
    fill(0);
    return 0;
}
