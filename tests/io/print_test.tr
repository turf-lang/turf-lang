fn int main() {
    io.print(42)
    io.printline(0)

    io.print(3.14)
    io.printline(0.0) // double gets converted to int when its value is zero (not sure about the reason)

    io.print(true)
    io.printline(false)

    io.print("Hello ")
    io.printline("World")

    int a = 100
    io.printline(a)

    double b = 2.5
    io.printline(b)

    bool c = true
    io.printline(c)

    string d = "Turf"
    io.printline(d)

    return 0
}
