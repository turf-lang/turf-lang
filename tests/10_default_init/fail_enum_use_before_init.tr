// SEM-004 (F-INIT-1): an enum-typed local declared without an initializer
// is statically unassigned -- reading it before any assignment is
// DefiniteAssignmentError (E008). Before SEM-004, an enum was a
// Mechanism-B type Codegen eagerly defaulted to its ordinal-0 variant, so
// this compiled; see 15_enum_assign_then_use.tr for the still-legal
// assign-then-use shape.
enum Direction {
    North,
    East,
    South,
    West
}

fn main(): int {
    mut d: Direction;
    if (d to int) == 0 {
        return 1;
    }
    return 0;
}
