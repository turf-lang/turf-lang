// Stress test: struct with many fields of various types — all default-initialized
import io;

struct BigStruct {
    a: int,
    b: int,
    c: int,
    d: double,
    e: double,
    f: bool,
    g: bool,
    h: string
}

fn main(): int {
    mut s: BigStruct;
    assert(s.a == 0, "a=0");
    assert(s.b == 0, "b=0");
    assert(s.c == 0, "c=0");
    assert(s.d == 0.0, "d=0.0");
    assert(s.e == 0.0, "e=0.0");
    assert(s.f == false, "f=false");
    assert(s.g == false, "g=false");
    assert(s.h == "", "h=empty");
    return 0;
}
