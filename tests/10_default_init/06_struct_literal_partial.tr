// Test: Point::default() + setting only SOME fields afterward -- the
// replacement for the old partial-field brace-literal (`Point{x: 5}`,
// leaving y/z at their defaults), which no longer parses at all.
import io;

struct Point {
    x: int,
    y: int,
    z: int
}

fn main(): int {
    mut p: Point = Point::default();
    p.x = 5;
    assert(p.x == 5, "explicit x=5");
    assert(p.y == 0, "missing y defaults to 0");
    assert(p.z == 0, "missing z defaults to 0");

    mut q: Point = Point::default();
    q.y = 7;
    q.z = 3;
    assert(q.x == 0, "missing x defaults to 0");
    assert(q.y == 7, "explicit y=7");
    assert(q.z == 3, "explicit z=3");

    return 0;
}
