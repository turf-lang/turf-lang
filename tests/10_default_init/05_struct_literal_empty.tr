// Test: Config::default() zero-inits every field (the replacement for the
// old empty brace-literal `Config{}`, which no longer parses at all).
import io;

struct Config {
    retries: int,
    timeout: int,
    verbose: bool
}

fn main(): int {
    mut cfg: Config = Config::default();
    assert(cfg.retries == 0, "Config::default() retries default 0");
    assert(cfg.timeout == 0, "Config::default() timeout default 0");
    assert(cfg.verbose == false, "Config::default() verbose default false");
    return 0;
}
