// SEM-004 (F-INIT-1): the bad direction 02_struct_flat_default.tr's own
// comment points at -- a struct declared with no initializer at all is
// statically unassigned; reading a field is DefiniteAssignmentError (E008).
import test;
struct Config {
    retries: int,
    timeout: int
}

fn main(): int {
    mut cfg: Config;
    test::assert(cfg.retries == 0, "unreachable: this read must not compile");
    return 0;
}
