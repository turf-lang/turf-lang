// LEC-003: no double literal patterns in 2.0. Expected: E092.
struct P { x: double }
@test(compile_error, E092, "A `double` literal cannot be a pattern: exact equality on a `double` is almost never what you mean.")
fn rejects_pattern_double_literal(): void {
    mut p: P = P::default();
    compare p {
        matches P { x: 1.5 }: return 1; done
        otherwise: return 0;
    }
}
