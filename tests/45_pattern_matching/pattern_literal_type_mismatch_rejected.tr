// LEC-003: a literal pattern has the field's own type. Expected: E092.
struct P { s: string }
@test(compile_error, E092, "The field is a `string`, and this pattern is an `int`.")
fn rejects_pattern_literal_type_mismatch(): void {
    mut p: P = P::default();
    compare p {
        matches P { s: 3 }: return 1; done
        otherwise: return 0;
    }
}
