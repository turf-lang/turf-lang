// EXPECT-DIAG: E092
// EXPECT-DIAG: This pattern destructures a `Q`, and what it matches is a `P`.
// LEC-003: the pattern must name the struct it is matched against.
// Expected: E092.
struct P { x: int }
struct Q { x: int }
fn main(): int {
    mut p: P = P::default();
    compare p {
        matches Q { x }: return x; done
        otherwise: return 0;
    }
}
