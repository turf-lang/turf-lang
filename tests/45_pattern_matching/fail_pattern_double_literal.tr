// EXPECT-DIAG: E092
// EXPECT-DIAG: A `double` literal cannot be a pattern: exact equality on a `double` is almost never what you mean.
// LEC-003: no double literal patterns in 2.0. Expected: E092.
struct P { x: double }
fn main(): int {
    mut p: P = P::default();
    compare p {
        matches P { x: 1.5 }: return 1; done
        otherwise: return 0;
    }
}
