// LEC-003: a struct pattern needs a struct subject. Expected: E092.
struct P { x: int }
@test(compile_error, E092, "This is a struct pattern, and what it matches is an `int`, not a struct.")
fn rejects_struct_pattern_on_int(): void {
    mut n: int = 3;
    compare n {
        matches P { x }: return x; done
        otherwise: return 0;
    }
}
