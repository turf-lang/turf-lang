// LEC-003: a binding is scoped to its arm. Expected: E040.
struct P { x: int }
@test(compile_error, E040, "I cannot find anything named `x`")
fn rejects_binding_not_visible_outside_arm(): void {
    mut p: P = P::default();
    compare p {
        matches P { x }: return 1; done
        otherwise: return x;
    }
}
