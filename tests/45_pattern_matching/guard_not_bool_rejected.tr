// LEC-003: a guard is a bool condition. Expected: E092.
struct P { x: int }
@test(compile_error, E092, "A guard must be a `bool`, and I found an `int`.")
fn rejects_guard_not_bool(): void {
    mut p: P = P::default();
    compare p {
        matches P { x } if x + 1: return x; done
        otherwise: return 0;
    }
}
