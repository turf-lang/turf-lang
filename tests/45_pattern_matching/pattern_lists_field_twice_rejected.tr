// LEC-003: a field can be listed once. Expected: E092.
struct P { x: int, y: int }
@test(compile_error, E092, "the field `x` listed twice in this pattern")
fn rejects_pattern_lists_field_twice(): void {
    mut p: P = P::default();
    compare p {
        matches P { x: 0, x, .. }: return x; done
        otherwise: return 0;
    }
}
