// LEC-003: every field is listed or waved off with `..`. Expected: E092.
struct P { x: int, y: int }
@test(compile_error, E092, "This pattern does not mention the field `y` of `P`.")
fn rejects_pattern_missing_field_without_rest(): void {
    mut p: P = P::default();
    compare p {
        matches P { x }: return x; done
        otherwise: return 0;
    }
}
