// SEM-002 (FREEZE.md §6.2 row 3): the same representability check applies
// to 'int32', not just 'int' -- a literal that fits 'int' comfortably but
// exceeds int32's 32-bit signed range is still rejected, since it's
// acquiring type 'int32' here, not 'int'.
fn main(): int {
    mut x: int32 = 99999999999;
    return 0;
}
