// RUNTIME_ABORT_EXPECTED
// EXPECT-RUNTIME: runtime check: Integer overflow
// `int ** int` is computed with pow() on doubles and converted back to int;
// 3 ** 50 is past INT_MAX, so the conversion panics (F-NUM-3). It was a bare
// fptosi: INT_MIN at -O0, 4294967295 at -O2.
fn id(x: int): int {
    return x;
}

fn main(): int {
    mut b: int = id(3);
    b **= 50;
    io::printline(b);
    return 0;
}
