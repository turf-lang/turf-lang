// Regression (pre-existing behavior, unchanged by SEM-002): 'double -> int'
// is NOT one of the three implicit conversions (FREEZE.md §6.2 row 4) --
// needs an explicit 'to int' (which truncates toward zero). Confirmed
// still correct after this group's changes.
fn main(): int {
    mut x: int = 5.5;
    return 0;
}
