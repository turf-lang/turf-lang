// Regression (pre-existing behavior, unchanged by SEM-002): 'int -> int32'
// is NOT one of the three implicit conversions (FREEZE.md §6.2 row 4) --
// narrowing always needs an explicit 'to int32'. Confirmed still correct
// after this group's cast-legality move (Rule B1) and representability
// checks -- neither touches implicit-conversion rules at all.
fn main(): int {
    mut a: int = 5;
    mut b: int32 = a;
    return 0;
}
