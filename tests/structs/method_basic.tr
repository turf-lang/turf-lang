// Test: basic struct methods
struct User {
  age: int,
  name: string
}

// Method modifying struct fields
fn User.grow(): void {
  self.age = self.age + 1;
}

// Method taking arguments
fn User.rename(new_name: string): void {
  self.name = new_name;
}

fn main(): int {
  mutable u: User = User { age: 10, name: "Alice" };
  
  u.grow();
  io.printline(u.age);
  
  u.rename("Bob");
  io.printline(u.name);

  return 0;
}
