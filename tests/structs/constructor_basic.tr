// Test: basic constructor/factory function replacement
struct User {
  age: int,
  name: string
}

// Replaces the old User.init
fn create_user(starting_age: int): User {
  return User { age: starting_age, name: "Unknown User" };
}

fn main(): int {
  // Use the factory function
  mutable u: User = create_user(10);
  io.printline(u.age);
  io.printline(u.name);

  return 0;
}
