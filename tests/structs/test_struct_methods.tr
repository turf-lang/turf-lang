// Test: struct methods with returns and arguments
struct User {
  age: int,
  name: string
}

fn User.incrementAge(): int {
  self.age = self.age + 1;
  return self.age;
}

fn User.setAge(newAge: int): void {
  self.age = newAge;
}

fn main(): int {
  mutable u: User = User { age: 10, name: "Alice" };
  
  io.printline(u.age);
  io.printline(u.name);

  u.incrementAge();
  io.printline(u.age);

  u.setAge(25);
  io.printline(u.age);

  return 0;
}
