// Regression test: TYPE-002 S12a -- a generic free function that requests
// a new, ever-growing instantiation of itself must be rejected with
// GenericInstantiationDepthError (E079), not left to exhaust memory or
// hang the compiler.
//
// `wrap<T>` calls `wrap(&x)`, where `x: &T` -- each recursive call's
// argument is `&T`, one reference level deeper than the call it came
// from, so every instantiation this produces (wrap<&int>, wrap<&&int>,
// wrap<&&&int>, ...) is a genuinely DIFFERENT, never-repeating type
// tuple. InstantiationCache::find() (Monomorphize.h) therefore never
// returns a cache hit for it, and the worklist never bottoms out on its
// own -- Monomorphize::kMaxInstantiationDepth is what stops it.

fn<T> wrap(x: &T): int {
    return wrap(&x);
}

fn main(): int {
    mut v: int = 1;
    return wrap(&v);
}
