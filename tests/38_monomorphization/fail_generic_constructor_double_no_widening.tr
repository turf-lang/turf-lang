// EXPECT-DIAG: E056
// EXPECT-DIAG: Argument 1 is 'int', but building a 'Box<double>' needs 'double'
// A generic constructor's T comes from the declared type; the argument must
// already have that type, since it is not converted on the way in.
struct Box<T> {
    v: T
}

fn<T> Box.new(v: T): void {
    self.v = v;
}

fn main(): int {
    mut b: Box<double> = Box::new(1);
    return 0;
}
