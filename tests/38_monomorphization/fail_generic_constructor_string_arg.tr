// EXPECT-DIAG: E056
// EXPECT-DIAG: Argument 1 is an `int`, and building a `Box<string>` needs a `string` there.
// A generic constructor's T comes from the declared type; the argument must
// already have that type, since it is not converted on the way in.
struct Box<T> {
    v: T
}

fn<T> Box.new(v: T): void {
    self.v = v;
}

fn main(): int {
    mut b: Box<string> = Box::new(42);
    return 0;
}
