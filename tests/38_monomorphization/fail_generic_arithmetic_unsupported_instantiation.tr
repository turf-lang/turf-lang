// EXPECT-DIAG: E057
// EXPECT-DIAG: In this instantiation: I cannot use `+` on a `bool` and a `bool`.
// EXPECT-DIAG: immut s: bool = twice(true);
// `+` on `T` is checked for `T = bool`, at the call.

fn<T> twice(a: T): T {
    return a + a;
}

fn main(): int {
    immut s: bool = twice(true);
    return 0;
}
