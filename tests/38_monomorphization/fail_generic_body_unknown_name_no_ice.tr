// turf-fuzz #36: an unknown name in a generic function's body is reported
// once, as E040. The instantiation the call asks for cannot resolve either,
// for the same reason; that is not a compiler bug and is not called one.
// EXPECT-DIAG: E040
// EXPECT-NO-DIAG: compiler bug
// EXPECT-NO-DIAG: E011
fn<T, N: size> fill(v: T): T[N] {
    defer[N] = v;
}

fn main(): int {
    mut a: int[2] = fill(1);
    return 0;
}
