// tests/13_string_stdlib/16_dsa_longest_common_prefix.tr
// DSA: Longest Common Prefix (LCP) of an array of strings.
// Algorithm: use the first string as the candidate prefix, shrink it character
// by character until all strings start with it.
// Exercises: strings::starts_with, strings::substring, strings::length, string arrays.

import io;
import strings;

fn lcp(words: string[5], n: int): string {
    if n == 0 {
        return "";
    }
    mut prefix: string = words[0];
    mut i: int = 1;
    while i < n {
        // Shrink prefix until words[i] starts with it
        while strings::starts_with(words[i], prefix) == false {
            mut plen: int = strings::length(prefix);
            if plen == 0 {
                return "";
            }
            prefix = strings::substring(prefix, 0, plen - 1);
        }
        i = i + 1;
    }
    return prefix;
}

fn main(): int {
    mut w1: string[5] = ["flower", "flow", "flight", "", ""];
    assert(lcp(w1, 3) == "fl", "flower/flow/flight -> fl");

    mut w2: string[5] = ["dog", "racecar", "car", "", ""];
    assert(lcp(w2, 3) == "", "dog/racecar/car -> empty (no common prefix)");

    mut w3: string[5] = ["interview", "interact", "interpose", "interstate", "interior"];
    assert(lcp(w3, 5) == "inter", "inter* -> inter");

    mut w4: string[5] = ["abc", "abc", "abc", "", ""];
    assert(lcp(w4, 3) == "abc", "identical strings -> full string");

    mut w5: string[5] = ["a", "a", "a", "a", "a"];
    assert(lcp(w5, 5) == "a", "all same single char -> a");

    io::printline("16 PASS: DSA longest common prefix");
    return 0;
}
