// tests/13_string_stdlib/22_str_parse_double.tr
// Tests strings::parse_double -- success paths (integer-looking and real
// decimals, positive and negative, exponents) and every documented failure
// path.

import io;
import strings;

import test;
// See tests/13_string_stdlib/21_str_parse_int.tr's comment: a diverging
// `return` inside `recover as err run { ... }` returns from the ENCLOSING
// function, so this lives in its own helper rather than inline in main().
fn parseFailsWithInvalidDouble(s: string): bool {
    mut result: double = strings::parse_double(s) recover as err run {
        if err == strings::StringParseError::InvalidDouble {
            return true;
        }
        return false;
    };
    return false;
}

// parse_double validates the text, then converts it with `s to double`, so
// the result is the correctly rounded double: exactly the compiler's own
// value for that literal, compared with `==` below. (It used to sum digits
// in double arithmetic and could be off in the last bit, so this test once
// compared within an epsilon.)
fn assertExact(actual: double, expected: double, msg: string): void {
    test::assert(actual == expected, msg);
}

fn main(): int {
    // Success paths
    assertExact(strings::parse_double("3.14") recover produce -1.0, 3.14, "parse_double: '3.14' -> 3.14");
    assertExact(strings::parse_double("0.5") recover produce -1.0, 0.5, "parse_double: '0.5' -> 0.5");
    assertExact(strings::parse_double("42") recover produce -1.0, 42.0, "parse_double: integer-looking string");
    assertExact(strings::parse_double("-2.5") recover produce 999.0, -2.5, "parse_double: negative decimal");
    assertExact(strings::parse_double("0") recover produce -1.0, 0.0, "parse_double: '0' -> 0.0");
    assertExact(strings::parse_double("123.456") recover produce -1.0, 123.456, "parse_double: correctly rounded");
    assertExact(strings::parse_double(".5") recover produce -1.0, 0.5, "parse_double: no digit before '.'");
    assertExact(strings::parse_double("5.") recover produce -1.0, 5.0, "parse_double: no digit after '.'");

    // Exponents: e or E, an optional sign, digits (the forms JSON writes)
    assertExact(strings::parse_double("1e10") recover produce -1.0, 1e10, "parse_double: '1e10'");
    assertExact(strings::parse_double("2.5E-3") recover produce -1.0, 0.0025, "parse_double: 'E' and a negative exponent");
    assertExact(strings::parse_double("-1.5e+2") recover produce -1.0, -150.0, "parse_double: '+' exponent sign");
    test::assert((strings::parse_double("1e400") recover produce 0.0) > 1e308, "parse_double: past the double range is inf");
    test::assert_eq(strings::parse_double("1e") recover produce -1.0, -1.0, "parse_double: 'e' with no digits fails");
    test::assert_eq(strings::parse_double("1e+") recover produce -1.0, -1.0, "parse_double: a sign with no digits fails");
    test::assert_eq(strings::parse_double("e5") recover produce -1.0, -1.0, "parse_double: an exponent alone fails");

    // Failure paths
    test::assert_eq(strings::parse_double("") recover produce -1.0, -1.0, "parse_double: empty string fails");
    test::assert_eq(strings::parse_double("-") recover produce -1.0, -1.0, "parse_double: bare '-' fails");
    test::assert_eq(strings::parse_double(".") recover produce -1.0, -1.0, "parse_double: bare '.' fails");
    test::assert_eq(strings::parse_double("1.2.3") recover produce -1.0, -1.0, "parse_double: two decimal points fails");
    test::assert_eq(strings::parse_double("abc") recover produce -1.0, -1.0, "parse_double: all non-digit fails");
    test::assert_eq(strings::parse_double("1.5x") recover produce -1.0, -1.0, "parse_double: trailing garbage fails");
    // What strtod would take but parse_double does not.
    test::assert_eq(strings::parse_double("+1") recover produce -1.0, -1.0, "parse_double: a leading '+' fails");
    test::assert_eq(strings::parse_double(" 1") recover produce -1.0, -1.0, "parse_double: a leading space fails");
    test::assert_eq(strings::parse_double("inf") recover produce -1.0, -1.0, "parse_double: 'inf' fails");
    test::assert_eq(strings::parse_double("0x10") recover produce -1.0, -1.0, "parse_double: hex fails");

    // recover as err: distinguish the error variant
    test::assert(parseFailsWithInvalidDouble("nope"), "parse_double: recover as err sees InvalidDouble variant");

    io::printline("22 PASS: strings::parse_double");
    return 0;
}
