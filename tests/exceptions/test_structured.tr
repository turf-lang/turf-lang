fn int main() {
  try {
    int x = 10 / 0;
  } onError(err) {
    io.printline("Caught division error:");
    io.printline(err.message);
  }

  try {
    list<int> l;
    l.push(1);
    l.push(2);
    l.push(3);
    int y = l[5];
  } onError(err) {
    io.printline("Caught bounds error:");
    io.printline(err.message);
  }

  return 0;
}
