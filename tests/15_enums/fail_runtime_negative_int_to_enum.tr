// RUNTIME_ABORT_EXPECTED
// EXPECT-RUNTIME: Invalid int to enum conversion
// A negative run-time int is outside every enum's variant range too.
enum Color {
    Red,
    Green,
    Blue
}

fn id(x: int): int {
    return x;
}

fn main(): int {
    mut c: Color = id(-1) to Color;
    io::printline(c to int);
    return 0;
}
