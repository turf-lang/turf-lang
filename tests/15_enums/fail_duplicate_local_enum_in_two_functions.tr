// EXPECT-DIAG: E034
// EXPECT-DIAG: An enum named 'E' is already declared
// Two functions in one file each declaring a local `enum E` -- two
// declarations of one name (a type's identity is (module, name) with no
// function-level scope, FREEZE.md §6.11): E034 at the second, the same rule
// as for local structs (tests/06_structs/fail_duplicate_local_struct_in_two_functions.tr).

fn a(): int {
    enum E { A }
    return E::A to int;
}

fn b(): int {
    enum E { X, Y }
    return E::Y to int;
}

fn main(): int {
    return a() + b() - 1;
}
