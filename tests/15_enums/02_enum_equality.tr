// Test: Enum equality and inequality operators
import test;

enum Color { Red, Green, Blue }

fn main(): int {
    immut c1: Color = Color::Red;
    immut c2: Color = Color::Red;
    immut c3: Color = Color::Blue;

    test::assert(c1 == c2, "Red == Red");
    test::assert(c1 != c3, "Red != Blue");
    test::assert(c2 != c3, "Red != Blue");

    immut g: Color = Color::Green;
    test::assert(g == Color::Green, "Green == Green");
    test::assert(g != Color::Red, "Green != Red");
    return 0;
}
