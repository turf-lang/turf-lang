// Test (fail): Assigning a variant from one enum to a variable of another enum type
// Should fail with type mismatch error
enum Direction { North, East, South, West }
enum Color { Red, Green, Blue }

@test(compile_error, E066, "I cannot store a `Color` in `d`, which is a `Direction`.")
fn rejects_enum_cross_assign(): void {
    mut d: Direction = Color::Red;
}
