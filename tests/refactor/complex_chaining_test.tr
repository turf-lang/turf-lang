fn int get_index() {
    return 2
}

fn void dummy_func(int val) {
    io.printline(val)
}

fn int main() {
    int[5] arr = [10, 20, 30, 40, 50]

    // 1. Deep grouping (testing that postfix operators can attach to arbitrarily nested bases)
    io.printline(((((arr))))[1])

    // 2. Using a function call as an index (testing expression evaluation in postfix arguments)
    io.printline(arr[get_index()])

    // 3. Function call using a grouped base (testing postfix function calls)
    // We use an 'if' block to prevent the parser from attaching the '(' to the previous expression
    // INTERESTING!
    if true {
        (dummy_func)(100)
    } else {
        (dummy_func)(0)
    }

    // 4. Complex L-Value expression inside a loop
    int i = 0
    while i < 3 {
        if true {
            ((arr))[i] = ((arr))[i] * 2
        } else {
            ((arr))[i] = 0
        }
        i = i + 1
    }

    io.printline(arr[0])
    io.printline(arr[1])
    io.printline(arr[2])

    return 0
}
