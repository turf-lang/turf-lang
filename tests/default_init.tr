struct Point {
    int x,
    int y,
    string name,
    double z
}

fn int main() {
    int a;
    double b;
    bool c;
    string d;
    Point p = Point();

    io.printline(a)
    io.printline(b)
    io.printline(c)
    io.printline(d)
    io.printline(p.x)
    io.printline(p.y)
    io.printline(p.name)
    io.printline(p.z)

    return 0;
}
