// TRACKED BUG: Issue #1 (Parser Ambiguity: Struct Initialization in conditions)
// When the parser is fixed to disable struct initialization matching inside `if/while/for` condition expressions,
// this file should compile without throwing "Expected ':' after field name 'max_val' in struct initializer".

fn main(): int {
    mut a: int = 10;
    mut b: int = 20;
    mut max_val: int = 0;

    // Fails because `b {` is greedily matched as a struct initialization
    if a > b {
        max_val = a;
    } else {
        max_val = b;
    }
    
    return 0;
}
