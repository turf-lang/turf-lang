// TRACKED BUG: Issue #3 (TypeChecker strips array dimensions from variables)
// When the TypeChecker is fixed, this should compile without throwing "Cannot access field on non-struct type"

struct Inner {
    val: int
}

fn main(): int {
    mut arr: Inner[1] = [ Inner { val: 42 } ];
    
    // Fails because 'arr' is recorded as 'Inner', so 'arr[0]' strips it to an invalid type.
    arr[0].val = 100;
    
    assert(arr[0].val == 100, "L-value chained assignment failed");
    return 0;
}
