// F-11e: tests moved from fail_*.tr files, one function each; each `@test` names the
// error its body must be rejected with.

// A function with no type parameters takes none through UFCS either.

fn plain(x: int): int {
    return x;
}

@test(compile_error, E148, "`plain` is not generic, so it takes no type arguments, and 1 is written.")
fn rejects_ufcs_type_arguments_on_a_plain_function(): void {
    mut a: int = 3;
    io::printline(a.plain::<int>());
}

// Through UFCS as in a direct call: one type per type parameter.

fn<T> twice(x: T): T {
    return x;
}

@test(compile_error, E148, "`twice` takes 1 type argument, and 2 are written.")
fn rejects_ufcs_wrong_number_of_type_arguments(): void {
    mut a: int = 3;
    io::printline(a.twice::<int, int>());
}

// One type per type parameter, in order.

fn<T> identity(x: T): T {
    return x;
}

@test(compile_error, E148, "`identity` takes 1 type argument, and 2 are written.")
fn rejects_wrong_number_of_type_arguments(): void {
    immut a: int = identity::<int, int>(3);
}
