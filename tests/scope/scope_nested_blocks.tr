fn int main() {
    int x = 1
    io.printline(x)

    if x > 0 {
        int y = 2
        io.printline(y)

        if y > 0 {
            int z = 3
            io.printline(z)
        } else {
            io.printline(0)
        }
        io.printline(y)
    } else {
        io.printline(0)
    }

    io.printline(x)

    return 0
}
