// Regression test: List.find() (lib/std/collections/list.tr) -- linear
// search over an unsorted List<int> for the first element matching an
// arbitrary predicate. (Was the `list_find` free function until LEC-007
// removed that wrapper.)
import list::List;
import test;

fn is_even(x: int): bool {
    return x % 2 == 0;
}

fn is_negative(x: int): bool {
    return x < 0;
}

fn main(): int {
    mut l: List<int> = List::default();
    l.push(7);
    l.push(3);
    l.push(9);
    l.push(4);
    l.push(11);
    l.push(6);

    test::assert(l.find(is_even) == 3, "first even number is at index 3 (value 4)");
    test::assert(l.find(is_negative) == -1, "no negative numbers present, must return -1");

    return 0;
}
