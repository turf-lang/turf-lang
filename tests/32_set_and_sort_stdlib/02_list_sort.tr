// Regression test: list_sort() (lib/std/collections/list.tr), sorting a
// List<int> of unsorted values in place using a comparator function.
//
// Since STD-003, `list_sort` is a thin, DEPRECATED wrapper over the real
// generic `fn<T> List.sort(cmp: fn(T, T): int): void` method -- kept for
// one cycle so this exact call shape keeps working unchanged (see
// list.tr's own doc comment). New code should prefer `l.sort(cmp_int)`
// directly; see tests/38_monomorphization/27_generic_list_sort_and_search.tr
// for coverage of the generic method itself across multiple element types.
import list::List;
import list::list_sort;
import test;

fn cmp_int(a: int, b: int): int {
    return a - b;
}

fn main(): int {
    mut l: List<int> = List::default();
    l.push(5);
    l.push(1);
    l.push(4);
    l.push(2);
    l.push(8);
    l.push(3);
    l.push(9);

    list_sort(l, cmp_int);

    test::assert(l.length() == 7, "sort must not change the length");
    test::assert(l.pop() == 9, "");
    test::assert(l.pop() == 8, "");
    test::assert(l.pop() == 5, "");
    test::assert(l.pop() == 4, "");
    test::assert(l.pop() == 3, "");
    test::assert(l.pop() == 2, "");
    test::assert(l.pop() == 1, "");

    return 0;
}
