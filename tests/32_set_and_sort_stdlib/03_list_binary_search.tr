// Regression test: list_binary_search() (lib/std/collections/list.tr) --
// finding a present value in an already-sorted List<int>, and correctly
// returning -1 for an absent one.
//
// A free function taking a concrete `List<int>` -- see list_sort()'s doc
// comment in list.tr for why a generic `fn<T> List.binary_search(...)`
// method can't compile here.
import list::List;
import list::list_binary_search;
import test;

fn cmp_int(a: int, b: int): int {
    return a - b;
}

fn main(): int {
    mut l: List<int> = List::default();
    l.push(1);
    l.push(3);
    l.push(5);
    l.push(7);
    l.push(9);
    l.push(11);
    // l is already sorted ascending -- list_binary_search()'s precondition.

    test::assert(list_binary_search(l, 1, cmp_int) == 0, "find first element");
    test::assert(list_binary_search(l, 11, cmp_int) == 5, "find last element");
    test::assert(list_binary_search(l, 7, cmp_int) == 3, "find a middle element");
    test::assert(list_binary_search(l, 2, cmp_int) == -1, "absent value between elements returns -1");
    test::assert(list_binary_search(l, 100, cmp_int) == -1, "absent value past the end returns -1");
    test::assert(list_binary_search(l, -5, cmp_int) == -1, "absent value before the start returns -1");

    return 0;
}
