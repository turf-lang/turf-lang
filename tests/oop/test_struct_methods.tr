struct User {
    int age,
    string name
}

fn int User.incrementAge() {
    self.age = self.age + 1
    return self.age
}

fn void User.setAge(int newAge) {
    self.age = newAge
}

User u = User(10, "Alice")
printline(u.age)
printline(u.name)

u.incrementAge()
printline(u.age)

u.setAge(25)
printline(u.age)
