// tests/31_fs_and_path_stdlib/06_fs_mkdir_and_remove.tr
// Integration test for fs::mkdir/fs::is_dir/fs::remove_file/fs::remove_dir:
// actually creates a directory, confirms is_dir sees it, writes a file
// inside it via io::write_string, removes the file then the directory, and
// confirms both are gone afterward. Cleans up after itself either way so
// no junk is left behind in the repo.

import fs;
import io;
import test;

fn main(): int {
    immut dir_path: string = "tmp_fs_test_dir";
    immut file_path: string = fs::join(dir_path, "hello.txt");

    // Start from a clean slate in case a previous run left something behind
    // (remove_file/remove_dir on a path that doesn't exist just fail
    // harmlessly -- their return value is deliberately ignored here).
    fs::remove_file(file_path);
    fs::remove_dir(dir_path);
    test::assert(!fs::is_dir(dir_path), "setup: directory does not exist yet");

    immut created: bool = fs::mkdir(dir_path);
    test::assert(created, "mkdir: reports success");
    test::assert(fs::is_dir(dir_path), "is_dir: sees the freshly created directory");

    immut wrote: bool = io::write_string(file_path, "hello from fs test");
    test::assert(wrote, "write_string: writes a file inside the new directory");
    test::assert(io::exists(file_path), "io::exists: sees the file just written");
    test::assert(!fs::is_dir(file_path), "is_dir: a plain file is not a directory");

    immut removed_file: bool = fs::remove_file(file_path);
    test::assert(removed_file, "remove_file: reports success");
    test::assert(!io::exists(file_path), "io::exists: file is gone after remove_file");

    immut removed_dir: bool = fs::remove_dir(dir_path);
    test::assert(removed_dir, "remove_dir: reports success");
    test::assert(!fs::is_dir(dir_path), "is_dir: directory is gone after remove_dir");

    return 0;
}
