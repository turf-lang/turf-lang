// Test: Stress test for structs and self-referential structures
//
// This test exercises deep nesting, chaining field access through pointers,
// and passing structs by value vs pointer in complex nested arrangements.

import test;

struct Point {
    x: int,
    y: int
}

fn Point.new(x: int, y: int): void {
    self.x = x;
    self.y = y;
}

struct Rect {
    top_left: Point,
    bottom_right: Point
}

fn Rect.new(top_left: Point, bottom_right: Point): void {
    self.top_left = top_left;
    self.bottom_right = bottom_right;
}

// A tree-like self-referential struct that also holds a pointer to another struct
struct GraphNode {
    id: int,
    left: GraphNode*,
    right: GraphNode*,
    data: Rect*
}

fn GraphNode.new(id: int, left: GraphNode*, right: GraphNode*, data: Rect*): void {
    self.id = id;
    self.left = left;
    self.right = right;
    self.data = data;
}

fn area(r: Rect): int {
    mut width: int = r.bottom_right.x - r.top_left.x;
    mut height: int = r.bottom_right.y - r.top_left.y;
    return width * height;
}

// Recursive function to sum all IDs in the graph
fn sum_graph(node: GraphNode*): int {
    if node == null {
        return 0;
    }
    return node.id + sum_graph(node.left) + sum_graph(node.right);
}

fn main(): int {
    mut p1: Point = Point::new(0, 0);
    mut p2: Point = Point::new(10, 5);
    mut r: Rect = Rect::new(p1, p2);

    test::assert(area(r) == 50, "FAIL: Rect area calculation");

    mut root: GraphNode = GraphNode::new(100, null, null, &r);
    mut left: GraphNode = GraphNode::new(50, null, null, null);
    mut right: GraphNode = GraphNode::new(150, null, null, null);
    
    root.left = &left;
    root.right = &right;
    
    // Test recursive structure traversal
    test::assert(sum_graph(&root) == 300, "FAIL: Graph tree sum");
    
    // Test deep field access through a mix of direct fields and pointer fields
    // root (GraphNode) -> data (Rect*) -> bottom_right (Point) -> x (int)
    test::assert(root.data.bottom_right.x == 10, "FAIL: Deep nested field access x");
    test::assert(root.data.bottom_right.y == 5, "FAIL: Deep nested field access y");

    // Modify deep field and verify
    root.data.bottom_right.x = 20;
    test::assert(r.bottom_right.x == 20, "FAIL: Mutation through pointer didn't persist");
    test::assert(area(r) == 100, "FAIL: Area didn't update after deep mutation");

    return 0;
}
