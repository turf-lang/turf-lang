struct Row {
    val: int
}

struct Matrix {
    row: Row
}

fn get_matrix(): Matrix {
    mut matrix: Matrix = Matrix { row: Row { val: 10 } };
    return matrix;
}

fn main(): int {
    mut mat: Matrix = get_matrix();
    
    // Test parsing Type System assignment and return types with nested structs
    assert(mat.row.val == 10, "Type System parsing failed");
    
    return 0;
}
