// Regression test (was DISCOVERED_ISSUES.md #16, "Missing Static
// Constructors"): a `fn StructName.init(args...)` function is picked up
// automatically by StructInitExprAST::codegen() when brace-init supplies
// arguments matching its parameter types, letting user code run side
// effects (validation, derived-field computation, etc.) during
// construction instead of just doing a flat field-by-field copy.
//
// This entire mechanism (StructInitExprAST::codegen()'s "Try to find a
// user-defined constructor function" block, ~80 lines in src/Codegen.cpp)
// had ZERO test coverage anywhere in tests/ before this file, discovered
// while re-verifying issue #16 during a code review pass. Confirmed working
// via direct testing before this file was added.

struct Point {
    x: int,
    y: int
}

// Constructor that transforms its inputs rather than storing them verbatim.
fn Point.init(x: int, y: int): void {
    self.x = x * 10;
    self.y = y * 10;
}

struct Fraction {
    num: int,
    den: int
}

// A constructor that validates/normalizes -- rejects a zero denominator by
// substituting a sentinel, and always stores a positive denominator.
fn Fraction.init(n: int, d: int): void {
    if (d == 0) {
        self.num = 0;
        self.den = 1;
    } else if (d < 0) {
        self.num = 0 - n;
        self.den = 0 - d;
    } else {
        self.num = n;
        self.den = d;
    }
}

// A struct with NO custom constructor -- must still fall back to plain
// field-by-field initialization, unaffected by the mangled-name lookup
// mechanism finding no match.
struct Plain {
    a: int,
    b: int
}

fn main(): int {
    // Constructor transforms inputs (x*10, y*10).
    mut p: Point = Point { x: 1, y: 2 };
    assert(p.x == 10, "");
    assert(p.y == 20, "");

    // Constructor normalizes a negative denominator. NOTE: brace-init field
    // names must match the STRUCT's declared field names (num/den), not the
    // constructor's parameter names (n/d) -- the constructor's own
    // parameter names are irrelevant to caller syntax; values are matched
    // by field name, then passed positionally in field-declaration order.
    mut f: Fraction = Fraction { num: 3, den: -4 };
    assert(f.num == -3, "");
    assert(f.den == 4, "");

    // Constructor substitutes a sentinel for a zero denominator.
    mut bad: Fraction = Fraction { num: 5, den: 0 };
    assert(bad.num == 0, "");
    assert(bad.den == 1, "");

    // No constructor defined for Plain -- plain field-by-field init still
    // works, unaffected by the constructor-lookup mechanism.
    mut pl: Plain = Plain { a: 7, b: 8 };
    assert(pl.a == 7, "");
    assert(pl.b == 8, "");

    return 0;
}
