// FAILING TEST — fail_01: Method self-mutation does not persist to caller scope
//
// Expected behavior (should work in the future):
//   After n.scale(3), n.val should be 60 (was 20).
//
// Actual behavior (current compiler):
//   n.val stays 20 — the mutation to self.val inside Node.scale() is
//   visible only within the method body. The callee receives a copy of the
//   Node struct rather than a true pointer-to-self, so writes to self.val
//   are lost on return.
//
// Root cause:
//   Struct methods are compiled as free functions that receive 'self' as a
//   by-value struct argument. The codegen for method dispatch passes the
//   struct value (not a pointer to the caller's alloca), so stores to
//   self.field inside the method never reach the caller's memory.
//
// Fix needed:
//   When generating a method call, pass &(caller_alloca) as the self
//   argument (i.e. a pointer to the stack slot), and compile the method
//   body to receive self as a pointer type, so GEP + store writes through.

struct Node {
    val: int,
    next: Node*
}

fn Node.scale(factor: int): void {
    self.val = self.val * factor;
}

fn main(): int {
    mut n: Node = Node { val: 20, next: null };
    n.scale(3);

    // BUG: n.val is still 20 here — the assert fires at runtime.
    assert(n.val == 60, "FAIL: self.val mutation not visible after method call");

    return 0;
}
