// EXPECT-DIAG: E060
// EXPECT-FIX: replace 'immut' with 'mut'
// EXPECT-DIAG: You can't change the value of 'c' because it's immutable
// Regression test (LEC-006 follow-up): the scan recursed through blocks, `if`,
// `while` and `for` but not `compare`, so a mutation inside an arm was missed.
// Expected: ImmutableAssignmentError on `c`.
struct Counter {
    val: int
}

fn Counter.reset(): void {
    compare self.val {
        matches 0: self.val = 5; done
        otherwise: self.val = 6;
    }
}

fn main(): int {
    immut c: Counter = Counter::default();
    c.reset();
    return 0;
}
