// EXPECT-DIAG: E049
// EXPECT-DIAG: Not definitely assigned on every path: y
// Regression test for ConstructorFieldAssignmentPass: a field never
// assigned anywhere in the constructor body at all -- the simplest possible
// case, must still raise IncompleteConstructorError naming 'y' (not crash,
// not silently leave it uninitialized garbage).

struct Point {
    x: int,
    y: int
}

fn Point.new(x: int): void {
    self.x = x;
}

fn main(): int {
    mut p: Point = Point::new(1);
    return 0;
}
