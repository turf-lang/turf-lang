struct User {
  age: int,
  name: string
}

fn User.new(age: int, name: string): void {
  self.age = age;
  self.name = name;
}

fn main(): int {
  mut u: User = User::new(10, "Alice");
  
  assert(u.age == 10, "");
    // Verify basic int property

  u.age = 25;
  assert(u.age == 25, "");

  return 0;
}
