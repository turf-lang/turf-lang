// Test: Linked list traversal and summation
//
// This test verifies that we can create a linked list using self-referential
// pointers, and use standard loops (`while`) to traverse the list and compute
// values, simulating real-world linked list operations.

struct Node {
    val: int,
    next: Node*
}

// Computes the sum of all elements in the linked list
fn sum_list(head: Node*): int {
    mut current: Node* = head;
    mut sum: int = 0;
    while current != null {
        sum = sum + current.val;
        current = current.next;
    }
    return sum;
}

// Returns the length of the list
fn list_length(head: Node*): int {
    mut current: Node* = head;
    mut len: int = 0;
    while current != null {
        len = len + 1;
        current = current.next;
    }
    return len;
}

fn main(): int {
    // 1. Create a bunch of stack-allocated nodes
    mut n1: Node = Node { val: 10, next: null };
    mut n2: Node = Node { val: 20, next: null };
    mut n3: Node = Node { val: 30, next: null };
    mut n4: Node = Node { val: 40, next: null };
    mut n5: Node = Node { val: 50, next: null };

    // 2. Link them up using the address-of operator
    n1.next = &n2;
    n2.next = &n3;
    n3.next = &n4;
    n4.next = &n5;

    // 3. Test traversal sum
    assert(sum_list(&n1) == 150, "FAIL: sum_list should be 150");

    // 4. Test length
    assert(list_length(&n1) == 5, "FAIL: list_length should be 5");

    // 5. Test sub-list traversal
    assert(sum_list(&n3) == 120, "FAIL: sub-list sum should be 120");
    assert(list_length(&n3) == 3, "FAIL: sub-list len should be 3");

    // 6. Mutate list and verify changes
    n3.val = 100;
    assert(sum_list(&n1) == 220, "FAIL: sum_list after mutation");

    return 0;
}
