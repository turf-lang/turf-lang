// A struct method returns `self` BY VALUE (`fn Node.get_self(): Node`, not
// just `: Node*`) by copying it out: `return self to Node;`. `self` is the
// receiver's address (typed `Node*`), and a value leaves a reference only
// through an explicit `to`, so the copy is visible where it happens. The
// returned value is a copy, not an alias, and it chains like any value.
// Method-return-by-pointer for chaining is
// tests/06_structs/23_self_pointer_chaining.tr.

import test;

struct Node {
    val: int
}

fn Node.new(val: int): void {
    self.val = val;
}

fn Node.get_self(): Node {
    return self to Node;
}

fn main(): int {
    mut n: Node = Node::new(42);

    // Chaining method calls on a returned-by-value struct instance.
    test::assert(n.get_self().get_self().val == 42, "");

    // The returned value is a genuine by-value COPY, not an alias: mutating
    // the original afterward must not affect a variable holding the copy.
    mut copy: Node = n.get_self();
    test::assert(copy.val == 42, "");
    n.val = 999;
    test::assert(copy.val == 42, "");
    test::assert(n.val == 999, "");

    return 0;
}
