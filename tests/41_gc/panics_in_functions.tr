// F-11e: tests moved from fail_*.tr files that abort at run time, one function each;
// each `@test(panic, ...)` names the text its panic prints.

import mem;
import strings;

// tests/41_gc/fail_free_gc_pointer.tr
// MEM-002's own "Breaking changes" entry (docs/archive/ARCHITECTURE_OVERHAUL.md
// §8): "Programs that mem::free something they got from strings::* or a
// collection now free GC memory -- that must become a diagnosable runtime
// error." Compiles fine (mem::free(p: void*) accepts any pointer-shaped
// value, including a string cast to void* -- there is nothing for the
// TYPE CHECKER to reject here, the mistake is a HEAP-IDENTITY one, only
// knowable at runtime against the collector's own block table), then
// aborts the moment it actually runs, naming the cross-heap mistake
// instead of silently corrupting mem::free's own manual-heap bookkeeping
// (or, pre-MEM-002, doing nothing detectable at all -- this exact class of
// bug was completely undiagnosed before this group, per MEM-001's own
// "Must NOT reinterpret": "the two heaps do not merge" was a rule with no
// enforcement until this group's block table existed).

@test(panic, "cross-heap free")
fn panics_free_gc_pointer(): void {
    mut s: string = strings::repeat("z", 10);
    unsafe {
        mem::free(s to void*);
    }
}

// tests/41_gc/fail_mem_unroot_unpinned.tr
// OVH-010 (docs/planning/OVERHAUL_REMAINING_WORK.md): mem::unroot()'s own
// required behaviour -- "unroot of an unpinned object panics with a named
// message." Compiles fine (mem::unroot(p: void*) accepts any
// pointer-shaped value; there is nothing for the TYPE CHECKER to reject
// here), then aborts the moment it actually runs, naming the mistake
// instead of silently doing nothing or corrupting the pin table -- the
// same "diagnosable runtime error, not undefined behaviour" shape MEM-002
// already established for mem::free()'s cross-heap check
// (fail_free_gc_pointer.tr, this same directory).
//
// `s` genuinely IS a GC-heap pointer (turf_rt_pin/unpin's no-op case is
// reserved for a `p` that is not a GC pointer at all -- see
// mem::root()/mem::unroot()'s own doc comments in lib/std/mem/mem.tr) --
// it was simply never mem::root()'d, so the pin table has no outstanding
// pin to release.

@test(panic, "unpin of unpinned object")
fn panics_mem_unroot_unpinned(): void {
    mut s: string = strings::repeat("q", 4);
    unsafe {
        mem::unroot(s to void*);
    }
}
