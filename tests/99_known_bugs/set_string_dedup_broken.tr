// KNOWN BUG, NOT A LIVE REGRESSION -- excluded from scripts/test_runner.sh
// (see AGENTS.md's note on this directory). Tracks an accepted, deferred
// compiler limitation: Set<T>.indexOf()'s `self.items[i] == item` compares
// by raw pointer identity for T = string, not content, because a generic
// method's body is type-checked/codegenned exactly ONCE, shared across
// every instantiation -- `self.items[i]`/`item` never carry the concrete
// type `string` for operator-overload resolution to dispatch
// strings.tr's real `operator==(string, string)` through. See set.tr's
// own Set.indexOf() doc comment and docs/planning/LIMITATIONS.md for the
// full mechanism, and map.tr's Map.indexOf() doc comment for the
// identical gap on Map<K, V>.
//
// IMPORTANT: the duplicate key below is built at RUNTIME via
// strings::trim(), not written as a second occurrence of the same string
// literal. Two identical string LITERALS in one source file are not a
// reliable repro of this bug -- the linker merges identical read-only
// string constants into one address, so two literal "hello"s can end up
// pointer-equal by sheer coincidence, making a raw pointer-identity
// comparison accidentally "work" and masking the real bug. A duplicate
// built from a genuinely separate allocation (trim/substring/concat/
// anything parsed from input) does not share that coincidence and
// reliably reproduces the broken dedup.
//
// This file exists so the bug stays reproducible and visible in the tree
// instead of being silently forgotten. DO NOT "fix" this by changing the
// assertion below to match the buggy behavior and moving it into tests/
// proper -- that would just be asserting the bug is correct.

import io;
import set::Set;
import strings;

fn main(): int {
    mut s: Set<string> = Set::default();
    s.add("hello");
    s.add("world");
    immut dup: string = strings::trim(" hello "); // content-equal to "hello", different allocation
    s.add(dup); // should be a no-op (duplicate) -- currently isn't

    // This is what SHOULD hold once Set<string> dedup is fixed:
    //   assert(s.length() == 2, "duplicate string add should be a no-op");
    // What it actually does today:
    if s.length() == 2 {
        io::printline("Set<string> dedup is FIXED -- update this test, set.tr, map.tr, and docs/planning/LIMITATIONS.md");
        return 1; // fail loudly so a real fix can't go unnoticed here
    }

    io::printline("known bug still present: Set<string> dedup broken (length == " + (s.length() to string) + ", expected 2)");
    return 0;
}
