fn int main() {
    int a = 10
    int b = 20

    int max_val = if a > b then a else b
    io.printline(max_val)

    int c = 5
    if c > 0 {
        io.printline("positive")
    } else {
        io.printline("non-positive")
    }

    int d = 15
    if d > 20 {
        io.printline("big")
    } else {
        if d > 10 {
            io.printline("medium")
        } else {
            io.printline("small")
        }
    }

    int e = 7
    if e > 5 {
        io.printline("above five")
    }

    return 0
}
