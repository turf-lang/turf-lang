fn int main() {
    bool a = true && false
    bool b = true || false
    bool c = 5 > 3 && 2 < 4
    bool d = 5 >= 5 || 3 <= 2
    bool e = 5 == 5
    bool f = 5 != 3

    io.printline(a)
    io.printline(b)
    io.printline(c)
    io.printline(d)
    io.printline(e)
    io.printline(f)

    return 0
}
