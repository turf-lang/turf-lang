fn int main() {
    int a = 5 + 3
    io.printline(a)

    int b = 10 - 7
    io.printline(b)

    int c = 6 * 7
    io.printline(c)

    int d = 100 / 4
    io.printline(d)

    int e = 17 % 5
    io.printline(e)

    double f = 2.0 ^ 3.0
    io.printline(f)

    int g = -10
    io.printline(g)

    int h = 2 + 3 * 4
    io.printline(h)

    int i = (2 + 3) * 4
    io.printline(i)

    double j = 5 + 2.5
    io.printline(j)

    return 0
}
