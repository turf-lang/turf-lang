// Test: Bitwise OR operator
// 5 | 3 == 7  (0b101 | 0b011 = 0b111)

fn main(): int {
    mut a: int = 5 | 3;
    assert(a == 7, "5 | 3 should equal 7");

    // Additional OR tests
    mut b: int = 8 | 4;     // 1000 | 0100 = 1100 = 12
    assert(b == 12, "8 | 4 should equal 12");

    mut c: int = 0 | 255;
    assert(c == 255, "0 | 255 should equal 255");

    mut d: int = 255 | 255;
    assert(d == 255, "255 | 255 should equal 255");

    mut e: int = 0 | 0;
    assert(e == 0, "0 | 0 should equal 0");

    // OR with negative numbers
    mut f: int = -1 | 5;   // all-ones | anything = all-ones = -1
    assert(f == -1, "-1 | 5 should equal -1");

    return 0;
}
