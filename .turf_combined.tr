// std/math.tr

@intrinsic("llvm.pow.f64")
fn double pow(double base, double exp)

@intrinsic("llvm.fabs.f64")
fn double abs(double val)

@intrinsic("llvm.sqrt.f64")
fn double sqrt(double val)

@intrinsic("llvm.sin.f64")
fn double sin(double val)

@intrinsic("llvm.cos.f64")
fn double cos(double val)

@intrinsic("llvm.floor.f64")
fn double floor(double val)

@intrinsic("llvm.ceil.f64")
fn double ceil(double val)

@intrinsic("llvm.round.f64")
fn double round(double val)

struct list_int {
    int* data,
    int len,
    int capacity
}

fn void list_int.push(int val) {
    if self.capacity == 0 {
        self.capacity = 4;
        self.data = malloc(sizeof(int) * self.capacity);
    } elseif self.len == self.capacity {
        self.capacity = self.capacity * 2;
        self.data = realloc(self.data, sizeof(int) * self.capacity);
    }
    
    self.data[self.len] = val;
    self.len = self.len + 1;
}

fn int list_int.get(int index) {
    if index < 0 { return 0; }
    if index >= self.len { return 0; }
    return self.data[index];
}

fn int list_int.pop() {
    if self.len == 0 { return 0; }
    self.len = self.len - 1;
    return self.data[self.len];
}

fn void list_int.free_memory() {
    free(self.data);
    self.len = 0;
    self.capacity = 0;
}

