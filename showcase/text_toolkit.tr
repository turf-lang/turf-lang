// A small text-analysis program: takes an in-memory list of "lines",
// reports line/word counts and the distribution of word lengths, and
// times the analysis. Exercises, in one realistic program: strings::split/
// pad_right, fs's pure path-string helpers, collections::Set<int>,
// List.sort/List.find (generic List<T> methods taking a comparator /
// predicate function), and time's CPU-time measurement.
//
// Deliberately does NOT use io::read_to_string/read_lines/write_string --
// a real, unresolved heap-corruption bug was found in that combination
// while building this file (io::write_string + io::read_to_string or
// read_lines, followed by essentially any further string allocation,
// corrupts the heap and crashes on a LATER, unrelated malloc call). Not
// fixed yet; tracked separately. This program builds its "file contents"
// as an in-memory List<string> instead, which sidesteps it entirely.
//
// List<T> only exposes push/pop/length as its safe public API (no
// random-access get/set) -- every list below is consumed by popping
// until empty, this stdlib's own idiom for "iterate everything once".
//
// Run it:
//   turf showcase/text_toolkit.tr -o text_toolkit
//   ./text_toolkit

import io;
import strings;
import fs;
import list::List;
import set::Set;
import time;

fn compare_lengths(a: int, b: int): int {
    return a - b;
}

fn is_long_word(len: int): bool {
    return len >= 7;
}

fn main(): int {
    immut sample_name: string = "notes.txt";
    io::print("Analyzing ");
    io::print(fs::basename(sample_name));
    io::print(" (a ");
    io::print(fs::extension(sample_name));
    io::printline(" file):");

    immut clock_start: int = time::clock_ticks();

    mut lines: List<string> = List::default();
    lines.push("Turf compiles directly to native code");
    lines.push("Turf has structs enums generics and pointers");
    lines.push("The standard library now has JSON time and random");

    immut line_count: int = lines.length();
    io::print("  lines: ");
    io::printline(line_count to string);

    mut distinct_lengths: Set<int> = Set::default();
    mut word_lengths: List<int> = List::default();
    mut word_count: int = 0;

    while lines.length() > 0 {
        immut line: string = lines.pop();
        mut words: List<string> = strings::split(line, " ");
        while words.length() > 0 {
            immut word: string = words.pop();
            immut len: int = strings::length(word);
            distinct_lengths.add(len);
            word_lengths.push(len);
            word_count = word_count + 1;
        }
    }

    io::print("  words: ");
    io::printline(word_count to string);
    io::print("  distinct word lengths: ");
    io::printline(distinct_lengths.length() to string);

    immut found_long_word: bool = word_lengths.find(is_long_word) >= 0;
    if found_long_word {
        io::printline("  found a word at least 7 characters long.");
    }

    // Sort word lengths ascending, then drain (pop takes the last/largest
    // element first, so this naturally prints longest-to-shortest).
    word_lengths.sort(compare_lengths);
    io::print("  longest word length: ");
    io::printline(word_lengths.pop() to string);

    mut shortest: int = 0;
    while word_lengths.length() > 0 {
        shortest = word_lengths.pop();
    }
    io::print("  shortest word length: ");
    io::printline(shortest to string);

    // A small aligned report, using pad_right for column alignment.
    io::printline("");
    io::printline(strings::pad_right("metric", 24, ' ') + "value");
    io::printline(strings::pad_right("lines", 24, ' ') + (line_count to string));
    io::printline(strings::pad_right("words", 24, ' ') + (word_count to string));
    io::printline(strings::pad_right("distinct word lengths", 24, ' ') + (distinct_lengths.length() to string));

    immut elapsed_ms: int = time::elapsed_ms(clock_start);
    io::print("Analysis took ");
    io::print(elapsed_ms to string);
    io::printline("ms of CPU time.");

    return 0;
}
