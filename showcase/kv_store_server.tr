// A tiny in-memory key-value store, served over TCP -- a miniature
// Redis-shaped service written entirely in Turf. Combines three separate
// stdlib pieces (net, list, strings) the way a real small service would:
// state held in a generic collection, a hand-rolled text protocol parsed
// with string primitives, network I/O via the net module. No `extern fn`
// anywhere in this file.
//
// Protocol: one command per connection (connect, send one line, get one
// line back, connection closes) -- kept simple deliberately; see
// showcase/http_server.tr for the same "process an accepted connection"
// shape applied to HTTP instead.
//   SET <key> <value>   -> "OK"
//   GET <key>           -> the value, or "NOT_FOUND"
//
// Run it:
//   turf showcase/kv_store_server.tr -o kv_store_server
//   ./kv_store_server &
//   turf showcase/kv_store_client.tr -o kv_store_client
//   ./kv_store_client SET name Turf
//   ./kv_store_client GET name
//
// One thing worth knowing if you're using this file as a reference for
// your own generic-collection-of-structs code:
//
// The per-connection handling is inlined directly in main()'s accept loop
// instead of factored into its own `handle(conn, store)` function. Passing
// `store: List<Entry>` to a helper function would pass the LIST STRUCT
// itself by value, so a `.push()` inside that helper (which can reallocate
// the list's backing buffer and update its own `len`/`cap`/`data` fields)
// would only mutate the helper's own copy -- the very next connection
// would see the store exactly as it was before that push, silently losing
// every write. Confirmed live while first writing this file with a
// `handle()` helper. Keeping the mutation in the same scope as the `mut
// store` declaration sidesteps the whole problem. (`&store` -- the safe-
// reference operator -- doesn't fix this either: `.push()` needs a
// genuinely mutable receiver to persist a reallocation, which this
// language's method-call ABI already gives `self` for an ordinary by-value
// struct parameter passed to a method; the constraint here is about a
// HELPER FUNCTION's own by-value parameter losing later mutations, an
// unrelated shape.)
//
// `store` is `List<Entry>` **by value**, not `List<Entry*>` (OVH-002,
// `docs/planning/OVERHAUL_REMAINING_WORK.md`) -- an earlier version of
// this file individually heap-boxed each `Entry` with `mem::alloc(16)`,
// under the same stale "structs over 8 bytes can't go in a generic
// collection by value" belief `lib/std/json/json.tr`'s own OVH-002 comment
// describes and corrects (monomorphization made it false; the box was
// also a live GC-safety gap, since each boxed Entry's `key`/`value`
// GC-heap string pointers lived only inside untraced manual memory,
// F-MEM-3). No `unsafe { }` is needed anywhere in this file any more
// either: `store.data[idx]` now yields an `Entry` by value directly, so
// `.key`/`.value` field access on it is ordinary struct field access, not
// a dereference through a raw `Entry*` base.

import io;
import net;
import strings;
import list::List;

struct Entry {
    key: string,
    value: string
}

// List<T>'s own public `data`/`len` fields (see lib/std/list.tr) give
// direct indexed access -- List.push()/pop()/length() alone would only
// support stack-shaped access, not the "find by key" scan a KV store
// actually needs. There's no Map<K,V> in the standard library yet (see
// docs/planning/STDLIB_ROADMAP.md) -- this linear scan is the honest
// current alternative for a small store like this one.
fn findIndex(store: List<Entry>, key: string): int {
    mut i: int = 0;
    while i < store.length() {
        if store.data[i].key == key {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn main(): int {
    mut store: List<Entry> = List::default();
    mut server: net::TcpListener = net::TcpListener::bind(8181) recover run {
        io::printline("Could not start the store -- is port 8181 already in use?");
        return 1;
    };
    io::printline("Turf key-value store listening on port 8181...");

    mut requestCount: int = 0;
    while requestCount < 1000 {
        // A single bad accept() shouldn't bring the whole store down --
        // log it and keep serving instead of aborting.
        mut conn: net::TcpConnection = server.accept() recover run {
            io::printline("accept() failed, skipping.");
            continue;
        };
        immut line: string = strings::trim(conn.read(4096));

        immut firstSpace: int = strings::index_of(line, " ");
        if firstSpace < 0 {
            conn.write("ERROR malformed command\n");
        } else {
            immut cmd: string = strings::substring(line, 0, firstSpace);
            immut rest: string = strings::substring(line, firstSpace + 1, strings::length(line));

            if cmd == "GET" {
                immut idx: int = findIndex(store, rest);
                if idx >= 0 {
                    conn.write(store.data[idx].value + "\n");
                } else {
                    conn.write("NOT_FOUND\n");
                }
            } elseif cmd == "SET" {
                immut secondSpace: int = strings::index_of(rest, " ");
                if secondSpace < 0 {
                    conn.write("ERROR: SET needs a key and a value\n");
                } else {
                    immut key: string = strings::substring(rest, 0, secondSpace);
                    immut value: string = strings::substring(rest, secondSpace + 1, strings::length(rest));
                    immut idx: int = findIndex(store, key);
                    if idx >= 0 {
                        store.data[idx].value = value;
                    } else {
                        mut e: Entry = Entry::default();
                        e.key = key;
                        e.value = value;
                        store.push(e);
                    }
                    conn.write("OK\n");
                }
            } else {
                conn.write("ERROR: unknown command '" + cmd + "'\n");
            }
        }

        conn.close();
        requestCount = requestCount + 1;
    }

    server.close();
    io::printline("Handled 1000 requests, shutting down.");
    return 0;
}
