// A client for showcase/kv_store_server.tr. Sends one hardcoded SET
// followed by one hardcoded GET over two separate connections (matching
// the server's one-command-per-connection protocol), printing both
// responses -- a self-contained demonstration that doesn't need any CLI
// argument handling (there's no argv access in the standard library yet,
// see docs/planning/STDLIB_ROADMAP.md's `os` module entry).
//
// Run it (after starting showcase/kv_store_server.tr):
//   turf showcase/kv_store_client.tr -o kv_store_client
//   ./kv_store_client

import io;
import net;
import strings; // string '+' is an operator overload now, not a builtin

fn main(): int {
    mut setConn: net::TcpConnection = net::TcpConnection::connect(127, 0, 0, 1, 8181) recover as err run {
        if err == net::NetworkError::ConnectionRefused {
            io::printline("Connection refused -- is showcase/kv_store_server.tr running on port 8181?");
        } else {
            io::printline("Failed to connect (socket() error).");
        }
        return 1;
    };
    defer setConn.close();
    setConn.write("SET language Turf\n");
    io::printline("SET response: " + setConn.read(1024));

    mut getConn: net::TcpConnection = net::TcpConnection::connect(127, 0, 0, 1, 8181) recover run {
        io::printline("Failed to connect for GET.");
        return 1;
    };
    defer getConn.close();
    getConn.write("GET language\n");
    io::printline("GET response: " + getConn.read(1024));

    mut missConn: net::TcpConnection = net::TcpConnection::connect(127, 0, 0, 1, 8181) recover run {
        io::printline("Failed to connect for GET (miss).");
        return 1;
    };
    defer missConn.close();
    missConn.write("GET nonexistent\n");
    io::printline("GET (miss) response: " + missConn.read(1024));

    return 0;
}
