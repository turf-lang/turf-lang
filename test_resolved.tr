// test_resolved.tr  — Issue #5 visual demonstration
// Exercises every node type that gets a ResolvedSymbol attached:
//   VariableExprAST, VarDeclExprAST, ForExprAST, ArrayDeclExprAST
//
// Run with:  ./build/turf test_resolved.tr --dump-resolved

fn int main() {
    // 1. VarDeclExprAST  →  ResolvedSymbol should be attached
    int x = 10;
    int y = 20;
    double ratio = 3.14;
    bool flag = true;

    // 2. VariableExprAST  →  ResolvedSymbol attached (uses of x, y, ratio)
    int sum = x + y;
    double scaled = ratio + 1.0;

    // 3. ArrayDeclExprAST  →  ResolvedSymbol attached
    int[5] nums = [1, 2, 3, 4, 5];

    // 4. ForExprAST  →  ResolvedLoopVar attached for induction variable "i"
    int total = 0;
    for i in 0..5 step i++ {
        total = total + i;
    }

    return total;
}
