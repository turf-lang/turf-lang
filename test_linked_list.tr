// test_linked_list.tr — Issue #18: Two-Pass Resolver self-referential struct test.
//
// Demonstrates:
//   1. A self-referential struct: Node has a field of type Node*
//      The Resolver's Pass 1 registers "Node" in RegisteredStructs_.
//      Pass 2's visitStructDecl sees Node* → unwraps pointer → finds "Node"
//      in isKnownStruct() → validation passes.
//
//   2. Functions declared in a different order from their calls (forward refs).
//      printList() is defined before createNode() but calls it — both resolve
//      correctly because hoistTopLevel registered all signatures first.
//
// Note on linked-list codegen:
//   Full runtime execution of this program requires the Phase 3 LLVM backend
//   fix for self-referential structs (two-step StructType::create + setBody
//   in StructDeclExprAST::codegen). See ROADMAP_v1.0.0.md § Phase 3.
//
//   To verify the Resolver accepts it without errors:
//     ./turf test_linked_list.tr --resolve
//     ./turf test_linked_list.tr --dump-resolver-symbols
//
//   The Resolver dump will show:
//     --- Registered Struct Names (Pass 1 Hoist) ---
//       struct Node
//
//   To inspect the emitted IR (available even before Phase 3 LLVM fix):
//     ./turf test_linked_list.tr --emit-llvm

import io;

struct Node {
    val: int,
    next: Node*
}

fn printList(head: Node*): void {
    mutable cur: Node* = head;
    while cur != null {
        io.printline(cur.val);
        cur = cur.next;
    }
}

fn main(): int {
    // Basic linked list is ready for Phase 3 full codegen.
    // The Resolver should pass with zero errors on this file.
    return 0;
}
