// Min Heap using a list
fn void swap(list<int> heap, int i, int j) {
    int temp = heap[i]
    heap[i] = heap[j]
    heap[j] = temp
}

fn void heap_push(list<int> heap, int val) {
    heap.push(val)
    int i = heap.length - 1
    while (i > 0) {
        int p_idx = (i - 1) / 2
        if (heap[p_idx] > heap[i]) {
            swap(heap, p_idx, i)
            i = p_idx
        } else {
            break
        }
    }
}

fn int heap_pop(list<int> heap) {
    if (heap.length == 0) { return -1 }
    int res = heap[0]
    heap[0] = heap[heap.length - 1]
    int dummy = heap.pop()
    
    int i = 0
    while (1) {
        int left = 2 * i + 1
        int right = 2 * i + 2
        int smallest = i
        
        if (left < heap.length) {
            if (heap[left] < heap[smallest]) {
                smallest = left
            }
        }
        if (right < heap.length) {
            if (heap[right] < heap[smallest]) {
                smallest = right
            }
        }
        if (smallest != i) {
            swap(heap, i, smallest)
            i = smallest
        } else {
            break
        }
    }
    return res
}

list<int> heap
heap_push(heap, 10)
heap_push(heap, 5)
heap_push(heap, 15)
printline(heap_pop(heap)) // 5
printline(heap_pop(heap)) // 10
