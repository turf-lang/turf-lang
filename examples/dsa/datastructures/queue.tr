// Queue Implementation using a list and a head pointer
fn list<int> init_queue() {
    list<int> q
    q.push(1) // Head pointer starts at index 1
    return q
}
fn void enqueue(list<int> q, int val) {
    q.push(val)
}
fn int dequeue(list<int> q) {
    int head = q[0]
    if (head == q.length) { return -1 } // Empty
    int val = q[head]
    q[0] = head + 1
    return val
}
list<int> q = init_queue()
enqueue(q, 10)
enqueue(q, 20)
printline(dequeue(q)) // 10
printline(dequeue(q)) // 20
