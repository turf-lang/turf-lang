// Stack Implementation
fn list<int> create_stack() {
    list<int> s
    return s
}
fn void push(list<int> s, int val) {
    s.push(val)
}
fn int pop(list<int> s) {
    if (s.length == 0) { return -1 }
    return s.pop()
}
fn int peek(list<int> s) {
    if (s.length == 0) { return -1 }
    return s[s.length - 1]
}
list<int> s = create_stack()
push(s, 10)
push(s, 20)
printline(pop(s)) // 20
printline(peek(s)) // 10
