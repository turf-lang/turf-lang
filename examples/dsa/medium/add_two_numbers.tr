// Add Two Numbers (Simulated Linked List)
fn int create_node(int v, list<int> val, list<int> next) {
    val.push(v)
    next.push(-1)
    return val.length - 1
}

fn int add_two_numbers(int l1, int l2, list<int> val, list<int> next) {
    int dummy = create_node(0, val, next)
    int curr = dummy
    int carry = 0
    
    while (l1 != -1) {
        int sum = val[l1] + carry
        if (l2 != -1) { sum = sum + val[l2]; l2 = next[l2] }
        carry = sum / 10
        next[curr] = create_node(sum % 10, val, next)
        curr = next[curr]
        l1 = next[l1]
    }
    while (l2 != -1) {
        int sum = val[l2] + carry
        carry = sum / 10
        next[curr] = create_node(sum % 10, val, next)
        curr = next[curr]
        l2 = next[l2]
    }
    if (carry > 0) {
        next[curr] = create_node(carry, val, next)
    }
    return next[dummy]
}

list<int> val
list<int> next
int l1 = create_node(2, val, next)
next[l1] = create_node(4, val, next)
next[next[l1]] = create_node(3, val, next)

int l2 = create_node(5, val, next)
next[l2] = create_node(6, val, next)
next[next[l2]] = create_node(4, val, next)

int res = add_two_numbers(l1, l2, val, next)
while (res != -1) {
    printline(val[res])
    res = next[res]
}
