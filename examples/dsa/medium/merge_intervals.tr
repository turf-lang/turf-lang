// Merge Intervals
fn void sort_intervals(list<int> itvs) {
    int n = itvs.length / 2
    for i in 0..n step i += 1 {
        for j in 0..n - i - 1 step j += 1 {
            if (itvs[2 * j] > itvs[2 * (j + 1)]) {
                int t1 = itvs[2 * j]
                int t2 = itvs[2 * j + 1]
                itvs[2 * j] = itvs[2 * (j + 1)]
                itvs[2 * j + 1] = itvs[2 * (j + 1) + 1]
                itvs[2 * (j + 1)] = t1
                itvs[2 * (j + 1) + 1] = t2
            }
        }
    }
}

fn list<int> merge(list<int> itvs) {
    sort_intervals(itvs)
    list<int> res
    if (itvs.length == 0) { return res }
    res.push(itvs[0])
    res.push(itvs[1])
    
    int n = itvs.length / 2
    for i in 1..n step i += 1 {
        int start = itvs[2 * i]
        int end = itvs[2 * i + 1]
        int last_end = res[res.length - 1]
        
        if (start <= last_end) {
            if (end > last_end) {
                res[res.length - 1] = end
            }
        } else {
            res.push(start)
            res.push(end)
        }
    }
    return res
}

list<int> itvs
itvs.push(1) itvs.push(3)
itvs.push(2) itvs.push(6)
itvs.push(8) itvs.push(10)
itvs.push(15) itvs.push(18)
list<int> res = merge(itvs)
for i in 0..res.length step i += 2 {
    printline(res[i])
    printline(res[i+1])
}
