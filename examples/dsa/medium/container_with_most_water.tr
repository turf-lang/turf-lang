// Container With Most Water
fn int max_area(list<int> height) {
    int left = 0
    int right = height.length - 1
    int mx = 0
    
    while (left < right) {
        int h = height[left]
        if (height[right] < h) { h = height[right] }
        int w = right - left
        int area = h * w
        if (area > mx) { mx = area }
        
        if (height[left] < height[right]) {
            left = left + 1
        } else {
            right = right - 1
        }
    }
    return mx
}

list<int> h
h.push(1) h.push(8) h.push(6) h.push(2) h.push(5) h.push(4) h.push(8) h.push(3) h.push(7)
printline(max_area(h)) // 49
