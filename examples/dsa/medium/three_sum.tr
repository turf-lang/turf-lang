// 3Sum (O(N^2) using sorting and two pointers)
fn void sort(list<int> nums) {
    int n = nums.length
    for i in 0..n step i += 1 {
        for j in 0..n - i - 1 step j += 1 {
            if (nums[j] > nums[j + 1]) {
                int t = nums[j]
                nums[j] = nums[j + 1]
                nums[j + 1] = t
            }
        }
    }
}

fn int three_sum_count(list<int> nums) {
    sort(nums)
    int count = 0
    int n = nums.length
    for i in 0..n - 2 step i += 1 {
        if (i > 0) {
            if (nums[i] == nums[i - 1]) { continue }
        }
        int left = i + 1
        int right = n - 1
        while (left < right) {
            int sum = nums[i] + nums[left] + nums[right]
            if (sum == 0) {
                count = count + 1
                left = left + 1
                while (left < right) {
                    if (nums[left] == nums[left - 1]) { left = left + 1 } else { break }
                }
            } elseif (sum < 0) {
                left = left + 1
            } else {
                right = right - 1
            }
        }
    }
    return count
}

list<int> nums
nums.push(-1) nums.push(0) nums.push(1) nums.push(2) nums.push(-1) nums.push(-4)
printline(three_sum_count(nums)) // 2 unique triplets
