// Number of Islands
fn void dfs(list<int> grid, int m, int n, int i, int j) {
    if (i < 0) { return }
    if (i >= m) { return }
    if (j < 0) { return }
    if (j >= n) { return }
    if (grid[i * n + j] == 0) { return }
    
    grid[i * n + j] = 0
    dfs(grid, m, n, i + 1, j)
    dfs(grid, m, n, i - 1, j)
    dfs(grid, m, n, i, j + 1)
    dfs(grid, m, n, i, j - 1)
}

fn int num_islands(list<int> grid, int m, int n) {
    int count = 0
    for i in 0..m step i += 1 {
        for j in 0..n step j += 1 {
            if (grid[i * n + j] == 1) {
                count = count + 1
                dfs(grid, m, n, i, j)
            }
        }
    }
    return count
}

list<int> grid
grid.push(1) grid.push(1) grid.push(0) grid.push(0) grid.push(0)
grid.push(1) grid.push(1) grid.push(0) grid.push(0) grid.push(0)
grid.push(0) grid.push(0) grid.push(1) grid.push(0) grid.push(0)
grid.push(0) grid.push(0) grid.push(0) grid.push(1) grid.push(1)

printline(num_islands(grid, 4, 5)) // 3
