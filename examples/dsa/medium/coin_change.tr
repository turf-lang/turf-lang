// Coin Change
fn int coin_change(list<int> coins, int amount) {
    list<int> dp
    int top = amount + 1
    for i in 0..top step i += 1 { dp.push(999999) }
    dp[0] = 0
    
    for i in 1..top step i += 1 {
        for j in 0..coins.length step j += 1 {
            if (coins[j] <= i) {
                int res = dp[i - coins[j]] + 1
                if (res < dp[i]) { dp[i] = res }
            }
        }
    }
    if (dp[amount] >= 999999) { return -1 }
    return dp[amount]
}

list<int> coins
coins.push(1) coins.push(2) coins.push(5)
printline(coin_change(coins, 11)) // 3
