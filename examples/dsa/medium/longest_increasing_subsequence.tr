// Longest Increasing Subsequence
fn int lis(list<int> nums) {
    if (nums.length == 0) { return 0 }
    list<int> dp
    for i in 0..nums.length step i += 1 { dp.push(1) }
    int max_len = 1
    
    for i in 1..nums.length step i += 1 {
        for j in 0..i step j += 1 {
            if (nums[i] > nums[j]) {
                if (dp[j] + 1 > dp[i]) { dp[i] = dp[j] + 1 }
            }
        }
        if (dp[i] > max_len) { max_len = dp[i] }
    }
    return max_len
}

list<int> nums
nums.push(10) nums.push(9) nums.push(2) nums.push(5) nums.push(3) nums.push(7) nums.push(101) nums.push(18)
printline(lis(nums)) // 4
