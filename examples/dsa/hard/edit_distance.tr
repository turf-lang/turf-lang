// Edit Distance (Using arrays of ints to represent strings)
fn int min3(int a, int b, int c) {
    int m = a
    if (b < m) { m = b }
    if (c < m) { m = c }
    return m
}

fn int min_distance(list<int> word1, list<int> word2) {
    int m = word1.length
    int n = word2.length
    list<int> dp
    int total = (m + 1) * (n + 1)
    for i in 0..total step i += 1 { dp.push(0) }
    
    for i in 0..m + 1 step i += 1 { dp[i * (n + 1)] = i }
    for j in 0..n + 1 step j += 1 { dp[j] = j }
    
    for i in 1..m + 1 step i += 1 {
        for j in 1..n + 1 step j += 1 {
            if (word1[i - 1] == word2[j - 1]) {
                dp[i * (n + 1) + j] = dp[(i - 1) * (n + 1) + (j - 1)]
            } else {
                int replace = dp[(i - 1) * (n + 1) + (j - 1)]
                int insert = dp[i * (n + 1) + (j - 1)]
                int delete = dp[(i - 1) * (n + 1) + j]
                dp[i * (n + 1) + j] = min3(replace, insert, delete) + 1
            }
        }
    }
    return dp[m * (n + 1) + n]
}

list<int> w1
w1.push(104) w1.push(111) w1.push(114) w1.push(115) w1.push(101)
list<int> w2
w2.push(114) w2.push(111) w2.push(115)

printline(min_distance(w1, w2)) // 3
