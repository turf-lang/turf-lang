// Jump Game II
fn int jump(list<int> nums) {
    int jumps = 0
    int current_end = 0
    int farthest = 0
    
    for i in 0..nums.length - 1 step i += 1 {
        int max_reach = i + nums[i]
        if (max_reach > farthest) { farthest = max_reach }
        
        if (i == current_end) {
            jumps = jumps + 1
            current_end = farthest
        }
    }
    return jumps
}

list<int> nums
nums.push(2) nums.push(3) nums.push(1) nums.push(1) nums.push(4)
printline(jump(nums)) // 2
