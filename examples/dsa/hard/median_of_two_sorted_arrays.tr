// Median of Two Sorted Arrays
fn double find_median(list<int> nums1, list<int> nums2) {
    if (nums1.length > nums2.length) {
        return find_median(nums2, nums1)
    }
    int m = nums1.length
    int n = nums2.length
    int low = 0
    int high = m
    
    while (low <= high) {
        int partition1 = (low + high) / 2
        int partition2 = (m + n + 1) / 2 - partition1
        
        int max_left1 = -999999
        if (partition1 != 0) { max_left1 = nums1[partition1 - 1] }
        
        int min_right1 = 999999
        if (partition1 != m) { min_right1 = nums1[partition1] }
        
        int max_left2 = -999999
        if (partition2 != 0) { max_left2 = nums2[partition2 - 1] }
        
        int min_right2 = 999999
        if (partition2 != n) { min_right2 = nums2[partition2] }
        
        if (max_left1 <= min_right2) {
            if (max_left2 <= min_right1) {
                if ((m + n) % 2 == 0) {
                    int max_l = max_left1
                    if (max_left2 > max_l) { max_l = max_left2 }
                    int min_r = min_right1
                    if (min_right2 < min_r) { min_r = min_right2 }
                    return (max_l + min_r) / 2.0
                } else {
                    int max_l = max_left1
                    if (max_left2 > max_l) { max_l = max_left2 }
                    return max_l / 1.0
                }
            } else {
                low = partition1 + 1
            }
        } else {
            high = partition1 - 1
        }
    }
    return 0.0
}

list<int> n1
list<int> n2
n1.push(1) n1.push(3)
n2.push(2)
printline(find_median(n1, n2)) // 2
