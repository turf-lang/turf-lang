// Word Break II (Simulated with lengths)
// Backtracking over lengths of words
fn void backtrack(list<int> s, list<int> word_lens, int start, list<int> path, list<int> res) {
    if (start == s.length) {
        res[0] = res[0] + 1
        return
    }
    for i in 0..word_lens.length step i += 1 {
        int wlen = word_lens[i]
        if (start + wlen <= s.length) {
            if (wlen == 3) {
                path.push(wlen)
                backtrack(s, word_lens, start + wlen, path, res)
                int dummy = path.pop()
            } elseif (wlen == 4) {
                path.push(wlen)
                backtrack(s, word_lens, start + wlen, path, res)
                int dummy = path.pop()
            }
        }
    }
}

fn int word_break(list<int> s, list<int> word_lens) {
    list<int> res
    res.push(0)
    list<int> path
    backtrack(s, word_lens, 0, path, res)
    return res[0]
}

list<int> s
for i in 0..7 step i += 1 { s.push(1) } // length 7 string
list<int> w
w.push(3) w.push(4)

printline(word_break(s, w)) // e.g. catsanddog count
