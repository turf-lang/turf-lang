// Merge k Sorted Lists
fn int create_node(int v, list<int> val, list<int> next) {
    val.push(v)
    next.push(-1)
    return val.length - 1
}

fn int merge_two(int l1, int l2, list<int> val, list<int> next) {
    int dummy = create_node(0, val, next)
    int curr = dummy
    while (1) {
        if (l1 == -1) { next[curr] = l2; break }
        if (l2 == -1) { next[curr] = l1; break }
        
        if (val[l1] < val[l2]) {
            next[curr] = l1
            l1 = next[l1]
        } else {
            next[curr] = l2
            l2 = next[l2]
        }
        curr = next[curr]
    }
    return next[dummy]
}

fn int merge_k(list<int> arrs, list<int> val, list<int> next) {
    if (arrs.length == 0) { return -1 }
    int interval = 1
    while (interval < arrs.length) {
        for i in 0..arrs.length - interval step i += interval * 2 {
            arrs[i] = merge_two(arrs[i], arrs[i + interval], val, next)
        }
        interval = interval * 2
    }
    return arrs[0]
}

list<int> val
list<int> next
int l1 = create_node(1, val, next); next[l1] = create_node(4, val, next); next[next[l1]] = create_node(5, val, next)
int l2 = create_node(1, val, next); next[l2] = create_node(3, val, next); next[next[l2]] = create_node(4, val, next)
int l3 = create_node(2, val, next); next[l3] = create_node(6, val, next)

list<int> arrs
arrs.push(l1) arrs.push(l2) arrs.push(l3)

int res = merge_k(arrs, val, next)
while (res != -1) {
    printline(val[res])
    res = next[res]
}
