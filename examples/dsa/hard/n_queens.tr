// N-Queens
fn void solve(int row, int n, list<int> res, list<int> cols, list<int> diag1, list<int> diag2) {
    if (row == n) {
        res[0] = res[0] + 1
        return
    }
    for col in 0..n step col += 1 {
        if (cols[col] == 0) {
            if (diag1[row + col] == 0) {
                if (diag2[row - col + n - 1] == 0) {
                    cols[col] = 1
                    diag1[row + col] = 1
                    diag2[row - col + n - 1] = 1
                    
                    solve(row + 1, n, res, cols, diag1, diag2)
                    
                    cols[col] = 0
                    diag1[row + col] = 0
                    diag2[row - col + n - 1] = 0
                }
            }
        }
    }
}

fn int total_n_queens(int n) {
    list<int> cols
    list<int> diag1
    list<int> diag2
    for i in 0..n step i += 1 { cols.push(0) }
    for i in 0..2 * n step i += 1 { diag1.push(0); diag2.push(0) }
    list<int> res
    res.push(0)
    solve(0, n, res, cols, diag1, diag2)
    return res[0]
}

printline(total_n_queens(4)) // 2
