// Maximal Rectangle
fn int largest_rectangle(list<int> heights) {
    list<int> stack
    int max_area = 0
    int i = 0
    while (i < heights.length) {
        if (stack.length == 0) {
            stack.push(i)
            i = i + 1
        } elseif (heights[stack[stack.length - 1]] <= heights[i]) {
            stack.push(i)
            i = i + 1
        } else {
            int top = stack.pop()
            int area = 0
            if (stack.length == 0) { area = heights[top] * i }
            else { area = heights[top] * (i - stack[stack.length - 1] - 1) }
            if (area > max_area) { max_area = area }
        }
    }
    while (stack.length > 0) {
        int top = stack.pop()
        int area = 0
        if (stack.length == 0) { area = heights[top] * i }
        else { area = heights[top] * (i - stack[stack.length - 1] - 1) }
        if (area > max_area) { max_area = area }
    }
    return max_area
}

fn int maximal_rect(list<int> matrix, int m, int n) {
    if (m == 0) { return 0 }
    list<int> heights
    for j in 0..n step j += 1 { heights.push(0) }
    int max_area = 0
    
    for i in 0..m step i += 1 {
        for j in 0..n step j += 1 {
            if (matrix[i * n + j] == 1) {
                heights[j] = heights[j] + 1
            } else {
                heights[j] = 0
            }
        }
        int curr_area = largest_rectangle(heights)
        if (curr_area > max_area) { max_area = curr_area }
    }
    return max_area
}

list<int> mat
mat.push(1) mat.push(0) mat.push(1) mat.push(0) mat.push(0)
mat.push(1) mat.push(0) mat.push(1) mat.push(1) mat.push(1)
mat.push(1) mat.push(1) mat.push(1) mat.push(1) mat.push(1)
mat.push(1) mat.push(0) mat.push(0) mat.push(1) mat.push(0)

printline(maximal_rect(mat, 4, 5)) // 6
