// Trapping Rain Water
fn int trap(list<int> height) {
    if (height.length == 0) { return 0 }
    int left = 0
    int right = height.length - 1
    int max_left = 0
    int max_right = 0
    int res = 0
    
    while (left <= right) {
        if (max_left <= max_right) {
            if (height[left] >= max_left) { max_left = height[left] }
            else { res = res + max_left - height[left] }
            left = left + 1
        } else {
            if (height[right] >= max_right) { max_right = height[right] }
            else { res = res + max_right - height[right] }
            right = right - 1
        }
    }
    return res
}

list<int> h
h.push(0) h.push(1) h.push(0) h.push(2) h.push(1) h.push(0) h.push(1) h.push(3) h.push(2) h.push(1) h.push(2) h.push(1)
printline(trap(h)) // 6
