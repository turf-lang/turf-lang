fn main(): int {
    mutable x: int = 5;
    mutable abs_x: int = x > 0 give x otherwise -x;
    io.printline(abs_x);
    assert(abs_x == 5);

    mutable y: int = -10;
    mutable abs_y: int = y > 0 give y otherwise -y;
    io.printline(abs_y);
    assert(abs_y == 10);

    // Nested ternary
    mutable a: int = 1;
    mutable b: int = 2;
    mutable res: int = a > b give 10 otherwise (a == b give 20 otherwise 30);
    io.printline(res);
    assert(res == 30);

    // Block if (mandated braces)
    if x > 0 {
        io.printline("positive");
    } elseif x == 0 {
        io.printline("zero");
    } else {
        io.printline("negative");
    }

    io.printline("Ternary and unified if tests passed!");
    return 0;
}
