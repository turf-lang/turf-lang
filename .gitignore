Thumbs.db

# Test inputs / local experiments
*.turf.out


# Debug
*.dSYM/

# File Binary. Anchored to the repo root: an unanchored `turf` also matches the
# DIRECTORY cli/cmd/turf/ (LEC-001), so `git add` would silently skip every new
# file under it. `turfc` is the compiler's name since LEC-001.
/turf
/turfc
program
# ...but not the tool API's header directory (include/turf/Analysis.h, SMP-001)
!include/turf/

# Models
models/

# Compilation database
compile_commands.json

# Patent disclosure material -- never pushed
docs/patent/
docs/patent.zip


# Bundled C runtime a release archive carries (REL-008 stage 4 builds it in CI;
# a developer may assemble one to try the embedded linker, see
# scripts/bundled_link_smoke.sh).
/lib/rt/
fuzz-findings/
build_cov/

# Generated by tooling, never source
__pycache__/
*.pyc
# gcov output (TURF_COVERAGE builds; see tests/CONFORMANCE.md)
*.gcda
*.gcno
*.gcov
# Temporary objects the test runner leaves behind when a run is killed
.testrun_*
# Reproducers scripts/fuzz/crash_fuzz.py writes before they are minimized into tests/
fuzz-findings/
