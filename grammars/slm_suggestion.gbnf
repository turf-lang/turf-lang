# GBNF grammar for SLM suggestion JSON output.
# Constrains the model to emit a well-formed JSON object with exactly the six
# required fields in order, and token-constrains fix_mode to only "MODIFY" or
# "NONE" — it is physically impossible for the model to emit any other value.
#
# Field order is fixed; update this file if the prompt schema changes.

root ::= "{" ws
         "\"explanation\":"      ws string "," ws
         "\"fix_mode\":"         ws fix-mode "," ws
         "\"suggested_comment\":" ws string "," ws
         "\"code_patch\":"       ws string "," ws
         "\"replacement_line\":" ws string "," ws
         "\"warning\":"          ws string "," ws
         "\"category\":"         ws category
         ws "}"

fix-mode ::= "\"MODIFY\"" | "\"NONE\""

category ::= "\"TYPE_MISMATCH\""       | "\"UNDECLARED_VARIABLE\""
           | "\"CONTROL_FLOW\""        | "\"SYNTAX_ERROR\""
           | "\"ARITHMETIC\""          | "\"STRING_CONVERSION\""
           | "\"ARRAY_ERROR\""         | "\"DECLARATION\""
           | "\"FUNCTION_SIGNATURE\""  | "\"BUILTIN_FUNCTION\""
           | "\"GENERAL\""

# JSON string: any characters except raw " or \, or a valid escape sequence.
string ::= "\"" string-char* "\""
string-char ::= [^"\\\x00-\x1f] | "\\" escape
escape ::= ["\\/bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F]

ws ::= [ \t\n\r]*
