fn main(): int {
    mutable n: double = 3.99;
    mutable i: int = n to int;
    mutable s: string = i to string;

    io.printline(n);
    io.printline(i);
    io.printline(s);

    assert(i == 3);
    assert(s to int == 3);
    
    mutable d: double = i to int to double;
    io.printline(d);
    assert(d == 3.0);

    io.printline("Cast tests passed successfully!");
    return 0;
}
