// list.tr — List<T>: a dynamically-growing array.
// Usage:
//   import list;
//   mut l: List<int> = List { data: null, len: 0, cap: 0 };
//   l.push(1);
//   l.push(2);
//   mut x: int = l.pop();   // 2
//   mut n: int = l.length(); // 1

import mem;

struct List<T> {
  data: T*,
  len: int,
  cap: int
}

fn<T> List.push(item: T): void {
  if (self.len == self.cap) {
    if (self.cap == 0) {
      self.cap = 8;
    } else {
      self.cap = self.cap * 2;
    }

    // In Type Erasure, all T are 64 bits (pointers, int, double)
    immutable byteSize: int = self.cap * 8;

    if (self.data == null) {
      self.data = mem::malloc(byteSize) to T*;
    } else {
      self.data = mem::realloc(self.data, byteSize) to T*;
    }
  }

  self.data[self.len] = item;
  self.len = self.len + 1;
}

fn<T> List.pop(): T {
  if (self.len == 0) {
    fail("List.pop: pop on empty list");
  }

  self.len = self.len - 1;
  return self.data[self.len];
}

fn<T> List.length(): int {
  return self.len;
}
