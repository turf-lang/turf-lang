unsafe module;

// ─── io.tr ─────────────────────────────────────────────────────────────────
// Console I/O for TurfLang.
//
// Design:
//   - print/printline/input are ordinary Turf functions that delegate to
//     libc via `extern fn` (FFI), exactly like math.tr/mem.tr -- no compiler
//     C++ hardcodes their names or behavior. This replaces the previous
//     @intrinsic("print"/"printline"/"input") mechanism, which has been
//     removed from the compiler entirely (it had exactly these 9 signatures
//     as its only consumer anywhere in the codebase).
//   - print/printline dispatch per-type by overload (int/double/bool/string)
//     rather than at runtime, mirroring the previous @intrinsic behavior's
//     per-LLVM-type dispatch in Builtins.cpp.
//
// Usage:
//   import io;
//   io::printline("hello");
//   mut name: string = io::input();
//
//   mut content: string = io::read_to_string("file.txt") recover run {
//       io::eprintline("couldn't read file.txt");
//       return;
//   };
//   io::write_string("out.txt", "hello");
//   if io::exists("out.txt") { io::printline("it's there"); }

import list::List;
import strings;

// ─── libc bindings ────────────────────────────────────────────────────────

extern fn printf(fmt: string, ...): int;
extern fn getchar(): int32;

// Buffered file I/O (fopen/fclose/fseek/ftell/fread/fwrite/fflush) --
// `string` and `void*` are the same opaque pointer at the LLVM level in
// this compiler (confirmed by net.tr's TcpConnection.read()), so a `string`
// buffer is passed wherever a C function wants a `char*`/`void*` and back,
// exactly like net.tr/strings.tr already do.
extern fn fopen(path: string, mode: string): void*;
extern fn fclose(stream: void*): int;
extern fn fseek(stream: void*, offset: int, whence: int): int;
extern fn ftell(stream: void*): int;
extern fn fread(buf: void*, size: int, count: int, stream: void*): int;
extern fn fwrite(buf: string, size: int, count: int, stream: void*): int;
extern fn fflush(stream: void*): int;

// A raw POSIX write(2) syscall, not buffered stdio -- eprint/eprintline use
// this instead of an fprintf+FILE* stream, mirroring sys.tr's own panic()
// implementation exactly (see its doc comment: there's no way to `extern` a
// libc global like `stderr`, and repeatedly fdopen()-ing fd 2 for every
// eprint() call would leak one FILE* per call with no way to free it, since
// this language has no way to cache a persistent handle across calls --
// only `export immut` constants exist at module scope, not mutable
// globals). A raw write() to the well-known stderr fd sidesteps both
// problems entirely.
extern fn write(fd: int, buf: string, count: int): int;
extern fn strlen(s: string): int;

// ─── print ────────────────────────────────────────────────────────────────

pub fn print(val: int): void {
    printf("%lld", val);
}

// A NaN prints "nan" whatever its sign bit (owner decision 2026-10-12): `%g`
// prints the sign, which differs between run-time arithmetic ("-nan") and
// constant folding ("nan"), so the output changed with -O (found by
// turf-fuzz). `(x to string)` follows the same rule in Codegen. Written
// without `x != x`, which the self-comparison lint flags in every program,
// since this file is in the prelude (see double.tr's header).
fn is_nan_value(x: double): bool {
    return !(x >= 0.0) && !(x < 0.0);
}

pub fn print(val: double): void {
    if is_nan_value(val) {
        printf("nan");
        return;
    }
    printf("%g", val);
}

// `true`/`false`, the same text as `(val to string)`.
pub fn print(val: bool): void {
    if val {
        printf("true");
    } else {
        printf("false");
    }
}

pub fn print(val: char): void {
    printf("%c", val);
}

pub fn print(val: string): void {
    printf("%s", val);
}

// ─── printline ────────────────────────────────────────────────────────────

pub fn printline(val: int): void {
    printf("%lld\n", val);
}

pub fn printline(val: double): void {
    if is_nan_value(val) {
        printf("nan\n");
        return;
    }
    printf("%g\n", val);
}

// `true`/`false`, the same text as `(val to string)`.
pub fn printline(val: bool): void {
    if val {
        printf("true\n");
    } else {
        printf("false\n");
    }
}

pub fn printline(val: char): void {
    printf("%c\n", val);
}

pub fn printline(val: string): void {
    printf("%s\n", val);
}

// ─── input ────────────────────────────────────────────────────────────────

// Reads one line from stdin, of any length, without its '\n'. Bytes are taken
// one getchar() at a time into a growing StringBuilder, so there is no fixed
// buffer to split a long line. At the end of input it returns what it has,
// which is "" when nothing is left: an empty line and the end of input read
// the same.
pub fn input(): string {
    mut line: strings::StringBuilder = strings::StringBuilder::default();
    // C's getchar() returns an `int`, 32 bits: EOF is -1 only when read as
    // int32 (as a 64-bit int it would be 4294967295 and never end the loop).
    mut c: int32 = getchar();
    while c != -1 && c != 10 {
        line.append_char((c to int) to char);
        c = getchar();
    }
    return line.to_string();
}

// Prints `msg` and flushes stdout, so the prompt is on screen before the
// program waits, then reads a line like input().
pub fn input(msg: string): string {
    print(msg);
    flush();
    return input();
}

// ─── file errors ──────────────────────────────────────────────────────────

// One variant per distinct file-I/O failure the functions below can report
// (docs/reference/error_handling.md) -- kept separate rather than one
// generic "FileError::Failed" so callers using `recover as err run { ... }`
// can still tell "the file isn't there" apart from "it's there but
// something went wrong reading/writing it", mirroring net.tr's
// NetworkError split.
//
// Each carries the path it failed on (LEC-004): read it by destructuring --
// `matches io::FileError::NotFound(path):` -- or ignore it and compare with
// `err == io::FileError::NotFound` as before (equality looks at the variant only).
pub error FileError {
    NotFound(path: string),
    ReadFailed(path: string),
    WriteFailed(path: string),
}

// ─── read_to_string ───────────────────────────────────────────────────────

// read_to_string: reads the entire contents of the file at `path` into one
// string. Returns `!string`: a missing/unopenable file or a short read are
// both ordinary, expected outcomes for file I/O (a typo'd path, a deleted
// file, a permissions error), not bugs -- the caller decides how to
// recover, exactly like net.tr's connect()/bind()/accept().
//
// Opens in binary mode ("rb") and seeks to the end to find the size before
// reading, rather than growing a buffer incrementally -- simplest correct
// approach for "read the whole file in one shot". Allocates zero-initialized
// (MEM-001: gc_alloc_zeroed, not calloc -- a `string` result is GC-heap,
// F-MEM-3), specifically so the byte one past the last byte actually read is
// already 0 -- a free, always-correct null terminator with no separate write
// needed, even on a short read.
//
// Deliberately does NOT free the buffer before returning: `string` and
// `void*` are the same opaque pointer at the LLVM level, so `buf to
// string` does not copy -- the returned string IS the buffer. This matches
// the exact convention io.tr's own input() and net.tr's TcpConnection.read()
// already established -- ownership of the heap buffer transfers to the
// caller, who is never expected to free it either (MEM-001 puts it on the
// GC heap, but nothing collects yet -- MEM-002 is what stops the leak, not
// this function; see EmitStringConcat's own TURF-MEMLEAK comment history in
// strings.tr).
pub fn read_to_string(path: string): !string {
    mut stream: void* = fopen(path, "rb");
    if stream == null {
        return FileError::NotFound(path, "file not found: '" + path + "'");
    }

    fseek(stream, 0, 2); // SEEK_END
    immut size: int = ftell(stream);
    fseek(stream, 0, 0); // SEEK_SET

    mut buf: void* = gc_alloc_zeroed(size + 1);
    immut readCount: int = fread(buf, 1, size, stream);
    fclose(stream);

    if readCount != size {
        return FileError::ReadFailed(path, "could not read '" + path + "'");
    }

    return buf to string;
}

// ─── read_lines ───────────────────────────────────────────────────────────

// read_lines: reads the file at `path` and splits it into lines on '\n'.
// Returns `!List<string>` for the same reasons read_to_string returns
// `!string` -- built directly on top of it (this collapses BOTH of
// read_to_string's failure variants into FileError::NotFound, the by-far
// more common real-world cause; a caller that needs to tell them apart can
// always call read_to_string() itself instead).
//
// A trailing '\n' at the very end of the file (the overwhelmingly common
// case for a normal text file) would otherwise leave strings::split with a
// spurious empty trailing element ("a\nb\n" -> ["a", "b", ""]) -- dropped
// explicitly so callers get the lines they'd actually expect, not an extra
// blank one. A trailing empty line from a genuine blank line (two '\n' in
// a row at the end, "a\n\n") is intentionally left alone -- only ONE
// trailing empty element is ever dropped.
pub fn read_lines(path: string): !List<string> {
    immut content: string = read_to_string(path) recover run {
        return FileError::NotFound(path, "file not found: '" + path + "'");
    };

    mut lines: List<string> = strings::split(content, "\n");
    if lines.length() > 0 {
        if lines.get(lines.length() - 1) == "" {
            lines.pop();
        }
    }

    return lines;
}

// ─── write_string ─────────────────────────────────────────────────────────

// write_string: writes `content` to the file at `path`, overwriting it if
// it already exists (creating it if not). Returns `!void`:
// FileError::WriteFailed(path) if the path can't be opened for writing (a
// missing directory, no permission) or the write comes up short.
//
// This returned a bare `bool` until LEC-007. That broke the module's own
// rule -- read_to_string / read_lines report a failure on the same file as
// `!T` carrying the path -- and a caller with a bool had no way to say which
// of several writes failed. A failed write is input-dependent, not a
// programming error, so it is `!void` and not a panic (the stdlib rule is in
// docs/reference/stdlib/README.md).
pub fn write_string(path: string, content: string): !void {
    mut stream: void* = fopen(path, "wb");
    if stream == null {
        return FileError::WriteFailed(path, "could not write '" + path + "'");
    }

    immut n: int = strlen(content);
    immut written: int = fwrite(content, 1, n, stream);
    fclose(stream);

    if written != n {
        return FileError::WriteFailed(path, "could not write '" + path + "'");
    }
    return;
}

// ─── exists ────────────────────────────────────────────────────────────────

// exists: true if the file at `path` can be opened for reading.
pub fn exists(path: string): bool {
    mut stream: void* = fopen(path, "rb");
    if stream == null {
        return false;
    }
    fclose(stream);
    return true;
}

// ─── eprint / eprintline ───────────────────────────────────────────────────

// eprint: like print(val: string), but writes to stderr (fd 2) instead of
// stdout. See the `write`/`strlen` extern bindings' doc comment above for
// why this is a raw write(2) syscall rather than buffered stdio.
pub fn eprint(val: string): void {
    write(2, val, strlen(val));
}

// eprintline: like printline(val: string), but writes to stderr (fd 2)
// instead of stdout.
pub fn eprintline(val: string): void {
    write(2, val, strlen(val));
    write(2, "\n", 1);
}

// ─── flush ─────────────────────────────────────────────────────────────────

// flush: forces any buffered stdout output (from print/printline, which go
// through libc's buffered printf) out immediately. Passing a null stream
// to fflush() is glibc-specific behavior (this codebase already targets
// glibc/Linux primarily, e.g. net.tr's Linux-numbered socket constants):
// it flushes every open output stream, not just stdout, which is what's
// wanted here since there's no way to obtain stdout's own FILE* handle
// directly (same reasoning as eprint/eprintline above -- no `extern`-able
// libc global, and no persistent handle to cache one in).
pub fn flush(): void {
    fflush(null);
}
