// ─── bool.tr ─────────────────────────────────────────────────────────────────
// UFCS-callable helpers for `bool` (STRING_UFCS_OPERATOR_CHAR_RFC.md §5.3).
// Part of the prelude -- always in scope, no explicit `import bool;` needed.
//
// bool has little room for extra helpers beyond the built-in `&&`/`||`/`!` --
// the ones below fill gaps Turf has no operator for at all.

// Turf has no built-in XOR for bool (`^` is bitwise, int-only).
fn logical_xor(a: bool, b: bool): bool {
    return a != b;
}

fn logical_nand(a: bool, b: bool): bool {
    return !(a && b);
}

fn logical_nor(a: bool, b: bool): bool {
    return !(a || b);
}

// implies: material implication (`a -> b`), i.e. "if a then b". Turf has no
// operator spelling for this at all.
fn implies(a: bool, b: bool): bool {
    return !a || b;
}
