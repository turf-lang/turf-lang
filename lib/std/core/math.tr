// ─── math.tr ─────────────────────────────────────────────────────────────────
// Mathematical functions for TurfLang.
//
// Design:
//   - All C math functions are declared via `extern fn` (FFI), not @intrinsic.
//   - Functions that require libm are declared with `extern from "m"` so the
//     compiler automatically appends -lm to the linker flags.
//   - Turf-level wrappers implement overloaded variants and add new functions
//     (min, max, clamp, tan, log, etc.) that were previously unavailable.
//
// Usage:
//   import math;
//   mut x: double = math::sqrt(2.0);
//   mut n: int    = math::abs(-5);
//   mut q: int    = math::divide(10, 0) recover produce -1;

// ─── constants ─────────────────────────────────────────────────────────────
//
// Always qualified (`math::PI`, `math::INT_MAX`): a constant is never a bare
// name, so none of these can collide with a program's own.

export immut PI: double = 3.14159265358979323846;
export immut TAU: double = 6.28318530717958647692;
export immut E: double = 2.71828182845904523536;
export immut PHI: double = 1.61803398874989484820;
export immut SQRT2: double = 1.41421356237309504880;
export immut SQRT1_2: double = 0.70710678118654752440;
export immut LN2: double = 0.69314718055994530942;
export immut LN10: double = 2.30258509299404568402;
export immut LOG2E: double = 1.44269504088896340736;
export immut LOG10E: double = 0.43429448190325182765;

// ─── limits ──────────────────────────────────────────────────────────────────
//
// The range of each numeric type. `MIN` is the most negative value of the
// type for `double` as for the integers; the smallest positive normal
// `double` (C's DBL_MIN) is `DOUBLE_MIN_POSITIVE`.

export immut INT_MAX: int = 9223372036854775807;
export immut INT_MIN: int = -9223372036854775808;
export immut INT32_MAX: int32 = 2147483647;
export immut INT32_MIN: int32 = -2147483648;
export immut DOUBLE_MAX: double = 1.7976931348623157e308;
export immut DOUBLE_MIN: double = -1.7976931348623157e308;
export immut DOUBLE_MIN_POSITIVE: double = 2.2250738585072014e-308;
export immut DOUBLE_EPSILON: double = 2.220446049250313e-16;

// ─── infinity and NaN ────────────────────────────────────────────────────────
//
// No literal spells these, and `/` by zero panics for a double, so the
// compiler gives these three their values (src/sema/Intrinsics.h, kind 6):
// the `0.0` each is written with is never read. NaN equals nothing, itself
// included, so `x == NAN` is always false: test with `is_nan(x)`.

export immut INFINITY: double = 0.0;
export immut NEG_INFINITY: double = 0.0;
export immut NAN: double = 0.0;

// ─── libm bindings ────────────────────────────────────────────────────────────

pub extern from "m" fn pow(base: double, exp: double): double;
pub extern from "m" fn sqrt(val: double): double;
pub extern from "m" fn sin(val: double): double;
pub extern from "m" fn cos(val: double): double;
pub extern from "m" fn tan(val: double): double;
pub extern from "m" fn floor(val: double): double;
pub extern from "m" fn ceil(val: double): double;
pub extern from "m" fn round(val: double): double;
pub extern from "m" fn fabs(val: double): double;
pub extern from "m" fn log(val: double): double;
pub extern from "m" fn log2(val: double): double;
pub extern from "m" fn log10(val: double): double;
pub extern from "m" fn exp(val: double): double;

// ─── abs ─────────────────────────────────────────────────────────────────────

pub fn abs(val: double): double {
    return fabs(val);
}

pub fn abs(val: int): int {
    if val < 0 {
        return 0 - val;
    }
    return val;
}

// ─── power (four overloads, mirrors previous @intrinsic behaviour) ────────────

pub fn power(base: double, exp: double): double {
    return pow(base, exp);
}

pub fn power(base: int, exp: int): int {
    return pow(base to double, exp to double) to int;
}

pub fn power(base: int, exp: double): double {
    return pow(base to double, exp);
}

pub fn power(base: double, exp: int): double {
    return pow(base, exp to double);
}

// ─── is_nan / is_infinite / is_finite ────────────────────────────────────────

// NaN is the one value not equal to itself.
pub fn is_nan(val: double): bool {
    return val != val;
}

pub fn is_infinite(val: double): bool {
    return val == INFINITY || val == NEG_INFINITY;
}

pub fn is_finite(val: double): bool {
    return !is_nan(val) && !is_infinite(val);
}

// ─── min / max ────────────────────────────────────────────────────────────────

pub fn min(a: int, b: int): int {
    if a < b {
        return a;
    }
    return b;
}

pub fn min(a: double, b: double): double {
    if a < b {
        return a;
    }
    return b;
}

pub fn max(a: int, b: int): int {
    if a > b {
        return a;
    }
    return b;
}

pub fn max(a: double, b: double): double {
    if a > b {
        return a;
    }
    return b;
}

// ─── clamp ────────────────────────────────────────────────────────────────────

pub fn clamp(val: int, min_val: int, max_val: int): int {
    if val < min_val {
        return min_val;
    }
    if val > max_val {
        return max_val;
    }
    return val;
}

pub fn clamp(val: double, min_val: double, max_val: double): double {
    if val < min_val {
        return min_val;
    }
    if val > max_val {
        return max_val;
    }
    return val;
}

// ─── wrapping arithmetic ──────────────────────────────────────────────────────
//
// `int` arithmetic modulo 2^64 that never traps on overflow, for hashes,
// checksums and random-number generators, where overflow is the intended
// result. The operators stay checked. The compiler lowers every call of the
// first four, and each of their bodies, to one plain add, subtract, multiply
// or shift at every optimization level (src/sema/Intrinsics.h, kind 5), so
// the operators written in those four bodies are never compiled: they say
// which operation each one wraps. The rest are built on those four. Division
// by zero has no wrapped result, so `wrapping_div` and `wrapping_rem` still
// panic for it, at the caller's line.

pub fn wrapping_add(a: int, b: int): int {
    return a + b;
}

pub fn wrapping_sub(a: int, b: int): int {
    return a - b;
}

pub fn wrapping_mul(a: int, b: int): int {
    return a * b;
}

// `a` shifted left by `n` modulo 64 places; bits shifted out are dropped.
pub fn wrapping_shl(a: int, n: int): int {
    return a << n;
}

// `a` shifted right (arithmetic, keeping the sign) by `n` modulo 64 places.
pub fn wrapping_shr(a: int, n: int): int {
    return a >> (n & 63);
}

// `-a`; the most negative int is its own negation.
pub fn wrapping_neg(a: int): int {
    return wrapping_sub(0, a);
}

// `|a|`; the most negative int is its own absolute value.
pub fn wrapping_abs(a: int): int {
    if a < 0 {
        return wrapping_neg(a);
    }
    return a;
}

// `a / b`, truncated toward zero; the most negative int divided by -1 is
// itself. Panics when `b` is 0.
@caller_location
pub fn wrapping_div(a: int, b: int): int {
    if b == 0 {
        sys::panic(caller_location + ": math::wrapping_div: division by zero");
    }
    if b == -1 {
        return wrapping_neg(a);
    }
    return a / b;
}

// `a % b`, with the sign of `a`; the most negative int modulo -1 is 0.
// Panics when `b` is 0.
@caller_location
pub fn wrapping_rem(a: int, b: int): int {
    if b == 0 {
        sys::panic(caller_location + ": math::wrapping_rem: division by zero");
    }
    if b == -1 {
        return 0;
    }
    return a % b;
}

// `base` to the power `exp` modulo 2^64. Panics when `exp` is negative: the
// result would be a fraction.
@caller_location
pub fn wrapping_pow(base: int, exp: int): int {
    if exp < 0 {
        sys::panic(caller_location + ": math::wrapping_pow: negative exponent");
    }
    mut result: int = 1;
    mut b: int = base;
    mut e: int = exp;
    while e > 0 {
        if (e & 1) == 1 {
            result = wrapping_mul(result, b);
        }
        b = wrapping_mul(b, b);
        e = e >> 1;
    }
    return result;
}

// ─── divide ───────────────────────────────────────────────────────────────────
//
// The raw `/` operator hard-panics (aborts the whole process) on division by
// zero -- appropriate when it really is a programming bug, but not when the
// divisor is genuinely untrusted input the caller should get a chance to
// react to. `divide` is the recoverable alternative (docs/planning/
// Errors.md's own worked example): `math::divide(a, b) recover produce 0;`
// or a full `recover as err run { ... }` if the caller wants to react to the
// failure specifically, instead of a program-ending abort.

pub error MathError {
    DivisionByZero,
}

pub fn divide(a: int, b: int): !int {
    if b == 0 {
        return MathError::DivisionByZero("division by zero");
    }
    return a / b;
}

pub fn divide(a: double, b: double): !double {
    if b == 0.0 {
        return MathError::DivisionByZero("division by zero");
    }
    return a / b;
}
