// ─── char.tr ─────────────────────────────────────────────────────────────────
// UFCS-callable helpers for `char` (STRING_UFCS_OPERATOR_CHAR_RFC.md §3/§5.3).
// Part of the prelude -- always in scope, no explicit `import char;` needed.
// This is the RFC's own named example of what a prelude module should look
// like (`c.isDigit()`, etc.).
//
// ASCII-only, matching char's own "1 byte, no Unicode" design (RFC §3).
// Arithmetic on char values requires an explicit `to int` cast first (char
// has no built-in arithmetic) -- every helper below does that internally.

fn isDigit(c: char): bool {
    return (c to int) >= 48 && (c to int) <= 57; // '0'..'9'
}

fn isUpper(c: char): bool {
    return (c to int) >= 65 && (c to int) <= 90; // 'A'..'Z'
}

fn isLower(c: char): bool {
    return (c to int) >= 97 && (c to int) <= 122; // 'a'..'z'
}

fn isAlpha(c: char): bool {
    return c.isUpper() || c.isLower();
}

fn isAlphaNumeric(c: char): bool {
    return c.isAlpha() || c.isDigit();
}

// isPunctuation: printable ASCII (33..126) that's neither a letter nor a
// digit -- e.g. '.', ',', '!', '('.
fn isPunctuation(c: char): bool {
    mut n: int = c to int;
    return n >= 33 && n <= 126 && !c.isAlphaNumeric();
}

fn isWhitespace(c: char): bool {
    mut n: int = c to int;
    return n == 32 || n == 9 || n == 10 || n == 13; // space, tab, \n, \r
}

fn toUpper(c: char): char {
    if c.isLower() {
        return ((c to int) - 32) to char;
    }
    return c;
}

fn toLower(c: char): char {
    if c.isUpper() {
        return ((c to int) + 32) to char;
    }
    return c;
}
