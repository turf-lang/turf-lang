unsafe module;

// ─── strings.tr ──────────────────────────────────────────────────────────────
// String utility library for TurfLang.
//
// Design:
//   - All C functions are declared via `extern fn` (FFI), not @intrinsic.
//   - malloc is declared directly here to avoid inter-stdlib import issues.
//   - High-level functions are implemented in Turf on top of the C bindings.
//   - String ordering uses byte-by-byte strcmp (Decision D2). Unicode-aware
//     sorting belongs in a future `unicode` module.
//   - `strings::length(s)` is the way to get string length. The bare
//     `lengthof(s)` intrinsic that used to exist has been removed entirely
//     (STRING_UFCS_OPERATOR_CHAR_RFC.md §7 step 7).
//
// Usage:
//   import strings;
//   if strings::contains("hello world", "world") { ... }
//   mut upper: string = strings::to_upper("hello");

import sys;
// split()/join() below return/take `List<string>`. list.tr only imports
// mem/sys (never strings), so pulling it in here does not create the
// inter-stdlib import cycle this file otherwise avoids (confirmed by
// actually compiling tests/13_string_stdlib/18_str_split_join.tr etc.).
import list::List;

// ─── C bindings ───────────────────────────────────────────────────────────────

extern fn malloc(size: int): void*;
extern fn strlen(s: string): int;
extern fn strstr(haystack: string, needle: string): string;
extern fn strncpy(dst: string, src: string, n: int): string;
extern fn strcpy(dst: string, src: string): string;
extern fn strcat(dst: string, src: string): string;
// strcmp/toupper/tolower are declared with their REAL C ABI signatures --
// all three genuinely take/return a 32-bit C `int`, not Turf's 64-bit
// `int`. Declaring them as `int` builds the wrong LLVM function signature
// (a real, confirmed bug: strcmp() silently read back as an unsigned
// 4294967295 instead of signed -1, because the call read a full 64-bit
// register through a prototype that only ever had 32 valid bits). See
// Int32Type's doc comment in Types.h.
extern fn strcmp(a: string, b: string): int32;
extern fn toupper(c: int32): int32;
extern fn tolower(c: int32): int32;

// ─── operator overloads ─────────────────────────────────────────────────────
//
// String is a compiler-recognized type with ZERO hardcoded operator
// behavior (STRING_UFCS_OPERATOR_CHAR_RFC.md §1) -- `+`/`==`/`!=`/`< > <= >=`
// on two strings are ordinary `operator` overloads, resolved the same way
// any user-defined operator overload would be. This is the first real
// consumer of the `operator` keyword/resolution mechanism (RFC §7 step 3),
// and it's the reason `strings` module functions below must only ever use
// `int`-typed comparisons/arithmetic internally (never string `+`/`==` on
// themselves) -- doing so would try to resolve against these same
// definitions recursively. `operator +`'s body mirrors exactly what used to
// be Codegen's hardcoded EmitStringConcat, including the same TURF-MEMLEAK
// tradeoff: the malloc'd buffer is intentionally never freed (Turf has no
// GC yet); future work is an arena allocator or a Boehm GC sweep.

operator +(a: string, b: string): string {
    mut n: int = strlen(a) + strlen(b) + 1;
    mut buf: string = malloc(n) to string;
    strcpy(buf, a);
    strcat(buf, b);
    return buf;
}

operator ==(a: string, b: string): bool {
    return strcmp(a, b) == 0;
}

operator !=(a: string, b: string): bool {
    return strcmp(a, b) != 0;
}

operator <(a: string, b: string): bool {
    return strcmp(a, b) < 0;
}

operator >(a: string, b: string): bool {
    return strcmp(a, b) > 0;
}

operator <=(a: string, b: string): bool {
    return strcmp(a, b) <= 0;
}

operator >=(a: string, b: string): bool {
    return strcmp(a, b) >= 0;
}

// ─── length ───────────────────────────────────────────────────────────────────

// length: returns the byte-length of string `s`.
// The `lengthof(s)` intrinsic this replaced has been removed entirely.
fn length(s: string): int {
    return strlen(s);
}

// ─── contains ─────────────────────────────────────────────────────────────────

// contains: returns true if `needle` occurs anywhere in `s`.
fn contains(s: string, needle: string): bool {
    mut result: string = strstr(s, needle);
    return result != null;
}

// ─── index_of ─────────────────────────────────────────────────────────────────

// index_of: returns the byte offset of the first occurrence of `needle` in `s`,
// or -1 if not found. Returns -1 if needle is not found.
fn index_of(s: string, needle: string): int {
    mut found: string = strstr(s, needle);
    if found == null {
        return 0 - 1;
    }
    // Walk s to find where needle starts
    mut i: int = 0;
    mut n: int = strlen(s);
    mut nlen: int = strlen(needle);
    while i <= n - nlen {
        mut is_match: bool = true;
        mut j: int = 0;
        while j < nlen {
            if s[i + j] != needle[j] {
                is_match = false;
            }
            j = j + 1;
        }
        if is_match {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

// ─── starts_with ──────────────────────────────────────────────────────────────

// starts_with: returns true if `s` begins with `prefix`.
fn starts_with(s: string, prefix: string): bool {
    mut plen: int = strlen(prefix);
    mut slen: int = strlen(s);
    if plen > slen {
        return false;
    }
    mut i: int = 0;
    while i < plen {
        if s[i] != prefix[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// ─── ends_with ────────────────────────────────────────────────────────────────

// ends_with: returns true if `s` ends with `suffix`.
fn ends_with(s: string, suffix: string): bool {
    mut slen: int = strlen(s);
    mut suflen: int = strlen(suffix);
    if suflen > slen {
        return false;
    }
    mut offset: int = slen - suflen;
    mut i: int = 0;
    while i < suflen {
        if s[offset + i] != suffix[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// ─── repeat ───────────────────────────────────────────────────────────────────

// repeat: returns a string consisting of `n` copies of `s` concatenated.
fn repeat(s: string, n: int): string {
    mut result: string = "";
    mut i: int = 0;
    while i < n {
        result = result + s;
        i = i + 1;
    }
    return result;
}

// ─── count_char ───────────────────────────────────────────────────────────────

// count_char: returns the number of times the character with code `ch` appears in `s`.
fn count_char(s: string, ch: int): int {
    mut count: int = 0;
    mut i: int = 0;
    mut n: int = strlen(s);
    while i < n {
        if s[i] == ch {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

// ─── substring ────────────────────────────────────────────────────────────────

// substring: returns the slice of `s` from byte index `start` (inclusive) to
// `end` (exclusive). Aborts if the range is out of bounds.
fn substring(s: string, start: int, end: int): string {
    mut n: int = strlen(s);
    if start < 0 || end < start || end > n {
        sys::panic("strings.substring: index out of bounds");
    }
    mut len: int = end - start;
    // Allocate len+1 bytes (for null terminator)
    mut buf: string = malloc(len + 1) to string;
    mut i: int = 0;
    while i < len {
        buf[i] = s[start + i];
        i = i + 1;
    }
    buf[len] = 0;
    return buf;
}

// ─── replace ──────────────────────────────────────────────────────────────────

// replace: returns a copy of `s` with every non-overlapping occurrence of `old`
// replaced by `new_str`.
fn replace(s: string, old: string, new_str: string): string {
    mut result: string = "";
    mut oldlen: int = strlen(old);
    if oldlen == 0 {
        return s;
    }
    mut slen: int = strlen(s);
    mut i: int = 0;
    while i < slen {
        mut is_match: bool = true;
        if i + oldlen > slen {
            is_match = false;
        }
        if is_match {
            mut j: int = 0;
            while j < oldlen {
                if s[i + j] != old[j] {
                    is_match = false;
                }
                j = j + 1;
            }
        }
        if is_match {
            result = result + new_str;
            i = i + oldlen;
        } else {
            // Append single character as a 2-byte heap buffer
            mut chbuf: string = malloc(2) to string;
            chbuf[0] = s[i];
            chbuf[1] = 0;
            result = result + chbuf;
            i = i + 1;
        }
    }
    return result;
}

// ─── to_upper ─────────────────────────────────────────────────────────────────

// to_upper: returns a copy of `s` with all ASCII lowercase letters uppercased.
fn to_upper(s: string): string {
    mut n: int = strlen(s);
    mut buf: string = malloc(n + 1) to string;
    mut i: int = 0;
    while i < n {
        buf[i] = toupper(s[i] to int32);
        i = i + 1;
    }
    buf[n] = 0;
    return buf;
}

// ─── to_lower ─────────────────────────────────────────────────────────────────

// to_lower: returns a copy of `s` with all ASCII uppercase letters lowercased.
fn to_lower(s: string): string {
    mut n: int = strlen(s);
    mut buf: string = malloc(n + 1) to string;
    mut i: int = 0;
    while i < n {
        buf[i] = tolower(s[i] to int32);
        i = i + 1;
    }
    buf[n] = 0;
    return buf;
}

// ─── trim ─────────────────────────────────────────────────────────────────────

// trim: returns `s` with leading and trailing ASCII whitespace removed.
// Whitespace: space (32), tab (9), newline (10), carriage return (13).
fn trim(s: string): string {
    mut n: int = strlen(s);
    mut start_idx: int = 0;
    mut end_idx: int = n;
    while start_idx < n && (s[start_idx] == 32 || s[start_idx] == 9 || s[start_idx] == 10 || s[start_idx] == 13) {
        start_idx = start_idx + 1;
    }
    while end_idx > start_idx && (s[end_idx - 1] == 32 || s[end_idx - 1] == 9 || s[end_idx - 1] == 10 || s[end_idx - 1] == 13) {
        end_idx = end_idx - 1;
    }
    return substring(s, start_idx, end_idx);
}

// ─── trim_start / trim_end ─────────────────────────────────────────────────────

// trim_start: returns `s` with leading ASCII whitespace removed (trailing
// whitespace, if any, is left alone). Same whitespace set as `trim`.
fn trim_start(s: string): string {
    mut n: int = strlen(s);
    mut start_idx: int = 0;
    while start_idx < n && (s[start_idx] == 32 || s[start_idx] == 9 || s[start_idx] == 10 || s[start_idx] == 13) {
        start_idx = start_idx + 1;
    }
    return substring(s, start_idx, n);
}

// trim_end: returns `s` with trailing ASCII whitespace removed (leading
// whitespace, if any, is left alone). Same whitespace set as `trim`.
fn trim_end(s: string): string {
    mut n: int = strlen(s);
    mut end_idx: int = n;
    while end_idx > 0 && (s[end_idx - 1] == 32 || s[end_idx - 1] == 9 || s[end_idx - 1] == 10 || s[end_idx - 1] == 13) {
        end_idx = end_idx - 1;
    }
    return substring(s, 0, end_idx);
}

// ─── split / join ───────────────────────────────────────────────────────────────
//
// split()'s two edge cases, decided explicitly rather than left ambiguous:
//   - Empty `delimiter`: splitting on "" is not well-defined (it could mean
//     "one piece per byte" or "no-op"); this returns a single-element list
//     containing all of `s` unchanged, treating an empty delimiter as "no
//     real delimiter given" rather than silently exploding every string
//     into one-byte pieces.
//   - `delimiter` not found anywhere in `s`: also returns a single-element
//     list containing all of `s` -- exactly like Python's/JS's `.split()`,
//     so `split(s, d).length() == 1` is the normal way callers detect "no
//     delimiter present" without a separate contains() check first.
// join() is split()'s exact inverse: `join(split(s, d), d) == s` holds for
// any `s`/non-empty `d` where `d` doesn't appear at the very start/end
// (matches every other language's split/join pair -- e.g. splitting
// "a,,b" on "," produces ["a", "", "b"], and joining that back with ","
// reproduces "a,,b" exactly).

// split: splits `s` on every non-overlapping occurrence of `delimiter`,
// returning the pieces (in order, including empty pieces between adjacent
// delimiters) as a `List<string>`. See the block comment above for the
// empty-delimiter and no-match behavior.
fn split(s: string, delimiter: string): List<string> {
    mut result: List<string> = List::default();
    mut dlen: int = strlen(delimiter);
    mut slen: int = strlen(s);
    if dlen == 0 {
        result.push(s);
        return result;
    }
    mut start: int = 0;
    mut i: int = 0;
    while i <= slen - dlen {
        mut is_match: bool = true;
        mut j: int = 0;
        while j < dlen {
            if s[i + j] != delimiter[j] {
                is_match = false;
            }
            j = j + 1;
        }
        if is_match {
            result.push(substring(s, start, i));
            i = i + dlen;
            start = i;
        } else {
            i = i + 1;
        }
    }
    result.push(substring(s, start, slen));
    return result;
}

// join: concatenates every element of `items` in order, separated by `sep`
// (no leading/trailing `sep`). Returns "" for an empty list. The exact
// inverse of `split` -- see the block comment above.
fn join(items: List<string>, sep: string): string {
    mut result: string = "";
    mut n: int = items.length();
    mut i: int = 0;
    while i < n {
        if i > 0 {
            result = result + sep;
        }
        result = result + items.data[i];
        i = i + 1;
    }
    return result;
}

// ─── pad_left / pad_right ───────────────────────────────────────────────────────

// pad_left: pads `s` on the left with `pad_char` until it is `target_len`
// bytes long. Returns `s` unchanged if it is already `target_len` bytes or
// longer.
fn pad_left(s: string, target_len: int, pad_char: char): string {
    mut n: int = strlen(s);
    if n >= target_len {
        return s;
    }
    mut pad_count: int = target_len - n;
    mut buf: string = malloc(target_len + 1) to string;
    mut i: int = 0;
    while i < pad_count {
        buf[i] = pad_char to int;
        i = i + 1;
    }
    mut j: int = 0;
    while j < n {
        buf[pad_count + j] = s[j];
        j = j + 1;
    }
    buf[target_len] = 0;
    return buf;
}

// pad_right: pads `s` on the right with `pad_char` until it is `target_len`
// bytes long. Returns `s` unchanged if it is already `target_len` bytes or
// longer.
fn pad_right(s: string, target_len: int, pad_char: char): string {
    mut n: int = strlen(s);
    if n >= target_len {
        return s;
    }
    mut buf: string = malloc(target_len + 1) to string;
    mut i: int = 0;
    while i < n {
        buf[i] = s[i];
        i = i + 1;
    }
    while i < target_len {
        buf[i] = pad_char to int;
        i = i + 1;
    }
    buf[target_len] = 0;
    return buf;
}

// ─── parse_int / parse_double ───────────────────────────────────────────────────
//
// Unlike `substring`'s out-of-bounds check (a programming bug -- hard
// panic via sys::panic()), a malformed number is ordinary, expected input
// (e.g. parsing a line of user/file/network input) -- these report failure
// through the `!T` error-union return type instead, so the caller decides
// how to recover (`recover produce 0` / `recover as err run { ... }`),
// exactly like math::divide's DivisionByZero. Hand-rolled digit parsing
// (no atoi/atof binding) so the failure paths -- empty string, a bare "-",
// a non-digit byte, more than one "." -- are all real, checked error
// returns instead of C's atoi/atof silently returning 0 on garbage input.

error StringParseError {
    InvalidInt,
    InvalidDouble,
}

// parse_int: parses `s` as a base-10 integer, with an optional leading `-`.
// Fails on an empty string, a bare "-", or any non-digit byte.
fn parse_int(s: string): !int {
    mut n: int = strlen(s);
    if n == 0 {
        return StringParseError::InvalidInt;
    }
    mut i: int = 0;
    mut neg: bool = false;
    if s[0] == 45 { // '-'
        neg = true;
        i = 1;
    }
    if i >= n {
        return StringParseError::InvalidInt;
    }
    mut result: int = 0;
    while i < n {
        mut c: int = s[i];
        if c < 48 || c > 57 {
            return StringParseError::InvalidInt;
        }
        result = result * 10 + (c - 48);
        i = i + 1;
    }
    if neg {
        result = 0 - result;
    }
    return result;
}

// parse_double: parses `s` as a base-10 decimal number, with an optional
// leading `-` and at most one `.`. Fails on an empty string, a bare "-",
// any non-digit byte outside the single decimal point, or a string with
// no digits at all (e.g. "-" or ".").
fn parse_double(s: string): !double {
    mut n: int = strlen(s);
    if n == 0 {
        return StringParseError::InvalidDouble;
    }
    mut i: int = 0;
    mut neg: bool = false;
    if s[0] == 45 { // '-'
        neg = true;
        i = 1;
    }
    if i >= n {
        return StringParseError::InvalidDouble;
    }
    mut saw_digit: bool = false;
    mut int_part: double = 0.0;
    while i < n && s[i] != 46 { // '.'
        mut c: int = s[i];
        if c < 48 || c > 57 {
            return StringParseError::InvalidDouble;
        }
        int_part = int_part * 10.0 + ((c - 48) to double);
        saw_digit = true;
        i = i + 1;
    }
    mut frac_part: double = 0.0;
    if i < n && s[i] == 46 { // '.'
        i = i + 1;
        mut frac_div: double = 1.0;
        while i < n {
            mut c: int = s[i];
            if c < 48 || c > 57 {
                return StringParseError::InvalidDouble;
            }
            frac_div = frac_div * 10.0;
            frac_part = frac_part + ((c - 48) to double) / frac_div;
            saw_digit = true;
            i = i + 1;
        }
    }
    if !saw_digit {
        return StringParseError::InvalidDouble;
    }
    mut result: double = int_part + frac_part;
    if neg {
        result = 0.0 - result;
    }
    return result;
}
