// ─── array.tr ────────────────────────────────────────────────────────────────
// UFCS-callable helpers for arrays (STRING_UFCS_OPERATOR_CHAR_RFC.md §5.3).
// Part of the prelude -- always in scope, no explicit `import array;` needed.
//
// Two real constraints shape every function below:
//
// 1. UFCS is NOT generic (RFC step 4, TypeChecker::tryUFCSFallback()'s
//    receiver matching is a plain, non-generic exact-element-type match) --
//    so there is one concrete overload per element type (int[]/double[]/
//    string[]), not a single `fn<T>` version. A caller needing another
//    element type can still reach for the equivalent `list<T>` (list.tr),
//    which IS a real generic type.
//
// 2. An "unsized" array parameter (`arr: int[]`, the spelling that accepts
//    an argument of ANY concrete length) has its size erased entirely --
//    `arr.length()` inside such a function returns -1, not the caller's
//    real length, because Size == -1 is baked into the parameter's static
//    type. There is no way to recover it at runtime. Every function here
//    therefore takes an explicit `len: int` alongside the array, exactly
//    like the existing `sumFive`-style pattern already used elsewhere in
//    the codebase (tests/05_arrays_pointers_ffi/10_array_unsized_param.tr).
//    Call as `arr.sum(len)`, `array::sum(arr, len)`, etc.

pub fn sum(arr: int[], len: int): int {
    mut total: int = 0;
    mut i: int = 0;
    while i < len {
        total += arr[i];
        i++;
    }
    return total;
}

pub fn sum(arr: double[], len: int): double {
    mut total: double = 0.0;
    mut i: int = 0;
    while i < len {
        total += arr[i];
        i++;
    }
    return total;
}

pub fn max(arr: int[], len: int): int {
    mut best: int = arr[0];
    mut i: int = 1;
    while i < len {
        if arr[i] > best {
            best = arr[i];
        }
        i++;
    }
    return best;
}

pub fn max(arr: double[], len: int): double {
    mut best: double = arr[0];
    mut i: int = 1;
    while i < len {
        if arr[i] > best {
            best = arr[i];
        }
        i++;
    }
    return best;
}

pub fn min(arr: int[], len: int): int {
    mut best: int = arr[0];
    mut i: int = 1;
    while i < len {
        if arr[i] < best {
            best = arr[i];
        }
        i++;
    }
    return best;
}

pub fn min(arr: double[], len: int): double {
    mut best: double = arr[0];
    mut i: int = 1;
    while i < len {
        if arr[i] < best {
            best = arr[i];
        }
        i++;
    }
    return best;
}

pub fn contains(arr: int[], len: int, val: int): bool {
    mut i: int = 0;
    while i < len {
        if arr[i] == val {
            return true;
        }
        i++;
    }
    return false;
}

pub fn contains(arr: double[], len: int, val: double): bool {
    mut i: int = 0;
    while i < len {
        if arr[i] == val {
            return true;
        }
        i++;
    }
    return false;
}

pub fn contains(arr: string[], len: int, val: string): bool {
    mut i: int = 0;
    while i < len {
        if arr[i] == val {
            return true;
        }
        i++;
    }
    return false;
}

pub fn index_of(arr: int[], len: int, val: int): int {
    mut i: int = 0;
    while i < len {
        if arr[i] == val {
            return i;
        }
        i++;
    }
    return 0 - 1;
}

pub fn index_of(arr: double[], len: int, val: double): int {
    mut i: int = 0;
    while i < len {
        if arr[i] == val {
            return i;
        }
        i++;
    }
    return 0 - 1;
}

pub fn index_of(arr: string[], len: int, val: string): int {
    mut i: int = 0;
    while i < len {
        if arr[i] == val {
            return i;
        }
        i++;
    }
    return 0 - 1;
}
