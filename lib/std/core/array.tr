// ─── array.tr ────────────────────────────────────────────────────────────────
// UFCS-callable helpers for arrays (STRING_UFCS_OPERATOR_CHAR_RFC.md §5.3).
// Part of the prelude -- always in scope, no explicit `import array;` needed.
//
// Two real constraints shape every function below:
//
// 1. UFCS is NOT generic (RFC step 4, TypeChecker::tryUFCSFallback()'s
//    receiver matching is a plain, non-generic exact-element-type match) --
//    so there is one concrete overload per element type (int[]/double[]/
//    string[]), not a single `fn<T>` version. A caller needing another
//    element type can still reach for the equivalent `list<T>` (list.tr),
//    which IS a real generic type.
//
// 2. Every function here takes an explicit `len: int` alongside the array.
//    They were written when an unsized parameter (`arr: int[]`) could not
//    know its own length; since issue #260 it can (`arr.length()`, for-each,
//    bounds-checked `arr[i]`), so `len` is no longer needed to stay in
//    bounds -- a `len` past the end now panics instead of reading past it.
//    The signatures are part of the 2.x stdlib surface (FREEZE.md §6.20),
//    so they stay. Call as `arr.sum(len)`, `array::sum(arr, len)`, etc.

pub fn sum(arr: int[], len: int): int {
    mut total: int = 0;
    mut i: int = 0;
    while i < len {
        total += arr[i];
        i++;
    }
    return total;
}

pub fn sum(arr: double[], len: int): double {
    mut total: double = 0.0;
    mut i: int = 0;
    while i < len {
        total += arr[i];
        i++;
    }
    return total;
}

pub fn max(arr: int[], len: int): int {
    mut best: int = arr[0];
    mut i: int = 1;
    while i < len {
        if arr[i] > best {
            best = arr[i];
        }
        i++;
    }
    return best;
}

pub fn max(arr: double[], len: int): double {
    mut best: double = arr[0];
    mut i: int = 1;
    while i < len {
        if arr[i] > best {
            best = arr[i];
        }
        i++;
    }
    return best;
}

pub fn min(arr: int[], len: int): int {
    mut best: int = arr[0];
    mut i: int = 1;
    while i < len {
        if arr[i] < best {
            best = arr[i];
        }
        i++;
    }
    return best;
}

pub fn min(arr: double[], len: int): double {
    mut best: double = arr[0];
    mut i: int = 1;
    while i < len {
        if arr[i] < best {
            best = arr[i];
        }
        i++;
    }
    return best;
}

pub fn contains(arr: int[], len: int, val: int): bool {
    mut i: int = 0;
    while i < len {
        if arr[i] == val {
            return true;
        }
        i++;
    }
    return false;
}

pub fn contains(arr: double[], len: int, val: double): bool {
    mut i: int = 0;
    while i < len {
        if arr[i] == val {
            return true;
        }
        i++;
    }
    return false;
}

pub fn contains(arr: string[], len: int, val: string): bool {
    mut i: int = 0;
    while i < len {
        if arr[i] == val {
            return true;
        }
        i++;
    }
    return false;
}

pub fn index_of(arr: int[], len: int, val: int): int {
    mut i: int = 0;
    while i < len {
        if arr[i] == val {
            return i;
        }
        i++;
    }
    return 0 - 1;
}

pub fn index_of(arr: double[], len: int, val: double): int {
    mut i: int = 0;
    while i < len {
        if arr[i] == val {
            return i;
        }
        i++;
    }
    return 0 - 1;
}

pub fn index_of(arr: string[], len: int, val: string): int {
    mut i: int = 0;
    while i < len {
        if arr[i] == val {
            return i;
        }
        i++;
    }
    return 0 - 1;
}
