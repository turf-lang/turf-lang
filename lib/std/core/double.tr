// ─── double.tr ───────────────────────────────────────────────────────────────
// UFCS-callable helpers for `double` (STRING_UFCS_OPERATOR_CHAR_RFC.md §5.3).
// Part of the prelude -- always in scope, no explicit `import double;` needed.
//
// Deliberately minimal: arithmetic helpers (abs/min/max/clamp/power) already
// live in lib/std/math.tr and aren't duplicated here.
//
// NOTE: an `is_nan` helper (the standard `x != x` idiom) was considered and
// deliberately NOT added here -- Lint.cpp's self-comparison check has no
// type information and can't distinguish that legitimate idiom from a
// copy-paste bug (see tests/02_resolver/warn_self_comparison_nan.tr), so it
// always warns on `x != x`. That's an accepted tradeoff for ordinary user
// code, but this file is auto-imported into EVERY compile (it's part of the
// prelude) -- baking that warning into a helper here would mean literally
// every program compiled shows a warning about this file's own internals,
// regardless of whether the program ever calls the helper.

import math;

// sign: -1.0 / 0.0 / 1.0 depending on x's sign. Lint-clean (no self-
// comparison), and not something math.tr provides.
pub fn sign(x: double): double {
    if x > 0.0 {
        return 1.0;
    }
    if x < 0.0 {
        return 0.0 - 1.0;
    }
    return 0.0;
}

pub fn is_positive(x: double): bool {
    return x > 0.0;
}

pub fn is_negative(x: double): bool {
    return x < 0.0;
}

pub fn is_zero(x: double): bool {
    return x == 0.0;
}

// is_integer: true if x is a whole number. `floor(x) - x` is exactly 0 for a
// finite whole number and NaN for a NaN or an infinity (inf - inf), so both
// are false; a fractional x is nonzero. Never converts to `int`, so a value
// beyond int's range (1e300) answers instead of panicking.
pub fn is_integer(x: double): bool {
    return math::floor(x) - x == 0.0;
}

// round, floor, ceil: libm's, so they are exact for every double and pass a
// NaN or an infinity through, where converting to `int` and back panicked
// for those and for anything beyond int's range. round is half away from
// zero.
pub fn round(x: double): double {
    return math::round(x);
}

pub fn floor(x: double): double {
    return math::floor(x);
}

pub fn ceil(x: double): double {
    return math::ceil(x);
}
