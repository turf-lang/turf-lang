// std/collections.tr

struct List<T> {
  T* data,
  int len,
  int cap
}

fn void List<T>.init() {
  self.len = 0;
  self.cap = 4;
  self.data = malloc(sizeof(T) * self.cap) as T*;
}

fn void List<T>.push(T val) {
  if self.len == self.cap {
    self.cap = self.cap * 2;
    self.data = realloc(self.data as void*, sizeof(T) * self.cap) as T*;
  }
  self.data[self.len] = val;
  self.len = self.len + 1;
}

fn T List<T>.get(int i) {
  if i < 0 or i >= self.len {
    raise OutOfBoundsException("List index out of bounds");
  }
  return self.data[i];
}

fn void List<T>.set(int i, T val) {
  if i < 0 or i >= self.len {
    raise OutOfBoundsException("List index out of bounds");
  }
  self.data[i] = val;
}

fn int List<T>.length() {
  return self.len;
}

struct Stack<T> {
  List<T> items
}

fn void Stack<T>.init() {
  self.items = List<T>();
}

fn void Stack<T>.push(T val) {
  self.items.push(val);
}

fn T Stack<T>.pop() {
  if self.items.length() == 0 {
    raise OutOfBoundsException("Stack is empty");
  }
  self.items.len = self.items.len - 1;
  return self.items.data[self.items.len];
}

fn int Stack<T>.length() {
  return self.items.length();
}

struct Queue<T> {
  List<T> items,
  int head
}

fn void Queue<T>.init() {
  self.items = List<T>();
  self.head = 0;
}

fn void Queue<T>.enqueue(T val) {
  self.items.push(val);
}

fn T Queue<T>.dequeue() {
  if self.head >= self.items.length() {
    raise OutOfBoundsException("Queue is empty");
  }
  T val = self.items.get(self.head);
  self.head = self.head + 1;
  return val;
}

fn int Queue<T>.length() {
  return self.items.length() - self.head;
}
