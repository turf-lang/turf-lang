// std/collections.tr

import mem;

struct List<T> {
  T* data,
  int len,
  int cap
}

fn<T> List.init(): void {
  self.len = 0;
  self.cap = 4;
  self.data = mem.alloc(sizeof(T) * self.cap) as T*;
}

fn<T> List.push(val: T): void {
  if self.len == self.cap {
    self.cap = self.cap * 2;
    self.data = mem.grow(self.data as void*, sizeof(T) * self.cap) as T*;
  }
  self.data[self.len] = val;
  self.len = self.len + 1;
}

fn<T> List.get(i: int): T {
  if i < 0 or i >= self.len {
    fail("List index out of bounds");
  }
  return self.data[i];
}

fn<T> List.set(i: int, val: T): void {
  if i < 0 or i >= self.len {
    fail("List index out of bounds");
  }
  self.data[i] = val;
}

fn<T> List.length(): int {
  return self.len;
}

struct Stack<T> {
  items: List<T>
}

fn<T> Stack.init(): void {
  self.items = List<T>();
}

fn<T> Stack.push(val: T): void {
  self.items.push(val);
}

fn<T> Stack.pop(): T {
  if self.items.length() == 0 {
    fail("Stack is empty");
  }
  self.items.len = self.items.len - 1;
  return self.items.data[self.items.len];
}

fn<T> Stack.length(): int {
  return self.items.length();
}

struct Queue<T> {
  items: List<T>,
  head: int
}

fn<T> Queue.init(): void {
  self.items = List<T>();
  self.head = 0;
}

fn<T> Queue.enqueue(val: T): void {
  self.items.push(val);
}

fn<T> Queue.dequeue(): T {
  if self.head >= self.items.length() {
    fail("Queue is empty");
  }
  immutable val: T = self.items.get(self.head);
  self.head = self.head + 1;
  return val;
}

fn<T> Queue.length(): int {
  return self.items.length() - self.head;
}
