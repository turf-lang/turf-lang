// ─── test.tr ───────────────────────────────────────────────────────────────
// A minimal testing library for TurfLang.
//
// Design:
//   - fail/assert/assert_eq/assert_neq are ordinary Turf functions, not
//     compiler builtins -- they resolve through exactly the same overload
//     machinery as io::print (see io.tr), with no special-casing anywhere
//     in the compiler.
//   - fail() is a thin wrapper over sys::panic() -- this file owns the
//     name callers actually write in test code, sys.tr owns the mechanism
//     (write-to-stderr-then-abort) that every OTHER stdlib module's
//     internal guard rails also depend on. See sys.tr's own doc comment
//     for why that split exists.
//   - assert/assert_eq/assert_neq each have a 2-arg (default message) and a
//     3-arg (custom message) overload of the same name -- arity-overloading
//     is a real, compiler-supported feature (see io.tr's print/printline),
//     not something this file has to work around.
//   - assert_eq/assert_neq are only overloaded for int/double/bool/string --
//     the four types every existing test in this codebase actually compares.
//     Not attempted generically (`assert_eq<T>`): equality on an arbitrary
//     generic T isn't guaranteed to mean anything yet (operator overloading
//     doesn't exist), so a real per-type overload is both simpler and
//     actually correct.
//
// Usage:
//   import test;
//   test::assert(x == 5);
//   test::assert(x == 5, "x should be 5");
//   test::assert_eq(x, 5);
//   test::assert_eq(x, 5, "x should be 5");

import sys;
// String `==`/`!=`/`+` used below (assert_eq/assert_neq's string overloads,
// assert_fail_eq/assert_fail_neq's message building) are `operator`
// overloads defined in strings.tr, not compiler builtins anymore -- must be
// imported explicitly like any other operator consumer. See
// STRING_UFCS_OPERATOR_CHAR_RFC.md's Option-A visibility discussion: since
// virtually every test file already imports `test`, this is what makes
// string operators available everywhere with zero test-file edits, at the
// deliberate cost of them becoming de-facto globally visible in any program
// using the test harness.
import strings;

// ─── fail ──────────────────────────────────────────────────────────────────

// fail: print `msg` to stderr and terminate immediately. Never returns.
//
// STD-002 (ARCHITECTURE_OVERHAUL.md §8/§15.6(a)): `@caller_location` makes
// this report the ORIGINAL caller's file/line, not this file's own --
// before this, a failing test::assert() printed nothing but the message
// text, giving no clue which test (of possibly hundreds importing this
// same module) actually failed. `caller_location` is built into the
// message HERE, once, so sys::panic() itself needs no changes at all --
// every OTHER sys::panic() call site across lib/std (mem.tr, net.tr,
// list.tr, ...) is completely unaffected by this change; retrofitting
// those is explicitly out of this group's scope (see
// docs/development/changes/STD-002.md's own *Removed assumptions*).
@caller_location
pub fn fail(msg: string): void {
    sys::panic(caller_location + ": " + msg);
}

// ─── assert ────────────────────────────────────────────────────────────────

// Both overloads are `@caller_location` -- the 1-arg form's own internal
// call to the 2-arg form (below) is itself a call FROM a `@caller_location`
// function, so it forwards the ORIGINAL caller's location rather than
// stamping its own line inside this file (see include/Intrinsics.h §1's
// caller_location entry, and docs/architecture/boundary.md, for the
// forward-vs-stamp mechanism this relies on).
@caller_location
pub fn assert(cond: bool): void {
    assert(cond, "Oops! An assertion failed here.\nHint: Assertions are checks that make sure your code is running exactly as you expect. This one didn't pass.");
}

@caller_location
pub fn assert(cond: bool, msg: string): void {
    if !cond {
        fail(msg);
    }
}

// ─── assert_eq / assert_neq: int ──────────────────────────────────────────

pub fn assert_eq(left: int, right: int): void {
    assert_eq(left, right, "");
}

pub fn assert_eq(left: int, right: int, msg: string): void {
    if left != right {
        assert_fail_eq(left to string, right to string, msg);
    }
}

pub fn assert_neq(left: int, right: int): void {
    assert_neq(left, right, "");
}

pub fn assert_neq(left: int, right: int, msg: string): void {
    if left == right {
        assert_fail_neq(left to string, right to string, msg);
    }
}

// ─── assert_eq / assert_neq: double ───────────────────────────────────────

pub fn assert_eq(left: double, right: double): void {
    assert_eq(left, right, "");
}

pub fn assert_eq(left: double, right: double, msg: string): void {
    if left != right {
        assert_fail_eq(left to string, right to string, msg);
    }
}

pub fn assert_neq(left: double, right: double): void {
    assert_neq(left, right, "");
}

pub fn assert_neq(left: double, right: double, msg: string): void {
    if left == right {
        assert_fail_neq(left to string, right to string, msg);
    }
}

// ─── assert_eq / assert_neq: bool ─────────────────────────────────────────

pub fn assert_eq(left: bool, right: bool): void {
    assert_eq(left, right, "");
}

pub fn assert_eq(left: bool, right: bool, msg: string): void {
    if left != right {
        assert_fail_eq(left to string, right to string, msg);
    }
}

pub fn assert_neq(left: bool, right: bool): void {
    assert_neq(left, right, "");
}

pub fn assert_neq(left: bool, right: bool, msg: string): void {
    if left == right {
        assert_fail_neq(left to string, right to string, msg);
    }
}

// ─── assert_eq / assert_neq: string ────────────────────────────────────────

pub fn assert_eq(left: string, right: string): void {
    assert_eq(left, right, "");
}

pub fn assert_eq(left: string, right: string, msg: string): void {
    if left != right {
        assert_fail_eq(left, right, msg);
    }
}

pub fn assert_neq(left: string, right: string): void {
    assert_neq(left, right, "");
}

pub fn assert_neq(left: string, right: string, msg: string): void {
    if left == right {
        assert_fail_neq(left, right, msg);
    }
}

// ─── Shared failure-message formatting (private to this module) ──────────

pub fn assert_fail_eq(left: string, right: string, msg: string): void {
    mut detail: string = "assert_eq failed: " + left + " != " + right;
    if strings::length(msg) > 0 {
        fail(detail + " (" + msg + ")");
    } else {
        fail(detail);
    }
}

pub fn assert_fail_neq(left: string, right: string, msg: string): void {
    mut detail: string = "assert_neq failed: both sides equal " + left;
    if strings::length(msg) > 0 {
        fail(detail + " (" + msg + ")");
    } else {
        fail(detail);
    }
}
