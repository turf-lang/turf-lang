unsafe module;

// ─── mem.tr ──────────────────────────────────────────────────────────────────
// Low-level memory management for TurfLang.
//
// Design:
//   - All C allocator ABI functions are declared via `extern fn` (FFI), not
//     @intrinsic. This keeps the compiler free of hardcoded knowledge of these
//     functions. The linker resolves them against libc at link time.
//   - Turf-level helpers (alloc, grow, dup, zero) are implemented in Turf on
//     top of the C layer and provide checked, fail-fast variants of the raw
//     allocator calls.
//
// Usage:
//   import mem;
//   mut buf: void* = mem::alloc(1024);
//   mem::free(buf);
//
// NOTE: parameters are named `p`, not `ptr` -- `ptr` is this language's own
// reserved type keyword (the opaque-pointer type), so using it as a
// parameter name fails to parse ("Expected a parameter name in extern
// function '...'"). Discovered because that parse failure, when it happens
// inside an imported module specifically, used to crash the whole compiler
// with an unhandled C++ iostream exception instead of a clean diagnostic --
// see ParseFile()'s error-recovery fix in src/frontend/ParserModule.cpp for the compiler-
// side half of this fix; this file is the "don't actually trigger it"
// stdlib-side half.

import sys;

// ─── C allocator bindings ─────────────────────────────────────────────────────

// `@ownership` is how the compiler's double-free / use-after-free check learns
// what allocates and what releases: from these declarations, never from the
// names `malloc` or `free`. Any function, in any module, can say the same.
@ownership(acquires)
pub extern fn malloc(size: int): void*;

@ownership(acquires)
pub extern fn calloc(count: int, size: int): void*;

@ownership(acquires)
pub extern fn realloc(p: void*, new_size: int): void*;

// MEM-002: there used to be a plain `extern fn free(p: void*): void;` here,
// bound straight to libc. It's gone -- Turf's `extern fn` has no alias
// syntax (the declared Turf-level name IS the linked C symbol name,
// verified live: `src/frontend/ParserDecl.cpp`'s ExternFuncDeclExprAST has exactly
// one `Name_` field, used for both), so a checked wrapper could not also be
// named `free` in this same file without colliding with it (the same
// redeclaration conflict tests/21_extern_conflict/ exists to catch).
// `gc_checked_free(p)` (a bare intrinsic, same mechanism as `gc_alloc`)
// is the actual libc `free()` call now -- see its own doc comment in
// runtime/turfrt.h (`turf_rt_checked_free`) -- with the cross-heap check
// this file's own free() (below) wraps it in.

// posix_memalign's first parameter is genuinely a `void**` (an out-param:
// the C function writes the allocated address INTO the location this
// pointer points at) -- Turf has no separate "pointer to pointer" type,
// but `void*` is fully opaque at the LLVM level regardless of pointer
// depth, so it round-trips fine: alloc_aligned() below allocates its own
// 8-byte scratch slot, passes ITS address as this param, then reads the
// real result back out of that slot via an `int*` cast (the same
// pointer-indexed-read/write idiom net.tr's sockaddr_in construction and
// this file's own posix_memalign wrapper both already use).
pub extern fn posix_memalign(memptr: void*, alignment: int, size: int): int;

// glibc-specific (this codebase already targets glibc/Linux primarily --
// see e.g. net.tr's Linux-numbered socket constants). Reports how many
// bytes are ACTUALLY usable at `p`, which is often more than what was
// requested (malloc rounds up internally) -- useful for code that wants to
// opportunistically use any slack space without a realloc.
//
// Darwin spells the same function `malloc_size`, so this declaration says so
// with `@ffi(macos: ...)` and the compiler forwards to it there; the compiler
// has no table of libc names. There is deliberately no `windows:` entry: the C
// runtime's `_msize` is wrong for a block from posix_memalign (it corrupts the
// heap), and libturfrt defines `malloc_usable_size` itself on Windows, so the
// name binds to that.
@ffi(macos: malloc_size)
pub extern fn malloc_usable_size(p: void*): int;

// ─── Memory primitive bindings ────────────────────────────────────────────────

pub extern fn memcpy(dst: void*, src: void*, n: int): void*;
pub extern fn memmove(dst: void*, src: void*, n: int): void*;
pub extern fn memset(p: void*, val: int, n: int): void*;
pub extern fn memcmp(a: void*, b: void*, n: int): int;

// ─── Turf-level safe helpers ──────────────────────────────────────────────────

// alloc: allocate `size` bytes. Aborts on OOM.
@ownership(acquires)
pub fn alloc(size: int): void* {
    mut result: void* = malloc(size);
    if result == null {
        sys::panic("mem.alloc: out of memory");
    }
    return result;
}

// alloc_zeroed: allocate `count * elem_size` zero-initialised bytes. Aborts on OOM.
@ownership(acquires)
pub fn alloc_zeroed(count: int, elem_size: int): void* {
    mut result: void* = calloc(count, elem_size);
    if result == null {
        sys::panic("mem.alloc_zeroed: out of memory");
    }
    return result;
}

// grow: reallocate `p` to `new_size` bytes. Aborts on OOM.
@ownership(acquires)
pub fn grow(p: void*, new_size: int): void* {
    mut result: void* = realloc(p, new_size);
    if result == null {
        sys::panic("mem.grow: out of memory");
    }
    return result;
}

// dup: copy `n` bytes from `src` into a fresh heap buffer. Aborts on OOM.
@ownership(acquires)
pub fn dup(src: void*, n: int): void* {
    mut dst: void* = alloc(n);
    memcpy(dst, src, n);
    return dst;
}

// zero: write `n` zero bytes starting at `p`.
pub fn zero(p: void*, n: int): void {
    memset(p, 0, n);
}

// alloc_aligned: allocate `size` bytes aligned to `alignment` bytes
// (`alignment` must be a power of two and a multiple of `sizeof(void*)`,
// same requirement as the underlying posix_memalign()). Aborts on OOM or a
// bad alignment argument, matching every other checked helper in this file.
@ownership(acquires)
pub fn alloc_aligned(alignment: int, size: int): void* {
    mut out_slot: void* = malloc(8);
    immut result: int = posix_memalign(out_slot, alignment, size);
    if result != 0 {
        sys::panic("mem.alloc_aligned: allocation failed (bad alignment or out of memory)");
    }
    mut i_slot: int* = out_slot to int*;
    mut allocated: void* = i_slot[0] to void*;
    gc_checked_free(out_slot);
    return allocated;
}

// free: releases a manual-heap allocation obtained from alloc()/
// alloc_zeroed()/alloc_aligned()/grow()/dup(), or any other pointer the
// PROGRAMMER owns (F-MEM-3). Freeing a GC-heap pointer here instead -- a
// `string`, or a collection's backing buffer -- is the exact cross-heap
// mistake F-MEM-3 forbids ("the two heaps do not merge" -- MEM-001's own
// "Must NOT reinterpret" entry); gc_checked_free() (a bare intrinsic,
// runtime/turfrt.h's turf_rt_checked_free) is what turns that from
// undiagnosed corruption into a diagnosable runtime panic naming the
// mistake. Usage is unchanged from before this group: `mem::free(buf)`.
@ownership(releases: p)
pub fn free(p: void*): void {
    gc_checked_free(p);
}

// usable_size: how many bytes are ACTUALLY available at `p` (often more
// than what was originally requested -- the allocator rounds up
// internally). Lets code opportunistically use slack space without a
// realloc. See malloc_usable_size()'s own doc comment above for the
// glibc-specific caveat.
pub fn usable_size(p: void*): int {
    return malloc_usable_size(p);
}

// root: pins the GC object containing `p` so the collector never reclaims
// it, until a matching unroot(p) -- OVH-010
// (docs/planning/OVERHAUL_REMAINING_WORK.md), the answer §14.3/§14.6
// promised to F-MEM-3's own documented unsoundness: a GC pointer (a
// runtime-built `string`, a collection's backing buffer) stored ONLY
// inside a manual-heap struct (a `mem::alloc`'d buffer, a C library's own
// bookkeeping) is invisible to every other root-finding path -- it is not
// on the stack, not in a register, not behind a global root, and no other
// GC-heap block's own declared pointer words reach it either -- so the
// collector frees it out from under whoever's holding it in manual memory.
// `p` may be an interior pointer (e.g. `buf + k`, not only a block's exact
// start), exactly like a stack/register root; the whole object it points
// into is what gets pinned. Pins nest: two independent root(p) calls need
// two matching unroot(p) calls. A `p` that is not a GC-heap pointer at all
// is a documented no-op, not an error -- C memory (an `int` cast to
// `void*`, an FFI buffer) is legitimately passed through here too, and
// pinning it would be meaningless.
pub fn root(p: void*): void {
    gc_pin(p);
}

// unroot: releases one pin root(p) placed on the GC object containing `p`.
// Panics if that object currently has no outstanding pin at all -- an
// unbalanced unroot() (never rooted, or already fully unrooted) is treated
// as a programmer error worth surfacing, unlike root()'s own silent no-op
// for a `p` that was never a GC pointer to begin with (see root()'s own
// doc comment just above for that asymmetry's reasoning).
pub fn unroot(p: void*): void {
    gc_unpin(p);
}

// ─── Pool: bulk-free allocation tracking ────────────────────────────────────
//
// A Pool records manual allocations so one call frees them all, e.g. once per
// request in a server. It is not a bump-pointer arena: it hands out nothing
// itself, it only remembers pointers it is given.
//
// It is not generic, and holds `void*` only, so a GC-heap value (a `string`, a
// collection, a struct holding one) cannot be tracked: the pool's storage is
// manual memory the collector never scans, so a GC pointer kept only there
// would be freed under it (docs/architecture/boundary.md §6). Any `T*`
// converts to `void*` implicitly; a GC value needs an explicit `to void*`.
//
// It does not `import list;`, because list.tr imports this file and imports
// cannot be circular; its growth below is List.push()'s, on malloc/realloc.
//
// Usage:
//   import mem;
//   mut pool: mem::Pool = mem::Pool::default();
//   mut buf: void* = mem::alloc(256);
//   pool.track(buf);              // pool now owns `buf`'s lifetime
//   mem::free_pool(pool);         // frees every tracked allocation

// A Pool is a handle to one shared header, like every collection (FREEZE.md
// §6.27): copying it, or passing it by value, shares the tracked items, so a
// function that tracks into a pool it was handed tracks into the caller's.
// `Pool::default()` allocates the header (a `&U` field's default is a fresh
// `heap(U::default())`, F-COLL-2).
struct PoolHeader<T> {
    items: T*,
    len: int,
    cap: int
}

pub struct Pool {
    h: &PoolHeader<void*>
}

// Registers `item` with this pool. It allocates nothing for the item: pass a
// pointer from alloc()/alloc_zeroed()/alloc_aligned()/grow()/dup() (or any
// manual-heap pointer you own) to hand its lifetime to the pool.
pub fn Pool.track(item: void*): void {
    if self.h.len == self.h.cap {
        self.h.grow();
    }
    self.h.items[self.h.len] = item;
    self.h.len = self.h.len + 1;
}

// Doubles the capacity (starting at 8). Generic only so the new buffer can be
// cast to `T*`: there is no spelling for a pointer to `void*`.
fn<T> PoolHeader.grow(): void {
    if self.cap == 0 {
        self.cap = 8;
    } else {
        self.cap = self.cap * 2;
    }
    immut byte_size: int = self.cap * sizeof(T);
    if self.items == null {
        self.items = malloc(byte_size) to T*;
    } else {
        self.items = realloc(self.items, byte_size) to T*;
    }
}

// How many allocations this pool is currently tracking.
pub fn Pool.length(): int {
    return self.h.len;
}

// Frees every tracked allocation and this pool's own backing array. The pool
// is left empty, and every copy of it with it, so freeing it again, or
// tracking into it afterwards, is safe.
pub fn free_pool(pool: Pool): void {
    mut i: int = 0;
    while i < pool.h.len {
        free(pool.h.items[i]);
        i = i + 1;
    }
    if pool.h.items != null {
        free(pool.h.items);
    }
    pool.h.items = null;
    pool.h.len = 0;
    pool.h.cap = 0;
}
