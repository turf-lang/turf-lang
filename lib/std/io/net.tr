unsafe module;

// ─── net.tr ────────────────────────────────────────────────────────────────
// TCP networking for TurfLang.
//
// Design:
//   - Wraps the raw POSIX sockets API (socket/bind/listen/accept/connect/
//     recv/send) behind two ordinary Turf structs, exactly like io.tr wraps
//     libc's printf/scanf and mem.tr wraps malloc/free -- the `extern fn`
//     declarations, `void*` handling, and the sockaddr_in byte-layout trick
//     all live in here, never in caller code.
//   - `TcpListener` is a server-side listening socket; `TcpConnection` is
//     either an accepted inbound connection or an outbound client
//     connection -- the same struct either way, since once connected a
//     socket is symmetric (both ends just read()/write()).
//
// Why the address is 4 separate int octets (`connect(127, 0, 0, 1, 8080)`)
// instead of a single "127.0.0.1" string: `struct sockaddr_in` needs a raw
// 32-bit address in a specific byte layout, and strings.tr doesn't have a
// dotted-decimal parser (splitting on '.') yet -- four octets sidesteps
// needing one, and is itself a completely ordinary shape for a low-level
// sockets API. `TcpListener::bind()` doesn't take an address at all since a
// listener always binds all interfaces (equivalent to C's INADDR_ANY).
//
// Usage:
//   import net;
//
//   // Server
//   mut server: net::TcpListener = net::TcpListener::bind(8080) recover run {
//       sys::exit(1); // can't serve without a listening socket -- fatal
//   };
//   mut conn: net::TcpConnection = server.accept() recover run {
//       continue; // a single bad accept() shouldn't kill the whole server
//   };
//   immut request: string = conn.read(4096);
//   conn.write("hello back");
//   conn.close();
//
//   // Client
//   mut conn2: net::TcpConnection = net::TcpConnection::connect(127, 0, 0, 1, 8080) recover as err run {
//       if err == net::NetworkError::ConnectionRefused {
//           io::printline("nothing is listening on that host/port");
//       }
//       return;
//   };
//   conn2.write("hello server");
//   immut reply: string = conn2.read(4096);
//   conn2.close();
//
// connect()/bind()/accept() all return `!T` instead of aborting the process
// on failure (docs/planning/Errors.md) -- a refused connection, a port
// already in use, or a transient accept() failure are ordinary, expected
// outcomes for a network program, not bugs, so the caller decides how to
// recover instead of the whole process dying unconditionally.

import mem;

// ─── Socket bindings (private to this module) ──────────────────────────────
// Every call below that returns a C `int` is declared `int32`, not `int`: a
// callee writing -1 to the 32-bit return register leaves the upper half
// zero, so an `int` declaration reads 4294967295 and `fd >= 0` accepts every
// failure (tests/33_net_dns/02_accept_failure_is_reported.tr). recv()/send()
// return a 64-bit ssize_t on POSIX but a 32-bit int on Windows; they are
// declared `int32` for that reason, and their result is only ever a byte count
// far below 2^31 here (and is not read at all by this module).
//
// The things about TCP sockets that are NOT the same on every platform are in
// libturfrt, not here (runtime/turfrt_net.c has the reasons): starting Winsock,
// closing a socket (closesocket on Windows), SO_REUSEADDR (different numbers on
// Windows) and building a `struct sockaddr_in` (BSD/macOS has a length byte).
// bind, listen, accept, connect, recv, send and gethostbyname are the same
// function everywhere and are bound directly. A socket is an `int` here, which
// holds a Windows SOCKET too: its handles are small multiples of four.

extern fn turfrt_net_startup(): int32;
extern fn turfrt_net_socket(): int;
extern fn turfrt_net_close(fd: int): int32;
extern fn turfrt_net_reuseaddr(fd: int): int32;
extern fn turfrt_net_sockaddr(a: int, b: int, c: int, d: int, port: int): void*;
extern fn bind(fd: int, addr: void*, len: int): int32;
extern fn listen(fd: int, backlog: int): int32;
extern fn accept(fd: int, addr: void*, len: void*): int32;
extern fn connect(fd: int, addr: void*, len: int): int32;
extern fn recv(fd: int, buf: void*, len: int, flags: int): int32;
extern fn send(fd: int, buf: string, len: int, flags: int): int32;
extern fn strlen(s: string): int;

// The classic (deprecated, but still universally present and ABI-stable on
// Linux glibc) hostname-lookup call -- see resolve_hostname() below for the
// full explanation of why this one, and how its result is read.
extern fn gethostbyname(name: string): ptr;

// Named POSIX constants, exported so callers of net.tr could reference them
// too if they ever needed to (e.g. a future UdpSocket built the same way).
// They are the Linux values, and are exported API, so they are unchanged.
// AF_INET and SOCK_STREAM are the same on every platform; SOL_SOCKET and
// SO_REUSEADDR are NOT (0xffff and 4 on Windows and macOS). This module does not
// use these two itself any more (turfrt_net_reuseaddr does the setsockopt), so
// only a caller passing them to its own FFI call needs to know.
export immut AF_INET: int = 2;
export immut SOCK_STREAM: int = 1;
export immut SOL_SOCKET: int = 1;
export immut SO_REUSEADDR: int = 2;

// One variant per distinct syscall failure connect()/bind()/accept() can
// report (docs/planning/Errors.md) -- kept separate rather than one generic
// "NetworkError::Failed" so callers using `recover as err run { ... }` can
// still tell them apart (e.g. ConnectionRefused vs. a local socket() failure
// are very different things to react to), even though a variant itself
// carries no payload/message.
pub error NetworkError {
    SocketCreationFailed,
    ConnectionRefused,
    BindFailed,
    ListenFailed,
    AcceptFailed,
    ResolutionFailed,
}

// Resolves a hostname ("localhost", "example.com", ...) to a dotted-decimal
// IPv4 address string ("127.0.0.1", ...), so callers can connect by name
// instead of by four raw octets:
//
//   immut ip: string = net::resolve_hostname("localhost") recover produce "127.0.0.1";
//   mut conn: net::TcpConnection = net::TcpConnection::connect(...) // still needs octets, see below
//
// Returns `!string`: an unresolvable hostname (typo, no DNS record, no
// network at all) is an ordinary, expected outcome for a network program,
// not a bug -- the caller decides how to recover, same philosophy as
// connect()/bind()/accept() above.
//
// Implementation: binds the classic libc `struct hostent
// *gethostbyname(const char *name)`. It's deprecated in favor of
// getaddrinfo() (which is reentrant and IPv6-aware), but it's still
// universally present, and -- critically for a compiler that can't declare
// a Turf struct matching an arbitrary C struct's real memory layout --
// `struct hostent`'s layout is a stable, simple part of the Linux x86_64
// glibc ABI:
//
//   struct hostent {
//       char  *h_name;       // offset 0,  8 bytes (pointer)
//       char **h_aliases;    // offset 8,  8 bytes (pointer)
//       int    h_addrtype;   // offset 16, 4 bytes (int)
//       int    h_length;     // offset 20, 4 bytes (int)
//       char **h_addr_list;  // offset 24, 8 bytes (pointer) -- NULL-
//                             // terminated array of pointers, each to a
//                             // 4-byte (AF_INET) address in NETWORK byte
//                             // order
//   };
//
// This is the READING counterpart to build_sock_addr()'s WRITING technique
// above: no Turf struct can express this mixed 8-byte/4-byte-field layout,
// so this reads the raw bytes through pointer-indexed loads instead --
// `void* to int*` indexed loads, the same idiom list.tr/stack.tr use for
// their own `data: T*` fields, plus (new here) `void* to char*` indexed
// loads for single-BYTE granularity, needed for the final 4 address bytes.
//
// h_addrtype/h_length are two 4-byte C `int`s that together occupy exactly
// one 8-byte slot (bytes 16-23) -- every other field is an 8-byte pointer,
// so h_addr_list's byte offset (24) happens to land exactly on `int*`
// element index 3 (3 * 8 = 24). That's the one piece of luck that makes
// this doable with plain `int*` indexing instead of needing raw
// pointer-to-integer address arithmetic (which this language's `to` cast
// doesn't support directly for the opaque `ptr` type -- only `T* <-> int`,
// not `ptr <-> int`): every field this function actually touches sits on
// an 8-byte boundary.
//
// Once at h_addr_list[0] (the first resolved address, a pointer to 4 raw
// bytes in network order), `char*` indexing reads those bytes one at a
// time -- byte 0 of that 4-byte address is the first octet ("a" in
// "a.b.c.d"), since network byte order for a dotted-decimal address is
// just left-to-right, same as build_sock_addr()'s own addrPart comment notes.
pub fn resolve_hostname(host: string): !string {
    turfrt_net_startup();
    mut h: ptr = gethostbyname(host);
    if h == null {
        return NetworkError::ResolutionFailed("could not resolve host '" + host + "'");
    }

    // Byte offset 24 == int* element index 3 (24 / 8 == 3) -- see doc
    // comment above for why every field up to here is 8-byte aligned.
    mut ih: int* = h to int*;
    immut h_addr_list_raw: int = ih[3];
    if h_addr_list_raw == 0 {
        return NetworkError::ResolutionFailed("could not resolve host '" + host + "'");
    }

    // h_addr_list[0]: the first entry of the NULL-terminated
    // address-pointer array -- itself another pointer, to the actual
    // 4-byte address.
    mut h_addr_list: int* = h_addr_list_raw to int*;
    immut first_addr_raw: int = h_addr_list[0];
    if first_addr_raw == 0 {
        return NetworkError::ResolutionFailed("could not resolve host '" + host + "'");
    }

    // Now read the 4 individual address bytes at BYTE granularity --
    // this is the one place `int*`'s 8-byte stride is too coarse, so
    // `char*` (1-byte elements) is used instead.
    mut addr_bytes: char* = first_addr_raw to char*;
    immut a: int = addr_bytes[0] to int;
    immut b: int = addr_bytes[1] to int;
    immut c: int = addr_bytes[2] to int;
    immut d: int = addr_bytes[3] to int;

    return (a to string) + "." + (b to string) + "." + (c to string) + "." + (d to string);
}

// Builds a `struct sockaddr_in` for address a.b.c.d (all zero = INADDR_ANY,
// "any local interface") on the given port, ready to hand to bind()/connect().
// The runtime builds it with the platform's own struct, so the layout is right
// everywhere -- the Linux byte image this used to assemble by hand (family in the
// first two bytes, port and address in network order) is wrong on BSD/macOS,
// where the first byte is a length. Allocated with calloc: release it with
// mem::free(), as before.
fn build_sock_addr(a: int, b: int, c: int, d: int, port: int): void* {
    return turfrt_net_sockaddr(a, b, c, d, port);
}

// ─── TcpConnection ───────────────────────────────────────────────────────
// A connected socket -- either accepted server-side (from
// TcpListener.accept()) or dialed client-side (from
// TcpConnection::connect()). Symmetric once connected: both sides just
// read()/write().

pub struct TcpConnection {
    fd: int
}

pub fn TcpConnection.new(fd: int): void {
    self.fd = fd;
}

// Dial out to a.b.c.d:port. Returns `!TcpConnection`: a refused connection
// (nothing listening) or a local socket() failure are both ordinary,
// expected outcomes -- the caller decides how to recover.
pub fn TcpConnection.connect(a: int, b: int, c: int, d: int, port: int) static: !TcpConnection {
    mut fd: int = turfrt_net_socket();
    if !(fd >= 0) {
        return NetworkError::SocketCreationFailed("could not create a socket");
    }

    mut addr: void* = build_sock_addr(a, b, c, d, port);
    immut result: int = connect(fd, addr, 16);
    mem::free(addr);
    if !(result == 0) {
        return NetworkError::ConnectionRefused("connection to port " + (port to string) + " refused");
    }

    return TcpConnection::new(fd);
}

// Reads up to max_bytes from the connection. Returns whatever arrived
// (possibly less than max_bytes, possibly "" on a closed connection) as a
// string. Blocks until at least some data arrives or the peer closes.
//
// Deliberately does NOT free the buffer before returning: `string` and
// `void*` are the same opaque pointer at the LLVM level, so `buf to
// string` does not copy -- the returned string IS the buffer. Freeing it
// here would hand the caller a dangling pointer (confirmed live: the
// caller received corrupted/garbage bytes instead of the real response
// before this was fixed). Matches the exact convention io.tr's input()
// already established -- ownership of the heap buffer transfers to the
// caller, who is never expected to free it either (MEM-001 puts this on
// the GC heap -- gc_alloc_zeroed, not mem::alloc_zeroed, since a returned
// `string` is a language-owned result, F-MEM-3 -- but nothing collects
// yet, so it still leaks exactly as before; see EmitStringConcat's own
// TURF-MEMLEAK comment history in strings.tr). Zero-filled, not just
// malloc'd, for the same reason io::read_to_string() is: recv() may write
// fewer than max_bytes bytes, and the untouched tail needs to already be 0
// to serve as the string's NUL terminator.
pub fn TcpConnection.read(max_bytes: int): string {
    mut buf: void* = gc_alloc_zeroed(max_bytes + 1);
    recv(self.fd, buf, max_bytes, 0);
    return buf to string;
}

// Writes the entirety of `data` to the connection.
pub fn TcpConnection.write(data: string): void {
    send(self.fd, data, strlen(data), 0);
}

// The underlying file descriptor, for handing to FFI (`poll`, `fcntl`, ...) --
// the other half of TcpConnection::new(fd), which wraps one. -1 after close().
// A plain accessor, not a `pub fd` field: a public field would let a caller
// assign the descriptor, and a connection pointing at someone else's fd closes
// it.
pub fn TcpConnection.raw_fd(): int {
    return self.fd;
}

// Closes the connection. Idempotent (LEC-007): the descriptor is set to -1
// afterwards and a second close() does nothing. The reason is `defer
// conn.close();` plus an explicit close on an early path -- the second call
// used to close(2) the stale number, which by then can name a DIFFERENT, newly
// opened descriptor (the kernel reuses the lowest free one) and silently shuts
// an unrelated socket or file.
pub fn TcpConnection.close(): void {
    if self.fd < 0 {
        return;
    }
    turfrt_net_close(self.fd);
    self.fd = -1;
}

// ─── TcpListener ─────────────────────────────────────────────────────────
// A server-side listening socket, bound to all local interfaces.

pub struct TcpListener {
    fd: int
}

pub fn TcpListener.new(fd: int): void {
    self.fd = fd;
}

// Binds and starts listening on the given port (all interfaces). Sets
// SO_REUSEADDR so restarting a server doesn't fail with "address already
// in use" while the previous socket lingers in TIME_WAIT. Returns
// `!TcpListener`: a port already in use, or any other socket/bind/listen
// failure, is an ordinary startup condition the caller decides how to
// handle (most programs will just treat it as fatal via `recover run {
// sys::exit(1); }`, but that's the caller's call, not this function's).
pub fn TcpListener.bind(port: int) static: !TcpListener {
    mut fd: int = turfrt_net_socket();
    if !(fd >= 0) {
        return NetworkError::SocketCreationFailed("could not create a socket");
    }

    turfrt_net_reuseaddr(fd);

    mut addr: void* = build_sock_addr(0, 0, 0, 0, port);
    immut bind_result: int = bind(fd, addr, 16);
    mem::free(addr);
    if !(bind_result == 0) {
        return NetworkError::BindFailed("could not bind port " + (port to string));
    }

    immut listen_result: int = listen(fd, 128);
    if !(listen_result == 0) {
        return NetworkError::ListenFailed("could not listen on port " + (port to string));
    }

    return TcpListener::new(fd);
}

// Blocks until a client connects, then returns the accepted connection.
// Returns `!TcpConnection`: a single bad accept() shouldn't necessarily
// bring down a whole server -- the caller decides (commonly
// `recover run { continue; }` to just keep serving).
pub fn TcpListener.accept(): !TcpConnection {
    mut client_fd: int = accept(self.fd, null, null);
    if !(client_fd >= 0) {
        return NetworkError::AcceptFailed("could not accept a connection");
    }
    return TcpConnection::new(client_fd);
}

// The underlying file descriptor; -1 after close(). See TcpConnection.raw_fd.
pub fn TcpListener.raw_fd(): int {
    return self.fd;
}

// Stops listening and closes the socket. Idempotent, for the same reason as
// TcpConnection.close.
pub fn TcpListener.close(): void {
    if self.fd < 0 {
        return;
    }
    turfrt_net_close(self.fd);
    self.fd = -1;
}
