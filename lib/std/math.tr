@intrinsic("power")
fn power(base: int, exp: int): int

@intrinsic("power")
fn power(base: double, exp: int): double

@intrinsic("power")
fn power(base: int, exp: double): double

@intrinsic("power")
fn power(base: double, exp: double): double

@intrinsic("abs")
fn abs(val: int): int

@intrinsic("abs")
fn abs(val: double): double

@intrinsic("llvm.pow.f64")
fn pow(base: double, exp: double): double

@intrinsic("llvm.sqrt.f64")
fn sqrt(val: double): double

@intrinsic("llvm.sin.f64")
fn sin(val: double): double

@intrinsic("llvm.cos.f64")
fn cos(val: double): double

@intrinsic("llvm.floor.f64")
fn floor(val: double): double

@intrinsic("llvm.ceil.f64")
fn ceil(val: double): double

@intrinsic("llvm.round.f64")
fn round(val: double): double
