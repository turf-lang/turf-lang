// ─── math.tr ─────────────────────────────────────────────────────────────────
// Mathematical functions for TurfLang.
//
// Design:
//   - All C math functions are declared via `extern fn` (FFI), not @intrinsic.
//   - Functions that require libm are declared with `extern from "m"` so the
//     compiler automatically appends -lm to the linker flags.
//   - Turf-level wrappers implement overloaded variants and add new functions
//     (min, max, clamp, tan, log, etc.) that were previously unavailable.
//
// Usage:
//   import math;
//   mut x: double = math::sqrt(2.0);
//   mut n: int    = math::abs(-5);

// ─── libm bindings ────────────────────────────────────────────────────────────

extern from "m" fn pow(base: double, exp: double): double;
extern from "m" fn sqrt(val: double): double;
extern from "m" fn sin(val: double): double;
extern from "m" fn cos(val: double): double;
extern from "m" fn tan(val: double): double;
extern from "m" fn floor(val: double): double;
extern from "m" fn ceil(val: double): double;
extern from "m" fn round(val: double): double;
extern from "m" fn fabs(val: double): double;
extern from "m" fn log(val: double): double;
extern from "m" fn log2(val: double): double;
extern from "m" fn log10(val: double): double;
extern from "m" fn exp(val: double): double;

// ─── abs ─────────────────────────────────────────────────────────────────────

fn abs(val: double): double {
    return fabs(val);
}

fn abs(val: int): int {
    if val < 0 {
        return 0 - val;
    }
    return val;
}

// ─── power (four overloads, mirrors previous @intrinsic behaviour) ────────────

fn power(base: double, exp: double): double {
    return pow(base, exp);
}

fn power(base: int, exp: int): int {
    return pow(base to double, exp to double) to int;
}

fn power(base: int, exp: double): double {
    return pow(base to double, exp);
}

fn power(base: double, exp: int): double {
    return pow(base, exp to double);
}

// ─── min / max ────────────────────────────────────────────────────────────────

fn min(a: int, b: int): int {
    if a < b {
        return a;
    }
    return b;
}

fn min(a: double, b: double): double {
    if a < b {
        return a;
    }
    return b;
}

fn max(a: int, b: int): int {
    if a > b {
        return a;
    }
    return b;
}

fn max(a: double, b: double): double {
    if a > b {
        return a;
    }
    return b;
}

// ─── clamp ────────────────────────────────────────────────────────────────────

fn clamp(val: int, min_val: int, max_val: int): int {
    if val < min_val {
        return min_val;
    }
    if val > max_val {
        return max_val;
    }
    return val;
}

fn clamp(val: double, min_val: double, max_val: double): double {
    if val < min_val {
        return min_val;
    }
    if val > max_val {
        return max_val;
    }
    return val;
}
