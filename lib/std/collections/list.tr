unsafe module;

// list.tr — List<T>: a dynamically-growing array.
// Usage:
//   import list::List;   // (or `import list;` + spell it `list::List<int>` below)
//   mut l: List<int>;   // default-initialized -- no need to write out the fields
//   l.push(1);
//   l.push(2);
//   mut x: int = l.pop();   // 2
//   mut n: int = l.length(); // 1
//
// STD-003 item 8 considered (ARCHITECTURE_OVERHAUL.md §8) and DELIBERATELY
// NOT DONE: making `data` a safe `&T` instead of a raw `T*` looked
// straightforward in isolation, but `T` is genuinely unconstrained here --
// a caller can instantiate `List<SomeStruct*>` (item 2's own documented
// >8-byte-workaround pattern, still fully supported, not removed by this
// group) -- and once `T` is itself a raw pointer type, `List.push(item:
// T)` substitutes to a raw-pointer-typed PARAMETER
// (`checkNoRawPointersInSignature`, TypeCheckerCore.cpp), which requires
// the DECLARING FILE to hold the raw-pointer capability regardless of
// what `data`'s own field type is -- confirmed live:
// `List<Point*>.push(&pt1 to Point*)` failed with "cannot use raw pointer
// type 'Point*' for parameter 'item' ... even inside 'unsafe { }'" the
// moment `unsafe module;` was removed here. A scoped `unsafe { }` block
// around just the alloc/realloc calls (which is otherwise all this file
// would need) cannot satisfy that check, because the check runs against
// the FUNCTION'S OWN DECLARED SIGNATURE, not anything about how its body
// is written. This is a real, load-bearing reason item 8 doesn't apply to
// a module generic over an unconstrained `T` (see also map.tr/set.tr/
// stack.tr/queue.tr, all identically affected, and hashing.tr, which hit
// the exact same failure through its own `fn<T> hash(x: T): int` -- see
// each file's own note and this group's change record, *Known pitfalls*).

import sys;

struct List<T> {
  data: T*,
  len: int,
  cap: int
}

fn<T> List.push(item: T): void {
  if (self.len == self.cap) {
    if (self.cap == 0) {
      self.cap = 8;
    } else {
      self.cap = self.cap * 2;
    }

    // TYPE-002 (S14b): was `self.cap * 8` under Type Erasure, where every T
    // was assumed to fit in one uniform 8-byte slot -- wrong for a T over
    // 8 bytes (a real by-value struct element, S13b/S14a's own completion
    // criterion 2), which would under-allocate this buffer and silently
    // overflow it a few pushes later. sizeof(T) is now correct per
    // instantiation (monomorphized, S12a's own completion criterion 4) --
    // this is the ONE stdlib change this whole group permits itself
    // (ARCHITECTURE_OVERHAUL.md §8's TYPE-002 entry).
    immutable byteSize: int = self.cap * sizeof(T);

    if (self.data == null) {
      self.data = gc_alloc(byteSize) to T*;
    } else {
      self.data = gc_realloc(self.data, byteSize) to T*;
    }
  }

  self.data[self.len] = item;
  self.len = self.len + 1;
}

fn<T> List.pop(): T {
  if (self.len == 0) {
    sys::panic("List.pop: pop on empty list");
  }

  self.len = self.len - 1;
  return self.data[self.len];
}

fn<T> List.length(): int {
  return self.len;
}

// ─── get / set (OVH-003) ─────────────────────────────────────────────────────
//
// Bounds-checked, GENUINELY generic (unlike operator[]/[]= above, which are
// declared for the concrete List<int> only -- ParseOperatorDecl() parses no
// `<T>` block at all, see that declaration's own doc comment) element
// access for any T. Exists because `l.data[i]` -- the only way to read/
// write an element of a List<T> for T != int before this fix -- is a raw
// T* dereference, and OVH-003 (docs/planning/OVERHAUL_REMAINING_WORK.md)
// closed the gap where TypeChecker::visitArrayAccess() never gated that:
// `l.data[100000] = 42;` compiled with no `unsafe { }` and no capability,
// an out-of-bounds write reachable from ordinary safe code. `@caller_location`
// (STD-002) so the panic names the CALLER's line, not this one -- matching
// operator[]'s own message text, just with a location a caller-heavy stdlib
// consumer (json.tr, http.tr, ...) actually benefits from.
@caller_location
fn<T> List.get(i: int): T {
  if (i < 0 || i >= self.len) {
    sys::panic(caller_location + ": List.get: index out of bounds");
  }
  return self.data[i];
}

@caller_location
fn<T> List.set(i: int, value: T): void {
  if (i < 0 || i >= self.len) {
    sys::panic(caller_location + ": List.set: index out of bounds");
  }
  self.data[i] = value;
}

// ─── operator[] / operator[]= (LANG-001) ────────────────────────────────────
//
// The better form of the `get`/`set` this file's own LIMITATIONS.md §4 entry
// asked for -- `l[i]` and `l[i] = v` instead of named methods. Declared for
// the CONCRETE `List<int>` only, not genuinely generic over `T`, for the
// identical reason list_sort()/list_binary_search()/list_find() above are
// concrete rather than `fn<T> List....`: `operator` declarations are
// deliberately non-generic (ParseOperatorDecl() parses no `<T>` block at
// all -- see its own doc comment, src/ParserDecl.cpp) -- lifting that
// restriction is a genuinely separate parser/Resolver/Monomorphizer feature,
// not something LANG-001 asked for, and specializing on one concrete element
// type (matching this file's own established precedent) is what keeps this
// addition small and self-contained instead. Bounds-checked, matching
// index_of()'s absence of a bounds guard being the ODD one out here, not the
// norm -- every other List accessor (push/pop/the raw `self.data[i]` reads
// above) already trusts the caller; operator[] deliberately does not,
// since `l[i]` reads exactly like array indexing to a caller and array
// indexing IS bounds-checked everywhere else in the language.
operator [](l: List<int>, i: int): int {
  if (i < 0 || i >= l.len) {
    sys::panic("List[]: index out of bounds");
  }
  return l.data[i];
}

// Self taken BY VALUE, not `&List<int>` -- unlike a plain value struct,
// that's sufficient for this write to persist: `data` is a heap pointer
// (list_sort()'s own doc comment above makes the identical point about
// List<int> more generally), so copying the List<int> header still shares
// the same backing buffer, and `l.data[i] = value` writes through it.
operator []=(l: List<int>, i: int, value: int): void {
  if (i < 0 || i >= l.len) {
    sys::panic("List[]=: index out of bounds");
  }
  l.data[i] = value;
}

// ─── sort / search ──────────────────────────────────────────────────────────
//
// Genuinely generic `List<T>` methods (STD-003, ARCHITECTURE_OVERHAUL.md
// §8, item 3) -- NOT possible until this group. `sort`/`binary_search`/
// `find` used to be concrete, `List<int>`-only FREE functions
// (`list_sort`/`list_binary_search`/`list_find`, kept below as thin
// deprecated wrappers over these methods, for one cycle, per this group's
// own "prefer keeping wrappers" guidance) because a comparator parameter
// typed `fn(T, T): int` never type-checked correctly at the call site:
// nothing in the substitution machinery recursed into a `FuncType`'s own
// parameter/return types (`collectGenericSubstitution()`/
// `typesCompatible()` in `src/TypeCheckerCall.cpp`/`src/Types.cpp`,
// `Monomorphize::substituteConcreteTypes()`, and
// `Resolver::substituteTypeParams()` all special-cased pointers/arrays/
// `GenericType`, but none had a `FuncType` case). Fixed directly in the
// compiler as part of this group (all five call sites above), on the
// reasoning that `self.otherMethod(concreteArg)`-shaped code -- or, as
// here, a comparator callback -- is ordinary code any Turf program might
// write, not an internal-to-this-group inconvenience; see this group's own
// change record for the full root-cause writeup and live repro. The dead-
// end history that used to live here (four approaches tried, each
// confirmed broken) is preserved in that change record instead of
// duplicated in this file, now that the actual fix makes it historical
// rather than a live warning against "fixing this back."
//
// Insertion sort: O(n^2), but simple, obviously-correct, and stable -- fine
// for the small lists this stdlib deals with (see map.tr's identical
// "small collections, correctness over cleverness" reasoning for its own
// hash-collision handling).
fn<T> List.sort(cmp: fn(T, T): int): void {
  mut i: int = 1;
  while i < self.length() {
    immutable key: T = self.data[i];
    mut j: int = i - 1;
    while j >= 0 && cmp(self.data[j], key) > 0 {
      self.data[j + 1] = self.data[j];
      j = j - 1;
    }
    self.data[j + 1] = key;
    i = i + 1;
  }
}

// Binary search for `target` using the same `fn(T, T): int` comparator
// convention as sort() above. PRECONDITION: the list must already be
// sorted (ascending, by the same `cmp`) -- this method does not check or
// enforce that, it only assumes it, exactly like a `qsort`-then-`bsearch`
// pairing in C. Returns the index of a matching element if found, -1
// otherwise.
fn<T> List.binary_search(target: T, cmp: fn(T, T): int): int {
  mut lo: int = 0;
  mut hi: int = self.length() - 1;
  while lo <= hi {
    immutable mid: int = lo + (hi - lo) / 2;
    immutable c: int = cmp(self.data[mid], target);
    if (c == 0) {
      return mid;
    } else if (c < 0) {
      lo = mid + 1;
    } else {
      hi = mid - 1;
    }
  }
  return -1;
}

// Linear search over an unsorted (or sorted, doesn't matter) List<T> for
// the first element matching an arbitrary predicate -- for lookups that
// aren't simple equality/ordering (sort()/binary_search() above cover
// that case).
fn<T> List.find(predicate: fn(T): bool): int {
  mut i: int = 0;
  while i < self.length() {
    if (predicate(self.data[i])) {
      return i;
    }
    i = i + 1;
  }
  return -1;
}

// ─── deprecated free-function wrappers ───────────────────────────────────
//
// `list_sort`/`list_binary_search`/`list_find` are the pre-STD-003 concrete
// `List<int>`-only free functions this file used to have no alternative
// to. Kept as thin wrappers over the real generic methods above, for one
// cycle, per this group's own "Breaking changes" guidance (prefer keeping
// wrappers over removing outright) -- existing callers
// (`tests/32_set_and_sort_stdlib/02_list_sort.tr` and siblings) keep
// working unchanged. Prefer `l.sort(cmp)`/`l.binary_search(target, cmp)`/
// `l.find(predicate)` directly in new code; these three may be removed in
// a future cycle.
fn list_sort(l: List<int>, cmp: fn(int, int): int): void {
  l.sort(cmp);
}

fn list_binary_search(l: List<int>, target: int, cmp: fn(int, int): int): int {
  return l.binary_search(target, cmp);
}

fn list_find(l: List<int>, predicate: fn(int): bool): int {
  return l.find(predicate);
}
