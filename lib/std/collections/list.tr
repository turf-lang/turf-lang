unsafe module;

// list.tr — List<T>: a dynamically-growing array.
// Usage:
//   import list::List;   // (or `import list;` + spell it `list::List<int>` below)
//   mut l: List<int>;   // default-initialized -- no need to write out the fields
//   l.push(1);
//   l.push(2);
//   mut x: int = l.pop();   // 2
//   mut n: int = l.length(); // 1

import mem;
import sys;

struct List<T> {
  data: T*,
  len: int,
  cap: int
}

fn<T> List.push(item: T): void {
  if (self.len == self.cap) {
    if (self.cap == 0) {
      self.cap = 8;
    } else {
      self.cap = self.cap * 2;
    }

    // TYPE-002 (S14b): was `self.cap * 8` under Type Erasure, where every T
    // was assumed to fit in one uniform 8-byte slot -- wrong for a T over
    // 8 bytes (a real by-value struct element, S13b/S14a's own completion
    // criterion 2), which would under-allocate this buffer and silently
    // overflow it a few pushes later. sizeof(T) is now correct per
    // instantiation (monomorphized, S12a's own completion criterion 4) --
    // this is the ONE stdlib change this whole group permits itself
    // (ARCHITECTURE_OVERHAUL.md §8's TYPE-002 entry).
    immutable byteSize: int = self.cap * sizeof(T);

    if (self.data == null) {
      self.data = mem::malloc(byteSize) to T*;
    } else {
      self.data = mem::realloc(self.data, byteSize) to T*;
    }
  }

  self.data[self.len] = item;
  self.len = self.len + 1;
}

fn<T> List.pop(): T {
  if (self.len == 0) {
    sys::panic("List.pop: pop on empty list");
  }

  self.len = self.len - 1;
  return self.data[self.len];
}

fn<T> List.length(): int {
  return self.len;
}

// ─── operator[] / operator[]= (LANG-001) ────────────────────────────────────
//
// The better form of the `get`/`set` this file's own LIMITATIONS.md §4 entry
// asked for -- `l[i]` and `l[i] = v` instead of named methods. Declared for
// the CONCRETE `List<int>` only, not genuinely generic over `T`, for the
// identical reason list_sort()/list_binary_search()/list_find() above are
// concrete rather than `fn<T> List....`: `operator` declarations are
// deliberately non-generic (ParseOperatorDecl() parses no `<T>` block at
// all -- see its own doc comment, src/ParserDecl.cpp) -- lifting that
// restriction is a genuinely separate parser/Resolver/Monomorphizer feature,
// not something LANG-001 asked for, and specializing on one concrete element
// type (matching this file's own established precedent) is what keeps this
// addition small and self-contained instead. Bounds-checked, matching
// index_of()'s absence of a bounds guard being the ODD one out here, not the
// norm -- every other List accessor (push/pop/the raw `self.data[i]` reads
// above) already trusts the caller; operator[] deliberately does not,
// since `l[i]` reads exactly like array indexing to a caller and array
// indexing IS bounds-checked everywhere else in the language.
operator [](l: List<int>, i: int): int {
  if (i < 0 || i >= l.len) {
    sys::panic("List[]: index out of bounds");
  }
  return l.data[i];
}

// Self taken BY VALUE, not `&List<int>` -- unlike a plain value struct,
// that's sufficient for this write to persist: `data` is a heap pointer
// (list_sort()'s own doc comment above makes the identical point about
// List<int> more generally), so copying the List<int> header still shares
// the same backing buffer, and `l.data[i] = value` writes through it.
operator []=(l: List<int>, i: int, value: int): void {
  if (i < 0 || i >= l.len) {
    sys::panic("List[]=: index out of bounds");
  }
  l.data[i] = value;
}

// ─── sort / search ──────────────────────────────────────────────────────────
//
// sort()/binary_search()/list_find() below are for `List<int>` SPECIFICALLY
// -- not `fn<T> List.sort(...)` / a generic `List<T>` as originally
// intended. This is a deliberate, forced design change, not a shortcut:
// every genuinely-generic-in-T shape was tried first and each one hits a
// real, confirmed compiler limitation (worth recording in full so nobody
// "fixes" this back to the more obvious generic spelling later and
// silently reintroduces a compile break across THE ENTIRE STDLIB --
// see the last paragraph for why the blast radius is that large):
//
//   1. `cmp: fn(T, T): int` (a comparator parameter, as the task's first
//      choice) -- overload/call-site matching substitutes a generic
//      struct's type parameter (e.g. `List<int>` => T=int) into a
//      candidate's OWN parameter types before comparing against the
//      argument's type (TypeCheckerCall.cpp's Subst machinery), but that
//      substitution -- and the earlier "is this candidate even a match"
//      filter, which runs typesCompatible() BEFORE substitution ever
//      happens -- never recurses INTO a FuncType's parameter/return types
//      (collectGenericSubstitution(), substituteReturnType(), and
//      typesCompatible() in src/TypeCheckerCall.cpp/src/Types.cpp all
//      special-case pointers/arrays/GenericType, but none of them has a
//      FuncType branch). A callback type that mentions T anywhere inside
//      `fn(...)` therefore stays the literal, unresolved `fn(T, T): int`
//      forever, which can never equal a real caller's concrete
//      `fn(int, int): int` -- confirmed empirically ("No matching
//      overload"). Property of the METHOD DEFINITION, not the call site,
//      so it fails identically for every instantiation.
//   2. Comparing `self.data[j] < key` directly (bare `T < T`), forgoing a
//      callback entirely (the task's documented fallback) -- also
//      confirmed to fail, with "Cannot compare 'T' with 'T' using '<'.",
//      because TypeChecker::inferRelationalType() has a generic-name
//      bypass for `==`/`!=` (two same-named types, e.g. two T's, are
//      accepted) but NOT for ordering operators -- and a generic method's
//      body is type-checked ONCE, generically, with T left abstract (no
//      per-instantiation re-checking, no trait/constraint system), so this
//      can't be fixed by calling from a concrete instantiation either.
//      Both of the task's two suggested options are therefore blocked by
//      essentially the same root cause: generics here support storage and
//      equality on a bare T, and nothing else.
//   3. `cmp: fn(ptr, ptr): int` (pass element ADDRESSES, exactly like C's
//      real `int (*)(const void*, const void*)` qsort comparator) --
//      concrete, no `T` inside the FuncType at all, so it sidesteps
//      problem 1 above entirely... but `checkNoRawPointersInSignature()`
//      (TypeCheckerCore.cpp) rejects ANY ordinary function declaring a raw
//      `ptr`/`T*` parameter outside `lib/std` -- unconditionally, even
//      inside `unsafe { }` (confirmed) -- so a comparator a caller writes
//      in their OWN file could never be given this exact signature in the
//      first place.
//   4. Keep `cmp: fn(int, int): int` (concrete, no raw-pointer issue) and
//      read each element as `int` from INSIDE a still-generic
//      `fn<T> List.sort(...)`, via `self.data[i] to int` or an
//      intermediate `int`-typed local -- also confirmed broken, and this
//      is the one that matters most to remember, because it doesn't fail
//      loudly at the call site the way (1)-(3) do: it fails to
//      TYPE-CHECK THE METHOD DEFINITION ITSELF. `self.data[i] to int`
//      (explicit `to`) fails because CastExprAST::codegen() derives its
//      source-type name from the STATIC declared type ("T"), which has no
//      case at all in that function -- "Cannot explicitly cast 'T' to
//      'int'". `immutable x: int = self.data[i];` (implicit coercion)
//      fails too, "Cannot initialise 'int' variable 'x' with value of
//      type 'T'" -- because inside the struct's OWN method, `self`'s
//      static type never carries concrete type-args to substitute with
//      (that substitution machinery -- TypeCheckerCall.cpp's Subst-scan --
//      only has something to substitute FROM at an external call site
//      like `someList.data[0]` where someList: List<int>; from INSIDE
//      List's own generic method, self.data[i]'s field type resolves to
//      NamedType("T") -- a placeholder, not a real TurfGenericParamType --
//      and typesCompatible()'s type-erasure bypass only special-cases the
//      latter). Since this compiler eagerly type-checks every file under
//      lib/std/** on EVERY compile (to build the cross-file "known
//      anywhere" UFCS/operator visibility table, per
//      docs/reference/functions_and_modules.md §3) regardless of whether
//      the current program imports `list` at all, a `fn<T> List.sort`
//      left in this broken state doesn't just fail its own tests -- it
//      breaks compiling EVERY `.tr` file in the entire repo, including
//      ones with no relation to List whatsoever. Confirmed live during
//      this file's own development: a trivial `fn main(): int { return
//      0; }` with zero imports failed with this exact list.tr error.
//
// Given all four are dead ends for genuine `T`, the design that actually
// works: drop genericity for JUST this trio, and take `List<int>` as an
// ordinary, CONCRETE parameter to plain (non-generic) free functions. This
// sidesteps every problem above -- `l: List<int>` is a real, concrete
// GenericType argument to an ordinary function, so `l.data[i]` resolves to
// a genuine `int` with no substitution gap at all (exactly the "external
// call site" case that already works, e.g. Map<K,V>'s own tests reading
// `m.get("a")` as `int`), and `cmp`'s declared type has no `T` in it to
// begin with. This also happens to be the ONLY element type sort/search
// could ever be numerically correct for anyway: under Type Erasure (the
// model this whole historical writeup was written against -- TYPE-002
// later replaced it with monomorphization, S11a-S14b, though this trio is
// deliberately NOT converted to real generic methods as part of that group,
// see docs/planning/LIMITATIONS.md item 2), every T erased to one uniform
// 8-byte slot, so a hypothetical `List<double>` sort would have needed to
// compare each element's raw IEEE-754 bit pattern as if it were an integer,
// which does not preserve numeric ordering -- not something worth chasing
// given the deeper blockers above.
//
// Insertion sort: O(n^2), but simple, obviously-correct, and stable -- fine
// for the small lists this stdlib deals with (see map.tr's identical
// "small collections, correctness over cleverness" reasoning for its own
// linear scan). `l: List<int>` is taken BY VALUE, not by reference/pointer
// -- that's fine for in-place mutation because `data` is a heap pointer:
// copying the `List<int>` header (data/len/cap) still shares the same
// backing buffer, so writes through `l.data[i]` are visible to the
// caller's own list, exactly like push()/pop() already rely on for their
// own self-mutation.
fn list_sort(l: List<int>, cmp: fn(int, int): int): void {
  mut i: int = 1;
  while i < l.length() {
    immutable key: int = l.data[i];
    mut j: int = i - 1;
    while j >= 0 && cmp(l.data[j], key) > 0 {
      l.data[j + 1] = l.data[j];
      j = j - 1;
    }
    l.data[j + 1] = key;
    i = i + 1;
  }
}

// Binary search for `target` using the same `fn(int, int): int` comparator
// convention as list_sort() above (see its doc comment for the full design
// story). PRECONDITION: the list must already be sorted (ascending, by the
// same `cmp`) -- this function does not check or enforce that, it only
// assumes it, exactly like a `qsort`-then-`bsearch` pairing in C. Returns
// the index of a matching element if found, -1 otherwise.
fn list_binary_search(l: List<int>, target: int, cmp: fn(int, int): int): int {
  mut lo: int = 0;
  mut hi: int = l.length() - 1;
  while lo <= hi {
    immutable mid: int = lo + (hi - lo) / 2;
    immutable c: int = cmp(l.data[mid], target);
    if (c == 0) {
      return mid;
    } else if (c < 0) {
      lo = mid + 1;
    } else {
      hi = mid - 1;
    }
  }
  return -1;
}

// Linear search over an unsorted (or sorted, doesn't matter) List<int> for
// the first element matching an arbitrary predicate -- for lookups that
// aren't simple equality/ordering (list_sort()/list_binary_search() above
// cover that case). A free function, not a method, matching the task's
// original intent (and, incidentally, still necessary: a generic
// `fn<T> List.find` bound method is exactly as blocked as `fn<T> List.sort`
// was -- see list_sort()'s doc comment). `l: List<int>`, concrete, for the
// same reasons documented there.
fn list_find(l: List<int>, predicate: fn(int): bool): int {
  mut i: int = 0;
  while i < l.length() {
    if (predicate(l.data[i])) {
      return i;
    }
    i = i + 1;
  }
  return -1;
}
