// set.tr — Set<T>: a collection of unique, unordered values.
// Usage:
//   import set::Set;
//   mut s: Set<int>;   // default-initialized -- no need to write out the fields
//   s.add(1);
//   s.add(2);
//   s.add(1);                  // no-op, already present
//   mut has: bool = s.contains(1); // true
//   mut n: int = s.length();        // 2
//   mut removed: bool = s.remove(2); // true, and length() drops to 1
//
// Design:
//   Same rationale as map.tr's Map<K, V> (see that file's comment for the
//   full explanation): there is no generic `hash(T)` in the language yet,
//   so this is a LINEAR SCAN over a single type-erased array, not a hash
//   set. Set<T> is really just Map<K, V> with the value array dropped --
//   presence in the `items` array *is* the membership -- grown exactly like
//   list.tr's List<T>.push() (every T assumed to fit in one 8-byte slot).

import mem;
import sys;

struct Set<T> {
  items: T*,
  len: int,
  cap: int
}

// FIXED (TYPE-002, S12b/S14a, 2026-09-21): `self.items[i] == item` below
// used to be a raw pointer/bit comparison for T = string, not a content
// comparison, because this generic method's body used to be checked and
// codegenned exactly ONCE, shared across every instantiation (Type
// Erasure) -- both operands had the STATIC type TurfGenericParamType("T")
// inside the body, so no operator-overload candidate could ever
// exact-match it and `strings.tr`'s real `operator==(string, string)`
// never got a chance to run. Monomorphization (TYPE-002) gives
// `Set<string>.indexOf()` its own real, separately-codegenned clone, with
// `item`/`self.items[i]` concretely typed as `string` during that clone's
// own re-typecheck -- overload resolution now correctly dispatches to the
// real content-comparing `operator==(string, string)`. Verified live:
// `tests/38_monomorphization/10_set_string_dedup.tr` (moved and rewritten
// from `tests/99_known_bugs/set_string_dedup_broken.tr`, which this
// comment used to describe) asserts the now-correct dedup behavior,
// including the genuinely-separate-allocation duplicate
// (`strings::trim()`-built, not a second string literal, since the linker
// merges identical literal constants and would mask a real regression
// here).
fn<T> Set.indexOf(item: T): int {
  mut i: int = 0;
  while i < self.len {
    if (self.items[i] == item) {
      return i;
    }
    i = i + 1;
  }
  return -1;
}

fn<T> Set.contains(item: T): bool {
  return self.indexOf(item) >= 0;
}

fn<T> Set.add(item: T): void {
  if (self.contains(item)) {
    return;
  }

  if (self.len == self.cap) {
    if (self.cap == 0) {
      self.cap = 8;
    } else {
      self.cap = self.cap * 2;
    }

    // TYPE-002 (S15/D3): was `self.cap * 8` under Type Erasure -- wrong for
    // a T over 8 bytes, which under-allocated this buffer and silently
    // overran it a few adds later. sizeof(T) is correct per instantiation
    // (monomorphized, TYPE-002) -- see list.tr's identical fix, S14b, for
    // the first instance of this.
    immutable byteSize: int = self.cap * sizeof(T);

    if (self.items == null) {
      self.items = mem::malloc(byteSize) to T*;
    } else {
      self.items = mem::realloc(self.items, byteSize) to T*;
    }
  }

  self.items[self.len] = item;
  self.len = self.len + 1;
}

fn<T> Set.remove(item: T): bool {
  immutable idx: int = self.indexOf(item);
  if (idx < 0) {
    return false;
  }

  // Swap-with-last removal -- O(1), doesn't preserve insertion order
  // (mirrors Map.remove()'s identical tradeoff).
  self.len = self.len - 1;
  self.items[idx] = self.items[self.len];
  return true;
}

fn<T> Set.length(): int {
  return self.len;
}

// ─── operator[] (LANG-001) ───────────────────────────────────────────────────
//
// `s[i]` -- positional read of the i-th stored element (insertion order is
// NOT preserved across remove(), see Set.remove()'s swap-with-last comment,
// so "positional" means "whatever slot i currently holds", same caveat
// List<int>'s own operator[] doesn't have to make). Declared for the
// CONCRETE `Set<int>` only -- see list.tr's operator[] doc comment for why
// `operator` declarations can't be generic over T at all.
//
// Deliberately NO `operator[]=` for Set<T>: unlike List/Map, a set's
// invariant is uniqueness -- `s[i] = v` would let a caller silently
// overwrite one element with a value that duplicates another slot,
// corrupting that invariant with no check at all. add()/remove() stay the
// only way to mutate a Set's contents.
operator [](s: Set<int>, i: int): int {
  if (i < 0 || i >= s.len) {
    sys::panic("Set[]: index out of bounds");
  }
  return s.items[i];
}
