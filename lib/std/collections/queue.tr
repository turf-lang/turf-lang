unsafe module;

// Queue<T> — FIFO (First In, First Out) collection.
// Usage:
//   import queue::Queue;   // (or `import queue;` + spell it `queue::Queue<int>` below)
//   mut q: Queue<int> = Queue::default();
//   q.enqueue(1)  q.dequeue()  q.peek()  q.length()  q.copy()
//
// Shared by default, copied on demand (LEC-009, FREEZE.md §6.27): a
// `Queue<T>` is a handle to one `QueueHeader<T>`, so `=` and passing share it
// and `copy()` gives an independent queue. See list.tr's header.
//
// Implementation: dynamic array with a head offset.
//   - enqueue appends at data[head + len]
//   - dequeue reads from data[head] and advances head
//   - when (head + len == cap): if head > 0 compact elements to front,
//     otherwise double the capacity
//
// `unsafe module;` stays -- STD-003 item 8 (making `data` a safe `&T`)
// considered and rejected for the identical reason across every collection
// module in this directory: `T` is genuinely unconstrained, a caller can
// legally instantiate `Queue<SomeStruct*>`, and the raw-pointer capability
// is then required by the SUBSTITUTED parameter type of `enqueue(item:
// T)` itself, not by anything `data`'s own field type or a scoped
// `unsafe { }` block around the body could avoid. See list.tr's own note
// (this directory) for the full investigation and live repro.

import sys;

struct QueueHeader<T> {
    data: T*,
    len: int,
    cap: int,
    head: int
}

pub struct Queue<T> {
    h: &QueueHeader<T>
}

pub fn<T> Queue.enqueue(item: T): void {
    if (self.h.head + self.h.len == self.h.cap) {
        if (self.h.head > 0) {
            // Compact: shift live elements to the front of the buffer
            mut i: int = 0;
            while i < self.h.len {
                self.h.data[i] = self.h.data[self.h.head + i];
                i = i + 1;
            }
            self.h.head = 0;
        } else {
            // Buffer is full and already at front — grow it.
            // TYPE-002 (S15/D3): was `self.cap * 8` under Type Erasure -- wrong
            // for a T over 8 bytes, which under-allocated this buffer and
            // silently overran it a few enqueues later. sizeof(T) is correct per
            // instantiation (monomorphized, TYPE-002) -- see list.tr's identical
            // fix, S14b, for the first instance of this.
            if (self.h.cap == 0) {
                self.h.cap = 8;
                self.h.data = gc_alloc(self.h.cap * sizeof(T)) to T*;
            } else {
                self.h.cap = self.h.cap * 2;
                self.h.data = gc_realloc(self.h.data, self.h.cap * sizeof(T)) to T*;
            }
        }
    }

    self.h.data[self.h.head + self.h.len] = item;
    self.h.len = self.h.len + 1;
}

@caller_location
pub fn<T> Queue.dequeue(): T {
    if (self.h.len == 0) {
        sys::panic(caller_location + ": Queue.dequeue: dequeue on empty queue");
    }

    immutable item: T = self.h.data[self.h.head];
    self.h.head = self.h.head + 1;
    self.h.len = self.h.len - 1;
    return item;
}

@caller_location
pub fn<T> Queue.peek(): T {
    if (self.h.len == 0) {
        sys::panic(caller_location + ": Queue.peek: peek on empty queue");
    }

    return self.h.data[self.h.head];
}

pub fn<T> Queue.length(): int {
    return self.h.len;
}

// An independent queue with the same elements in the same order (F-COLL-1).
pub fn<T> Queue.copy(): Queue<T> {
    mut out: Queue<T> = Queue::default();
    mut i: int = 0;
    while i < self.h.len {
        out.enqueue(self.h.data[self.h.head + i]);
        i = i + 1;
    }
    return out;
}
