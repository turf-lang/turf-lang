unsafe module;

// map.tr — Map<K, V>: a key/value association.
// Usage:
//   import map::Map;
//   mut m: Map<string, int> = Map::default();
//   m.put("a", 1);
//   m.put("b", 2);
//   mut x: int = m.get("a");        // 1
//   mut has: bool = m.contains("z"); // false
//   mut n: int = m.length();         // 2
//   mut y: int = m.tryGet("z") recover produce -1; // -1, no abort
//
// Design (STD-003, ARCHITECTURE_OVERHAUL.md §8, item 6 -- rewritten from
// the pre-TYPE-002 linear-scan version this file used to be):
//   - Storage is still the two parallel, DENSE, insertion-ordered arrays
//     (`keys`/`values`) this file always had -- unchanged on purpose.
//     `Map.remove()`'s swap-with-last compaction (below) is what keeps
//     them dense; nothing here relies on hash-bucket order for storage.
//   - NEW: a separate open-addressing hash index (`buckets`/`bcap`) maps
//     `hash(key) -> a slot in `buckets`, which holds the DENSE ARRAY INDEX
//     of that key (or a sentinel -- see below). `indexOf()`/`get()`/
//     `contains()`/`put()`/`remove()` all probe this index instead of
//     scanning `keys` linearly, which is what makes lookup O(1) average
//     instead of O(n). Every consumer of the dense arrays -- direct
//     `self.keys[i]`/`self.values[i]` access external code still expects,
//     insertion order, swap-with-last removal -- keeps working completely
//     unchanged; the hash index is purely an accelerator layered on top,
//     never the arrays' own storage. This split exists specifically
//     because `Set<int>`'s own `operator[]` (LANG-001,
//     `tests/18_operator_overload/14_stdlib_set_index.tr`) requires
//     INSERTION-ORDER positional access (`s[0]==10` after `s.add(10)` was
//     the FIRST add) -- a real, already-shipped, already-tested contract
//     a pure open-addressing table (values stored directly in hash-bucket
//     order) cannot provide at all. See this group's own change record
//     for the full investigation.
//   - `buckets[slot]` is one of: `-1` (EMPTY, never used), `-2`
//     (TOMBSTONE, held an entry that was since removed), or `>= 0` (the
//     dense-array index of the key that hashed here, after however much
//     linear probing past a collision). Tombstones are necessary because
//     open-addressing deletion can't simply clear a slot to EMPTY -- doing
//     so would break the probe chain for any OTHER key that collided at
//     this slot and had to probe past it; the classic fix is a distinct
//     "deleted but don't stop probing here" marker, reused by a later
//     insert if the probe walks over it again (`bucketInsertSlot()`
//     below).
//   - `hash(K)` is `hashing::hash()` (`hashing.tr`, this same directory) --
//     see that file's own header for why a generic `hash(T)` is even
//     possible now (TYPE-002/monomorphization) and its overload-resolution
//     design (one concrete `string` overload, one generic byte-hash
//     fallback covering everything else).
//   - Growth: the dense arrays grow exactly as before (doubling from 8,
//     `sizeof(K)`/`sizeof(V)` real per-instantiation byte sizes since
//     TYPE-002). The bucket index grows independently, on its OWN load
//     factor (doubling from 8 once occupancy would exceed 70%), via a full
//     rehash -- rebuilding `buckets` from scratch by re-probing every live
//     dense entry into the new, larger table. This can't be a `realloc`
//     the way the dense arrays' growth is: every entry's bucket slot is a
//     function of `hash(key) & (bcap - 1)`, which changes the moment
//     `bcap` does, so every entry must be re-probed into its new home
//     slot, not merely copied.
//
// Because lookups need `==` (equality, to disambiguate a hash collision)
// AND `hash()` (to pick a bucket) on `K`, your key type must support both.
// `int`/`string` are covered by `hashing.tr`'s own two overloads directly;
// any other struct key needs its own `operator==` (as before) and works
// through `hashing.tr`'s generic byte-hash fallback automatically, with
// the caveats documented in that file's own header.
//
// `unsafe module;` stays -- STD-003 item 8 (making `keys`/`values`/
// `buckets` safe types instead of raw pointers) considered and rejected
// for the identical reason across every collection module in this
// directory: `K`/`V` are genuinely unconstrained, a caller can legally
// instantiate `Map<SomeStruct*, V>`, and the raw-pointer capability is
// then required by the SUBSTITUTED parameter type of `put(key: K, ...)`
// (and, independently, by `hashing::hash`'s own `x: K` parameter for the
// same reason) -- not by anything these fields' own types or a scoped
// `unsafe { }` block around a body could avoid. See
// `lib/std/collections/list.tr`'s own note for the full investigation and
// live repro (`Map<Point*, int>`, specifically).

import sys;
import hashing;

struct Map<K, V> {
  keys: K*,
  values: V*,
  len: int,
  cap: int,
  buckets: int*,
  bcap: int
}

// ─── hash index (internal) ──────────────────────────────────────────────

// Returns the BUCKET slot currently holding `key`'s dense-array index, or
// -1 if `key` isn't present. O(1) average: one probe chain, stopping at
// the first EMPTY slot (which can only mean "never inserted here," since
// every occupied-then-removed slot leaves a TOMBSTONE, not an EMPTY, so a
// real probe chain is never broken by a deletion elsewhere on it).
fn<K, V> Map.bucketFind(key: K): int {
  if (self.bcap == 0) {
    return -1;
  }
  mut slot: int = hashing::hash(key) & (self.bcap - 1);
  mut probes: int = 0;
  while probes < self.bcap {
    immutable b: int = self.buckets[slot];
    if (b == -1) {
      return -1;
    }
    if (b != -2 && self.keys[b] == key) {
      return slot;
    }
    slot = (slot + 1) & (self.bcap - 1);
    probes = probes + 1;
  }
  return -1;
}

// Finds the bucket slot to store a NEW key's dense index at -- an EMPTY or
// TOMBSTONE slot along the probe chain, preferring the FIRST tombstone
// seen (keeps probe chains from growing unboundedly long as churn
// accumulates tombstones). Caller must already know `key` isn't present
// (a fresh `bucketFind()` returned -1) and that `self.bcap > 0`
// (`bucketMaybeGrow()` runs first in every caller below).
fn<K, V> Map.bucketInsertSlot(key: K): int {
  mut slot: int = hashing::hash(key) & (self.bcap - 1);
  mut tomb: int = -1;
  mut probes: int = 0;
  while probes < self.bcap {
    immutable b: int = self.buckets[slot];
    if (b == -1) {
      if (tomb >= 0) {
        return tomb;
      }
      return slot;
    }
    if (b == -2 && tomb < 0) {
      tomb = slot;
    }
    slot = (slot + 1) & (self.bcap - 1);
    probes = probes + 1;
  }
  return tomb;
}

// Grows+rehashes the bucket index once occupancy would exceed a 70% load
// factor (or on first use, from `bcap == 0`). A full rehash, not a
// realloc -- every entry's bucket slot is a function of
// `hash(key) & (bcap - 1)`, which changes the moment `bcap` does, so every
// entry must be re-probed into its new home slot, not merely copied.
fn<K, V> Map.bucketRehash(newBcap: int): void {
  self.buckets = gc_alloc(newBcap * sizeof(int)) to int*;
  mut z: int = 0;
  while z < newBcap {
    self.buckets[z] = -1;
    z = z + 1;
  }
  self.bcap = newBcap;

  mut i: int = 0;
  while i < self.len {
    immutable slot: int = self.bucketInsertSlot(self.keys[i]);
    self.buckets[slot] = i;
    i = i + 1;
  }
}

// Grows the bucket index once occupancy would exceed a 70% load factor (or
// on first use).
fn<K, V> Map.bucketMaybeGrow(): void {
  if (self.bcap == 0) {
    self.bucketRehash(8);
    return;
  }
  if ((self.len + 1) * 10 >= self.bcap * 7) {
    self.bucketRehash(self.bcap * 2);
  }
}

// ─── public API ──────────────────────────────────────────────────────────

// Returns the DENSE-array index of `key`, or -1 if absent. O(1) average
// (was O(n) before this group, see this file's header).
fn<K, V> Map.indexOf(key: K): int {
  immutable slot: int = self.bucketFind(key);
  if (slot < 0) {
    return -1;
  }
  return self.buckets[slot];
}

fn<K, V> Map.contains(key: K): bool {
  return self.indexOf(key) >= 0;
}

fn<K, V> Map.put(key: K, value: V): void {
  immutable existingSlot: int = self.bucketFind(key);
  if (existingSlot >= 0) {
    self.values[self.buckets[existingSlot]] = value;
    return;
  }

  if (self.len == self.cap) {
    if (self.cap == 0) {
      self.cap = 8;
    } else {
      self.cap = self.cap * 2;
    }

    // TYPE-002 (S15/D3): real per-instantiation byte sizes -- see
    // list.tr's identical fix for the first instance of this class of fix.
    immutable keyByteSize: int = self.cap * sizeof(K);
    immutable valueByteSize: int = self.cap * sizeof(V);

    if (self.keys == null) {
      self.keys = gc_alloc(keyByteSize) to K*;
      self.values = gc_alloc(valueByteSize) to V*;
    } else {
      self.keys = gc_realloc(self.keys, keyByteSize) to K*;
      self.values = gc_realloc(self.values, valueByteSize) to V*;
    }
  }
  self.bucketMaybeGrow();

  immutable insertSlot: int = self.bucketInsertSlot(key);
  self.buckets[insertSlot] = self.len;
  self.keys[self.len] = key;
  self.values[self.len] = value;
  self.len = self.len + 1;
}

fn<K, V> Map.get(key: K): V {
  immutable idx: int = self.indexOf(key);
  if (idx < 0) {
    sys::panic("Map.get: no such key");
  }
  return self.values[idx];
}

// Recoverable alternative to get() (docs/planning/Errors.md): a missing key
// is often an ordinary, expected outcome (checking a cache, an optional
// config value, ...), not a programming bug worth aborting the whole
// process over -- `m.tryGet(key) recover produce default;` or a full
// `recover run { ... }` lets the caller decide, instead of get()'s
// unconditional abort. get() itself is left as-is (unchanged behavior,
// still the right choice when a missing key really would be a bug).
error MapError {
  KeyNotFound,
}

fn<K, V> Map.tryGet(key: K): !V {
  immutable idx: int = self.indexOf(key);
  if (idx < 0) {
    return MapError::KeyNotFound;
  }
  return self.values[idx];
}

// Removal: tombstone the key's bucket entry, then swap-with-last on the
// dense arrays exactly like before -- but if the swap moves a DIFFERENT
// key (the one that used to be last) into the removed slot, that key's
// own bucket entry must be retargeted from the old dense index to the
// new one, or a later lookup for it would return stale/wrong data (or,
// worse, the bucket for the just-removed key could be found first and
// mistakenly matched against the moved-in key at the same dense index).
fn<K, V> Map.remove(key: K): void {
  immutable bslot: int = self.bucketFind(key);
  if (bslot < 0) {
    return;
  }
  immutable idx: int = self.buckets[bslot];
  self.buckets[bslot] = -2;

  self.len = self.len - 1;
  if (idx != self.len) {
    immutable movedSlot: int = self.bucketFind(self.keys[self.len]);
    if (movedSlot >= 0) {
      self.buckets[movedSlot] = idx;
    }
    self.keys[idx] = self.keys[self.len];
    self.values[idx] = self.values[self.len];
  }
}

fn<K, V> Map.length(): int {
  return self.len;
}

// ─── operator[] / operator[]= (LANG-001) ────────────────────────────────────
//
// `m[key]` / `m[key] = v`, wrapping get()/put() -- both already go through
// the hash index above, so these need no changes at all for this group.
// Declared for the CONCRETE `Map<string, int>` only (this file's own doc
// comment's example pairing), not genuinely generic over `K, V` -- see
// list.tr's identical operator[] doc comment for why `operator`
// declarations can't be generic at all (ParseOperatorDecl() parses no
// `<K, V>` block) and why specializing on one concrete pairing is the
// right-sized fix rather than a parser feature.
//
// Self is `&Map<string, int>` here, NOT by value, unlike List<int>'s
// operator[]=: put() can REALLOCATE `keys`/`values`/`buckets` and always
// updates `len`/`cap`/`bcap` -- mutations to the struct's OWN fields, not
// just through an already-shared heap pointer the way List<int>.data's
// writes are. A by-value `m` here would let put() grow/mutate only a
// local copy that vanishes when this function returns, silently losing
// every write.
operator [](m: Map<string, int>, key: string): int {
  return m.get(key);
}

operator []=(m: &Map<string, int>, key: string, value: int): void {
  m.put(key, value);
}
