// map.tr — Map<K, V>: a simple key/value association (linear-scan, not
// hashed -- see the design note below for why).
// Usage:
//   import map::Map;
//   mut m: Map<string, int>;   // default-initialized -- no need to write out fields
//   m.put("a", 1);
//   m.put("b", 2);
//   mut x: int = m.get("a");        // 1
//   mut has: bool = m.contains("z"); // false
//   mut n: int = m.length();         // 2
//   mut y: int = m.tryGet("z") recover produce -1; // -1, no abort
//
// Design:
//   - Two parallel type-erased arrays (keys/values), grown exactly like
//     list.tr's List<T>.push() (every T assumed to fit in one 8-byte slot --
//     see that file's own comment on this). A single array of a combined
//     Entry<K,V> struct was deliberately avoided: it would need `sizeof` on
//     a generic instantiation and a THIRD level of generic-parameter
//     substitution (Map -> Entry -> K/V) that nothing in the stdlib has
//     exercised yet -- the parallel-array shape reuses the identical,
//     already-proven List<T> pattern twice instead of risking new ground.
//   - Lookup is a LINEAR SCAN, not a hash table -- there is no generic
//     `hash(T)` in the language yet, so this is the honest, simple version.
//     Fine for the small maps a program typically builds; a hashed
//     HashMap<K,V> is a natural, separate future addition once hashing
//     exists.
//   - get() on a missing key fails() (mirrors List.pop()'s empty-list
//     behavior) -- check contains() first if a miss is expected.

import mem;
import sys;

struct Map<K, V> {
  keys: K*,
  values: V*,
  len: int,
  cap: int
}

// FIXED (TYPE-002, S12b/S14a, 2026-09-21): `self.keys[i] == key` below
// used to be a raw pointer/bit comparison for K = string, not a content
// comparison, even though `strings.tr` defines a real content-comparing
// `operator==(string, string)` -- because this generic method's body used
// to be type-checked and codegenned exactly ONCE, shared across every
// instantiation (Type Erasure), so `self.keys[i]`/`key` had the STATIC
// type TurfGenericParamType("K") inside the body and no `(string, string)`
// overload candidate could ever match it. Monomorphization (TYPE-002)
// gives `Map<string, V>.indexOf()` its own real, separately-codegenned
// clone per instantiation, with `key`/`self.keys[i]` concretely typed as
// `string` during that clone's own re-typecheck -- overload resolution
// now correctly dispatches to the real content-comparing operator.
// Verified live (S14b): a `Map<string, int>` key built via
// `strings::trim()` (a genuinely separate allocation from an
// already-`put()` literal key) is now correctly recognized as the SAME
// key by `.get()`/`.put()`/`.contains()`. `http.tr`'s
// `Request.get_header()`/`has_header()` still implement their own inline
// comparison on the concrete `Request` struct rather than relying on
// `Map<string,V>`'s generic accessors -- that workaround is no longer
// NEEDED for correctness, but simplifying it back is optional stdlib
// cleanup explicitly deferred out of this group (ARCHITECTURE_OVERHAUL.md
// §8's TYPE-002 entry), not attempted here.
fn<K, V> Map.indexOf(key: K): int {
  mut i: int = 0;
  while i < self.len {
    if (self.keys[i] == key) {
      return i;
    }
    i = i + 1;
  }
  return -1;
}

fn<K, V> Map.contains(key: K): bool {
  return self.indexOf(key) >= 0;
}

fn<K, V> Map.put(key: K, value: V): void {
  immutable existing: int = self.indexOf(key);
  if (existing >= 0) {
    self.values[existing] = value;
    return;
  }

  if (self.len == self.cap) {
    if (self.cap == 0) {
      self.cap = 8;
    } else {
      self.cap = self.cap * 2;
    }

    // TYPE-002 (S15/D3): was one shared `self.cap * 8` under Type Erasure,
    // used for BOTH arrays -- wrong the moment K and V aren't both exactly
    // 8 bytes (and wrong independently of each other even when neither is,
    // since K and V can be different sizes). Two separate byte sizes now:
    // sizeof(K) for keys, sizeof(V) for values. Sharing one `byteSize`
    // would silently under- or over-allocate whichever of the two arrays
    // has the larger element -- see list.tr's identical single-array fix,
    // S14b, for the first instance of this class of bug.
    immutable keyByteSize: int = self.cap * sizeof(K);
    immutable valueByteSize: int = self.cap * sizeof(V);

    if (self.keys == null) {
      self.keys = mem::malloc(keyByteSize) to K*;
      self.values = mem::malloc(valueByteSize) to V*;
    } else {
      self.keys = mem::realloc(self.keys, keyByteSize) to K*;
      self.values = mem::realloc(self.values, valueByteSize) to V*;
    }
  }

  self.keys[self.len] = key;
  self.values[self.len] = value;
  self.len = self.len + 1;
}

fn<K, V> Map.get(key: K): V {
  immutable idx: int = self.indexOf(key);
  if (idx < 0) {
    sys::panic("Map.get: no such key");
  }
  return self.values[idx];
}

// Recoverable alternative to get() (docs/planning/Errors.md): a missing key
// is often an ordinary, expected outcome (checking a cache, an optional
// config value, ...), not a programming bug worth aborting the whole
// process over -- `m.tryGet(key) recover produce default;` or a full
// `recover run { ... }` lets the caller decide, instead of get()'s
// unconditional abort. get() itself is left as-is (unchanged behavior,
// still the right choice when a missing key really would be a bug).
error MapError {
  KeyNotFound,
}

fn<K, V> Map.tryGet(key: K): !V {
  immutable idx: int = self.indexOf(key);
  if (idx < 0) {
    return MapError::KeyNotFound;
  }
  return self.values[idx];
}

fn<K, V> Map.remove(key: K): void {
  immutable idx: int = self.indexOf(key);
  if (idx < 0) {
    return;
  }

  // Swap-with-last removal -- O(1), doesn't preserve insertion order.
  self.len = self.len - 1;
  self.keys[idx] = self.keys[self.len];
  self.values[idx] = self.values[self.len];
}

fn<K, V> Map.length(): int {
  return self.len;
}
