unsafe module;

// Stack<T> — LIFO (Last In, First Out) collection.
// Usage:
//   import stack::Stack;   // (or `import stack;` + spell it `stack::Stack<int>` below)
//   mut s: Stack<int> = Stack::default();
//   s.push(1)  s.pop()  s.peek()  s.length()  s.copy()
//
// Shared by default, copied on demand (LEC-009, FREEZE.md §6.27): a
// `Stack<T>` is a handle to one `StackHeader<T>`, so `=` and passing share it
// and `copy()` gives an independent stack. See list.tr's header.
//
// `unsafe module;` stays -- STD-003 item 8 (making `data` a safe `&T`)
// considered and rejected for the identical reason across every collection
// module in this directory: `T` is genuinely unconstrained, a caller can
// legally instantiate `Stack<SomeStruct*>`, and the raw-pointer capability
// is then required by the SUBSTITUTED parameter type of `push(item: T)`
// itself, not by anything `data`'s own field type or a scoped `unsafe {
// }` block around the body could avoid. See list.tr's own note (this
// directory) for the full investigation and live repro.

import sys;

struct StackHeader<T> {
    data: T*,
    len: int,
    cap: int
}

pub struct Stack<T> {
    h: &StackHeader<T>
}

pub fn<T> Stack.push(item: T): void {
    if (self.h.len == self.h.cap) {
        if (self.h.cap == 0) {
            self.h.cap = 8;
        } else {
            self.h.cap = self.h.cap * 2;
        }

        // TYPE-002 (S15/D3): was `self.cap * 8` under Type Erasure, where every
        // T was assumed to fit in one uniform 8-byte slot -- wrong for a T over
        // 8 bytes (a real by-value struct element), which under-allocated this
        // buffer and silently overran it a few pushes later (glibc
        // "realloc(): invalid next size" once the heap's own metadata got
        // corrupted). sizeof(T) is correct per instantiation (monomorphized,
        // TYPE-002) -- see list.tr's identical fix, S14b, for the first
        // instance of this.
        immutable byte_size: int = self.h.cap * sizeof(T);

        if (self.h.data == null) {
            self.h.data = gc_alloc(byte_size) to T*;
        } else {
            self.h.data = gc_realloc(self.h.data, byte_size) to T*;
        }
    }

    self.h.data[self.h.len] = item;
    self.h.len = self.h.len + 1;
}

@caller_location
pub fn<T> Stack.pop(): T {
    if (self.h.len == 0) {
        sys::panic(caller_location + ": Stack.pop: pop on empty stack");
    }

    self.h.len = self.h.len - 1;
    return self.h.data[self.h.len];
}

@caller_location
pub fn<T> Stack.peek(): T {
    if (self.h.len == 0) {
        sys::panic(caller_location + ": Stack.peek: peek on empty stack");
    }

    return self.h.data[self.h.len - 1];
}

pub fn<T> Stack.length(): int {
    return self.h.len;
}

// An independent stack with the same elements in the same order (F-COLL-1).
pub fn<T> Stack.copy(): Stack<T> {
    mut out: Stack<T> = Stack::default();
    mut i: int = 0;
    while i < self.h.len {
        out.push(self.h.data[i]);
        i = i + 1;
    }
    return out;
}
