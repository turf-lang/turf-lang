// ─── http.tr ─────────────────────────────────────────────────────────────
// A minimal HTTP/1.1 layer on top of `net.tr`'s raw TCP transport.
//
// Both bugs tracked here as of 2026-08-22 are now fixed and covered by
// real regression tests (tests/34_http_and_json/03_http_manual_routing_roundtrip.tr
// and 04_http_callback_routing.tr, both passing):
//   - The heap-corruption crash during a real request/response round trip
//     was NOT specific to this file at all -- it was a compiler bug in
//     AssignmentExprAST::codegen() (src/CodegenVar.cpp): `buf[i] = charExpr;`
//     on a `string` stored a full 8-byte i64 at a 1-byte-wide `i8` GEP
//     slot (the LOGICAL type of a string-index access is `int`, but its
//     physical storage is one byte), silently overwriting 7 bytes past
//     every single character written -- every `strings.tr` function that
//     builds a string one byte at a time (`substring`, and everything
//     built on it: `trim*`, `to_upper`/`to_lower`, `pad_left`/`pad_right`,
//     `replace`) was affected, this file's own `parse_request` included.
//     Fixed by truncating the stored value to `i8` when the LHS is a
//     string-index access, mirroring the read side
//     (`ArrayAccessExprAST::codegen()`), which already loaded a single
//     `i8` and zext'd it back up.
//   - `Server.get/listen`'s callback routing wasn't a first-class-
//     functions-in-generics problem as originally suspected -- it was the
//     same `Map<string, V>` content-equality gap `Request.get_header()`'s
//     own doc comment below explains in full (a generic method's body used
//     to be type-checked/codegenned once, shared across every
//     instantiation, so `self.routes.keys[i] == path` inside `Map`'s own
//     `.try_get()`/`.contains()` could never see the concrete `string` type
//     needed to dispatch `strings.tr`'s real `operator==`). `Request.get_header()`/
//     `has_header()` and `Server.route_index()`/`has_route()`/`get_route()`
//     used to hand-roll their own linear scan to sidestep this; STD-003
//     (monomorphization having since fixed the underlying gap) simplified
//     all of them back down to plain `Map<K, V>` calls -- see either doc
//     comment below for the current shape.
//
// Design:
//   - Mechanical extraction of the request/response handling
//     `showcase/http_server.tr` and `showcase/http_client.tr` already
//     hand-write inline, following docs/planning/DESIGN_NOTES.md §4's
//     staged plan -- this is stage 1 (Request/Response structs + parsing +
//     response building) plus a genuine stage-2 callback router, which
//     turned out to be buildable now: DESIGN_NOTES.md marked callback
//     routing "blocked on first-class functions" (issue #187), but that
//     issue has since shipped (tests/24_first_class_functions/) and a
//     `Map<string, fn(Request, Response): void>` genuinely compiles and
//     stores/retrieves handler values correctly as a struct field --
//     dispatch (finding the right route BY PATH) needed its own fix, see
//     this file's header comment and Server.route_index() below. No raw
//     sockets, `ptr`, or manual memory management is ever visible to a
//     caller of this module.
//   - `parse_request` reads once from the connection and splits the
//     header block from the body on the first blank-line separator,
//     accepting BOTH `\r\n\r\n` (spec-correct) and `\n\n` (the looser
//     style `showcase/http_server.tr` already uses and every real HTTP
//     client tolerates) -- see that file's own comment on why `\n`-only
//     is fine in practice. Header lines are then split on `\n` and each
///    one's trailing `\r`, if any, is stripped by `strings::trim_end`
//     before further parsing, so both line-ending styles Just Work
//     without the caller ever choosing one.
//   - Headers are a real `Map<string, string>` (not the flat placeholder
//     `string` DESIGN_NOTES.md originally sketched) -- storing a generic
//     collection as a plain struct field used to crash the compiler with
//     an "unsized type" internal error (a real, general monomorphization
//     bug: a generic struct's field type never got registered under its
//     OWN base name when first seen as a nested field, so a later,
//     genuine build of that struct never filled in the stub -- see
//     src/CodegenCore.cpp's `getLLVMType()` GenericType branch, fixed
//     alongside this file). Confirmed fixed and covered by
//     tests/34_http_and_json/.
//   - A per-status-code text table only covers the handful of codes this
//     module's own callers actually need (200/201/400/404/500); anything
//     else gets a generic "`<code>` Unknown" status line rather than a
//     hardcoded table of the entire IANA registry.
//
// Usage (manual routing -- the same shape showcase/http_server.tr already
// proves out, still fully supported for callers who'd rather not use the
// Server/callback wrapper below):
//   import http;
//   import net;
//
//   fn main(): int {
//       mut listener: net::TcpListener = net::TcpListener::bind(8080) recover run {
//           sys::exit(1);
//       };
//       while true {
//           mut conn: net::TcpConnection = listener.accept() recover run { continue; };
//           defer conn.close();   // runs at the end of this iteration
//           mut req: http::Request = http::parse_request(conn);
//           mut res: http::Response;
//           res.conn = conn;
//           if req.path == "/" {
//               res.send_text(200, "hello");
//           } else {
//               res.send_text(404, "not found");
//           }
//       }
//       return 0;
//   }
//
// Usage (callback routing):
//   import http;
//
//   fn home(req: http::Request, res: http::Response): void {
//       res.send_text(200, "Welcome to Turflang!");
//   }
//
//   fn main(): int {
//       mut app: http::Server;
//       app.get("/", home);
//       app.listen(8080);
//       return 0;
//   }

import io;
import sys;
import net;
import strings;
import list::List;
import map::Map;

// ─── Request ─────────────────────────────────────────────────────────────

pub struct Request {
    pub method: string,
    pub path: string,
    pub headers: Map<string, string>,
    pub body: string
}

// get_header/has_header exist as thin, named wrappers over
// `self.headers.try_get(name)`/`.contains(name)` (STD-003, item 4,
// ARCHITECTURE_OVERHAUL.md §8) -- kept as their own methods rather than
// inlined at every call site both for the more specific panic message
// below (`Map.get`'s own is generic, "no such key", with no header name in
// it -- `try_get` + `recover run` is what lets this method supply its own)
// and because `req.get_header(name)`/`req.has_header(name)` reads better
// than `req.headers.get(name)` at a call site that has no reason to know
// `headers` is a `Map` at all. Until this group, `Map<K, V>`'s own generic
// `.get()`/`.try_get()`/`.contains()` were content-INCORRECT for `K =
// string` (compared by raw pointer identity, not bytes, under Type
// Erasure) and this file hand-rolled a linear scan over
// `self.headers.keys[i]`/`.values[i]` instead -- monomorphization
// (TYPE-002) fixed that gap for `Map<K, V>` generally, so the hand-rolled
// scan is no longer needed here; see docs/development/changes/STD-003.md
// and docs/planning/LIMITATIONS.md's (now closed) item 1 for the full
// history.
@caller_location
pub fn Request.get_header(name: string): string {
    return self.headers.try_get(name) recover run {
        sys::panic(caller_location + ": Request.get_header: no such header '" + name + "'");
        return ""; // unreachable (sys::panic never returns) -- see
                    // Server.listen()'s identical 'recover run'
                    // non-diverging-block rule, below.
    };
}

pub fn Request.has_header(name: string): bool {
    return self.headers.contains(name);
}

// Reads one request off `conn` and parses the request line + headers into
// a Request. See this file's own header comment for the exact parsing
// approach (blank-line separator, per-line \r trimming).
//
// A malformed/empty request line yields a Request with empty method/path
// rather than failing outright -- mirrors showcase/http_server.tr's own
// behavior (an unparseable request simply falls through its route-match
// chain to the 404 branch) instead of introducing a `!Request` error path
// this module's only real caller (a request-per-connection accept loop)
// has no natural way to act on differently anyway.
pub fn parse_request(conn: net::TcpConnection): Request {
    immut raw: string = conn.read(8192);
    mut req: Request = Request::default();

    mut sepIdx: int = strings::index_of(raw, "\r\n\r\n");
    mut sepLen: int = 4;
    if sepIdx < 0 {
        sepIdx = strings::index_of(raw, "\n\n");
        sepLen = 2;
    }

    mut headerBlock: string = raw;
    mut body: string = "";
    if sepIdx >= 0 {
        headerBlock = strings::substring(raw, 0, sepIdx);
        body = strings::substring(raw, sepIdx + sepLen, strings::length(raw));
    }

    mut lines: List<string> = strings::split(headerBlock, "\n");

    if lines.length() == 0 {
        req.method = "";
        req.path = "";
        req.body = body;
        return req;
    }

    immut requestLine: string = strings::trim_end(lines.get(0));
    mut parts: List<string> = strings::split(requestLine, " ");
    if parts.length() >= 2 {
        req.method = parts.get(0);
        req.path = parts.get(1);
    } else {
        req.method = "";
        req.path = "";
    }

    mut i: int = 1;
    while i < lines.length() {
        immut line: string = strings::trim_end(lines.get(i));
        immut colonIdx: int = strings::index_of(line, ":");
        if colonIdx >= 0 {
            immut key: string = strings::trim(strings::substring(line, 0, colonIdx));
            immut value: string = strings::trim(strings::substring(line, colonIdx + 1, strings::length(line)));
            req.headers.put(key, value);
        }
        i = i + 1;
    }

    req.body = body;
    return req;
}

// ─── Response ────────────────────────────────────────────────────────────

pub struct Response {
    pub conn: net::TcpConnection
}

// A small, deliberately incomplete status-text table -- see this file's
// header comment for why only these five codes are covered.
pub fn status_text(status: int): string {
    if status == 200 {
        return "200 OK";
    }
    if status == 201 {
        return "201 Created";
    }
    if status == 400 {
        return "400 Bad Request";
    }
    if status == 404 {
        return "404 Not Found";
    }
    if status == 500 {
        return "500 Internal Server Error";
    }
    return (status to string) + " Unknown";
}

// Shared response-building/writing logic for send_text/send_json below --
// the two only differ in Content-Type, exactly like DESIGN_NOTES.md's
// original sketch says they should.
pub fn Response.send_raw(status: int, contentType: string, body: string): void {
    immut bodyLen: int = strings::length(body);
    immut response: string = "HTTP/1.1 " + status_text(status) + "\r\n" +
        "Content-Type: " + contentType + "\r\n" +
        "Content-Length: " + (bodyLen to string) + "\r\n" +
        "Connection: close\r\n" +
        "\r\n" +
        body;
    self.conn.write(response);
}

pub fn Response.send_text(status: int, body: string): void {
    self.send_raw(status, "text/plain", body);
}

pub fn Response.send_json(status: int, body: string): void {
    self.send_raw(status, "application/json", body);
}

// ─── Server (callback-based routing) ────────────────────────────────────
//
// A route table keyed by exact path, storing a first-class function value
// per route -- `Map<string, fn(Request, Response): void>` as a plain
// struct field. First-class functions shipped
// (tests/24_first_class_functions/) and a generic collection embedded as
// a struct field genuinely compiles and stores/retrieves handler values
// correctly (a separate monomorphization fix, see this file's header
// comment) -- DESIGN_NOTES.md's own sketch expected BOTH of those to
// still be blocked, and neither is. Route DISPATCH (finding the right
// handler by path) needed its own additional fix on top of that, though --
// see route_index()/has_route()/get_route() below and this file's header
// comment for why `self.routes.try_get(path)` doesn't work.
//
// Route matching is EXACT-PATH ONLY (no `:id`-style parameter segments,
// no wildcards) -- Map<K,V>'s own linear-scan lookup is already the
// documented, accepted tradeoff for a small stdlib collection (see
// map.tr's own design note), and a real path-pattern matcher is a
// separate, bigger feature this module doesn't attempt.
// Both fields are private (LEC-007 API review): they are implementation, not
// something a program does anything with. `routes` is the storage behind
// get()/has_route()/get_route(); writing `listener` from outside would swap
// the socket listen() is serving on. (They were `pub` only because the
// LEC-002 sweep marked everything public.) The rule used across the stdlib:
// a function that does a job is public whether or not the repo itself calls
// it; a struct's internals are public only if a real program needs them.
pub struct Server {
    listener: net::TcpListener,
    routes: Map<string, fn(Request, Response): void>
}

// Registers `handler` to run for an exact-match request to `path`.
// Re-registering the same path replaces the previous handler (Map.put's
// own "update in place" behavior for an existing key).
pub fn Server.get(path: string, handler: fn(Request, Response): void): void {
    self.routes.put(path, handler);
}

// route_index is a thin, named wrapper over `self.routes.index_of(path)`
// (STD-003, item 4) -- kept as its own method since has_route()/
// get_route() below both already call it by name. Until this group,
// `Map<string, V>`'s own generic `.index_of()`/`.try_get()`/`.contains()`
// were content-INCORRECT for `K = string` (compared a freshly-PARSED
// request path against a route registered with a string literal by raw
// pointer identity, not content -- confirmed live: this is what made
// tests/34_http_and_json/04_http_callback_routing.tr fail its "route '/'
// should have been registered" assertion, not a first-class-functions-in-
// generics problem as originally suspected) and this file hand-rolled a
// linear scan over `self.routes.keys[i]` instead -- monomorphization
// (TYPE-002) fixed that gap for `Map<K, V>` generally, so the hand-rolled
// scan is no longer needed here; see docs/development/changes/STD-003.md
// and docs/planning/LIMITATIONS.md's (now closed) item 1 for the full
// history.
fn Server.route_index(path: string): int {
    return self.routes.index_of(path);
}

pub fn Server.has_route(path: string): bool {
    return self.route_index(path) >= 0;
}

@caller_location
pub fn Server.get_route(path: string): fn(Request, Response): void {
    immut idx: int = self.route_index(path);
    if idx < 0 {
        sys::panic(caller_location + ": Server.get_route: no such route '" + path + "'");
    }
    // This used to read `Map<K, V>.values[idx]` -- a raw `V*` -- through an
    // inline `unsafe { }` (OVH-003). `values` is private to map.tr now
    // (LEC-002), and the key is known to be present (`route_index()` found
    // it above), so the safe `get()` does the same job with no raw pointer.
    return self.routes.get(path);
}

// Binds `port` and serves forever, dispatching each accepted connection to
// the handler registered for its exact request path (or a built-in 404 if
// no route matches). A bind failure is treated as fatal -- exactly the
// same "most programs will just treat it as fatal" default net.tr's own
// doc comment describes for TcpListener::bind's `!TcpListener` -- and a
// single bad accept() is logged and skipped rather than killing the whole
// server, matching showcase/http_server.tr's own accept-loop.
pub fn Server.listen(port: int): void {
    mut listener: net::TcpListener = net::TcpListener::bind(port) recover run {
        io::printline("http::Server.listen: could not bind port " + (port to string) + ".");
        sys::exit(1);
        return; // unreachable (sys::exit never returns) -- see the
                 // 'recover run' non-diverging-block rule this satisfies.
    };
    self.listener = listener;

    while true {
        mut conn: net::TcpConnection = self.listener.accept() recover run {
            continue;
        };
        // Per-iteration (F-MEM-2: no finalizers, so closing is explicit): runs
        // on the 404 `continue` and on normal fall-through alike.
        defer conn.close();
        mut req: Request = parse_request(conn);
        mut res: Response = Response::default();
        res.conn = conn;

        if !self.has_route(req.path) {
            res.send_text(404, "Not Found");
            continue;
        }
        mut handler: fn(Request, Response): void = self.get_route(req.path);
        handler(req, res);
    }
}
