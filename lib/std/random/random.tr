// ─── random.tr ───────────────────────────────────────────────────────────
// Pseudo-random number generation for TurfLang, built on a generator that
// libturfrt keeps (runtime/turfrt_sys.c).
//
// Design:
//   - THIS IS NOT CRYPTOGRAPHICALLY SECURE. The generator is a plain PRNG
//     (xorshift64*) -- predictable, and trivially distinguishable
//     from true randomness by anyone who observes a few outputs or guesses
//     the seed. Never use anything in this module for tokens, keys,
//     passwords, nonces, or any other security-sensitive purpose. A real
//     CSPRNG binding (e.g. wrapping /dev/urandom or getrandom(2)) is a
//     deliberately separate, future module -- out of scope here.
//   - Seeding: this language has NO mutable global/module-level state at
//     all (only `export immut` constants exist; `export mut` is rejected at
//     parse time, see src/frontend/ParserDecl.cpp's ExportMutNotSupportedError), so a
//     Turf module cannot hold "already seeded" or a generator's state. The
//     RUNTIME can (it owns what must be true across the whole process,
//     FREEZE.md 6.8 B2): libturfrt keeps one generator (runtime/turfrt_sys.c),
//     seeded once, on first use, from the operating system's entropy, and
//     advanced by every draw. There is no seed()-before-use step to forget.
//
//     This replaced a design that reseeded libc's srand() on EVERY call from
//     the wall clock plus CPU ticks. That worked only where two calls a few
//     microseconds apart saw different clock values (glibc's clock() is CPU
//     time in microseconds): on Windows, where clock() is a millisecond wall
//     clock, 1000 calls in a tight loop shared one seed and returned one value
//     1000 times. It also took rand()'s range to be glibc's RAND_MAX (2^31-1),
//     which on Windows is 32767. The runtime generator returns 31 bits on every
//     platform, so RAND_MAX below is true everywhere.
//
//     Still NOT suitable for a reproducible-by-seed simulation (there is no way
//     to set the seed), and NOT secure: the generator is xorshift64*, which is
//     fast and well distributed but predictable from a few outputs.
//
// Usage:
//   import random;
//
//   immut roll: int = random::random_int(1, 6);      // 1..6 inclusive
//   immut chance: double = random::random_double();  // [0.0, 1.0)
//   if random::random_bool() { ... }                 // coin flip

import sys;

// ─── libc bindings ────────────────────────────────────────────────────────

extern fn turfrt_random_u31(): int;
extern fn turfrt_random_reseed(): void;

// ─── constants ──────────────────────────────────────────────────────────────

// The largest value the generator returns: 2^31 - 1 (31 bits), on every
// platform. (It used to be glibc's rand() limit, which is only true of glibc.)
export immut RAND_MAX: int = 2147483647;

// ─── Turf-level helpers ────────────────────────────────────────────────────

// reseed: draw a fresh seed for the generator from the operating system. The
// functions below do not need it called (the generator seeds itself on first
// use and then keeps advancing); it is kept for callers that want to
// deliberately discard the current sequence.
pub fn reseed(): void {
    turfrt_random_reseed();
}

// random_int: a pseudo-random integer in [min, max], inclusive of both
// ends, for any two ints. A span below 2^62 is served from a 62-bit draw
// (two 31-bit ones) as `draw % (span + 1)`, whose bias toward the low end is
// below 2^-30 even for the widest such span. A wider span, up to all of
// `int`, draws whole 64-bit values and keeps the first that falls inside, at
// least one in four. One 31-bit draw capped every result at
// min + 2147483647, and `max - min + 1` overflowed for the widest spans.
@caller_location
pub fn random_int(min: int, max: int): int {
    // `max < min` is an empty range. Not input a caller can recover from, so
    // it is a precondition panic that names the call.
    if max < min {
        sys::panic(caller_location + ": random_int: max (" + (max to string) + ") is less than min (" + (min to string) + ")");
    }
    // `max - min` overflows exactly when min < 0 and max > INT_MAX + min.
    immut span_overflows: bool = min < 0 && max > 9223372036854775807 + min;
    if !span_overflows && max - min < 4611686018427387904 {
        immut r: int = (turfrt_random_u31() << 31) | turfrt_random_u31();
        return min + (r % (max - min + 1));
    }
    while true {
        immut v: int = random_u64();
        if v >= min && v <= max {
            return v;
        }
    }
    return min;
}

// A uniformly random 64-bit pattern as an int: 63 low bits from three draws,
// and the sign from a fourth. Built so no shift drops a set bit, which `<<`
// checks.
fn random_u64(): int {
    immut low: int = (turfrt_random_u31() << 32) | (turfrt_random_u31() << 1) |
    (turfrt_random_u31() & 1);
    if (turfrt_random_u31() & 1) == 1 {
        return low + (-9223372036854775807 - 1);
    }
    return low;
}

// random_double: a pseudo-random value in [0.0, 1.0) -- never exactly
// 1.0, since rand()'s maximum possible output (RAND_MAX) is divided by
// RAND_MAX + 1, not RAND_MAX itself.
pub fn random_double(): double {
    immut r: int = turfrt_random_u31();
    return (r to double) / ((RAND_MAX to double) + 1.0);
}

// random_bool: a coin flip -- true or false, each roughly 50% of the time.
pub fn random_bool(): bool {
    return random_int(0, 1) == 1;
}
