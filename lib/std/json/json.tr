// ─── json.tr ─────────────────────────────────────────────────────────────
// A small, hand-rolled JSON parser/serializer for TurfLang.
//
// Design:
//   - Deliberately NOT a binding over an external C JSON library (cjson/
//     json-c/jansson/...) via `extern fn` -- docs/planning/DESIGN_NOTES.md
//     §4 originally sketched exactly that ("wrap cJSON via FFI"), but that
//     would make any Turf program that does `import json;` fail to LINK on
//     a machine that doesn't happen to have that specific shared library
//     installed, which defeats "batteries included, works out of the box"
//     for a language runtime. This file is pure Turf, using only the
//     stdlib's own `strings`/`list`/`sys` modules -- it always builds,
//     everywhere this compiler already runs.
//   - `JsonValue` is a tagged union in spirit, `struct` in practice --
//     this language has no real tagged-union/`enum`-with-payload type, so
//     it's one `JsonType` tag field plus one field per variant
//     (`bool_val`/`num_val`/`str_val`/`arr_val`/`obj_keys`+`obj_vals`),
//     exactly the shape sketched in DESIGN_NOTES.md. Only the field(s)
//     matching `.kind` are meaningful at any given time; the rest sit at
//     their zero value.
//   - Objects use TWO PARALLEL LISTS (`obj_keys: List<string>`,
//     `obj_vals: List<JsonValue>`) rather than `Map<string, JsonValue>`.
//     `Map<string, string>` as a plain struct field genuinely works now
//     (see http.tr's `Request.headers`) -- but a generic `Map<K, JsonValue>`
//     is unrelated to this choice; the two parallel lists predate that and
//     stay for the linear-scan tradeoff `map.tr` itself documents, not a
//     workaround.
//   - `arr_val`/`obj_vals` are `List<JsonValue>` **by value**, not
//     `List<JsonValue*>` (OVH-002,
//     `docs/planning/OVERHAUL_REMAINING_WORK.md`): earlier versions of this
//     file individually heap-boxed each element with `mem::alloc(sizeof(
//     JsonValue))` because `List<JsonValue>` was believed to fail at
//     `.push()` under type erasure. That belief was stale even before
//     TYPE-002 monomorphization landed for real (`List<T>` holds `data: T*`,
//     so `JsonValue` containing `List<JsonValue>` was never a by-value
//     cycle to begin with) -- and the boxing was actively unsafe once
//     MEM-002's collector existed: each box's `str_val`/`arr_val`/
//     `obj_keys`/`obj_vals` GC-heap pointers lived ONLY inside that
//     `mem::alloc` block, invisible to the collector (F-MEM-3 — manual
//     memory is never traced), so a collection between building a
//     `JsonValue` tree and reading it back could free a string or nested
//     list still reachable only through the box. `List<JsonValue>` by
//     value has no such gap: the collector traces a `List<T>` element the
//     same precise way it traces anything else (`getOrCreateElementTurfTypeDesc()`,
//     `docs/architecture/memory_model.md` §2.6). `tests/41_gc/
//     07_json_values_survive_collection.tr` is this fix's own regression
//     test.
//   - `obj_keys`/`obj_vals` lookup is a LINEAR SCAN, matching map.tr's own
//     "small collections, correctness over cleverness" tradeoff (no
//     generic `hash(T)` in the language yet either way).
//   - One documented, deliberate parsing gap: `\uXXXX` unicode escapes in
//     strings (an unrecognized escape is appended literally instead, e.g.
//     `\u` becomes the two characters `u`... note the backslash itself is
//     simply dropped for an unrecognized escape). Objects, arrays, strings,
//     numbers -- exponents included (`1e10`, `2.5E-3`, since
//     `strings::parse_double` reads them; before it did, any number with an
//     exponent failed the whole parse) -- true/false/null, and arbitrary
//     nesting are all handled. So is everything `stringify` writes: a large
//     or small number prints with an exponent (`1e+21`).
//
// Usage:
//   import json;
//
//   immut parsed: json::JsonValue = json::parse(text) recover as err run {
//       io::printline("bad json");
//       return;
//   };
//   immut name: string = parsed.get_string("name");
//
//   mut obj: json::JsonValue = json::JsonValue::new_object();
//   obj.set("status", json::JsonValue::from_string("ok"));
//   obj.set("count", json::JsonValue::from_number(3.0));
//   immut text: string = json::stringify(obj);

import io;
import sys;
import strings;
import list::List;

// ─── JsonValue ───────────────────────────────────────────────────────────

pub enum JsonType {
    Null,
    Bool,
    Number,
    String,
    Array,
    Object
}

pub struct JsonValue {
    pub kind: JsonType,
    pub bool_val: bool,
    pub num_val: double,
    pub str_val: string,
    pub arr_val: List<JsonValue>,
    pub obj_keys: List<string>,
    pub obj_vals: List<JsonValue>
}

// ─── constructors ──────────────────────────────────────────────────────────

pub fn JsonValue.null_value() static: JsonValue {
    mut v: JsonValue = JsonValue::default();
    v.kind = JsonType::Null;
    return v;
}

pub fn JsonValue.from_bool(b: bool) static: JsonValue {
    mut v: JsonValue = JsonValue::default();
    v.kind = JsonType::Bool;
    v.bool_val = b;
    return v;
}

pub fn JsonValue.from_number(n: double) static: JsonValue {
    mut v: JsonValue = JsonValue::default();
    v.kind = JsonType::Number;
    v.num_val = n;
    return v;
}

pub fn JsonValue.from_string(s: string) static: JsonValue {
    mut v: JsonValue = JsonValue::default();
    v.kind = JsonType::String;
    v.str_val = s;
    return v;
}

pub fn JsonValue.new_array() static: JsonValue {
    mut v: JsonValue = JsonValue::default();
    v.kind = JsonType::Array;
    return v;
}

pub fn JsonValue.new_object() static: JsonValue {
    mut v: JsonValue = JsonValue::default();
    v.kind = JsonType::Object;
    return v;
}

// ─── mutators (building a value to stringify) ───────────────────────────────

// Appends `item` to an Array-kind value.
pub fn JsonValue.push(item: JsonValue): void {
    self.arr_val.push(item);
}

// Sets `key` to `value` on an Object-kind value, replacing any existing
// value for the same key (linear scan, same tradeoff as map.tr's Map.put).
pub fn JsonValue.set(key: string, value: JsonValue): void {
    mut idx: int = 0 - 1;
    mut i: int = 0;
    while i < self.obj_keys.length() {
        if self.obj_keys.get(i) == key {
            idx = i;
        }
        i = i + 1;
    }

    if idx >= 0 {
        self.obj_vals.set(idx, value);
    } else {
        self.obj_keys.push(key);
        self.obj_vals.push(value);
    }
}

// ─── accessors ───────────────────────────────────────────────────────────

// Looks up `key` on an Object-kind value. Aborts if the key is missing --
// mirrors map.tr's Map.get()'s identical "missing key is a programming
// bug" default; check `.has(key)` first if a miss is expected input.
@caller_location
pub fn JsonValue.get(key: string): JsonValue {
    mut i: int = 0;
    while i < self.obj_keys.length() {
        if self.obj_keys.get(i) == key {
            return self.obj_vals.get(i);
        }
        i = i + 1;
    }
    sys::panic(caller_location + ": JsonValue.get: no such key '" + key + "'");
    return JsonValue::null_value();
}

// True if an Object-kind value has `key`.
pub fn JsonValue.has(key: string): bool {
    mut i: int = 0;
    while i < self.obj_keys.length() {
        if self.obj_keys.get(i) == key {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn JsonValue.get_string(key: string): string {
    return self.get(key).str_val;
}

pub fn JsonValue.get_number(key: string): double {
    return self.get(key).num_val;
}

pub fn JsonValue.get_int(key: string): int {
    return self.get_number(key) to int;
}

pub fn JsonValue.get_bool(key: string): bool {
    return self.get(key).bool_val;
}

// Indexes an Array-kind value. Aborts on an out-of-bounds index, mirroring
// strings.tr's substring()'s identical "this is a programming bug" abort.
@caller_location
pub fn JsonValue.at(index: int): JsonValue {
    if index < 0 || index >= self.arr_val.length() {
        sys::panic(caller_location + ": JsonValue.at: index out of bounds");
    }
    return self.arr_val.get(index);
}

// Element count for an Array or key count for an Object; 0 for any other
// kind (a scalar has no length, rather than treating that as an error).
pub fn JsonValue.length(): int {
    if self.kind == JsonType::Array {
        return self.arr_val.length();
    }
    if self.kind == JsonType::Object {
        return self.obj_keys.length();
    }
    return 0;
}

// ─── stringify ───────────────────────────────────────────────────────────

// Serializes `v` to compact JSON text (no extra whitespace).
//
// Destructuring (LEC-003): only the field(s) that are meaningful for a kind are
// named in its arm, which is exactly what the header comment above says about
// `.kind` -- the other fields "sit at" their defaults and are ignored by `..`.
pub fn stringify(v: JsonValue): string {
    compare v {
        matches JsonValue { kind: JsonType::Null, .. }:
        return "null";
        done
        matches JsonValue { kind: JsonType::Bool, bool_val: true, .. }:
        return "true";
        done
        matches JsonValue { kind: JsonType::Bool, .. }:
        return "false";
        done
        matches JsonValue { kind: JsonType::Number, num_val, .. }:
        return num_val to string;
        done
        matches JsonValue { kind: JsonType::String, str_val, .. }:
        return "\"" + escape_string(str_val) + "\"";
        done
        matches JsonValue { kind: JsonType::Array, .. }:
        return stringify_array(v);
        done
        otherwise:
        return stringify_object(v);
    }
}

// Built through a StringBuilder: `result = result + piece` copied everything
// written so far on every element, quadratic in the output (8000 items took
// 1.2 s; found by REL-005's benchmarks).
fn stringify_array(v: JsonValue): string {
    mut sb: strings::StringBuilder = strings::StringBuilder::default();
    sb.append_char('[');
    mut i: int = 0;
    mut n: int = v.arr_val.length();
    while i < n {
        if i > 0 {
            sb.append_char(',');
        }
        sb.append(stringify(v.arr_val.get(i)));
        i = i + 1;
    }
    sb.append_char(']');
    return sb.to_string();
}

fn stringify_object(v: JsonValue): string {
    mut sb: strings::StringBuilder = strings::StringBuilder::default();
    sb.append_char('{');
    mut i: int = 0;
    mut n: int = v.obj_keys.length();
    while i < n {
        if i > 0 {
            sb.append_char(',');
        }
        sb.append_char('"');
        sb.append(escape_string(v.obj_keys.get(i)));
        sb.append("\":");
        sb.append(stringify(v.obj_vals.get(i)));
        i = i + 1;
    }
    sb.append_char('}');
    return sb.to_string();
}

// escape_string: the body of a JSON string literal for `s` (WITHOUT the
// surrounding quotes), for a caller assembling JSON text by hand -- an HTTP
// handler splicing a user-supplied name into a response, say. `stringify`
// uses it for every string it writes, so the two can never disagree.
//
// Escapes `"` and `\`, uses the short forms `\n \r \t \b \f`, and writes every
// other control byte below 0x20 as `\u00XX`, because RFC 8259 forbids a raw
// control character inside a string: the old version covered only
// `" \ \n \r \t` and emitted invalid JSON for the rest. A byte >= 0x80 is
// copied through untouched (UTF-8 passes through; `char` is a SIGNED byte, so
// the `c >= 0` guard below is what keeps those bytes out of the control-
// character branch). `/` is not escaped (permitted, not required).
//
// parse() does NOT read `\u00XX` back (the documented \uXXXX gap in this
// file's header), so a string containing a control byte other than
// `\n \r \t` does not round-trip through stringify/parse; the OUTPUT is valid
// JSON, which is the part a caller splicing text into a response needs.
// Linear: built through a StringBuilder, not `result = result + piece`.
pub fn escape_string(s: string): string {
    mut sb: strings::StringBuilder = strings::StringBuilder::default();
    immut n: int = strings::length(s);
    sb.reserve(n);
    immut hex: string = "0123456789abcdef";
    mut i: int = 0;
    while i < n {
        immut ch: char = strings::byte_at_unchecked(s, i);
        // FDN-004: `char` is not a number; widen to `int` for the comparisons.
        immut c: int = ch to int;
        if c == 34 { // '"'
            sb.append("\\\"");
        } elseif c == 92 { // '\'
            sb.append("\\\\");
        } elseif c == 10 { // '\n'
            sb.append("\\n");
        } elseif c == 13 { // '\r'
            sb.append("\\r");
        } elseif c == 9 { // '\t'
            sb.append("\\t");
        } elseif c == 8 { // backspace
            sb.append("\\b");
        } elseif c == 12 { // form feed
            sb.append("\\f");
        } elseif c >= 0 && c < 32 {
            sb.append("\\u00");
            sb.append_char(strings::byte_at_unchecked(hex, c / 16));
            sb.append_char(strings::byte_at_unchecked(hex, c % 16));
        } else {
            sb.append_char(ch);
        }
        i = i + 1;
    }
    return sb.to_string();
}

// ─── parse ───────────────────────────────────────────────────────────────

// Every distinct way a JSON text can fail to parse -- kept as separate
// variants (docs/planning/Errors.md) so a caller using
// `recover as err run { ... }` can tell them apart. Every variant carries the
// byte offset into the text at which the parser gave up (LEC-004): read it with
// `matches json::JsonError::UnexpectedChar(at):`, or ignore it and compare with
// `err == json::JsonError::UnexpectedChar` as before. (A line/column would need
// position tracking this hand-rolled parser doesn't attempt; an offset is what
// it already has.)
pub error JsonError {
    UnexpectedEnd(offset: int),
    UnexpectedChar(offset: int),
    InvalidNumber(offset: int),
    InvalidLiteral(offset: int),
    UnterminatedString(offset: int),
    ExpectedColon(offset: int),
    ExpectedComma(offset: int),
}

// Parser state, threaded through by-reference via `self` exactly like
// List<T>/Map<K,V>'s own methods mutate `self.len` in place -- see
// list.tr's own design note on why this compiler's generic collections
// already rely on that same "self is mutated in place" method semantics.
struct Parser {
    pub s: string,
    pub pos: int,
    pub len: int
}

// The byte at `self.pos`, as an int. Precondition: `self.pos < self.len`;
// every caller has just checked it. Unchecked on purpose: `self.s[self.pos]`
// is bounds-checked against strlen() of the WHOLE document (F-STR-1), and
// LLVM cannot hoist that strlen() out of a loop that reads `s` through
// `self` while writing `self.pos`, so the parser was quadratic in the input
// (100 KB took 0.33 s, 1 MB ~30 s; found by REL-005's benchmarks).
fn Parser.at(): int {
    return strings::byte_at_unchecked(self.s, self.pos) to int;
}

// The bytes of the document from `a` up to `b`, appended to `sb`.
// Precondition: `0 <= a <= b <= self.len`. Not strings::substring(), which
// measures the whole document with strlen() to check the range: called for
// every number and string value, that kept parse() quadratic after `at()`.
fn Parser.copy_into(sb: &strings::StringBuilder, a: int, b: int): void {
    mut i: int = a;
    while i < b {
        sb.append_char(strings::byte_at_unchecked(self.s, i));
        i = i + 1;
    }
}

fn Parser.peek(): int {
    if self.pos >= self.len {
        return 0 - 1;
    }
    // The return type stays `int`: the `-1` end-of-input sentinel needs a
    // value outside 0..255, which `char` can't represent (FDN-004).
    return self.at();
}

fn Parser.skip_ws(): void {
    while self.pos < self.len {
        immut c: int = self.at();
        if c == 32 || c == 9 || c == 10 || c == 13 {
            self.pos = self.pos + 1;
        } else {
            return;
        }
    }
}

fn Parser.parse_value(): !JsonValue {
    self.skip_ws();
    immut c: int = self.peek();
    if c == (0 - 1) {
        return JsonError::UnexpectedEnd(self.pos);
    }
    // `return self.parse_object();` would do for the `{`/`[` cases (LEC-004: a
    // `!T` returned from a function declaring exactly that `!T` passes
    // through), but `try` reads the same everywhere below, where the result
    // needs unwrapping before it is wrapped again.
    if c == 123 { // '{'
        return self.parse_object();
    }
    if c == 91 { // '['
        return self.parse_array();
    }
    if c == 34 { // '"'
        immut s: string = try self.parse_string();
        return JsonValue::from_string(s);
    }
    if c == 116 { // 't' -- true
        return self.parse_literal("true", JsonValue::from_bool(true));
    }
    if c == 102 { // 'f' -- false
        return self.parse_literal("false", JsonValue::from_bool(false));
    }
    if c == 110 { // 'n' -- null
        return self.parse_literal("null", JsonValue::null_value());
    }
    if (c >= 48 && c <= 57) || c == 45 { // digit or '-'
        return self.parse_number();
    }
    return JsonError::UnexpectedChar(self.pos);
}

fn Parser.parse_literal(lit: string, value: JsonValue): !JsonValue {
    immut n: int = strings::length(lit);
    mut i: int = 0;
    while i < n {
        if self.pos >= self.len || self.at() != (lit[i] to int) {
            return JsonError::InvalidLiteral(self.pos);
        }
        self.pos = self.pos + 1;
        i = i + 1;
    }
    return value;
}

fn Parser.parse_string(): !string {
    // Precondition: self.peek() == '"' (only ever called from a context
    // that already checked this).
    self.pos = self.pos + 1; // consume opening quote
    // Each run of plain bytes is copied in one append, not one byte at a time
    // into `result = result + ...` (quadratic in the string's length).
    mut sb: strings::StringBuilder = strings::StringBuilder::default();
    mut seg: int = self.pos; // start of the current run of plain bytes
    while self.pos < self.len {
        immut c: int = self.at();
        if c == 34 { // closing quote
            self.copy_into(&sb, seg, self.pos);
            self.pos = self.pos + 1;
            return sb.to_string();
        }
        if c == 92 { // backslash
            self.copy_into(&sb, seg, self.pos);
            self.pos = self.pos + 1;
            if self.pos >= self.len {
                return JsonError::UnterminatedString(self.pos);
            }
            immut esc: int = self.at();
            if esc == 34 {
                sb.append_char('"');
            } elseif esc == 92 {
                sb.append_char('\\');
            } elseif esc == 47 {
                sb.append_char('/');
            } elseif esc == 110 {
                sb.append_char('\n');
            } elseif esc == 116 {
                sb.append_char('\t');
            } elseif esc == 114 {
                sb.append_char('\r');
            } else {
                // Unrecognized escape (including the unsupported \uXXXX --
                // see this file's header comment) -- append the character
                // itself literally rather than fail the whole parse.
                sb.append_char(strings::byte_at_unchecked(self.s, self.pos));
            }
            self.pos = self.pos + 1;
            seg = self.pos;
        } else {
            self.pos = self.pos + 1;
        }
    }
    return JsonError::UnterminatedString(self.pos);
}

fn Parser.parse_number(): !JsonValue {
    // Every `self.at()` below follows a `self.pos < self.len` in the same
    // condition (short-circuit), which is its precondition.
    immut start: int = self.pos;
    if self.pos < self.len && self.at() == 45 { // '-'
        self.pos = self.pos + 1;
    }
    mut sawDigit: bool = false;
    while self.pos < self.len && self.at() >= 48 && self.at() <= 57 {
        self.pos = self.pos + 1;
        sawDigit = true;
    }
    if self.pos < self.len && self.at() == 46 { // '.'
        self.pos = self.pos + 1;
        while self.pos < self.len && self.at() >= 48 && self.at() <= 57 {
            self.pos = self.pos + 1;
            sawDigit = true;
        }
    }
    // Exponent: `e`/`E`, an optional sign, digits; strings::parse_double
    // below reads it.
    if self.pos < self.len && (self.at() == 101 || self.at() == 69) { // 'e'/'E'
        self.pos = self.pos + 1;
        if self.pos < self.len && (self.at() == 43 || self.at() == 45) {
            self.pos = self.pos + 1;
        }
        while self.pos < self.len && self.at() >= 48 && self.at() <= 57 {
            self.pos = self.pos + 1;
        }
    }
    if !sawDigit {
        return JsonError::InvalidNumber(start);
    }
    mut digits: strings::StringBuilder = strings::StringBuilder::default();
    self.copy_into(&digits, start, self.pos);
    immut numStr: string = digits.to_string();
    immut n: double = strings::parse_double(numStr) recover run {
        return JsonError::InvalidNumber(start);
    };
    return JsonValue::from_number(n);
}

fn Parser.parse_array(): !JsonValue {
    self.pos = self.pos + 1; // consume '['
    mut arr: JsonValue = JsonValue::new_array();
    self.skip_ws();
    if self.peek() == 93 { // ']'
        self.pos = self.pos + 1;
        return arr;
    }
    while true {
        immut item: JsonValue = try self.parse_value();
        arr.push(item);
        self.skip_ws();
        immut c: int = self.peek();
        if c == 44 { // ','
            self.pos = self.pos + 1;
            self.skip_ws();
        } elseif c == 93 { // ']'
            self.pos = self.pos + 1;
            return arr;
        } else {
            return JsonError::ExpectedComma(self.pos);
        }
    }
    // No trailing `return arr;` here: every path through the loop above
    // ends in `return` (success on `']'`, failure on anything else), so
    // falling off the end of `while true` is unreachable -- OVH-012, a
    // genuine UnreachableCodeWarning confirmed live on the line this used
    // to be; the compiler accepts a `!T` function ending in an unbreakable
    // `while true` with no further statement.
}

fn Parser.parse_object(): !JsonValue {
    self.pos = self.pos + 1; // consume '{'
    mut obj: JsonValue = JsonValue::new_object();
    self.skip_ws();
    if self.peek() == 125 { // '}'
        self.pos = self.pos + 1;
        return obj;
    }
    while true {
        self.skip_ws();
        if self.peek() != 34 { // '"'
            return JsonError::UnexpectedChar(self.pos);
        }
        immut key: string = try self.parse_string();
        self.skip_ws();
        if self.peek() != 58 { // ':'
            return JsonError::ExpectedColon(self.pos);
        }
        self.pos = self.pos + 1;
        self.skip_ws();
        immut value: JsonValue = try self.parse_value();
        obj.set(key, value);
        self.skip_ws();
        immut c: int = self.peek();
        if c == 44 { // ','
            self.pos = self.pos + 1;
        } elseif c == 125 { // '}'
            self.pos = self.pos + 1;
            return obj;
        } else {
            return JsonError::ExpectedComma(self.pos);
        }
    }
    // No trailing `return obj;` here -- same unreachable-`while true`-tail
    // reasoning as parse_array() above (OVH-012).
}

// Parses `s` as a single JSON text (object, array, string, number,
// true/false/null). Trailing bytes after a complete value are ignored
// rather than rejected -- a deliberate simplification, not a correctness
// bug: this parser is meant for "parse the one JSON value a request/
// response body contains", not for validating a whole document stream.
pub fn parse(s: string): !JsonValue {
    mut p: Parser = Parser::default();
    p.s = s;
    p.pos = 0;
    p.len = strings::length(s);
    return p.parse_value();
}
