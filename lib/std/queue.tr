// std/queue.tr
// Queue<T> — FIFO (First In, First Out) collection.
// Usage: Queue<int> q = Queue<int>()  q.enqueue(1)  q.dequeue()  q.peek()  q.length()
//
// Implementation: dynamic array with a head offset.
//   - enqueue appends at data[head + len]
//   - dequeue reads from data[head] and advances head
//   - when (head + len == cap): if head > 0 compact elements to front,
//     otherwise double the capacity
import mem

struct Queue<T> {
  T* data,
  int len,
  int cap,
  int head
}

fn<T> void Queue.enqueue(T item) {
  if (self.head + self.len == self.cap) {
    if (self.head > 0) {
      // Compact: shift live elements to the front of the buffer
      int i = 0
      while i < self.len {
        self.data[i] = self.data[self.head + i]
        i = i + 1
      }
      self.head = 0
    } else {
      // Buffer is full and already at front — grow it
      if (self.cap == 0) {
        self.cap = 8
        self.data = T*(mem.malloc(self.cap * 8))
      } else {
        self.cap = self.cap * 2
        self.data = T*(mem.realloc(self.data, self.cap * 8))
      }
    }
  }

  self.data[self.head + self.len] = item
  self.len = self.len + 1
}

fn<T> T Queue.dequeue() {
  if (self.len == 0) {
    // Trap: dequeue on empty queue
    mem.free(T*(0))
  }

  T item = self.data[self.head]
  self.head = self.head + 1
  self.len = self.len - 1
  return item
}

fn<T> T Queue.peek() {
  if (self.len == 0) {
    // Trap: peek on empty queue
    mem.free(T*(0))
  }

  return self.data[self.head]
}

fn<T> int Queue.length() {
  return self.len
}
