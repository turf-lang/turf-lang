// std/io.tr

@intrinsic("input")
fn string input()

@intrinsic("print")
fn void print(int val)

@intrinsic("print")
fn void print(double val)

@intrinsic("print")
fn void print(bool val)

@intrinsic("print")
fn void print(string val)

@intrinsic("printline")
fn void printline(int val)

@intrinsic("printline")
fn void printline(double val)

@intrinsic("printline")
fn void printline(bool val)

@intrinsic("printline")
fn void printline(string val)
