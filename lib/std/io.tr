@intrinsic("input")
fn input(): string

@intrinsic("print")
fn print(val: int): void

@intrinsic("print")
fn print(val: double): void

@intrinsic("print")
fn print(val: bool): void

@intrinsic("print")
fn print(val: string): void

@intrinsic("printline")
fn printline(val: int): void

@intrinsic("printline")
fn printline(val: double): void

@intrinsic("printline")
fn printline(val: bool): void

@intrinsic("printline")
fn printline(val: string): void
