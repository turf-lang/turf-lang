// ─── sys.tr ────────────────────────────────────────────────────────────────
// Low-level system interaction for TurfLang: process termination and the
// one primitive every other stdlib module's internal guard rails are built
// on (`panic`).
//
// Design:
//   - `abort`/`exit` need no wrapping logic, so they're used directly as
//     their raw `extern fn` bindings -- `sys::abort()`/`sys::exit(code)` --
//     exactly like net.tr exposes `close(fd)` with no Turf-level wrapper.
//     (A same-named, same-signature Turf `fn abort(): void { abort(); }`
//     wrapper is NOT an overload of the extern declaration -- it's a
//     duplicate declaration, which is a compile error, and would recurse
//     into itself even if it weren't.)
//   - `panic` is the shared "print a message to stderr, then terminate"
//     primitive. It exists here, in sys.tr, rather than in test.tr, because
//     it's used by other stdlib modules' internal correctness guards (e.g.
//     mem.tr's out-of-memory checks, net.tr's socket-failure checks) --
//     those are production code, not test code, and must not depend on a
//     module named "test".
//   - There is no way to `extern` a global variable in this language (only
//     functions), so libc's `stderr` FILE* is unreachable directly. `panic`
//     instead uses the POSIX `write(2, ...)` syscall with the fd hardcoded
//     to `STDERR_FD` -- no FILE* needed, mirrors net.tr's raw-socket-fd
//     style rather than io.tr's buffered-stream style.
//
// Usage:
//   import sys;
//   if bad_thing { sys::panic("something went wrong"); }
//   sys::exit(1);

// ─── libc bindings ────────────────────────────────────────────────────────

extern fn abort(): void;
extern fn exit(code: int): void;
extern fn write(fd: int, buf: string, count: int): int;
// A local strlen extern, not `import strings;` -- strings.tr itself needs
// sys.tr for panics (see panic()'s own doc comment below on the circular-
// import constraint this avoids). Safe to declare independently: this is
// the same identical-signature-across-modules pattern strlen/malloc/calloc
// already use elsewhere in the stdlib (RFC step 5's extern-conflict fix
// explicitly allows this, rejecting only genuinely conflicting signatures).
extern fn strlen(s: string): int;

// ─── Turf-level helpers ───────────────────────────────────────────────────

export immut STDERR_FD: int = 2;

// panic: write `msg` (plus a trailing newline) to stderr, then abort. Never
// returns -- every stdlib module's internal "this should be impossible"
// guard rails (OOM, a failed syscall, a violated invariant) call this.
//
// Two separate write() calls instead of one concatenated `msg + "\n"`
// write, deliberately: string `+` is now an `operator` overload defined in
// lib/std/strings.tr (STRING_UFCS_OPERATOR_CHAR_RFC.md §7 step 2/3), and
// strings.tr itself needs sys.tr for panics on its own internal errors
// (e.g. substring's bounds check) -- sys.tr importing strings.tr back would
// be a circular import. Avoiding string arithmetic here entirely breaks
// that cycle without sys.tr needing any operator overload at all.
fn panic(msg: string): void {
    write(STDERR_FD, msg, strlen(msg));
    write(STDERR_FD, "\n", 1);
    abort();
}
